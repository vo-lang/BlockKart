package main

import (
	"math"
)

type BlockKartVehicleAssistOutput struct {
	Yaw_moment_newton_meters float64
	Lateral_force_newtons float64
	Rear_friction_scale float64
	Countersteer_radians float64
}

func (vehicle *BlockKartVehicleController) stepSteering(target float64, surface uint32, deltaSeconds float64) {
	speedMetersPerSecond := math.Abs(vehicle.Forward_speed) / 1000.0
	speedRatio := blockKartVehicleClamp(speedMetersPerSecond /
		(blockKartVehicleNormalMaximumSpeed/1000.0), 0, 1)
	// Digital steering is first converted to a bounded analog command. The
	// rates follow the same shape used by production vehicle SDKs: deliberate
	// turn-in, faster release, and a decisive but continuous reversal.
	reversing := target != 0 && vehicle.Steer_command != 0 &&
		(vehicle.Steer_command < 0) != (target < 0)
	commandRate := 3.10 - speedRatio * 0.70
	if target == 0 {
		commandRate = 6.0
	} else if reversing {
		commandRate = 5.2
		if surface == blockKartRoadSurfaceGrass {
			commandRate = 6.8
		}
	}
	vehicle.Steer_command = blockKartVehicleApproach(vehicle.Steer_command, target, commandRate *
		deltaSeconds)

	// Full input requests a lateral-acceleration budget. Converting that
	// budget through the bicycle model yields a physically meaningful,
	// speed-sensitive road-wheel angle: generous in a hairpin, measured at
	// racing speed. The previous linear angle table still allowed 13 degrees
	// at maximum speed, more than three times the stable value.
	const gripLateralAcceleration = 13.25
	speedSquared := math.Max(
		speedMetersPerSecond*speedMetersPerSecond,
		27.0,
	)
	maximumWheelAngle := math.Atan(
		gripLateralAcceleration * blockKartVehicleWheelbaseMeters /
			speedSquared,
	)
	maximumWheelAngle = blockKartVehicleClamp(
		maximumWheelAngle,
		0.034,
		0.49,
	)
	if vehicle.Drift_blend > 0 {
		maximumWheelAngle *= blockKartVehicleLerp(
			1.0,
			1.34,
			vehicle.Drift_blend,
		)
		maximumWheelAngle = math.Min(maximumWheelAngle, 0.52)
	}
	if surface == blockKartRoadSurfaceGrass {
		maximumWheelAngle *= 0.82
	}
	shaped := math.Pow(math.Abs(vehicle.Steer_command), 1.18)
	if vehicle.Steer_command < 0 {
		shaped = -shaped
	}
	wheelTarget := shaped * maximumWheelAngle
	wheelRate := 2.15
	if target == 0 {
		wheelRate = 4.8
	} else if reversing {
		wheelRate = 4.6
		if surface == blockKartRoadSurfaceGrass {
			wheelRate = 6.0
		}
	}
	vehicle.Wheel_angle_radians = blockKartVehicleApproach(vehicle.Wheel_angle_radians, wheelTarget, wheelRate *
		deltaSeconds)
	vehicle.Desired_yaw_rate = 0
	if speedMetersPerSecond > 0.25 {
		vehicle.Desired_yaw_rate = vehicle.Forward_speed / 1000.0 /
			blockKartVehicleWheelbaseMeters *
			math.Tan(vehicle.Wheel_angle_radians)
	}
}

func (vehicle *BlockKartVehicleController) stepDriftBlend(drifting bool, deltaSeconds float64) {
	target := 0.0
	rate := 5.8
	if drifting {
		target = 1.0
		rate = 4.7
	}
	vehicle.Drift_blend = blockKartVehicleApproach(vehicle.Drift_blend, target, rate * deltaSeconds)
}

func (vehicle *BlockKartVehicleController) computeAssists(longitudinalSpeed float64, lateralSpeed float64, yawRate float64, road BlockKartRoadSample, throttle float64, brake float64, drifting bool, driftDirection int32) BlockKartVehicleAssistOutput {
	output := BlockKartVehicleAssistOutput{Rear_friction_scale: 1.0}
	absoluteSpeed := math.Abs(longitudinalSpeed)
	speedBlend := blockKartVehicleSmoothstep(3.5, 13.0, absoluteSpeed)
	guideYawRate, guideLateralForce := vehicle.computeRoadGuidance(
		longitudinalSpeed,
		lateralSpeed,
		yawRate,
		road,
		drifting,
	)
	// Keyboard steering is a bounded heading bias around the road reference.
	// A raw sum made full digital input request the road curvature twice:
	// once from the path guide and again from the bicycle model. Keeping the
	// driver share below one preserves lane-choice authority without the
	// snap-oversteer that made a single key press throw the kart across a bend.
	driverYawAuthority := blockKartVehicleLerp(
		0.72,
		0.58,
		blockKartVehicleSmoothstep(8.0, 28.0, absoluteSpeed),
	)
	if drifting || vehicle.Drift_blend > 0 {
		driverYawAuthority = blockKartVehicleLerp(
			driverYawAuthority,
			1.0,
			vehicle.Drift_blend,
		)
	}
	desiredYaw := vehicle.Desired_yaw_rate*driverYawAuthority + guideYawRate
	beta := math.Atan2(lateralSpeed, math.Max(absoluteSpeed, 1.0))
	yawError := desiredYaw - yawRate
	steerCommit := math.Abs(vehicle.Steer_command)
	stabilityFade := (1.0 - steerCommit * 0.22) * speedBlend
	yawMoment := yawError * blockKartVehicleYawInertiaKgM2 * 3.8 * stabilityFade
	slipMoment := -beta * blockKartVehicleYawInertiaKgM2 * 3.1 * stabilityFade
	maximumMoment := 430.0 * road.Friction
	output.Yaw_moment_newton_meters = blockKartVehicleClamp(yawMoment + slipMoment, -maximumMoment, maximumMoment)
	lateralDamping := -lateralSpeed * blockKartVehicleMassKg * 0.92 * stabilityFade
	maximumLateralAssist := blockKartVehicleMassKg * blockKartVehicleGravity * road.Friction * 0.16
	output.Lateral_force_newtons = blockKartVehicleClamp(
		lateralDamping+guideLateralForce,
		-maximumLateralAssist,
		maximumLateralAssist,
	)
	if drifting || vehicle.Drift_blend > 0 {
		commit := 0.0
		counter := 0.0
		if driftDirection != 0 {
			signedSteer := vehicle.Steer_command * float64(driftDirection)
			commit = blockKartVehicleClamp(signedSteer, 0, 1)
			counter = blockKartVehicleClamp(-signedSteer, 0, 1)
		}
		driftBlend := vehicle.Drift_blend
		output.Rear_friction_scale = blockKartVehicleLerp(
			1.0,
			0.40+counter*0.22,
			driftBlend,
		)
		// Drift control tracks a bounded body-slip target. Steering into the
		// drift grows the target; countersteer continuously unwinds it. This
		// gives the player authority over the slide instead of switching
		// between two fixed friction presets.
		targetSlip := float64(driftDirection) * (0.12 + commit * 0.10 - counter * 0.085) * speedBlend
		targetLateralSpeed := math.Tan(targetSlip) * math.Max(absoluteSpeed, 4.0)
		slipControlForce := (targetLateralSpeed - lateralSpeed) * blockKartVehicleMassKg * 3.35 *
			driftBlend
		maximumSlipControlForce := blockKartVehicleMassKg * blockKartVehicleGravity * road.Friction * 0.62
		output.Lateral_force_newtons *= 1.0 - driftBlend * 0.86
		output.Lateral_force_newtons += blockKartVehicleClamp(slipControlForce, -maximumSlipControlForce, maximumSlipControlForce)
		targetYaw := float64(driftDirection) * (0.70 + commit * 0.34 - counter * 0.46) * speedBlend
		driftMoment := (targetYaw - yawRate) * blockKartVehicleYawInertiaKgM2 * 2.45 * driftBlend
		output.Yaw_moment_newton_meters += blockKartVehicleClamp(driftMoment, -460, 460)
		output.Countersteer_radians = blockKartVehicleClamp(-beta * 0.18, -0.060, 0.060) * driftBlend *
			counter
	}
	if road.Surface == blockKartRoadSurfaceGrass {
		// Steering grip falls on grass, while differential braking and the
		// bounded centerline assist still retain useful authority. Keeping
		// those effects above the tyre-grip scale lets the driver unwind an
		// excursion without an invisible rail or a prolonged spin.
		output.Yaw_moment_newton_meters *= 0.72
		output.Lateral_force_newtons *= 0.58
		output.Rear_friction_scale = math.Min(output.Rear_friction_scale, 0.90)
	}
	if brake > 0.4 {
		output.Yaw_moment_newton_meters *= 0.85
	}
	if throttle == 0 && absoluteSpeed < 2.0 {
		output.Yaw_moment_newton_meters *= absoluteSpeed / 2.0
	}
	output.Yaw_moment_newton_meters = blockKartVehicleClamp(output.Yaw_moment_newton_meters, -maximumMoment, maximumMoment)
	return output
}

// computeRoadGuidance is a bounded Stanley-style reference generator. It
// returns a yaw-rate contribution and a small lateral-force correction. The
// yaw contribution joins the driver request before stability control, so only
// one controller ever owns yaw.
func (vehicle *BlockKartVehicleController) computeRoadGuidance(longitudinalSpeed float64, lateralSpeed float64, yawRate float64, road BlockKartRoadSample, drifting bool) (float64, float64) {
	absoluteSpeed := math.Abs(longitudinalSpeed)
	halfWidthMeters := math.Max(float64(road.Half_width_milli) / 1000.0, 1.0)
	offsetMeters := float64(road.Signed_offset_milli) / 1000.0
	edgeRatio := blockKartVehicleSmoothstep(0.42, 1.08, math.Abs(offsetMeters) / halfWidthMeters)
	authority := 0.72 + edgeRatio*0.22
	if road.Surface == blockKartRoadSurfaceGrass {
		authority = math.Max(authority, 0.84)
	}
	if drifting || vehicle.Drift_blend > 0.15 {
		authority *= blockKartVehicleLerp(1.0, 0.16, vehicle.Drift_blend)
	}
	authority = blockKartVehicleClamp(authority, 0, 0.94)
	roadHeading := math.Atan2(road.Tangent_x, road.Tangent_z)
	headingError := blockKartVehicleWrapRadians(roadHeading - vehicle.Heading_radians)
	crossTrackAngle := math.Atan2(-1.35 * offsetMeters, absoluteSpeed + 5.5)
	pathError := blockKartVehicleClamp(headingError + crossTrackAngle, -0.50, 0.50)
	referenceYawRate := longitudinalSpeed * road.Curvature_per_meter +
		pathError * (1.45 + edgeRatio * 1.65)
	driverYawRate := vehicle.Desired_yaw_rate
	if math.Abs(driverYawRate) > 0.08 && math.Abs(referenceYawRate) > 0.04 &&
		(driverYawRate < 0) != (referenceYawRate < 0) {
		authority *= 0.70
	}
	guideYawRate := referenceYawRate * authority
	guideYawRate = blockKartVehicleClamp(guideYawRate, -0.72, 0.72)
	centerForce := -offsetMeters * 185.0 - lateralSpeed * blockKartVehicleMassKg * 0.20
	centerForce *= authority
	maximumCenterForce := blockKartVehicleMassKg * blockKartVehicleGravity *
		math.Max(road.Friction, 0.55) *
		0.20
	centerForce = blockKartVehicleClamp(centerForce, -maximumCenterForce, maximumCenterForce)
	return guideYawRate, centerForce
}
