package main

import (
	"math"
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

const (
	blockKartRenderStressPrimitive10k = "primitive10k"
	blockKartRenderStressWater = "water"
	blockKartRenderStressResourceChurn = "resource-churn"
	blockKartRenderStressChunkedWorldDrive = "chunked-world-drive"
	blockKartRenderStressShadowPostMatrix = "shadow-post-matrix"
	blockKartRenderStressPrimitive10kCount = 10000
	blockKartRenderStressPrimitive10kChunk = 128
	blockKartRenderStressPrimitive10kColumns = 100
)

func (w *World) ActivateRenderStressProfile(g *voplay.GameCtx, profile string) {
	if w == nil || profile == "" {
		return
	}
	if w.hud.renderStressProfile == profile && w.hud.renderStressApplied {
		blockKartReportWorldDiagnostics(g, BlockKartLifecycleRunning, "renderStress", profile, w)
		return
	}
	w.hud.renderStressProfile = profile
	w.hud.renderStressApplied = false
	if profile == blockKartRenderStressPrimitive10k {
		w.core.trackRuntime.beginRenderStressPrimitive10k(w.BlockKartRuntimeContext)
	} else if profile == blockKartRenderStressWater {
		w.core.trackRuntime.addRenderStressWater(w.BlockKartRuntimeContext)
		w.hud.renderStressApplied = true
	} else if profile == blockKartRenderStressResourceChurn {
		w.core.trackRuntime.addRenderStressResourceChurn(w.BlockKartRuntimeContext)
		w.hud.renderStressApplied = true
	} else if profile == blockKartRenderStressChunkedWorldDrive {
		w.core.trackRuntime.addRenderStressChunkedWorldDrive(w.BlockKartRuntimeContext)
		w.hud.renderStressApplied = true
	} else if profile == blockKartRenderStressShadowPostMatrix {
		w.core.trackRuntime.addRenderStressShadowPostMatrix(w.BlockKartRuntimeContext)
		w.hud.renderStressApplied = true
	}
	if w.hud.renderStressApplied {
		w.hud.message = "Render stress: " + profile
		w.hud.messageTimer = 1.5
	}
	blockKartReportWorldDiagnostics(g, BlockKartLifecycleRunning, "renderStress", profile, w)
}

func (t *TrackRuntime) beginRenderStressPrimitive10k(w *BlockKartRuntimePorts) {
	primitive := w.core.trackRuntime.ensurePrimitiveScene(w)
	t.renderStressPrimitive10kBatch = primitive.BeginScatterBatch()
	t.renderStressPrimitive10kBatch.Reserve(blockKartRenderStressPrimitive10kCount)
	t.renderStressPrimitive10kIndex = 0
	t.renderStressPrimitive10kCenter = w.race.startPosition
	t.renderStressPrimitive10kRotations = make([]voplay.Quat, 0, 31)
	for i := 0; i < 31; i++ {
		t.renderStressPrimitive10kRotations = append(t.renderStressPrimitive10kRotations, voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, float64(i)*0.07))
	}
	t.renderStressPrimitive10kScales = make([]voplay.Vec3, 0, 60)
	for i := 0; i < 60; i++ {
		t.renderStressPrimitive10kScales = append(t.renderStressPrimitive10kScales, voplay.Vec3{X: 0.58 + float64(i%4)*0.08, Y: 0.42 + float64((i/3)%5)*0.04, Z: 0.58 + float64((i/5)%4)*0.08})
	}
}

func (t *TrackRuntime) advanceRenderStress(w *BlockKartRuntimePorts, g *voplay.GameCtx) {
	if w == nil || g == nil || t.renderStressPrimitive10kBatch == nil {
		return
	}
	primitive := w.core.trackRuntime.ensurePrimitiveScene(w)
	end := t.renderStressPrimitive10kIndex + blockKartRenderStressPrimitive10kChunk
	if end > blockKartRenderStressPrimitive10kCount {
		end = blockKartRenderStressPrimitive10kCount
	}
	for t.renderStressPrimitive10kIndex < end {
		i := t.renderStressPrimitive10kIndex
		t.renderStressPrimitive10kBatch.Add(t.renderStressPrimitive10kPlacement(primitive, i))
		t.renderStressPrimitive10kIndex++
	}
	if t.renderStressPrimitive10kIndex < blockKartRenderStressPrimitive10kCount {
		return
	}
	t.renderStressPrimitive10kBatch.End()
	t.renderStressPrimitive10kBatch = nil
	t.renderStressPrimitive10kRotations = nil
	t.renderStressPrimitive10kScales = nil
	w.hud.renderStressApplied = true
	w.hud.message = "Render stress: " + blockKartRenderStressPrimitive10k
	w.hud.messageTimer = 1.5
	blockKartReportRuntimeDiagnostics(g, BlockKartLifecycleRunning, "renderStress", blockKartRenderStressPrimitive10k, w)
}

func (t *TrackRuntime) renderStressPrimitive10kPlacement(primitive *PrimitiveVisualContent, i int) scene3d.BlockKartPrimitivePlacement {
	spacing := 2.35
	col := i % blockKartRenderStressPrimitive10kColumns
	row := i / blockKartRenderStressPrimitive10kColumns
	x := t.renderStressPrimitive10kCenter.X + (float64(col) - 49.5) * spacing
	z := t.renderStressPrimitive10kCenter.Z - 30.0 - float64(row) * spacing
	y := t.renderStressPrimitive10kCenter.Y - 0.85 + float64((i%13)-6)*0.018
	shape := primitive.RoundedBox
	if i % 11 == 0 {
		shape = primitive.Sphere
	} else if i % 17 == 0 {
		shape = primitive.Cylinder
	}
	material := primitive.MeadowMat
	if i % 5 == 0 {
		material = primitive.StoneMat
	} else if i % 7 == 0 {
		material = primitive.PebbleMat
	}
	return scene3d.BlockKartPrimitivePlacement{Shape: shape, Material: material, Position: voplay.Vec3{X: x, Y: y, Z: z}, Rotation: t.renderStressPrimitive10kRotations[i%31], Scale: t.renderStressPrimitive10kScales[i%60], Flags: scene3d.BlockKartPrimitiveNoShadow, LodFar: 150}
}

func (t *TrackRuntime) addRenderStressWater(w *BlockKartRuntimePorts) {
	primitive := w.core.trackRuntime.ensurePrimitiveScene(w)
	if w.core.track != nil {
		w.core.trackRuntime.addPrimitiveLakeAndBridge(w, w.core.track)
	}
	center := w.race.startPosition.Add(voplay.Vec3{X: 24, Y: -0.95, Z: -42})
	batch := primitive.BeginStaticBatch()
	for i := 0; i < 12; i++ {
		x := center.X + float64(i%4)*8.5
		z := center.Z - float64(i/4)*9.0
		batch.Add(scene3d.BlockKartPrimitivePlacement{Shape: primitive.RoundedBox, Material: primitive.WaterMat, Position: voplay.Vec3{X: x, Y: center.Y, Z: z}, Rotation: voplay.QuatIdentity(), Scale: voplay.Vec3{X: 7.8, Y: 0.08, Z: 7.8}, Flags: scene3d.BlockKartPrimitiveNoShadow})
	}
	batch.End()
}

func (t *TrackRuntime) addRenderStressResourceChurn(w *BlockKartRuntimePorts) {
	primitive := w.core.trackRuntime.ensurePrimitiveScene(w)
	batch := primitive.BeginSmallDetailBatch()
	count := 1536
	columns := 64
	for i := 0; i < count; i++ {
		col := i % columns
		row := i / columns
		position := w.race.startPosition.Add(voplay.Vec3{X: (float64(col) - 31.5) * 1.85, Y: -0.42 + math.Sin(float64(i)*0.23)*0.10, Z: -18.0 - float64(row)*1.95})
		material := primitive.FlowerYellowMat
		if i % 2 == 0 {
			material = primitive.FlowerWhiteMat
		}
		batch.Add(scene3d.BlockKartPrimitivePlacement{Shape: primitive.Sphere, Material: material, Position: position, Rotation: voplay.QuatIdentity(), Scale: voplay.Vec3{X: 0.32, Y: 0.24, Z: 0.32}, Flags: scene3d.BlockKartPrimitiveNoShadow, LodFar: primitiveFlowerClumpLodFar})
	}
	batch.End()
}

func (t *TrackRuntime) addRenderStressChunkedWorldDrive(w *BlockKartRuntimePorts) {
	primitive := w.core.trackRuntime.ensurePrimitiveScene(w)
	batch := primitive.BeginScatterBatch()
	count := 4096
	columns := 64
	spacing := 6.75
	center := w.race.startPosition.Add(voplay.Vec3{Z: -72})
	for i := 0; i < count; i++ {
		col := i % columns
		row := i / columns
		x := center.X + (float64(col) - 31.5) * spacing
		z := center.Z - float64(row) * spacing
		y := center.Y - 0.78 + math.Sin(float64(col)*0.41+float64(row)*0.27)*0.18
		shape := primitive.RoundedBox
		if i % 13 == 0 {
			shape = primitive.Cylinder
		} else if i % 19 == 0 {
			shape = primitive.Sphere
		}
		material := primitive.MeadowMat
		if row % 5 == 0 {
			material = primitive.StoneMat
		} else if col % 7 == 0 {
			material = primitive.PebbleMat
		}
		scale := voplay.Vec3{X: 0.72 + float64(i%3)*0.12, Y: 0.38 + float64(row%4)*0.06, Z: 0.72 + float64(col%4)*0.10}
		batch.Add(scene3d.BlockKartPrimitivePlacement{Shape: shape, Material: material, Position: voplay.Vec3{X: x, Y: y, Z: z}, Rotation: voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, float64(i%47)*0.11), Scale: scale, Flags: scene3d.BlockKartPrimitiveNoShadow, LodFar: 780})
	}
	batch.End()
}

func (t *TrackRuntime) addRenderStressShadowPostMatrix(w *BlockKartRuntimePorts) {
	primitive := w.core.trackRuntime.ensurePrimitiveScene(w)
	center := w.race.startPosition.Add(voplay.Vec3{X: -18, Z: -34})
	for row := 0; row < 8; row++ {
		for col := 0; col < 12; col++ {
			x := center.X + float64(col) * 4.2
			z := center.Z - float64(row) * 4.6
			height := 1.35 + float64((row+col)%5)*0.34
			material := primitive.WoodMat
			if (row + col) % 3 == 0 {
				material = primitive.StoneMat
			}
			scene3d.ProductBlockKartStaticWithFlags(primitive, primitive.Cylinder, material, voplay.Vec3{X: x, Y: center.Y + height*0.5 - 0.72, Z: z}, voplay.QuatIdentity(), voplay.Vec3{X: 0.42, Y: height, Z: 0.42}, voplay.Color{}, 0)
			if (row + col) % 4 == 0 {
				scene3d.ProductBlockKartStaticWithFlags(primitive, primitive.RoundedBox, primitive.PebbleMat, voplay.Vec3{X: x + 1.1, Y: center.Y - 0.46, Z: z + 1.0}, voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, float64(row+col)*0.19), voplay.Vec3{X: 1.25, Y: 0.48, Z: 0.72}, voplay.Color{}, 0)
			}
		}
	}
}
