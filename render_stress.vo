package main

import (
	"math"
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

const (
	blockKartRenderStressPrimitive10k = "primitive10k"
	blockKartRenderStressWater = "water"
	blockKartRenderStressResourceChurn = "resource-churn"
	blockKartRenderStressChunkedWorldDrive = "chunked-world-drive"
	blockKartRenderStressShadowPostMatrix = "shadow-post-matrix"
	blockKartRenderStressPrimitive10kCount = 10000
	blockKartRenderStressPrimitive10kChunk = 48
	blockKartRenderStressPrimitive10kColumns = 100
	blockKartRenderStressPrimitive10kCullOffset = 240.0
	blockKartRenderStressResourceChurnCount = 128
)

func (w *World) ActivateRenderStressProfile(g *voplay.GameCtx, profile string) {
	if w == nil || profile == "" {
		return
	}
	if w.hud.renderStress.profile == profile && w.hud.renderStress.applied {
		blockKartReportWorldDiagnostics(g, BlockKartLifecycleRunning, "renderStress", profile, w)
		return
	}
	w.hud.renderStress.profile = profile
	w.hud.renderStress.applied = false
	if profile == blockKartRenderStressPrimitive10k {
		w.core.trackRuntime.beginRenderStressPrimitive10k(&w.core, &w.race)
	} else if profile == blockKartRenderStressWater {
		w.core.trackRuntime.addRenderStressWater(&w.core, &w.race)
		w.hud.renderStress.applied = true
	} else if profile == blockKartRenderStressResourceChurn {
		w.core.trackRuntime.addRenderStressResourceChurn(&w.core, &w.race)
		w.hud.renderStress.applied = true
	} else if profile == blockKartRenderStressChunkedWorldDrive {
		w.core.trackRuntime.addRenderStressChunkedWorldDrive(&w.core, &w.race)
		w.hud.renderStress.applied = true
	} else if profile == blockKartRenderStressShadowPostMatrix {
		w.core.trackRuntime.addRenderStressShadowPostMatrix(&w.core, &w.race)
		w.hud.renderStress.applied = true
	}
	if w.hud.renderStress.applied {
		blockKartResetRenderStressPerfWindow(diagnosticsPortsFromStates(&w.core, &w.input, &w.race, &w.kart, &w.hud), g)
		w.hud.presentation.message = "Render stress: " + profile
		w.hud.presentation.messageTimer = 1.5
	}
	blockKartReportWorldDiagnostics(g, BlockKartLifecycleRunning, "renderStress", profile, w)
}

func blockKartResetRenderStressPerfWindow(w *DiagnosticsPorts, g *voplay.GameCtx) {
	if w == nil || g == nil || !blockKartPerfStatsEnabled {
		return
	}
	mode := voplay.PerfModeStats
	snapshot := g.GetPerfSnapshot()
	if snapshot.Enabled && snapshot.Mode != "" {
		mode = snapshot.Mode
	}
	g.ResetPerfStats(mode)
	w.hud.perfAnalyzer = BlockKartPerfAnalyzer{}
	w.hud.perfSnapshotPollFrame = 0
	w.hud.perfSnapshotFastPolls = blockKartPerfPostResetFastPolls
}

func blockKartRenderStressPerfReportBlocked(w *DiagnosticsPorts) bool {
	if w == nil {
		return false
	}
	return w.core.trackRuntime.renderStressPrimitive10kBatch != nil
}

func (t *TrackRuntime) beginRenderStressPrimitive10k(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState) {
	primitive := core.trackRuntime.ensurePrimitiveScene(core)
	t.renderStressPrimitive10kBatch = primitive.BeginStressBatch()
	t.renderStressPrimitive10kBatch.Reserve(blockKartRenderStressPrimitive10kCount)
	t.renderStressPrimitive10kIndex = 0
	t.renderStressPrimitive10kCenter = race.startPosition
	t.renderStressPrimitive10kRotations = make([]voplay.Quat, 0, 31)
	for i := 0; i < 31; i++ {
		t.renderStressPrimitive10kRotations = append(t.renderStressPrimitive10kRotations, voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, float64(i)*0.07))
	}
	t.renderStressPrimitive10kScales = make([]voplay.Vec3, 0, 60)
	for i := 0; i < 60; i++ {
		t.renderStressPrimitive10kScales = append(t.renderStressPrimitive10kScales, voplay.Vec3{X: 0.58 + float64(i%4)*0.08, Y: 0.42 + float64((i/3)%5)*0.04, Z: 0.58 + float64((i/5)%4)*0.08})
	}
}

func (t *TrackRuntime) advanceRenderStress(core *BlockKartRuntimeCore, stress *RenderStressState) bool {
	if core == nil || stress == nil || t.renderStressPrimitive10kBatch == nil {
		return false
	}
	primitive := core.trackRuntime.ensurePrimitiveScene(core)
	end := t.renderStressPrimitive10kIndex + blockKartRenderStressPrimitive10kChunk
	if end > blockKartRenderStressPrimitive10kCount {
		end = blockKartRenderStressPrimitive10kCount
	}
	for t.renderStressPrimitive10kIndex < end {
		i := t.renderStressPrimitive10kIndex
		t.renderStressPrimitive10kBatch.Add(t.renderStressPrimitive10kPlacement(primitive, i))
		t.renderStressPrimitive10kIndex++
	}
	if t.renderStressPrimitive10kIndex < blockKartRenderStressPrimitive10kCount {
		return false
	}
	t.renderStressPrimitive10kBatch.End()
	t.renderStressPrimitive10kBatch = nil
	t.renderStressPrimitive10kRotations = nil
	t.renderStressPrimitive10kScales = nil
	stress.applied = true
	return true
}

func (t *TrackRuntime) renderStressPrimitive10kPlacement(primitive *PrimitiveVisualContent, i int) PrimitivePlacement {
	spacing := 2.35
	col := i % blockKartRenderStressPrimitive10kColumns
	row := i / blockKartRenderStressPrimitive10kColumns
	x := t.renderStressPrimitive10kCenter.X + (float64(col) - 49.5) * spacing
	z := t.renderStressPrimitive10kCenter.Z - blockKartRenderStressPrimitive10kCullOffset - float64(row) * spacing
	y := t.renderStressPrimitive10kCenter.Y - 0.85 + float64((i%13)-6)*0.018
	shape := primitive.RoundedBox
	if i % 11 == 0 {
		shape = primitive.Sphere
	} else if i % 17 == 0 {
		shape = primitive.Cylinder
	}
	material := primitive.MeadowMat
	if i % 5 == 0 {
		material = primitive.StoneMat
	} else if i % 7 == 0 {
		material = primitive.PebbleMat
	}
	return PrimitivePlacement{Shape: shape, Material: material, Position: voplay.Vec3{X: x, Y: y, Z: z}, Rotation: t.renderStressPrimitive10kRotations[i%31], Scale: t.renderStressPrimitive10kScales[i%60], Flags: PrimitiveNoShadow, LodFar: 150}
}

func (t *TrackRuntime) addRenderStressWater(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState) {
	primitive := core.trackRuntime.ensurePrimitiveScene(core)
	if core.track != nil {
		core.trackRuntime.addPrimitiveLakeAndBridge(core, core.track)
	}
	center := race.startPosition.Add(voplay.Vec3{Y: -0.95, Z: -28})
	batch := primitive.BeginStaticBatch()
	for i := 0; i < 12; i++ {
		x := center.X + (float64(i%4)-1.5)*8.5
		z := center.Z - float64(i/4)*9.0
		batch.Add(PrimitivePlacement{Shape: primitive.RoundedBox, Material: primitive.WaterMat, Position: voplay.Vec3{X: x, Y: center.Y, Z: z}, Rotation: voplay.QuatIdentity(), Scale: voplay.Vec3{X: 7.8, Y: 0.08, Z: 7.8}, Flags: PrimitiveNoShadow})
	}
	batch.End()
}

func (t *TrackRuntime) addRenderStressResourceChurn(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState) {
	primitive := core.trackRuntime.ensurePrimitiveScene(core)
	batch := primitive.BeginStressBatch()
	count := blockKartRenderStressResourceChurnCount
	columns := 16
	center := race.startPosition.Add(voplay.Vec3{X: -18, Z: -34})
	for i := 0; i < count; i++ {
		col := i % columns
		row := i / columns
		position := voplay.Vec3{X: center.X + float64(col)*3.0, Y: center.Y - 0.46, Z: center.Z - float64(row)*3.2}
		material := primitive.MeadowMat
		if i % 2 == 0 {
			material = primitive.StoneMat
		}
		batch.Add(PrimitivePlacement{Shape: primitive.RoundedBox, Material: material, Position: position, Rotation: voplay.QuatIdentity(), Scale: voplay.Vec3{X: 0.32, Y: 0.24, Z: 0.32}, Flags: PrimitiveNoShadow, LodFar: 150})
	}
	batch.End()
}

func (t *TrackRuntime) addRenderStressChunkedWorldDrive(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState) {
	primitive := core.trackRuntime.ensurePrimitiveScene(core)
	batch := primitive.BeginScatterBatch()
	count := 4096
	columns := 64
	spacing := 6.75
	center := race.startPosition.Add(voplay.Vec3{Z: -72})
	for i := 0; i < count; i++ {
		col := i % columns
		row := i / columns
		x := center.X + (float64(col) - 31.5) * spacing
		z := center.Z - float64(row) * spacing
		y := center.Y - 0.78 + math.Sin(float64(col)*0.41+float64(row)*0.27)*0.18
		shape := primitive.RoundedBox
		if i % 13 == 0 {
			shape = primitive.Cylinder
		} else if i % 19 == 0 {
			shape = primitive.Sphere
		}
		material := primitive.MeadowMat
		if row % 5 == 0 {
			material = primitive.StoneMat
		} else if col % 7 == 0 {
			material = primitive.PebbleMat
		}
		scale := voplay.Vec3{X: 0.72 + float64(i%3)*0.12, Y: 0.38 + float64(row%4)*0.06, Z: 0.72 + float64(col%4)*0.10}
		batch.Add(PrimitivePlacement{Shape: shape, Material: material, Position: voplay.Vec3{X: x, Y: y, Z: z}, Rotation: voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, float64(i%47)*0.11), Scale: scale, Flags: PrimitiveNoShadow, LodFar: 780})
	}
	batch.End()
}

func (t *TrackRuntime) addRenderStressShadowPostMatrix(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState) {
	primitive := core.trackRuntime.ensurePrimitiveScene(core)
	center := race.startPosition.Add(voplay.Vec3{X: -18, Z: -34})
	batch := primitive.BeginStressBatch()
	for row := 0; row < 8; row++ {
		for col := 0; col < 12; col++ {
			x := center.X + float64(col) * 4.2
			z := center.Z - float64(row) * 4.6
			height := 1.35 + float64((row+col)%5)*0.34
			material := primitive.WoodMat
			if (row + col) % 3 == 0 {
				material = primitive.StoneMat
			}
			batch.Add(PrimitivePlacement{Shape: primitive.Cylinder, Material: material, Position: voplay.Vec3{X: x, Y: center.Y + height*0.5 - 0.72, Z: z}, Rotation: voplay.QuatIdentity(), Scale: voplay.Vec3{X: 0.42, Y: height, Z: 0.42}})
			if (row + col) % 4 == 0 {
				batch.Add(PrimitivePlacement{Shape: primitive.RoundedBox, Material: primitive.PebbleMat, Position: voplay.Vec3{X: x + 1.1, Y: center.Y - 0.46, Z: z + 1.0}, Rotation: voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, float64(row+col)*0.19), Scale: voplay.Vec3{X: 1.25, Y: 0.48, Z: 0.72}})
			}
		}
	}
	batch.End()
}
