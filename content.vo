		{Id: 121, BaseColor: [4]uint16{39000, 21000, 8000, 65535}, Roughness: 60000, Alpha: render3d.AlphaOpaque, Revision: 1},
		{Id: 122, BaseColor: [4]uint16{35000, 36000, 33000, 65535}, Roughness: 59000, Alpha: render3d.AlphaOpaque, Revision: 1},
		{Id: 123, BaseColor: [4]uint16{65535, 49000, 2000, 65535}, Roughness: 41000, Emissive: [3]uint16{5000, 2800, 0}, Alpha: render3d.AlphaOpaque, Revision: 1},
		{Id: 124, BaseColor: [4]uint16{2200, 8500, 14500, 65535}, Roughness: 12000, Emissive: [3]uint16{0, 1200, 2600}, Alpha: render3d.AlphaOpaque, Revision: 1},
		{Id: 125, BaseColor: [4]uint16{65535, 4500, 1800, 65535}, Metallic: 8000, Roughness: 18000, Emissive: [3]uint16{32000, 1200, 300}, Alpha: render3d.AlphaOpaque, Revision: 1},
		{Id: 126, BaseColor: [4]uint16{9000, 15500, 31000, 65535}, Roughness: 42000, Alpha: render3d.AlphaOpaque, Revision: 1},
		{Id: 127, BaseColor: [4]uint16{57000, 5500, 3500, 65535}, Metallic: 5000, Roughness: 26000, Alpha: render3d.AlphaOpaque, Revision: 1},
		{Id: 128, BaseColor: [4]uint16{5000, 43000, 15000, 65535}, Metallic: 5000, Roughness: 28000, Alpha: render3d.AlphaOpaque, Revision: 1},
		{Id: 129, BaseColor: [4]uint16{36000, 7000, 54000, 65535}, Metallic: 5000, Roughness: 25000, Alpha: render3d.AlphaOpaque, Revision: 1},
		{Id: 130, BaseColor: [4]uint16{24000, 28500, 30500, 65535}, Roughness: 61000, Alpha: render3d.AlphaOpaque, Revision: 1},
		{Id: 131, BaseColor: [4]uint16{7000, 18000, 26000, 65535}, Metallic: 18000, Roughness: 14000, Emissive: [3]uint16{1200, 6200, 9800}, Alpha: render3d.AlphaOpaque, Revision: 1},
		{Id: 132, BaseColor: [4]uint16{62000, 64000, 65535, 65535}, Roughness: 47000, Emissive: [3]uint16{1600, 1900, 2200}, Alpha: render3d.AlphaOpaque, Revision: 1},
		{Id: 133, BaseColor: [4]uint16{65535, 47000, 2400, 65535}, Roughness: 38000, Emissive: [3]uint16{8500, 3900, 300}, Alpha: render3d.AlphaOpaque, Revision: 1},
