package main

import (
	"errors"
	"math"
	"os"
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/vo/audio"
	"github.com/vo-lang/voplay/vo/physics3d"
	"github.com/vo-lang/voplay/vo/render"
	"github.com/vo-lang/voplay/vo/render3d"
)

const blockKartUseGoldenScene = true

func blockKartStartTransform() Transform {
	return Transform{X: 0, Y: 1200, Z: 0, Yaw_milliradians: 3079}
}

func blockKartTrackPoints() [][3]int64 {
	return [][3]int64{
		{0, 0, 30000}, {0, 100, 0}, {2000, 1000, -32000}, {-6000, 2800, -64000},
		{-31000, 5800, -94000}, {-50000, 9500, -126000}, {-45000, 14500, -160000},
		{-22000, 19000, -194000}, {11000, 23000, -226000}, {42000, 27000, -258000},
		{62000, 30000, -292000}, {150000, 32000, -318000}, {250000, 26000, -275000},
		{285000, 18000, -180000}, {260000, 9000, -70000}, {190000, 3000, 35000},
		{90000, 800, 80000},
	}
}

func blockKartTrackHalfWidths() []int64 {
	return []int64{
		8200, 8200, 8200, 8200, 8200, 8200, 8200, 8200, 8200,
		8200, 8200, 8200, 8200, 8200, 8200, 8200, 8200,
	}
}

type BlockKartRoadPoint struct {
	X int64
	Y int64
	Z int64
	Half_width_milli int64
}

type BlockKartRoadSample struct {
	X int64
	Y int64
	Z int64
	Half_width_milli int64
	Distance_milli int64
	Signed_offset_milli int64
	Tangent_x_milli int32
	Tangent_z_milli int32
}

func blockKartCatmullRom(a int64, b int64, c int64, d int64, t float64) int64 {
	t2 := t * t
	t3 := t2 * t
	return int64(0.5 * (2.0 * float64(b) +
		float64(-a + c) * t +
		float64(2 * a - 5 * b + 4 * c - d) * t2 +
		float64(-a + 3 * b - 3 * c + d) * t3))
}

func blockKartTrackCenterline() []BlockKartRoadPoint {
	anchors := blockKartTrackPoints()
	widths := blockKartTrackHalfWidths()
	if len(anchors) < 4 || len(widths) != len(anchors) {
		return nil
	}
	const samplesPerSegment = 18
	result := make([]BlockKartRoadPoint, 0, len(anchors) * samplesPerSegment)
	for index, b := range anchors {
		a := anchors[(index - 1 + len(anchors)) % len(anchors)]
		c := anchors[(index + 1) % len(anchors)]
		d := anchors[(index + 2) % len(anchors)]
		wa := widths[(index - 1 + len(widths)) % len(widths)]
		wb := widths[index]
		wc := widths[(index + 1) % len(widths)]
		wd := widths[(index + 2) % len(widths)]
		for sample := 0; sample < samplesPerSegment; sample++ {
			t := float64(sample) / float64(samplesPerSegment)
			result = append(result, BlockKartRoadPoint{
				X: blockKartCatmullRom(a[0], b[0], c[0], d[0], t),
				Y: blockKartCatmullRom(a[1], b[1], c[1], d[1], t),
				Z: blockKartCatmullRom(a[2], b[2], c[2], d[2], t),
				Half_width_milli: blockKartCatmullRom(wa, wb, wc, wd, t),
			})
		}
	}
	return result
}

func (game *BlockKart) nearestRoadSample(transform Transform) BlockKartRoadSample {
	if game == nil || len(game.TrackCenterline) == 0 {
		return BlockKartRoadSample{
			X: transform.X, Y: transform.Y, Z: transform.Z,
			Half_width_milli: 9000, Distance_milli: 1000000,
			Tangent_z_milli: 1000,
		}
	}
	bestSquared := float64(1.0e30)
	best := BlockKartRoadSample{}
	x := float64(transform.X)
	z := float64(transform.Z)
	for index, from := range game.TrackCenterline {
		to := game.TrackCenterline[(index + 1) % len(game.TrackCenterline)]
		dx := float64(to.X - from.X)
		dz := float64(to.Z - from.Z)
		lengthSquared := dx * dx + dz * dz
		if lengthSquared < 1 {
			continue
		}
		along := ((x - float64(from.X)) * dx + (z - float64(from.Z)) * dz) /
			lengthSquared
		if along < 0 {
			along = 0
		}
		if along > 1 {
			along = 1
		}
		nearestX := float64(from.X) + dx * along
		nearestZ := float64(from.Z) + dz * along
		offsetX := x - nearestX
		offsetZ := z - nearestZ
		distanceSquared := offsetX * offsetX + offsetZ * offsetZ
		if distanceSquared >= bestSquared {
			continue
		}
		bestSquared = distanceSquared
		best = BlockKartRoadSample{
			X: int64(nearestX),
			Y: from.Y + int64(float64(to.Y - from.Y) * along),
			Z: int64(nearestZ),
			Half_width_milli: from.Half_width_milli +
				int64(float64(to.Half_width_milli - from.Half_width_milli) * along),
			Signed_offset_milli: int64(
				offsetX * dz / math.Sqrt(lengthSquared) -
					offsetZ * dx / math.Sqrt(lengthSquared),
			),
			Tangent_x_milli: int32(dx / math.Sqrt(lengthSquared) * 1000.0),
			Tangent_z_milli: int32(dz / math.Sqrt(lengthSquared) * 1000.0),
		}
	}
	best.Distance_milli = int64(math.Sqrt(bestSquared))
	return best
}

type BlockKartPhysicsEntity struct {
	Entity uint64
	Body physics3d.BodyRef
	Collider physics3d.ColliderRef
}

func (game *BlockKart) startTrack(context voplay.StartContext) error {
	points := blockKartTrackPoints()
	for index, position := range points {
		entityId := uint64(2 + index)
		if !game.Transforms.Upsert(entityId, Transform{X: position[0], Y: position[1], Z: position[2]}) ||
			!game.TrackMarkers.Upsert(entityId, TrackMarker{
				Kind: 1, Order: uint32(index + 1), Radius_milli: 12000,
			}) {
			return errors.New("blockkart: initialize checkpoint")
		}
		body, ok := game.Physics.CreateBody(physics3d.BodyDesc{
			Kind: physics3d.BodyStatic, Position: position,
		})
		if !ok {
			return errors.New("blockkart: create checkpoint body")
		}
		collider, ok := game.Physics.CreateCollider(physics3d.ColliderDesc{
			Body: body, HalfExtent: [3]uint32{16000, 4000, 16000},
			Layer: blockKartLayerTrigger, Mask: blockKartLayerKart, Sensor: true,
		})
		if !ok {
			return errors.New("blockkart: create checkpoint collider")
		}
		game.TrackGates = append(game.TrackGates, BlockKartGate{
			Entity: entityId, Order: uint32(index + 1), Body: body, Collider: collider,
			Position: position,
		})
	}
	return nil
}

func (game *BlockKart) startGameplay(context voplay.StartContext) error {
	points := blockKartTrackPoints()
	for index := 1; index < len(points); index += 2 {
		position := points[index]
		entityId := uint64(20 + index / 2)
		position[1] += 1800
		if !game.Transforms.Upsert(entityId, Transform{X: position[0], Y: position[1], Z: position[2]}) ||
			!game.Collectibles.Upsert(entityId, Collectible{Value: 100}) {
			return errors.New("blockkart: initialize collectible")
		}
		body, ok := game.Physics.CreateBody(physics3d.BodyDesc{
			Kind: physics3d.BodyStatic, Position: position,
		})
		if !ok {
			return errors.New("blockkart: collectible body")
		}
		collider, ok := game.Physics.CreateCollider(physics3d.ColliderDesc{
			Body: body, HalfExtent: [3]uint32{2500, 1800, 2500},
			Layer: blockKartLayerTrigger, Mask: blockKartLayerKart, Sensor: true,
		})
		if !ok {
			return errors.New("blockkart: collectible collider")
		}
		game.Pickups = append(game.Pickups, BlockKartPhysicsEntity{
			Entity: entityId, Body: body, Collider: collider,
		})
	}
	for index := 2; index < len(points); index += 4 {
		position := points[index]
		nextPosition := points[(index + 1) % len(points)]
		entityId := uint64(30 + index / 4)
		if !game.Transforms.Upsert(entityId, Transform{
			X: position[0], Y: position[1], Z: position[2],
			Yaw_milliradians: int32(math.Atan2(
				float64(nextPosition[0] - position[0]), float64(nextPosition[2] - position[2]),
			) * 1000.0),
		}) ||
			!game.BoostPads.Upsert(entityId, BoostPad{Strength: 12000}) {
			return errors.New("blockkart: initialize boost pad")
		}
		body, ok := game.Physics.CreateBody(physics3d.BodyDesc{
			Kind: physics3d.BodyStatic, Position: position,
		})
		if !ok {
			return errors.New("blockkart: boost pad body")
		}
		collider, ok := game.Physics.CreateCollider(physics3d.ColliderDesc{
			Body: body, HalfExtent: [3]uint32{6000, 900, 6000},
			Layer: blockKartLayerTrigger, Mask: blockKartLayerKart, Sensor: true,
		})
		if !ok {
			return errors.New("blockkart: boost pad collider")
		}
		game.PadEntities = append(game.PadEntities, BlockKartPhysicsEntity{
			Entity: entityId, Body: body, Collider: collider,
		})
	}
	for index := 3; index < len(points); index += 5 {
		position := points[index]
		nextPosition := points[(index + 1) % len(points)]
		deltaX := float64(nextPosition[0] - position[0])
		deltaZ := float64(nextPosition[2] - position[2])
		segmentLength := math.Sqrt(deltaX * deltaX + deltaZ * deltaZ)
		if segmentLength < 1 {
			return errors.New("blockkart: moving obstacle road tangent")
		}
		side := 1.0
		if index % 2 == 0 {
			side = -1.0
		}
		rightX := deltaZ / segmentLength
		rightZ := -deltaX / segmentLength
		roadsideOffset := 10500.0 * side
		entityId := uint64(40 + index / 5)
		obstacle := MovingObstacle{
			Origin_x: position[0] + int64(rightX * roadsideOffset),
			Origin_y: position[1] + 1100,
			Origin_z: position[2] + int64(rightZ * roadsideOffset),
			Axis_x: int32(rightX * 1000), Axis_z: int32(rightZ * 1000),
			Amplitude_milli: 1800,
			Period_ticks: 18 * blockKartTicksPerSecond, Phase_ticks: uint32(index * 57),
		}
		if !game.Transforms.Upsert(entityId, Transform{
			X: obstacle.Origin_x, Y: obstacle.Origin_y, Z: obstacle.Origin_z,
		}) ||
			!game.MovingObstacles.Upsert(entityId, obstacle) {
			return errors.New("blockkart: initialize moving obstacle")
		}
		body, ok := game.Physics.CreateBody(physics3d.BodyDesc{
			Kind: physics3d.BodyKinematic,
			Position: [3]int64{obstacle.Origin_x, obstacle.Origin_y, obstacle.Origin_z},
		})
		if !ok {
			return errors.New("blockkart: moving obstacle body")
		}
		collider, ok := game.Physics.CreateCollider(physics3d.ColliderDesc{
			Body: body, HalfExtent: [3]uint32{1050, 1100, 1050},
			Layer: blockKartLayerWorld, Mask: blockKartLayerKart,
		})
		if !ok {
			return errors.New("blockkart: moving obstacle collider")
		}
		game.ObstacleEntities = append(game.ObstacleEntities, BlockKartPhysicsEntity{
			Entity: entityId, Body: body, Collider: collider,
		})
	}
	return nil
}

func (game *BlockKart) updateDynamics(tick voplay.TickBatch) error {
	for _, entity := range game.ObstacleEntities {
		obstacle, ok := game.MovingObstacles.Get(entity.Entity)
		if !ok || obstacle.Period_ticks < 4 {
			return errors.New("blockkart: moving obstacle state")
		}
		phase := uint32(tick.FirstTick + uint64(obstacle.Phase_ticks)) % obstacle.Period_ticks
		half := obstacle.Period_ticks / 2
		var signed int64
		if phase <= half {
			signed = int64(phase) * 2 * int64(obstacle.Amplitude_milli) / int64(half) -
				int64(obstacle.Amplitude_milli)
		} else {
			signed = int64(obstacle.Amplitude_milli) -
				int64(phase - half) * 2 * int64(obstacle.Amplitude_milli) / int64(half)
		}
		position := [3]int64{
			obstacle.Origin_x + signed * int64(obstacle.Axis_x) / 1000, obstacle.Origin_y,
			obstacle.Origin_z + signed * int64(obstacle.Axis_z) / 1000,
		}
		if !game.Physics.Submit(physics3d.Command{
			Kind: physics3d.CommandKinematicTarget, Body: entity.Body, Value: position,
		}) ||
			!game.Transforms.Upsert(entity.Entity, Transform{
			X: position[0], Y: position[1], Z: position[2],
		}) {
			return errors.New("blockkart: move obstacle")
		}
	}
	for _, padEntity := range game.PadEntities {
		pad, ok := game.BoostPads.Get(padEntity.Entity)
		if !ok {
			return errors.New("blockkart: boost pad state")
		}
		if pad.Cooldown_ticks != 0 {
			pad.Cooldown_ticks--
			if !game.BoostPads.Upsert(padEntity.Entity, pad) {
				return errors.New("blockkart: update boost cooldown")
			}
		}
	}
	return nil
}

func (game *BlockKart) applyGameplayContacts(
	state *KartState,
	transform *Transform,
) error {
	if state == nil || transform == nil {
		return errors.New("blockkart: missing gameplay state")
	}
	if game.ObstacleHitCooldown_ticks != 0 {
		game.ObstacleHitCooldown_ticks--
	}
	for _, contact := range game.Contacts {
		var other physics3d.BodyRef
		if contact.A == game.KartBody {
			other = contact.B
		} else if contact.B == game.KartBody {
			other = contact.A
		} else {
			continue
		}
		for _, pickup := range game.Pickups {
			if pickup.Body != other {
				continue
			}
			value, ok := game.Collectibles.Get(pickup.Entity)
			if !ok {
				return errors.New("blockkart: collectible contact")
			}
			if !value.Collected {
				value.Collected = true
				state.Score += value.Value
				if !game.Collectibles.Upsert(pickup.Entity, value) {
					return errors.New("blockkart: collect pickup")
				}
			}
		}
		for _, padEntity := range game.PadEntities {
			if padEntity.Body != other {
				continue
			}
			pad, ok := game.BoostPads.Get(padEntity.Entity)
			if !ok {
				return errors.New("blockkart: boost pad contact")
			}
			if pad.Cooldown_ticks == 0 {
				state.Boost_ticks = blockKartBoostTicks
				pad.Cooldown_ticks = blockKartBoostCooldownTicks
				if !game.BoostPads.Upsert(padEntity.Entity, pad) {
					return errors.New("blockkart: activate boost pad")
				}
			}
		}
		for _, obstacle := range game.ObstacleEntities {
			if obstacle.Body == other && game.ObstacleHitCooldown_ticks == 0 {
				obstacleTransform, found := game.Transforms.Get(obstacle.Entity)
				if !found {
					return errors.New("blockkart: obstacle impact transform")
				}
				deltaX := obstacleTransform.X - transform.X
				deltaZ := obstacleTransform.Z - transform.Z
				normalX := 0.0
				normalZ := 0.0
				pushDistance := int64(180)
				if blockKartAbsInt64(deltaX) >= blockKartAbsInt64(deltaZ) {
					normalX = 1
					if deltaX < 0 {
						normalX = -1
					}
					pushDistance += 1900 - blockKartAbsInt64(deltaX)
				} else {
					normalZ = 1
					if deltaZ < 0 {
						normalZ = -1
					}
					pushDistance += 2300 - blockKartAbsInt64(deltaZ)
				}
				if pushDistance < 180 {
					pushDistance = 180
				}
				if pushDistance > 2600 {
					pushDistance = 2600
				}
				transform.X -= int64(normalX) * pushDistance
				transform.Z -= int64(normalZ) * pushDistance
				road := game.nearestRoadSample(*transform)
				transform.Y = road.Y
				impactSide := game.Vehicle.ApplyImpact(normalX, normalZ)
				state.Speed_per_second = int64(game.Vehicle.Forward_speed)
				if !game.Physics.Submit(physics3d.Command{
					Kind: physics3d.CommandTeleport, Body: game.KartBody,
					Value: [3]int64{transform.X, transform.Y, transform.Z},
				}) ||
					!game.Transforms.Upsert(game.KartEntity, *transform) {
					return errors.New("blockkart: resolve obstacle impact")
				}
				game.HitAudioPending = true
				state.Boost_ticks = 0
				game.MiniTurbo_ticks = 0
				game.CollisionShake_ticks = 8
				game.CollisionShake_side_milli = int32(impactSide * 1000.0)
				game.ObstacleHitCooldown_ticks = blockKartTicksPerSecond / 2
			}
		}
	}
	return nil
}

func blockKartHorizontalDistanceSquared(left Transform, right Transform) int64 {
	x := left.X - right.X
	z := left.Z - right.Z
	return x * x + z * z
}

func blockKartAbsInt64(value int64) int64 {
	if value < 0 {
		return -value
	}
	return value
}

func (game *BlockKart) startAssets(context voplay.StartContext) error {
	paths := []string{
		"assets/audio/kart_engine.wav",
		"assets/audio/kart_boost.wav",
		"assets/audio/kart_hit.wav",
		"assets/audio/kart_skid.wav",
		"assets/audio/kart_grass.wav",
	}
	game.EngineAudioAsset = 15001
	game.BoostAudioAsset = 15002
	game.HitAudioAsset = 15003
	game.SkidAudioAsset = 15004
	game.GrassAudioAsset = 15005
	game.KartMeshAsset = 10001
	game.Audio, _ = audio.NewControlState(8, 32, 64)
	if game.Audio == nil {
		return errors.New("blockkart: create audio owner")
	}
	start := blockKartStartTransform()
	audioCommit, ok := game.Audio.Commit(audio.ControlTransaction{
		ExpectedRevision: 1,
		Operations: []audio.ControlOperation{
			{
				Kind: audio.ControlCreateSource,
				SourceValue: audio.SourceDescriptor{
					AssetIndex: uint32(game.EngineAudioAsset), AssetGeneration: 1, Bus: game.Audio.Master(),
					GainMilli: 450, Looping: true, Playing: false, Recovery: audio.ResumeTimeline,
					Spatial: &audio.SpatialSource{
						PositionMilli: [3]int32{
							int32(start.X), int32(start.Y), int32(start.Z),
						}, MinDistanceMilli: 1000, MaxDistanceMilli: 80000,
					},
				},
			},
		},
	})
	if !ok || len(audioCommit.CreatedSources) != 1 {
		return errors.New("blockkart: create engine audio source")
	}
	game.EngineAudioSource = audioCommit.CreatedSources[0]
	audioHandles := []uint64{
		game.EngineAudioAsset, game.BoostAudioAsset, game.HitAudioAsset,
		game.SkidAudioAsset, game.GrassAudioAsset,
	}
	for index, path := range paths {
		bytes, readErr := os.ReadFile(path)
		if readErr != nil || len(bytes) == 0 {
			return errors.New("blockkart: read governed audio asset")
		}
		packet, encoded := audio.EncodeAssetPacket(game.Engine, 1, voplay.Handle{
			Index: uint32(audioHandles[index]), Generation: 1,
		}, 1, game.Audio.Revision, 1, bytes)
		if !encoded {
			return errors.New("blockkart: encode audio asset")
		}
		game.AudioAssetPackets = append(game.AudioAssetPackets, packet)
	}
	game.StaticRenderPackets = game.buildStaticRenderPackets()
	if len(game.StaticRenderPackets) == 0 {
		return errors.New("blockkart: build static render content")
	}
	return nil
}

func (game *BlockKart) buildStaticRenderPackets() [][]byte {
	packets := [][]byte{}
	environment := render3d.EncodeEnvironment(render3d.Environment{
		FogColor: [3]uint16{24500, 35000, 48500}, FogStartMilli: 340000, FogEndMilli: 1210000,
		ExposureMilli: 0, ToneMap: render3d.ToneMapAces, BloomThreshold: 56000, BloomStrength: 3200,
		AntiAlias: render3d.AntiAliasMsaa, MsaaSamples: 4,
	})
	sun := render3d.EncodeLight(render3d.RetainedLight{
		Kind: render3d.LightDirectional, Color: [3]uint16{65535, 57000, 45500}, IntensityMilli: 1850,
		CastsShadow: true,
	})
	skyFill := render3d.EncodeLight(render3d.RetainedLight{
		Kind: render3d.LightDirectional, Color: [3]uint16{26000, 39000, 65535}, IntensityMilli: 120,
		CastsShadow: false,
	})
	if len(environment) == 0 || len(sun) == 0 || len(skyFill) == 0 {
		return nil
	}
	sunTransform := blockKartLookAtMatrix(-320000, 520000, 420000, 0, 30000, -100000)
	fillTransform := blockKartLookAtMatrix(420000, 280000, -360000, 0, 70000, -100000)
	packets = append(
		packets,
		blockKartStaticRenderObject(10, environment),
		blockKartStaticRenderObjectTransform(11, sun, sunTransform),
		blockKartStaticRenderObjectTransform(11, skyFill, fillTransform),
	)
	textures := []struct {
		Id uint64
		Path string
	}{
		{12001, "assets/maps/primitive_track/grass_texture.png"},
		{12002, "assets/maps/primitive_track/dirt_texture.png"},
		{12003, "assets/maps/primitive_track/meadow_texture.png"},
		{12004, "assets/maps/primitive_track/rock_texture.png"},
		{12005, "assets/maps/primitive_track/terrain_splat_large.png"},
		{12007, "assets/maps/primitive_track/dirt_normal.png"},
		{12008, "assets/maps/primitive_track/dirt_mr.png"},
		{12009, "assets/maps/primitive_track/rock_normal.png"},
		{12010, "assets/maps/primitive_track/rock_mr.png"},
		{12100, "assets/maps/golden_alpine/asphalt_albedo_v1.png"},
	}
	if !blockKartUseGoldenScene {
		textures = append(
			textures,
			struct {
				Id uint64
				Path string
			}{12006, "assets/effects/grass_card_atlas.png"},
		)
	}
	for _, texture := range textures {
		bytes, readErr := os.ReadFile(texture.Path)
		if readErr != nil || len(bytes) == 0 {
			return nil
		}
		packet, encoded := render.EncodeAssetPacket(
			game.Engine, 1, render.AssetTexture2d, texture.Id, 1,
			game.RenderControls.Revision, 1, bytes,
		)
		if !encoded {
			return nil
		}
		game.RenderAssetPackets = append(game.RenderAssetPackets, packet)
	}
	materials := []render3d.Material{
		{Id: 100, BaseColor: [4]uint16{65535, 65535, 65535, 65535}, Roughness: 59000, Alpha: render3d.AlphaOpaque, Textures: [5]uint64{12005, 12001, 12003, 12002, 12004}, Revision: 1},
		{Id: 101, BaseColor: [4]uint16{15000, 15500, 16000, 65535}, Roughness: 57000, Alpha: render3d.AlphaOpaque, Textures: [5]uint64{12004, 12009, 12010}, Revision: 1},
