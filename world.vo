	"errors"
	"time"
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

const (
	kartBodyWidth = 1.7
	kartBodyHeight = 0.58
	kartBodyLength = 2.55
	kartItemBoostDuration = 1.25
	kartBoostPadDuration = 1.0
	kartMiniTurboCharge = 0.55
	kartSuperTurboCharge = 1.08
	kartMaxDriftCharge = 1.3
	kartMiniTurboDuration = 0.75
	kartSuperTurboDuration = 1.35
	kartSpawnRideHeight = 1.16
	kartRoadEdgeAssistCenterInset = 1.15
	kartRoadEdgeAssistSoftZone = 1.15
	kartRoadEdgeAssistMaxPushSpeed = 9.5
	kartRoadEdgeAssistVelocityBlend = 11.0
	kartRoadEdgeAssistOutwardDamping = 0.92
	kartRoadEdgeAssistImpactSpeed = 3.4
	kartRoadEdgeAssistPositionBlend = 6.5
	kartRoadEdgeAssistMaxCorrection = 0.18
	kartRoadEdgeAssistPostMaxCorrection = 0.36
	kartRoadEdgeAssistSnapOverflow = 1.35
	kartRoadEdgeAssistLift = 0.08
	raceLapCount = 3
	playerResetY = -25.0
)

const worldAssetGroup = "blockkart-world"

const blockKartRestartResourceRootCause = "Phase 2A root cause: restart was rebuilding immutable vpak map data and static primitive scenery on the render-driven frame; the runtime cache keeps asset pack, prepared map, and static primitive templates alive while World restart still rebuilds scene, race, physics, input, and dynamic kart state."

type BlockKartRuntimeCache struct {
	assets *voplay.Assets
	assetGroup string
	assetGroupActive bool
	skybox voplay.CubemapID
	primitiveMap *scene3d.MapPreparedAsset
	primitiveTemplate *BlockKartPrimitiveTemplate
	preparedMapBuilds int
	preparedMapReuses int
	primitiveTemplateBuilds int
	primitiveTemplateReuses int
}

