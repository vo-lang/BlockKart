type World struct {
	*BlockKartRuntimeContext
}

type roadEdgeAssistSample struct {
	Point scene3d.TrackPoint
	Right voplay.Vec3
	Inward voplay.Vec3
	EdgeHalfWidth float64
	AssistStart float64
	LateralAbs float64
	Side float64
}

func (c *BlockKartRuntimeCache) EnsureLoaded(assets *voplay.Assets) (voplay.CubemapID, error) {
	if assets == nil {
		return 0, errors.New("BlockKart assets unavailable")
	}
	if c == nil {
		return 0, errors.New("BlockKart runtime cache unavailable")
	}
	if c.assets != nil && c.assets != assets {
		c.Close()
	}
	c.assets = assets
	packErr := assets.Mount(blockKartAssetPath("blockkart.vpak"), 100)
	if packErr != nil {
		c.assets = nil
		return 0, errors.New("BlockKart asset pack mount failed: " + packErr.Error())
	}
	if c.skybox != 0 {
		return c.skybox, nil
	}
	assets.BeginGroup(worldAssetGroup)
	skybox, err := loadSkybox(assets)
	assets.EndGroup()
	if err != nil {
		if c.assetGroupActive {
			assets.ReleaseGroup(worldAssetGroup)
		} else {
			assets.ReleaseGroup(worldAssetGroup)
		}
		c.assets = nil
		c.assetGroup = ""
		c.assetGroupActive = false
		return 0, errors.New("BlockKart skybox load failed: " + err.Error())
	}
	c.assetGroup = worldAssetGroup
	c.assetGroupActive = true
	c.skybox = skybox
	return c.skybox, nil
}

func (c *BlockKartRuntimeCache) Close() {
	if c == nil {
		return
	}
	if c.assets != nil && c.assetGroupActive && c.assetGroup != "" {
		c.assets.ReleaseGroup(c.assetGroup)
	}
	c.assets = nil
	c.assetGroup = ""
	c.assetGroupActive = false
	c.skybox = 0
	c.primitiveMap = nil
	c.primitiveTemplate = nil
}

func NewWorld(g *voplay.GameCtx, runtimeCache *BlockKartRuntimeCache) (*World, *BlockKartFailureReport) {
	prof := newBlockKartStartupProfiler("BlockKart world")
	if g == nil {
		return nil, blockKartNewFailureReport(BlockKartLifecycleFailed, "alloc", BlockKartOwnerVoplay, BlockKartSubsystemRuntime, "BlockKart world construction received nil GameCtx", "BlockKart could not start. Please try again.")
	}
	w := &World{BlockKartRuntimeContext: &BlockKartRuntimeContext{scene: scene3d.New(), startPosition: voplay.Vec3{X: 0, Y: 1.1, Z: 98}, theme: defaultWorldTheme(), settings: defaultBlockKartSettings(), tuning: defaultBlockKartTuningPreset(), runtimeCache: runtimeCache, raceState: BlockKartRaceStateReady, totalLaps: raceLapCount, lap: 1}}
	w.assetRuntime.Bind(runtimeCache)
	w.raceSession.Reset(raceLapCount)
	prof.Mark("alloc")
	w.checkpointPosition = w.startPosition
	w.checkpointLabel = "Start"
	w.nextGateLabel = "Gate 1"
	w.assetRuntime.configureScene(w.BlockKartRuntimeContext)
	prof.Mark("configureScene")
	if err := w.assetRuntime.loadAssets(w.BlockKartRuntimeContext, g.Assets); err != nil {
		blockKartReportWorldDiagnostics(g, BlockKartLifecycleFailed, "loadAssets", "loadAssetsFailed", w)
		w.Close()
		return nil, blockKartNewFailureReport(BlockKartLifecycleFailed, "loadAssets", BlockKartOwnerBlockKart, BlockKartSubsystemAsset, err.Error(), "BlockKart could not load its game assets. Please try again.")
	}
	prof.Mark("loadAssets")
	w.kartRig.loadModels(w.BlockKartRuntimeContext)
	prof.Mark("loadModels")
	if err := w.trackRuntime.buildLevel(w.BlockKartRuntimeContext); err != nil {
		blockKartReportWorldDiagnostics(g, BlockKartLifecycleFailed, "buildLevel", "buildLevelFailed", w)
		w.Close()
		return nil, blockKartNewFailureReport(BlockKartLifecycleFailed, "buildLevel", BlockKartOwnerBlockKart, BlockKartSubsystemMap, err.Error(), "BlockKart could not prepare its track. Please try again.")
	}
	prof.Mark("buildLevel")
	w.raceSession.setupRacingInput(w.BlockKartRuntimeContext, g)
	prof.Mark("setupRacingInput")
	w.kartRig.spawnPlayer(w.BlockKartRuntimeContext)
	prof.Mark("spawnPlayer")
	w.kartRig.setupVehicleAudio(w.BlockKartRuntimeContext)
	prof.Mark("setupVehicleAudio")
	w.kartRig.setupCamera(w.BlockKartRuntimeContext)
	prof.Mark("setupCamera")
	w.raceSession.restartRun(w.BlockKartRuntimeContext)
	prof.Mark("restartRun")
	return w, nil
}

func (a *AssetRuntimeCache) configureScene(w *BlockKartRuntimeContext) {
	applyWorldTheme(w.theme, w.scene, w.settings)
}

func (r *RaceSession) setupRacingInput(w *BlockKartRuntimeContext, g *voplay.GameCtx) {
	if g == nil || g.Input == nil {
		return
	}
	profile := scene3d.NewRacingInputProfile(g.Input)
	profile.Rebind(scene3d.RacingActionDrift, voplay.KeyBinding("Space"), voplay.KeyBinding(" "), voplay.GamepadButtonBinding(profile.Gamepad, "right_shoulder"))
	profile.Rebind(scene3d.RacingActionBoost, voplay.KeyBinding("Shift"), voplay.GamepadButtonBinding(profile.Gamepad, "south"))
	w.racingInput = profile
}

func (k *KartRig) loadModels(w *BlockKartRuntimeContext) {
	w.cubeModel = scene3d.CubeMesh()
}

func loadTextureAsset(assets *voplay.Assets, rel string) (voplay.TextureID, error) {
	return assets.Texture(blockKartAssetPath(rel))
}

func loadAudioAsset(assets *voplay.Assets, rel string) (voplay.AudioClipID, error) {
	return assets.Audio(blockKartAssetPath(rel))
}

func (a *AssetRuntimeCache) loadAssets(w *BlockKartRuntimeContext, assets *voplay.Assets) error {
	if assets == nil {
		return errors.New("BlockKart assets unavailable")
	}
	w.assets = assets
	if w.runtimeCache != nil {
		skybox, err := w.runtimeCache.EnsureLoaded(assets)
		if err != nil {
			return err
		}
		w.scene.Skybox = skybox
		w.assetGroup = worldAssetGroup
		w.assetGroupOwnedByRuntime = true
		return nil
	}
	packErr := assets.Mount(blockKartAssetPath("blockkart.vpak"), 100)
	if packErr != nil {
		return errors.New("BlockKart asset pack mount failed: " + packErr.Error())
	}
	assets.BeginGroup(worldAssetGroup)
	skybox, err := loadSkybox(assets)
	if err == nil {
		w.scene.Skybox = skybox
	}
	assets.EndGroup()
	if err != nil {
		assets.ReleaseGroup(worldAssetGroup)
		return errors.New("BlockKart skybox load failed: " + err.Error())
	}
	w.assetGroup = worldAssetGroup
	return nil
}

func loadSkybox(assets *voplay.Assets) (voplay.CubemapID, error) {
	return assets.Cubemap(blockKartAssetPath("skybox/right.png"), blockKartAssetPath("skybox/left.png"), blockKartAssetPath("skybox/top.png"), blockKartAssetPath("skybox/bottom.png"), blockKartAssetPath("skybox/front.png"), blockKartAssetPath("skybox/back.png"))
}

func blockKartAssetPath(rel string) string {
	return "assets/" + rel
}

func (k *KartRig) spawnPlayer(w *BlockKartRuntimeContext) {
	w.player = w.scene.Spawn(scene3d.EntityDesc{Position: w.startPosition, Rotation: w.kartRig.kartRotation(w), Scale: voplay.Vec3{X: 1, Y: 1, Z: 1}, Tag: "kart_physics", Physics: &scene3d.Physics{Type: scene3d.Dynamic, Collider: scene3d.Box(0.78, 0.24, 1.16), Layer: voplay.CollisionLayerDefault, Mask: voplay.CollisionMaskAll, Density: 70.0, Friction: 0.25, Restitution: 0.02, LinearDamping: 0.12, AngularDamping: 3.5, LockRotationX: true, LockRotationZ: true}})
	w.player.Visible = false
	controllerConfig := w.tuning.KartControllerConfig()
	w.vehicle = scene3d.NewVehicle(w.player, controllerConfig.Vehicle)
	w.kartController = scene3d.NewKartController(w.vehicle, w.track, controllerConfig)
	w.kartController.Respawn(scene3d.TrackPose{Position: w.startPosition, Yaw: w.startYaw})
	w.kartRig.Bind(w.player, w.vehicle, w.kartController, scene3d.NewVehiclePhysicsSession(scene3d.VehiclePhysicsSessionDesc{Scene: w.scene, Vehicle: w.vehicle, FixedDt: 1.0 / 60.0}))
	w.kartRig.primeIdleStartPhysicsSleep(w)
	w.raceSession.resetKartRenderPose(w, w.startPosition, w.kartRig.kartRotation(w))
	w.kartRig.spawnKartVisuals(w)
	w.kartRig.syncKartVisuals(w)
}

func (k *KartRig) primeIdleStartPhysicsSleep(w *BlockKartRuntimeContext) {
	if w.vehicle == nil {
		return
	}
	scene3d.ProductPrimeVehicleIdleSleep(w.vehicle)
	w.physicsIdleFrames = scene3d.DefaultVehicleIdleSleepConfig().WarmupFrames
}

func (k *KartRig) spawnKartVisuals(w *BlockKartRuntimeContext) {
	w.trackRuntime.spawnPrimitiveKartVisuals(w)
}

func (k *KartRig) setupCamera(w *BlockKartRuntimeContext) {
	w.camera = scene3d.NewRacingCamera()
	w.camera.BaseDistance = 22.4
	w.camera.MaxDistance = 33.0
	w.camera.Height = 9.8
	w.camera.TargetHeight = 1.95
	w.camera.LookaheadBase = 16.2
	w.camera.LookaheadSpeedScale = 0.14
	w.camera.DistanceSpeedScale = 0.055
	w.camera.DriftOffset = 1.45
	w.camera.Smoothing = 5.8
	w.camera.TargetSmoothing = 7.2
	w.camera.Fov = 61
	w.camera.SpeedFov = 0.026
	w.camera.BoostFovKick = 3.2
	w.camera.CollisionEnabled = false
	w.camera.CollisionOffset = 0.72
	w.raceSession.updateRacingCamera(w, 0, false)
}

func (k *KartRig) setupVehicleAudio(w *BlockKartRuntimeContext) {
	if w.assets == nil || w.player == nil {
		return
	}
	w.assets.BeginGroup(worldAssetGroup)
	engine, engineErr := loadAudioAsset(w.assets, "audio/kart_engine.wav")
	skid, skidErr := loadAudioAsset(w.assets, "audio/kart_skid.wav")
	boost, boostErr := loadAudioAsset(w.assets, "audio/kart_boost.wav")
	surface, surfaceErr := loadAudioAsset(w.assets, "audio/kart_grass.wav")
	collision, collisionErr := loadAudioAsset(w.assets, "audio/kart_hit.wav")
	w.assets.EndGroup()
	if engineErr != nil || skidErr != nil || boostErr != nil || surfaceErr != nil || collisionErr != nil {
		return
	}
	config := scene3d.DefaultVehicleAudioConfig()
	config.EngineMaxSpeed = 38
	config.EngineMinVolume = 0.16
	config.EngineMaxVolume = 0.64
	config.SkidMaxVolume = 0.52
	config.BoostVolume = 0.42
	config.SurfaceVolume = 0.28
	audio, err := scene3d.AttachVehicleAudio(w.player, scene3d.VehicleAudioClips{Engine: engine, Skid: skid, Boost: boost, Surface: surface, Collision: collision}, config)
	if err == nil {
		w.vehicleAudio = audio
	}
}

func (w *World) FixedUpdate(g *voplay.GameCtx, dt float64, debugOverlayVisible bool) {
	profileFixedStep := debugOverlayVisible || blockKartFixedPhaseConsoleReports || blockKartPerfReports
	fixedStart := time.Time{}
	phaseStart := time.Time{}
	phaseStats := BlockKartFixedPhaseStats{}
	if profileFixedStep {
		fixedStart = time.Now()
		phaseStart = fixedStart
	}
	w.hudPresenter.updateTouchControls(w.BlockKartRuntimeContext, g)
	if profileFixedStep {
		now := time.Now()
		phaseStats.TouchMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	if w.touchResetPressed {
		w.raceSession.restartRun(w.BlockKartRuntimeContext)
		blockKartReportWorldDiagnostics(g, BlockKartLifecycleRunning, "race", "raceRestart", w)
		if profileFixedStep {
			now := time.Now()
			phaseStats.ResetMs = blockKartElapsedMs(phaseStart, now)
			phaseStats.TotalMs = blockKartElapsedMs(fixedStart, now)
			w.fixedProfiler.Record(phaseStats)
		}
		return
	}
	if w.raceState == BlockKartRaceStateReady {
		if w.raceSession.shouldStartRace(w.BlockKartRuntimeContext, g) {
			w.raceSession.startRace(w.BlockKartRuntimeContext, g)
		} else {
			w.kartRig.updateIdleVehicleAudio(w.BlockKartRuntimeContext)
			if profileFixedStep {
				now := time.Now()
				phaseStats.AudioMs = blockKartElapsedMs(phaseStart, now)
				phaseStats.TotalMs = blockKartElapsedMs(fixedStart, now)
				w.fixedProfiler.Record(phaseStats)
			}
			return
		}
	}
	w.raceSession.updateGameplay(w.BlockKartRuntimeContext, g, dt)
	if profileFixedStep {
		now := time.Now()
		phaseStats.GameplayMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	if w.finished {
		w.raceSession.reportRaceResultOnce(w.BlockKartRuntimeContext, g)
		w.kartRig.updateIdleVehicleAudio(w.BlockKartRuntimeContext)
		if profileFixedStep {
			now := time.Now()
			phaseStats.AudioMs = blockKartElapsedMs(phaseStart, now)
			phaseStats.TotalMs = blockKartElapsedMs(fixedStart, now)
			w.fixedProfiler.Record(phaseStats)
		}
		return
	}
	w.kartRig.applyKartDrive(w.BlockKartRuntimeContext, g, dt)
	if profileFixedStep {
		now := time.Now()
		phaseStats.DriveMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	w.kartRig.applyKartRoadEdgeAssist(w.BlockKartRuntimeContext, dt)
	if profileFixedStep {
		now := time.Now()
		phaseStats.AssistMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	shouldSleep := w.kartRig.shouldSleepKartPhysics(w.BlockKartRuntimeContext)
	if profileFixedStep {
		now := time.Now()
		phaseStats.SleepMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	if shouldSleep {
		w.physicsIdleFrames++
		if w.physicsIdleFrames >= scene3d.DefaultVehicleIdleSleepConfig().WarmupFrames {
			w.kartRig.updateVehicleAudio(w.BlockKartRuntimeContext)
			if profileFixedStep {
				now := time.Now()
				phaseStats.Slept = true
				phaseStats.AudioMs = blockKartElapsedMs(phaseStart, now)
				phaseStats.TotalMs = blockKartElapsedMs(fixedStart, now)
				w.fixedProfiler.Record(phaseStats)
			}
			return
		}
	} else {
		w.physicsIdleFrames = 0
	}
	w.raceSession.beginKartPhysicsStep(w.BlockKartRuntimeContext)
	w.kartRig.StepPhysics(dt, w.lastVehicleIntent)
	if profileFixedStep {
		now := time.Now()
		phaseStats.PhysicsMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	w.kartRig.resolveKartRoadEdgeAssistPose(w.BlockKartRuntimeContext)
	w.raceSession.endKartPhysicsStep(w.BlockKartRuntimeContext)
	if profileFixedStep {
		now := time.Now()
		phaseStats.ResolveMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	w.kartRig.updateVehicleAudio(w.BlockKartRuntimeContext)
	if profileFixedStep {
		now := time.Now()
		phaseStats.AudioMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	if w.player.Position().Y < playerResetY {
		w.raceSession.respawnAtCheckpoint(w.BlockKartRuntimeContext)
	}
	if profileFixedStep {
		now := time.Now()
		phaseStats.ResetMs = blockKartElapsedMs(phaseStart, now)
		phaseStats.TotalMs = blockKartElapsedMs(fixedStart, now)
		w.fixedProfiler.Record(phaseStats)
	}
}

func (r *RaceSession) shouldStartRace(w *BlockKartRuntimeContext, g *voplay.GameCtx) bool {
	if w == nil {
		return false
	}
	if w.touchInputActive && w.touchInput.Throttle > 0.05 {
		return true
	}
	if g == nil || g.Actions == nil {
		return false
	}
	return g.Actions.IsPressed("start") || g.Actions.IsDown("start")
}

func (r *RaceSession) startRace(w *BlockKartRuntimeContext, g *voplay.GameCtx) {
	if w == nil || w.raceState != BlockKartRaceStateReady {
		return
	}
	w.raceState = BlockKartRaceStateRunning
	w.message = "Go!"
	w.messageTimer = 1.1
	blockKartReportRuntimeDiagnostics(g, BlockKartLifecycleRunning, "race", "raceStart", w)
}

func (r *RaceSession) reportRaceResultOnce(w *BlockKartRuntimeContext, g *voplay.GameCtx) {
	if w == nil || w.raceResultReported {
		return
	}
	w.raceResultReported = true
	blockKartReportRuntimeDiagnostics(g, BlockKartLifecycleRunning, "race", "raceFinished", w)
}

func (k *KartRig) applyKartDrive(w *BlockKartRuntimeContext, g *voplay.GameCtx, dt float64) {
	if w.vehicle == nil {
		return
	}
	if w.racingInput == nil {
		w.raceSession.setupRacingInput(w, g)
	}
	input := scene3d.RacingInput{}
	if w.racingInput != nil {
		input = w.racingInput.Read()
	}
	if w.touchInputActive {
		input = mergeRacingInput(input, w.touchInput)
	}
	intent := input.VehicleIntent()
	boosting := w.boostTimer > 0 || input.Boost
	intent.BoostRequest = boosting
	w.lastVehicleIntent = intent
	w.lastSteer = input.Steer
	if w.kartController != nil {
		state := w.kartController.UpdateIntentFromSyncedState(intent, dt)
		w.lastControllerState = state
		if state.SuperTurboReleased {
			w.boostTimer = maxFloat(w.boostTimer, kartSuperTurboDuration)
			w.message = "Super mini-turbo!"
			w.messageTimer = 0.95
		} else if state.MiniTurboReleased {
			w.boostTimer = maxFloat(w.boostTimer, kartMiniTurboDuration)
			w.message = "Mini-turbo!"
			w.messageTimer = 0.82
		}
		if state.ShouldRespawn {
			w.raceSession.respawnAtCheckpoint(w)
		}
		w.drifting = state.Drifting
		w.driftCharge = state.DriftCharge
		telemetry := scene3d.ProductVehicleTelemetry(w.vehicle)
		w.kartYaw = telemetry.Yaw
		w.kartSpeed = telemetry.Speed
		return
	}
	w.vehicle.UpdateIntent(intent, dt)
	telemetry := scene3d.ProductVehicleTelemetry(w.vehicle)
	w.drifting = telemetry.Drifting
	w.driftCharge = 0
	w.kartYaw = telemetry.Yaw
	w.kartSpeed = telemetry.Speed
}

func (k *KartRig) shouldSleepKartPhysics(w *BlockKartRuntimeContext) bool {
	if w.vehicle == nil {
		return false
	}
	sample := scene3d.ProductVehicleIdleSleepSample(w.vehicle, w.lastVehicleIntent, w.kartSpeed, w.physicsIdleFrames, w.boostTimer > 0, w.drifting, w.roadEdgeAssistActive)
	return scene3d.VehicleShouldSleepIdlePhysics(sample, scene3d.DefaultVehicleIdleSleepConfig())
}

func blockKartElapsedMs(start time.Time, end time.Time) float64 {
	return float64(end.Sub(start).Nanoseconds()) / 1000000.0
}

type blockKartStartupProfiler struct {
	label string
	start time.Time
	last time.Time
}

func newBlockKartStartupProfiler(label string) *blockKartStartupProfiler {
	now := time.Now()
	return &blockKartStartupProfiler{label: label, start: now, last: now}
}

func (p *blockKartStartupProfiler) Mark(phase string) {
	if p == nil || !blockKartPerfReports {
		return
	}
	now := time.Now()
	println(p.label + " startup phase=" + phase + " delta=" + formatHudMs(blockKartElapsedMs(p.last, now)) + " total=" + formatHudMs(blockKartElapsedMs(p.start, now)))
	p.last = now
}

func moveTowardsFloat(current, target, maxDelta float64) float64 {
	if maxDelta <= 0 {
		return current
	}
	if current < target {
		current += maxDelta
		if current > target {
			return target
		}
		return current
	}
	current -= maxDelta
	if current < target {
		return target
	}
	return current
}

func clampFloat(v, lo, hi float64) float64 {
	if v < lo {
		return lo
	}
	if v > hi {
		return hi
	}
	return v
}

func (w *World) SetRacingDebugOverlayVisible(visible bool) {
	if !visible {
		w.hudPresenter.destroyRacingDebugOverlay(w.BlockKartRuntimeContext)
		return
	}
	if w.racingDebugOverlay != nil {
		w.racingDebugOverlay.Update(w.scene)
		return
	}
	if w.scene == nil || w.track == nil || w.vehicle == nil {
		return
	}
	overlay, err := scene3d.SpawnRacingDebugOverlay(w.scene, w.track, w.vehicle, scene3d.RacingDebugOptions{Model: w.cubeModel, SurfaceMarker: true, Track: scene3d.TrackDebugOptions{Model: w.cubeModel, HeightOffset: 0.55, LineThickness: 0.2}, Vehicle: scene3d.VehicleDebugOptions{Model: w.cubeModel, MarkerSize: 0.35, LineThickness: 0.12}})
	if err == nil {
		w.racingDebugOverlay = overlay
	}
}

func (w *World) SetRenderDebugMode(mode int) {
	if w.scene != nil {
		scene3d.ProductSetRenderDebugMode(w.scene, mode)
	}
}

func (w *World) SetHeroCameraVisible(visible bool) {
	w.heroCameraVisible = visible
}

func (h *HUDPresenter) destroyRacingDebugOverlay(w *BlockKartRuntimeContext) {
	if w.racingDebugOverlay != nil {
		w.racingDebugOverlay.Destroy(w.scene)
		w.racingDebugOverlay = nil
	}
}

func (w *World) Close() {
	w.hudPresenter.destroyRacingDebugOverlay(w.BlockKartRuntimeContext)
	if w.vehicleAudio != nil {
		w.vehicleAudio.Destroy()
		w.vehicleAudio = nil
	}
	if w.scene != nil {
		w.scene.Skybox = 0
		w.scene.Close()
	}
	if w.trackResult != nil {
		w.trackResult.ReleaseTextures()
		w.trackResult = nil
	}
	w.primitive = nil
	w.track = nil
	w.kartController = nil
	if w.assets != nil {
		if w.assetGroup != "" && !w.assetGroupOwnedByRuntime {
			w.assets.ReleaseGroup(w.assetGroup)
			w.assetGroup = ""
		}
		w.assets = nil
	}
	if w.cubeModel != 0 {
		w.cubeModel.Free()
		w.cubeModel = 0
	}
}
