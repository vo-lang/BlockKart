	runtimeCache *BlockKartRuntimeCache
	assetRuntime AssetRuntimeCache
	raceSession RaceSession
	kartRig KartRig
	trackRuntime TrackRuntime
	hudPresenter HUDPresenter
	perfReporter PerfReporter
	assets *voplay.Assets
	assetGroup string
	assetGroupOwnedByRuntime bool
	primitiveMap *scene3d.MapPreparedAsset
	preparedMapReused bool
	primitiveTemplateReused bool
	track *scene3d.Track
	trackResult *scene3d.TrackSpawnResult
	primitive *PrimitiveVisualContent
	racingDebugOverlay *scene3d.RacingDebugOverlay
	heroCameraVisible bool
