	core BlockKartRuntimeCore
	input BlockKartRuntimeInputState
	race BlockKartRuntimeRaceState
	kart BlockKartRuntimeKartState
	hud BlockKartRuntimeHudState
}

func diagnosticsPortsFromStates(core *BlockKartRuntimeCore, input *BlockKartRuntimeInputState, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, hud *BlockKartRuntimeHudState) *DiagnosticsPorts {
	return &DiagnosticsPorts{core: core, input: input, race: race, kart: kart, hud: hud}
}

type roadEdgeAssistSample struct {
	Point scene3d.TrackPoint
	Right voplay.Vec3
	Inward voplay.Vec3
	EdgeHalfWidth float64
	AssistStart float64
	LateralAbs float64
	Side float64
}

type KartSpawnSpec struct {
	Position voplay.Vec3
	Yaw float64
	Tuning BlockKartTuningPreset
}

func (c *BlockKartRuntimeCache) EnsureLoaded(assets *voplay.Assets) (voplay.CubemapID, error) {
	if assets == nil {
		return 0, errors.New("BlockKart assets unavailable")
	}
	if c == nil {
		return 0, errors.New("BlockKart runtime cache unavailable")
	}
	if c.assets != nil && c.assets != assets {
		c.Close()
	}
	c.assets = assets
	packErr := assets.Mount(blockKartAssetPath("blockkart.vpak"), 100)
	if packErr != nil {
		c.assets = nil
		return 0, errors.New("BlockKart asset pack mount failed: " + packErr.Error())
	}
	if c.skybox != 0 {
		return c.skybox, nil
	}
	assets.BeginGroup(worldAssetGroup)
	skybox, err := loadSkybox(assets)
	assets.EndGroup()
	if err != nil {
		if c.assetGroupActive {
			assets.ReleaseGroup(worldAssetGroup)
		} else {
			assets.ReleaseGroup(worldAssetGroup)
		}
		c.assets = nil
		c.assetGroup = ""
		c.assetGroupActive = false
		return 0, errors.New("BlockKart skybox load failed: " + err.Error())
	}
	c.assetGroup = worldAssetGroup
	c.assetGroupActive = true
	c.skybox = skybox
	return c.skybox, nil
}

func (c *BlockKartRuntimeCache) Close() {
	if c == nil {
		return
	}
	if c.assets != nil && c.assetGroupActive && c.assetGroup != "" {
		c.assets.ReleaseGroup(c.assetGroup)
	}
	c.assets = nil
	c.assetGroup = ""
	c.assetGroupActive = false
	c.skybox = 0
	c.primitiveMap = nil
	c.primitiveTemplate = nil
}

func NewWorld(g *voplay.GameCtx, runtimeCache *BlockKartRuntimeCache) (*World, *BlockKartFailureReport) {
	prof := newBlockKartStartupProfiler("BlockKart world")
	if g == nil {
		return nil, blockKartNewFailureReport(BlockKartLifecycleFailed, "alloc", BlockKartOwnerVoplay, BlockKartSubsystemRuntime, "BlockKart world construction received nil GameCtx", "BlockKart could not start. Please try again.")
	}
	w := &World{
		core: BlockKartRuntimeCore{scene: scene3d.New(), runtimeCache: runtimeCache},
		input: BlockKartRuntimeInputState{theme: defaultWorldTheme(), settings: defaultBlockKartSettings(), tuning: defaultBlockKartTuningPreset()},
		race: BlockKartRuntimeRaceState{startPosition: voplay.Vec3{X: 0, Y: 1.1, Z: 98}, raceState: BlockKartRaceStateReady, totalLaps: raceLapCount, lap: 1},
	}
	w.core.assetRuntime.Bind(runtimeCache)
	w.race.raceSession.Reset(raceLapCount)
	prof.Mark("alloc")
	w.race.checkpointPosition = w.race.startPosition
	w.race.checkpointLabel = "Start"
	w.race.nextGateLabel = "Gate 1"
	w.core.assetRuntime.configureScene(&w.core, &w.input)
	prof.Mark("configureScene")
	if err := w.core.assetRuntime.loadAssets(&w.core, g.Assets); err != nil {
		blockKartReportWorldDiagnostics(g, BlockKartLifecycleFailed, "loadAssets", "loadAssetsFailed", w)
		w.Close()
		return nil, blockKartNewFailureReport(BlockKartLifecycleFailed, "loadAssets", BlockKartOwnerBlockKart, BlockKartSubsystemAsset, err.Error(), "BlockKart could not load its game assets. Please try again.")
	}
	prof.Mark("loadAssets")
	w.kart.kartRig.loadModels(&w.kart)
	prof.Mark("loadModels")
	if err := w.core.trackRuntime.buildLevel(&w.core, &w.race, &w.kart, &w.hud.presentation, w.input.theme); err != nil {
		blockKartReportWorldDiagnostics(g, BlockKartLifecycleFailed, "buildLevel", "buildLevelFailed", w)
		w.Close()
		return nil, blockKartNewFailureReport(BlockKartLifecycleFailed, "buildLevel", BlockKartOwnerBlockKart, BlockKartSubsystemMap, err.Error(), "BlockKart could not prepare its track. Please try again.")
	}
	prof.Mark("buildLevel")
	w.race.raceSession.setupRacingInput(&w.input, g)
	prof.Mark("setupRacingInput")
	w.kart.kartRig.spawnPlayer(&w.core, &w.kart, &w.hud.presentation, KartSpawnSpec{Position: w.race.startPosition, Yaw: w.race.startYaw, Tuning: w.input.tuning})
	prof.Mark("spawnPlayer")
	w.kart.kartRig.setupVehicleAudio(&w.core)
	prof.Mark("setupVehicleAudio")
	w.kart.kartRig.setupCamera(&w.core, &w.race, &w.kart, &w.hud.presentation)
	prof.Mark("setupCamera")
	w.race.raceSession.restartRun(&w.core, &w.race, &w.kart, &w.hud.presentation)
	prof.Mark("restartRun")
	return w, nil
}

func (a *AssetRuntimeCache) configureScene(core *BlockKartRuntimeCore, input *BlockKartRuntimeInputState) {
	applyWorldTheme(input.theme, core.scene, input.settings)
}

func setupBlockKartRacingInput(input *BlockKartRuntimeInputState, g *voplay.GameCtx) {
	if g == nil || g.Input == nil {
		return
	}
	profile := scene3d.NewRacingInputProfile(g.Input)
	profile.Rebind(scene3d.RacingActionDrift, voplay.KeyBinding("Space"), voplay.KeyBinding(" "), voplay.GamepadButtonBinding(profile.Gamepad, "right_shoulder"))
	profile.Rebind(scene3d.RacingActionBoost, voplay.KeyBinding("Shift"), voplay.GamepadButtonBinding(profile.Gamepad, "south"))
	input.racingInput = profile
}

func (r *RaceSession) setupRacingInput(input *BlockKartRuntimeInputState, g *voplay.GameCtx) {
	setupBlockKartRacingInput(input, g)
}

func (k *KartRig) loadModels(kart *BlockKartRuntimeKartState) {
	kart.cubeModel = scene3d.CubeMesh()
}

func loadTextureAsset(assets *voplay.Assets, rel string) (voplay.TextureID, error) {
	return assets.Texture(blockKartAssetPath(rel))
}

func loadAudioAsset(assets *voplay.Assets, rel string) (voplay.AudioClipID, error) {
	return assets.Audio(blockKartAssetPath(rel))
}

func (a *AssetRuntimeCache) loadAssets(core *BlockKartRuntimeCore, assets *voplay.Assets) error {
	if assets == nil {
		return errors.New("BlockKart assets unavailable")
	}
	core.assets = assets
	if core.runtimeCache != nil {
		skybox, err := core.runtimeCache.EnsureLoaded(assets)
		if err != nil {
			return err
		}
		core.scene.Skybox = skybox
		core.assetGroup = worldAssetGroup
		core.assetGroupOwnedByRuntime = true
		return nil
	}
	packErr := assets.Mount(blockKartAssetPath("blockkart.vpak"), 100)
	if packErr != nil {
		return errors.New("BlockKart asset pack mount failed: " + packErr.Error())
	}
	assets.BeginGroup(worldAssetGroup)
	skybox, err := loadSkybox(assets)
	if err == nil {
		core.scene.Skybox = skybox
	}
	assets.EndGroup()
	if err != nil {
		assets.ReleaseGroup(worldAssetGroup)
		return errors.New("BlockKart skybox load failed: " + err.Error())
	}
	core.assetGroup = worldAssetGroup
	return nil
}

func loadSkybox(assets *voplay.Assets) (voplay.CubemapID, error) {
	return assets.Cubemap(blockKartAssetPath("skybox/right.png"), blockKartAssetPath("skybox/left.png"), blockKartAssetPath("skybox/top.png"), blockKartAssetPath("skybox/bottom.png"), blockKartAssetPath("skybox/front.png"), blockKartAssetPath("skybox/back.png"))
}

func blockKartAssetPath(rel string) string {
	return "assets/" + rel
}

func (k *KartRig) spawnPlayer(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState, presentation *RacePresentationState, spec KartSpawnSpec) {
	core.player = core.scene.Spawn(scene3d.EntityDesc{Position: spec.Position, Rotation: kart.kartRig.kartRotation(core, kart), Scale: voplay.Vec3{X: 1, Y: 1, Z: 1}, Tag: "kart_physics", Physics: &scene3d.Physics{Type: scene3d.Dynamic, Collider: scene3d.Box(0.78, 0.24, 1.16), Layer: voplay.CollisionLayerDefault, Mask: voplay.CollisionMaskAll, Density: 70.0, Friction: 0.25, Restitution: 0.02, LinearDamping: 0.12, AngularDamping: 3.5, LockRotationX: true, LockRotationZ: true}})
	core.player.Visible = false
	controllerConfig := spec.Tuning.KartControllerConfig()
	core.vehicle = scene3d.NewVehicle(core.player, controllerConfig.Vehicle)
	core.kartController = scene3d.NewKartController(core.vehicle, core.track, controllerConfig)
	core.kartController.Respawn(scene3d.TrackPose{Position: spec.Position, Yaw: spec.Yaw})
	kart.kartRig.Bind(core.player, core.vehicle, core.kartController, scene3d.NewVehiclePhysicsSession(scene3d.VehiclePhysicsSessionDesc{Scene: core.scene, Vehicle: core.vehicle, Controller: core.kartController, FixedDt: 1.0 / 60.0}))
	kart.kartRig.primeIdleStartPhysicsSleep(core, kart)
	session := RaceSession{}
	session.resetKartRenderPose(core, kart, presentation, spec.Position, kart.kartRig.kartRotation(core, kart))
	kart.kartRig.spawnKartVisuals(core, kart, spec.Position)
	kart.kartRig.syncKartVisuals(core, kart)
}

func (k *KartRig) primeIdleStartPhysicsSleep(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState) {
	if core.vehicle == nil {
		return
	}
	scene3d.ProductPrimeVehicleIdleSleep(core.vehicle)
	kart.physicsIdleFrames = scene3d.DefaultVehicleIdleSleepConfig().WarmupFrames
}

func (k *KartRig) spawnKartVisuals(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState, position voplay.Vec3) {
	core.trackRuntime.spawnPrimitiveKartVisuals(core, kart, position)
}

func (k *KartRig) setupCamera(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, presentation *RacePresentationState) {
	core.camera = scene3d.NewRacingCamera()
	core.camera.BaseDistance = 22.4
	core.camera.MaxDistance = 33.0
	core.camera.Height = 9.8
	core.camera.TargetHeight = 1.95
	core.camera.LookaheadBase = 16.2
	core.camera.LookaheadSpeedScale = 0.14
	core.camera.DistanceSpeedScale = 0.055
	core.camera.DriftOffset = 1.45
	core.camera.Smoothing = 5.8
	core.camera.TargetSmoothing = 7.2
	core.camera.Fov = 61
	core.camera.SpeedFov = 0.026
	core.camera.BoostFovKick = 3.2
	core.camera.CollisionEnabled = false
	core.camera.CollisionOffset = 0.72
	race.raceSession.updateRacingCamera(core, race, kart, presentation, 0, false)
}

func (k *KartRig) setupVehicleAudio(core *BlockKartRuntimeCore) {
	if core.assets == nil || core.player == nil {
		return
	}
	core.assets.BeginGroup(worldAssetGroup)
	engine, engineErr := loadAudioAsset(core.assets, "audio/kart_engine.wav")
	skid, skidErr := loadAudioAsset(core.assets, "audio/kart_skid.wav")
	boost, boostErr := loadAudioAsset(core.assets, "audio/kart_boost.wav")
	surface, surfaceErr := loadAudioAsset(core.assets, "audio/kart_grass.wav")
	collision, collisionErr := loadAudioAsset(core.assets, "audio/kart_hit.wav")
	core.assets.EndGroup()
	if engineErr != nil || skidErr != nil || boostErr != nil || surfaceErr != nil || collisionErr != nil {
		return
	}
	config := scene3d.DefaultVehicleAudioConfig()
	config.EngineMaxSpeed = 38
	config.EngineMinVolume = 0.16
	config.EngineMaxVolume = 0.64
	config.SkidMaxVolume = 0.52
	config.BoostVolume = 0.42
	config.SurfaceVolume = 0.28
	audio, err := scene3d.AttachVehicleAudio(core.player, scene3d.VehicleAudioClips{Engine: engine, Skid: skid, Boost: boost, Surface: surface, Collision: collision}, config)
	if err == nil {
		core.vehicleAudio = audio
	}
}

func (w *World) FixedUpdate(g *voplay.GameCtx, dt float64, debugOverlayVisible bool) {
	profileFixedStep := debugOverlayVisible || blockKartFixedPhaseConsoleReports || blockKartPerfReports
	fixedStart := time.Time{}
	phaseStart := time.Time{}
	phaseStats := BlockKartFixedPhaseStats{}
	if profileFixedStep {
		fixedStart = time.Now()
		phaseStart = fixedStart
	}
	w.hud.hudPresenter.updateTouchControls(&w.input, g)
	if profileFixedStep {
		now := time.Now()
		phaseStats.TouchMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	if w.input.touchResetPressed {
		w.race.raceSession.restartRun(&w.core, &w.race, &w.kart, &w.hud.presentation)
		blockKartReportWorldDiagnostics(g, BlockKartLifecycleRunning, "race", "raceRestart", w)
		if profileFixedStep {
			now := time.Now()
			phaseStats.ResetMs = blockKartElapsedMs(phaseStart, now)
			phaseStats.TotalMs = blockKartElapsedMs(fixedStart, now)
			w.hud.fixedProfiler.Record(phaseStats)
		}
		return
	}
	if w.race.raceState == BlockKartRaceStateReady {
		if w.race.raceSession.shouldStartRace(&w.input, g) {
			if w.race.raceSession.startRace(&w.race, &w.hud.presentation) {
				blockKartReportWorldDiagnostics(g, BlockKartLifecycleRunning, "race", "raceStart", w)
			}
		} else {
			w.kart.kartRig.updateIdleVehicleAudio(&w.core)
			if profileFixedStep {
				now := time.Now()
				phaseStats.AudioMs = blockKartElapsedMs(phaseStart, now)
				phaseStats.TotalMs = blockKartElapsedMs(fixedStart, now)
				w.hud.fixedProfiler.Record(phaseStats)
			}
			return
		}
	}
	w.race.raceSession.updateGameplay(&w.core, &w.race, &w.kart, &w.hud.presentation, dt)
	if profileFixedStep {
		now := time.Now()
		phaseStats.GameplayMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	if w.race.finished {
		if w.race.raceSession.reportRaceResultOnce(&w.race) {
			blockKartReportWorldDiagnostics(g, BlockKartLifecycleRunning, "race", "raceFinished", w)
		}
		w.kart.kartRig.updateIdleVehicleAudio(&w.core)
		if profileFixedStep {
			now := time.Now()
			phaseStats.AudioMs = blockKartElapsedMs(phaseStart, now)
			phaseStats.TotalMs = blockKartElapsedMs(fixedStart, now)
			w.hud.fixedProfiler.Record(phaseStats)
		}
		return
	}
	w.kart.kartRig.applyKartDrive(&w.core, &w.input, &w.kart, g, dt)
	if profileFixedStep {
		now := time.Now()
		phaseStats.DriveMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	w.kart.kartRig.applyKartRoadEdgeAssist(&w.core, &w.kart, dt)
	if profileFixedStep {
		now := time.Now()
		phaseStats.AssistMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	shouldSleep := w.kart.kartRig.shouldSleepKartPhysics(&w.core, &w.kart)
	if profileFixedStep {
		now := time.Now()
		phaseStats.SleepMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	if shouldSleep {
		w.kart.physicsIdleFrames++
		if w.kart.physicsIdleFrames >= scene3d.DefaultVehicleIdleSleepConfig().WarmupFrames {
			w.kart.kartRig.updateVehicleAudio(&w.core)
			if profileFixedStep {
				now := time.Now()
				phaseStats.Slept = true
				phaseStats.AudioMs = blockKartElapsedMs(phaseStart, now)
				phaseStats.TotalMs = blockKartElapsedMs(fixedStart, now)
				w.hud.fixedProfiler.Record(phaseStats)
			}
			return
		}
	} else {
		w.kart.physicsIdleFrames = 0
	}
	w.race.raceSession.beginKartPhysicsStep(&w.core, &w.race, &w.kart, &w.hud.presentation)
	telemetry := w.kart.kartRig.StepPhysics(dt, w.kart.lastVehicleIntent)
	w.kart.kartRig.applyKartDriveResult(&w.core, &w.race, &w.kart, &w.hud.presentation, telemetry)
	if profileFixedStep {
		now := time.Now()
		phaseStats.PhysicsMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	w.kart.kartRig.resolveKartRoadEdgeAssistPose(&w.core, &w.kart)
	w.race.raceSession.endKartPhysicsStep(&w.core, &w.race, &w.kart, &w.hud.presentation)
	if profileFixedStep {
		now := time.Now()
		phaseStats.ResolveMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	w.kart.kartRig.updateVehicleAudio(&w.core)
	if profileFixedStep {
		now := time.Now()
		phaseStats.AudioMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	if w.core.player.Position().Y < playerResetY {
		w.race.raceSession.respawnAtCheckpoint(&w.core, &w.race, &w.kart, &w.hud.presentation)
	}
	if profileFixedStep {
		now := time.Now()
		phaseStats.ResetMs = blockKartElapsedMs(phaseStart, now)
		phaseStats.TotalMs = blockKartElapsedMs(fixedStart, now)
		w.hud.fixedProfiler.Record(phaseStats)
	}
}

func (r *RaceSession) shouldStartRace(input *BlockKartRuntimeInputState, g *voplay.GameCtx) bool {
	if input == nil {
		return false
	}
	if input.touchInputActive && input.touchInput.Throttle > 0.05 {
		return true
	}
	if g == nil || g.Actions == nil {
		return false
	}
	return g.Actions.IsPressed("start") || g.Actions.IsDown("start")
}

func (r *RaceSession) startRace(race *BlockKartRuntimeRaceState, presentation *RacePresentationState) bool {
	if race == nil || race.raceState != BlockKartRaceStateReady {
		return false
	}
	race.raceState = BlockKartRaceStateRunning
	presentation.message = "Go!"
	presentation.messageTimer = 1.1
	return true
}

func (r *RaceSession) reportRaceResultOnce(race *BlockKartRuntimeRaceState) bool {
	if race == nil || race.raceResultReported {
		return false
	}
	race.raceResultReported = true
	return true
}

func (k *KartRig) applyKartDrive(core *BlockKartRuntimeCore, input *BlockKartRuntimeInputState, kart *BlockKartRuntimeKartState, g *voplay.GameCtx, dt float64) {
	if core.vehicle == nil {
		return
	}
	if input.racingInput == nil {
		setupBlockKartRacingInput(input, g)
	}
	driveInput := scene3d.RacingInput{}
	if input.racingInput != nil {
		driveInput = input.racingInput.Read()
	}
	if input.touchInputActive {
		driveInput = mergeRacingInput(driveInput, input.touchInput)
	}
	intent := driveInput.VehicleIntent()
	boosting := kart.boostTimer > 0 || driveInput.Boost
	intent.BoostRequest = boosting
	kart.lastVehicleIntent = intent
	kart.lastSteer = driveInput.Steer
}

func (k *KartRig) applyKartDriveResult(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, presentation *RacePresentationState, telemetry scene3d.VehicleTelemetry) {
	if core == nil || core.vehicle == nil {
		return
	}
	state := scene3d.KartControllerState{}
	if k != nil && k.PhysicsSession != nil {
		state = k.PhysicsSession.LastState
	}
	kart.lastControllerState = state
	if state.SuperTurboReleased {
		kart.boostTimer = maxFloat(kart.boostTimer, kartSuperTurboDuration)
		presentation.message = "Super mini-turbo!"
		presentation.messageTimer = 0.95
	} else if state.MiniTurboReleased {
		kart.boostTimer = maxFloat(kart.boostTimer, kartMiniTurboDuration)
		presentation.message = "Mini-turbo!"
		presentation.messageTimer = 0.82
	}
	if state.ShouldRespawn {
		race.raceSession.respawnAtCheckpoint(core, race, kart, presentation)
	}
	if telemetry.WheelCount == 0 {
		telemetry = scene3d.ProductVehicleTelemetry(core.vehicle)
	}
	kart.drifting = state.Drifting || telemetry.Drifting
	kart.driftCharge = state.DriftCharge
	kart.kartYaw = telemetry.Yaw
	kart.kartSpeed = telemetry.Speed
}

func (k *KartRig) shouldSleepKartPhysics(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState) bool {
	if core.vehicle == nil {
		return false
	}
	sample := scene3d.ProductVehicleIdleSleepSample(core.vehicle, kart.lastVehicleIntent, kart.kartSpeed, kart.physicsIdleFrames, kart.boostTimer > 0, kart.drifting, kart.roadEdgeAssistActive)
	return scene3d.VehicleShouldSleepIdlePhysics(sample, scene3d.DefaultVehicleIdleSleepConfig())
}

func blockKartElapsedMs(start time.Time, end time.Time) float64 {
	return float64(end.Sub(start).Nanoseconds()) / 1000000.0
}

type blockKartStartupProfiler struct {
	label string
	start time.Time
	last time.Time
}

func newBlockKartStartupProfiler(label string) *blockKartStartupProfiler {
	now := time.Now()
	return &blockKartStartupProfiler{label: label, start: now, last: now}
}

func (p *blockKartStartupProfiler) Mark(phase string) {
	if p == nil || !blockKartPerfReports {
		return
	}
	now := time.Now()
	println(p.label + " startup phase=" + phase + " delta=" + formatHudMs(blockKartElapsedMs(p.last, now)) + " total=" + formatHudMs(blockKartElapsedMs(p.start, now)))
	p.last = now
}

func moveTowardsFloat(current, target, maxDelta float64) float64 {
	if maxDelta <= 0 {
		return current
	}
	if current < target {
		current += maxDelta
		if current > target {
			return target
		}
		return current
	}
	current -= maxDelta
	if current < target {
		return target
	}
	return current
}

func clampFloat(v, lo, hi float64) float64 {
	if v < lo {
		return lo
	}
	if v > hi {
		return hi
	}
	return v
}

func (w *World) SetRacingDebugOverlayVisible(visible bool) {
	if !visible {
		w.hud.hudPresenter.destroyRacingDebugOverlay(&w.core, &w.hud)
		return
	}
	if w.hud.racingDebugOverlay != nil {
		w.hud.racingDebugOverlay.Update(w.core.scene)
		return
	}
	if w.core.scene == nil || w.core.track == nil || w.core.vehicle == nil {
		return
	}
	overlay, err := scene3d.SpawnRacingDebugOverlay(w.core.scene, w.core.track, w.core.vehicle, scene3d.RacingDebugOptions{Model: w.kart.cubeModel, SurfaceMarker: true, Track: scene3d.TrackDebugOptions{Model: w.kart.cubeModel, HeightOffset: 0.55, LineThickness: 0.2}, Vehicle: scene3d.VehicleDebugOptions{Model: w.kart.cubeModel, MarkerSize: 0.35, LineThickness: 0.12}})
	if err == nil {
		w.hud.racingDebugOverlay = overlay
	}
}

func (w *World) SetRenderDebugMode(mode int) {
	if w.core.scene != nil {
		scene3d.ProductSetRenderDebugMode(w.core.scene, mode)
	}
}

func (w *World) SetHeroCameraVisible(visible bool) {
	w.hud.presentation.heroCameraVisible = visible
}

func (h *HUDPresenter) destroyRacingDebugOverlay(core *BlockKartRuntimeCore, hud *BlockKartRuntimeHudState) {
	if hud.racingDebugOverlay != nil {
		hud.racingDebugOverlay.Destroy(core.scene)
		hud.racingDebugOverlay = nil
	}
}

func (w *World) Close() {
	w.hud.hudPresenter.destroyRacingDebugOverlay(&w.core, &w.hud)
	if w.core.vehicleAudio != nil {
		w.core.vehicleAudio.Destroy()
		w.core.vehicleAudio = nil
	}
	if w.core.scene != nil {
		w.core.scene.Skybox = 0
		w.core.scene.Close()
	}
	if w.core.trackResult != nil {
		w.core.trackResult.ReleaseTextures()
		w.core.trackResult = nil
	}
	w.core.primitive = nil
	w.core.track = nil
	w.core.kartController = nil
	if w.core.assets != nil {
		if w.core.assetGroup != "" && !w.core.assetGroupOwnedByRuntime {
			w.core.assets.ReleaseGroup(w.core.assetGroup)
			w.core.assetGroup = ""
		}
		w.core.assets = nil
	}
	if w.kart.cubeModel != 0 {
		w.kart.cubeModel.Free()
		w.kart.cubeModel = 0
	}
}
