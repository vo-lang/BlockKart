package main

import (
	"errors"
	"math"
	"time"
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

const (
	kartBodyWidth = 1.7
	kartBodyHeight = 0.58
	kartBodyLength = 2.55
	kartItemBoostDuration = 1.25
	kartBoostPadDuration = 1.0
	kartMiniTurboCharge = 0.55
	kartSuperTurboCharge = 1.08
	kartMaxDriftCharge = 1.3
	kartMiniTurboDuration = 0.75
	kartSuperTurboDuration = 1.35
	kartSpawnRideHeight = 1.16
	kartRoadEdgeAssistCenterInset = 1.15
	kartRoadEdgeAssistSoftZone = 1.15
	kartRoadEdgeAssistMaxPushSpeed = 9.5
	kartRoadEdgeAssistVelocityBlend = 11.0
	kartRoadEdgeAssistOutwardDamping = 0.92
	kartRoadEdgeAssistImpactSpeed = 3.4
	kartRoadEdgeAssistPositionBlend = 6.5
	kartRoadEdgeAssistMaxCorrection = 0.18
	kartRoadEdgeAssistPostMaxCorrection = 0.36
	kartRoadEdgeAssistSnapOverflow = 1.35
	kartRoadEdgeAssistLift = 0.08
	kartPhysicsIdleSleepWarmupFrames = 30
	kartPhysicsIdleLinearSleepSpeedSq = 0.0025
	kartPhysicsIdleAngularSleepSpeedSq = 0.0004
	raceLapCount = 3
	playerResetY = -25.0
)

const worldAssetGroup = "blockkart-world"

const blockKartRestartResourceRootCause = "Phase 2A root cause: restart was rebuilding immutable vpak map data and static primitive scenery on the render-driven frame; the runtime cache keeps asset pack, prepared map, and static primitive templates alive while World restart still rebuilds scene, race, physics, input, and dynamic kart state."

type BlockKartRuntimeCache struct {
	assets *voplay.Assets
	assetGroup string
	assetGroupActive bool
	skybox voplay.CubemapID
	primitiveMap *scene3d.MapPreparedAsset
	primitiveTemplate *BlockKartPrimitiveTemplate
	preparedMapBuilds int
	preparedMapReuses int
	primitiveTemplateBuilds int
	primitiveTemplateReuses int
}

type World struct {
	scene *scene3d.Scene
	camera *scene3d.RacingCamera
	player *scene3d.Entity
	vehicle *scene3d.Vehicle
	kartController *scene3d.KartController
	racingInput *scene3d.RacingInputProfile
	touchControls TouchDriveUI
	touchInput scene3d.RacingInput
	touchInputActive bool
	touchResetPressed bool
	vehicleAudio *scene3d.VehicleAudio
	startPosition voplay.Vec3
	startYaw float64
	theme WorldTheme
	settings BlockKartSettings
	tuning BlockKartTuningPreset
	runtimeCache *BlockKartRuntimeCache
	assets *voplay.Assets
	assetGroup string
	assetGroupOwnedByRuntime bool
	primitiveMap *scene3d.MapPreparedAsset
	preparedMapReused bool
	primitiveTemplateReused bool
	track *scene3d.Track
	trackResult *scene3d.TrackSpawnResult
	primitive *BlockKartPrimitiveScene
	racingDebugOverlay *scene3d.RacingDebugOverlay
	heroCameraVisible bool
	terrainCameraView int
	checkpointPosition voplay.Vec3
	checkpointYaw float64
	checkpointLabel string
	nextGateLabel string
	raceState string
	raceResultReported bool
	courseTime float64
	finishTime float64
	bestTime float64
	bestTimeSet bool
	finished bool
	collected int
	lap int
	totalLaps int
	nextCheckpoint int
	kartYaw float64
	kartSpeed float64
	lastSteer float64
	roadEdgeAssistActive bool
	cameraTelemetry CameraTargetTelemetry
	kartRenderPose KartRenderPose
	boostTimer float64
	driftCharge float64
	drifting bool
	message string
	messageTimer float64
	collectibles []*Collectible
	checkpoints []*Checkpoint
	boostPads []*BoostPad
	obstacles []*MovingObstacle
	cubeModel voplay.ModelID
	kartChassisPrimitive *PrimitivePart
	kartNosePrimitive *PrimitivePart
	kartCabinPrimitive *PrimitivePart
	kartDriverPrimitive *PrimitivePart
	kartSpoilerPrimitive *PrimitivePart
	kartBumperPrimitive *PrimitivePart
	kartExhaustLeftPrimitive *PrimitivePart
	kartExhaustRightPrimitive *PrimitivePart
	kartFlameLeftPrimitive *PrimitivePart
	kartFlameRightPrimitive *PrimitivePart
	kartPrimitiveVisualState PrimitiveKartVisualState
	kartPrimitiveVisualStateValid bool
	kartWheelPrimitives []*PrimitivePart
	kartBodyPrimitiveParts []PrimitiveKartBodyPart
	kartWheelVisuals []PrimitiveKartWheelVisual
	lastVehicleIntent scene3d.VehicleIntent
	lastControllerState scene3d.KartControllerState
	physicsIdleFrames int
	perfAnalyzer BlockKartPerfAnalyzer
	fixedProfiler BlockKartFixedStepProfiler
	perfSnapshotPollFrame int
	debugHudLines [18]string
	debugHudLineCount int
	debugHudFrame int
}

type roadEdgeAssistSample struct {
	Point scene3d.TrackPoint
	Right voplay.Vec3
	Inward voplay.Vec3
	EdgeHalfWidth float64
	AssistStart float64
	LateralAbs float64
	Side float64
}

func (c *BlockKartRuntimeCache) EnsureLoaded(assets *voplay.Assets) (voplay.CubemapID, error) {
	if assets == nil {
		return 0, errors.New("BlockKart assets unavailable")
	}
	if c == nil {
		return 0, errors.New("BlockKart runtime cache unavailable")
	}
	if c.assets != nil && c.assets != assets {
		c.Close()
	}
	c.assets = assets
	packErr := assets.Mount(blockKartAssetPath("blockkart.vpak"), 100)
	if packErr != nil {
		c.assets = nil
		return 0, errors.New("BlockKart asset pack mount failed: " + packErr.Error())
	}
	if c.skybox != 0 {
		return c.skybox, nil
	}
	assets.BeginGroup(worldAssetGroup)
	skybox, err := loadSkybox(assets)
	assets.EndGroup()
	if err != nil {
		if c.assetGroupActive {
			assets.ReleaseGroup(worldAssetGroup)
		} else {
			assets.ReleaseGroup(worldAssetGroup)
		}
		c.assets = nil
		c.assetGroup = ""
		c.assetGroupActive = false
		return 0, errors.New("BlockKart skybox load failed: " + err.Error())
	}
	c.assetGroup = worldAssetGroup
	c.assetGroupActive = true
	c.skybox = skybox
	return c.skybox, nil
}

func (c *BlockKartRuntimeCache) Close() {
	if c == nil {
		return
	}
	if c.assets != nil && c.assetGroupActive && c.assetGroup != "" {
		c.assets.ReleaseGroup(c.assetGroup)
	}
	c.assets = nil
	c.assetGroup = ""
	c.assetGroupActive = false
	c.skybox = 0
	c.primitiveMap = nil
	c.primitiveTemplate = nil
}

func NewWorld(g *voplay.GameCtx, runtimeCache *BlockKartRuntimeCache) (*World, *BlockKartFailureReport) {
	prof := newBlockKartStartupProfiler("BlockKart world")
	if g == nil {
		return nil, blockKartNewFailureReport(BlockKartLifecycleFailed, "alloc", BlockKartOwnerVoplay, BlockKartSubsystemRuntime, "BlockKart world construction received nil GameCtx", "BlockKart could not start. Please try again.")
	}
	w := &World{scene: scene3d.New(), startPosition: voplay.Vec3{X: 0, Y: 1.1, Z: 98}, theme: defaultWorldTheme(), settings: defaultBlockKartSettings(), tuning: defaultBlockKartTuningPreset(), runtimeCache: runtimeCache, raceState: BlockKartRaceStateReady, totalLaps: raceLapCount, lap: 1}
	prof.Mark("alloc")
	w.checkpointPosition = w.startPosition
	w.checkpointLabel = "Start"
	w.nextGateLabel = "Gate 1"
	w.configureScene()
	prof.Mark("configureScene")
	if err := w.loadAssets(g.Assets); err != nil {
		blockKartReportWorldDiagnostics(g, BlockKartLifecycleFailed, "loadAssets", "loadAssetsFailed", w)
		w.Close()
		return nil, blockKartNewFailureReport(BlockKartLifecycleFailed, "loadAssets", BlockKartOwnerBlockKart, BlockKartSubsystemAsset, err.Error(), "BlockKart could not load its game assets. Please try again.")
	}
	prof.Mark("loadAssets")
	w.loadModels()
	prof.Mark("loadModels")
	if err := w.buildLevel(); err != nil {
		blockKartReportWorldDiagnostics(g, BlockKartLifecycleFailed, "buildLevel", "buildLevelFailed", w)
		w.Close()
		return nil, blockKartNewFailureReport(BlockKartLifecycleFailed, "buildLevel", BlockKartOwnerBlockKart, BlockKartSubsystemMap, err.Error(), "BlockKart could not prepare its track. Please try again.")
	}
	prof.Mark("buildLevel")
	w.setupRacingInput(g)
	prof.Mark("setupRacingInput")
	w.spawnPlayer()
	prof.Mark("spawnPlayer")
	w.setupVehicleAudio()
	prof.Mark("setupVehicleAudio")
	w.setupCamera()
	prof.Mark("setupCamera")
	w.restartRun()
	prof.Mark("restartRun")
	return w, nil
}

func (w *World) configureScene() {
	applyWorldTheme(w.theme, w.scene, w.settings)
}

func (w *World) setupRacingInput(g *voplay.GameCtx) {
	if g == nil || g.Input == nil {
		return
	}
	profile := scene3d.NewRacingInputProfile(g.Input)
	profile.Rebind(scene3d.RacingActionDrift, voplay.KeyBinding("Space"), voplay.KeyBinding(" "), voplay.GamepadButtonBinding(profile.Gamepad, "right_shoulder"))
	profile.Rebind(scene3d.RacingActionBoost, voplay.KeyBinding("Shift"), voplay.GamepadButtonBinding(profile.Gamepad, "south"))
	w.racingInput = profile
}

func (w *World) loadModels() {
	w.cubeModel = scene3d.CubeMesh()
}

func loadTextureAsset(assets *voplay.Assets, rel string) (voplay.TextureID, error) {
	return assets.Texture(blockKartAssetPath(rel))
}

func loadAudioAsset(assets *voplay.Assets, rel string) (voplay.AudioClipID, error) {
	return assets.Audio(blockKartAssetPath(rel))
}

func (w *World) loadAssets(assets *voplay.Assets) error {
	if assets == nil {
		return errors.New("BlockKart assets unavailable")
	}
	w.assets = assets
	if w.runtimeCache != nil {
		skybox, err := w.runtimeCache.EnsureLoaded(assets)
		if err != nil {
			return err
		}
		w.scene.Skybox = skybox
		w.assetGroup = worldAssetGroup
		w.assetGroupOwnedByRuntime = true
		return nil
	}
	packErr := assets.Mount(blockKartAssetPath("blockkart.vpak"), 100)
	if packErr != nil {
		return errors.New("BlockKart asset pack mount failed: " + packErr.Error())
	}
	assets.BeginGroup(worldAssetGroup)
	skybox, err := loadSkybox(assets)
	if err == nil {
		w.scene.Skybox = skybox
	}
	assets.EndGroup()
	if err != nil {
		assets.ReleaseGroup(worldAssetGroup)
		return errors.New("BlockKart skybox load failed: " + err.Error())
	}
	w.assetGroup = worldAssetGroup
	return nil
}

func loadSkybox(assets *voplay.Assets) (voplay.CubemapID, error) {
	return assets.Cubemap(blockKartAssetPath("skybox/right.png"), blockKartAssetPath("skybox/left.png"), blockKartAssetPath("skybox/top.png"), blockKartAssetPath("skybox/bottom.png"), blockKartAssetPath("skybox/front.png"), blockKartAssetPath("skybox/back.png"))
}

func blockKartAssetPath(rel string) string {
	return "assets/" + rel
}

func (w *World) spawnPlayer() {
	w.player = w.scene.Spawn(scene3d.EntityDesc{Position: w.startPosition, Rotation: w.kartRotation(), Scale: voplay.Vec3{X: 1, Y: 1, Z: 1}, Tag: "kart_physics", Physics: &scene3d.Physics{Type: scene3d.Dynamic, Collider: scene3d.Box(0.78, 0.24, 1.16), Layer: voplay.CollisionLayerDefault, Mask: voplay.CollisionMaskAll, Density: 70.0, Friction: 0.25, Restitution: 0.02, LinearDamping: 0.12, AngularDamping: 3.5, LockRotationX: true, LockRotationZ: true}})
	w.player.Visible = false
	controllerConfig := w.tuning.KartControllerConfig()
	w.vehicle = scene3d.NewVehicle(w.player, controllerConfig.Vehicle)
	w.kartController = scene3d.NewKartController(w.vehicle, w.track, controllerConfig)
	w.vehicle.SetPose(w.startPosition, w.startYaw)
	w.primeIdleStartPhysicsSleep()
	w.resetKartRenderPose(w.startPosition, w.kartRotation())
	w.spawnKartVisuals()
	w.syncKartVisuals()
}

func (w *World) primeIdleStartPhysicsSleep() {
	if w.vehicle == nil {
		return
	}
	w.vehicle.Grounded = true
	w.physicsIdleFrames = kartPhysicsIdleSleepWarmupFrames
}

func (w *World) spawnKartVisuals() {
	w.spawnPrimitiveKartVisuals()
}

func (w *World) setupCamera() {
	w.camera = scene3d.NewRacingCamera()
	w.camera.BaseDistance = 22.4
	w.camera.MaxDistance = 33.0
	w.camera.Height = 9.8
	w.camera.TargetHeight = 1.95
	w.camera.LookaheadBase = 16.2
	w.camera.LookaheadSpeedScale = 0.14
	w.camera.DistanceSpeedScale = 0.055
	w.camera.DriftOffset = 1.45
	w.camera.Smoothing = 5.8
	w.camera.TargetSmoothing = 7.2
	w.camera.Fov = 61
	w.camera.SpeedFov = 0.026
	w.camera.BoostFovKick = 3.2
	w.camera.CollisionEnabled = false
	w.camera.CollisionOffset = 0.72
	w.updateRacingCamera(0, false)
}

func (w *World) setupVehicleAudio() {
	if w.assets == nil || w.player == nil {
		return
	}
	w.assets.BeginGroup(worldAssetGroup)
	engine, engineErr := loadAudioAsset(w.assets, "audio/kart_engine.wav")
	skid, skidErr := loadAudioAsset(w.assets, "audio/kart_skid.wav")
	boost, boostErr := loadAudioAsset(w.assets, "audio/kart_boost.wav")
	surface, surfaceErr := loadAudioAsset(w.assets, "audio/kart_grass.wav")
	collision, collisionErr := loadAudioAsset(w.assets, "audio/kart_hit.wav")
	w.assets.EndGroup()
	if engineErr != nil || skidErr != nil || boostErr != nil || surfaceErr != nil || collisionErr != nil {
		return
	}
	config := scene3d.DefaultVehicleAudioConfig()
	config.EngineMaxSpeed = 38
	config.EngineMinVolume = 0.16
	config.EngineMaxVolume = 0.64
	config.SkidMaxVolume = 0.52
	config.BoostVolume = 0.42
	config.SurfaceVolume = 0.28
	audio, err := scene3d.AttachVehicleAudio(w.player, scene3d.VehicleAudioClips{Engine: engine, Skid: skid, Boost: boost, Surface: surface, Collision: collision}, config)
	if err == nil {
		w.vehicleAudio = audio
	}
}

func (w *World) FixedUpdate(g *voplay.GameCtx, dt float64, debugOverlayVisible bool) {
	profileFixedStep := debugOverlayVisible || blockKartFixedPhaseConsoleReports || blockKartPerfReports
	fixedStart := time.Time{}
	phaseStart := time.Time{}
	phaseStats := BlockKartFixedPhaseStats{}
	if profileFixedStep {
		fixedStart = time.Now()
		phaseStart = fixedStart
	}
	w.updateTouchControls(g)
	if profileFixedStep {
		now := time.Now()
		phaseStats.TouchMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	if w.touchResetPressed {
		w.restartRun()
		blockKartReportWorldDiagnostics(g, BlockKartLifecycleRunning, "race", "raceRestart", w)
		if profileFixedStep {
			now := time.Now()
			phaseStats.ResetMs = blockKartElapsedMs(phaseStart, now)
			phaseStats.TotalMs = blockKartElapsedMs(fixedStart, now)
			w.fixedProfiler.Record(phaseStats)
		}
		return
	}
	if w.raceState == BlockKartRaceStateReady {
		if w.shouldStartRace(g) {
			w.startRace(g)
		} else {
			w.updateIdleVehicleAudio()
			if profileFixedStep {
				now := time.Now()
				phaseStats.AudioMs = blockKartElapsedMs(phaseStart, now)
				phaseStats.TotalMs = blockKartElapsedMs(fixedStart, now)
				w.fixedProfiler.Record(phaseStats)
			}
			return
		}
	}
	w.updateGameplay(g, dt)
	if profileFixedStep {
		now := time.Now()
		phaseStats.GameplayMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	if w.finished {
		w.reportRaceResultOnce(g)
		w.updateIdleVehicleAudio()
		if profileFixedStep {
			now := time.Now()
			phaseStats.AudioMs = blockKartElapsedMs(phaseStart, now)
			phaseStats.TotalMs = blockKartElapsedMs(fixedStart, now)
			w.fixedProfiler.Record(phaseStats)
		}
		return
	}
	w.applyKartDrive(g, dt)
	if profileFixedStep {
		now := time.Now()
		phaseStats.DriveMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	w.applyKartRoadEdgeAssist(dt)
	if profileFixedStep {
		now := time.Now()
		phaseStats.AssistMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	shouldSleep := w.shouldSleepKartPhysics()
	if profileFixedStep {
		now := time.Now()
		phaseStats.SleepMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	if shouldSleep {
		w.physicsIdleFrames++
		if w.physicsIdleFrames >= kartPhysicsIdleSleepWarmupFrames {
			w.updateVehicleAudio()
			if profileFixedStep {
				now := time.Now()
				phaseStats.Slept = true
				phaseStats.AudioMs = blockKartElapsedMs(phaseStart, now)
				phaseStats.TotalMs = blockKartElapsedMs(fixedStart, now)
				w.fixedProfiler.Record(phaseStats)
			}
			return
		}
	} else {
		w.physicsIdleFrames = 0
	}
	w.beginKartPhysicsStep()
	w.scene.StepAndSyncPhysics(dt)
	if profileFixedStep {
		now := time.Now()
		phaseStats.PhysicsMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	w.resolveKartRoadEdgeAssistPose()
	w.endKartPhysicsStep()
	if profileFixedStep {
		now := time.Now()
		phaseStats.ResolveMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	w.updateVehicleAudio()
	if profileFixedStep {
		now := time.Now()
		phaseStats.AudioMs = blockKartElapsedMs(phaseStart, now)
		phaseStart = now
	}
	if w.player.Position().Y < playerResetY {
		w.respawnAtCheckpoint()
	}
	if profileFixedStep {
		now := time.Now()
		phaseStats.ResetMs = blockKartElapsedMs(phaseStart, now)
		phaseStats.TotalMs = blockKartElapsedMs(fixedStart, now)
		w.fixedProfiler.Record(phaseStats)
	}
}

func (w *World) shouldStartRace(g *voplay.GameCtx) bool {
	if w == nil {
		return false
	}
	if w.touchInputActive && w.touchInput.Throttle > 0.05 {
		return true
	}
	if g == nil || g.Actions == nil {
		return false
	}
	return g.Actions.IsPressed("start") || g.Actions.IsDown("start")
}

func (w *World) startRace(g *voplay.GameCtx) {
	if w == nil || w.raceState != BlockKartRaceStateReady {
		return
	}
	w.raceState = BlockKartRaceStateRunning
	w.message = "Go!"
	w.messageTimer = 1.1
	blockKartReportWorldDiagnostics(g, BlockKartLifecycleRunning, "race", "raceStart", w)
}

func (w *World) reportRaceResultOnce(g *voplay.GameCtx) {
	if w == nil || w.raceResultReported {
		return
	}
	w.raceResultReported = true
	blockKartReportWorldDiagnostics(g, BlockKartLifecycleRunning, "race", "raceFinished", w)
}

func (w *World) applyKartDrive(g *voplay.GameCtx, dt float64) {
	if w.vehicle == nil {
		return
	}
	if w.racingInput == nil {
		w.setupRacingInput(g)
	}
	input := scene3d.RacingInput{}
	if w.racingInput != nil {
		input = w.racingInput.Read()
	}
	if w.touchInputActive {
		input = mergeRacingInput(input, w.touchInput)
	}
	intent := input.VehicleIntent()
	boosting := w.boostTimer > 0 || input.Boost
	intent.BoostRequest = boosting
	w.lastVehicleIntent = intent
	w.lastSteer = input.Steer
	if w.kartController != nil {
		state := w.kartController.UpdateIntentFromSyncedState(intent, dt)
		w.lastControllerState = state
		if state.SuperTurboReleased {
			w.boostTimer = maxFloat(w.boostTimer, kartSuperTurboDuration)
			w.message = "Super mini-turbo!"
			w.messageTimer = 0.95
		} else if state.MiniTurboReleased {
			w.boostTimer = maxFloat(w.boostTimer, kartMiniTurboDuration)
			w.message = "Mini-turbo!"
			w.messageTimer = 0.82
		}
		if state.ShouldRespawn {
			w.respawnAtCheckpoint()
		}
		w.drifting = state.Drifting
		w.driftCharge = state.DriftCharge
		w.kartYaw = w.vehicle.Yaw
		w.kartSpeed = w.vehicle.Speed
		return
	}
	w.vehicle.UpdateIntent(intent, dt)
	w.drifting = w.vehicle.Drifting
	w.driftCharge = 0
	w.kartYaw = w.vehicle.Yaw
	w.kartSpeed = w.vehicle.Speed
}

func (w *World) shouldSleepKartPhysics() bool {
	if w.player == nil || w.vehicle == nil {
		return false
	}
	if w.boostTimer > 0 || w.drifting || w.roadEdgeAssistActive {
		return false
	}
	intent := w.lastVehicleIntent.Normalized()
	if intent.Throttle > 0.001 || intent.Brake > 0.001 || math.Abs(intent.Steering) > 0.001 || intent.Drift || intent.BoostRequest {
		return false
	}
	if math.Abs(w.kartSpeed) > 0.05 {
		return false
	}
	if !w.vehicle.Grounded && w.physicsIdleFrames < kartPhysicsIdleSleepWarmupFrames {
		return false
	}
	if w.player.Velocity().LengthSq() > kartPhysicsIdleLinearSleepSpeedSq {
		return false
	}
	if w.player.AngularVelocity().LengthSq() > kartPhysicsIdleAngularSleepSpeedSq {
		return false
	}
	return true
}

func (w *World) applyKartRoadEdgeAssist(dt float64) {
	if dt <= 0 || w.track == nil || w.player == nil || w.vehicle == nil {
		w.roadEdgeAssistActive = false
		return
	}
	pos := w.player.Position()
	sample, ok := w.sampleRoadEdgeAssist(pos)
	if !ok {
		w.roadEdgeAssistActive = false
		return
	}
	if sample.LateralAbs <= sample.AssistStart {
		w.roadEdgeAssistActive = false
		return
	}
	enteringAssist := !w.roadEdgeAssistActive
	w.roadEdgeAssistActive = true
	t := clampFloat((sample.LateralAbs - sample.AssistStart) / kartRoadEdgeAssistSoftZone, 0, 1)
	strength := t * t * (3 - 2 * t)
	vel := w.player.Velocity()
	outwardSpeed := vel.Dot(sample.Right) * sample.Side
	if outwardSpeed > 0 {
		vel = vel.Sub(sample.Right.Scale(sample.Side * outwardSpeed * kartRoadEdgeAssistOutwardDamping * strength))
	}
	inwardSpeed := vel.Dot(sample.Inward)
	targetInwardSpeed := kartRoadEdgeAssistMaxPushSpeed * strength
	if enteringAssist && targetInwardSpeed < kartRoadEdgeAssistImpactSpeed {
		targetInwardSpeed = kartRoadEdgeAssistImpactSpeed
	}
	if inwardSpeed < targetInwardSpeed {
		blend := clampFloat(kartRoadEdgeAssistVelocityBlend * dt, 0, 1)
		vel = vel.Add(sample.Inward.Scale((targetInwardSpeed - inwardSpeed) * blend))
	}
	w.player.SetVelocity(vel)
	corrected := pos
	changed := false
	penetration := sample.LateralAbs - sample.EdgeHalfWidth
	if penetration > 0 {
		correction := clampFloat(penetration * kartRoadEdgeAssistPositionBlend * dt, 0, kartRoadEdgeAssistMaxCorrection)
		if correction > 0 {
			corrected = corrected.Add(sample.Inward.Scale(correction))
			changed = true
		}
	}
	if sample.LateralAbs > sample.EdgeHalfWidth + kartRoadEdgeAssistSnapOverflow {
		corrected = sample.Point.Position.Add(sample.Right.Scale(sample.Side * (sample.EdgeHalfWidth - kartRoadEdgeAssistSoftZone * 0.45)))
		corrected.Y = pos.Y
		changed = true
	}
	lifted := false
	corrected, lifted = w.liftKartAboveRoadEdge(corrected, sample)
	if changed || lifted {
		w.player.SetPosition(corrected)
	}
}

func (w *World) resolveKartRoadEdgeAssistPose() {
	if w.track == nil || w.player == nil {
		return
	}
	pos := w.player.Position()
	sample, ok := w.sampleRoadEdgeAssist(pos)
	if !ok || sample.LateralAbs <= sample.AssistStart {
		return
	}
	corrected := pos
	changed := false
	if sample.LateralAbs > sample.EdgeHalfWidth {
		correction := clampFloat(sample.LateralAbs - sample.EdgeHalfWidth, 0, kartRoadEdgeAssistPostMaxCorrection)
		if correction > 0 {
			corrected = corrected.Add(sample.Inward.Scale(correction))
			changed = true
		}
	}
	lifted := false
	corrected, lifted = w.liftKartAboveRoadEdge(corrected, sample)
	if changed || lifted {
		w.player.SetPosition(corrected)
	}
}

func (w *World) liftKartAboveRoadEdge(pos voplay.Vec3, sample roadEdgeAssistSample) (voplay.Vec3, bool) {
	minY := roadEdgeAssistMinY(sample)
	if pos.Y >= minY {
		return pos, false
	}
	pos.Y = minY
	w.clearKartDownwardVelocity()
	return pos, true
}

func roadEdgeAssistMinY(sample roadEdgeAssistSample) float64 {
	return sample.Point.Position.Y + kartSpawnRideHeight + kartRoadEdgeAssistLift
}

func (w *World) clearKartDownwardVelocity() {
	if w.player == nil {
		return
	}
	vel := w.player.Velocity()
	if vel.Y >= 0 {
		return
	}
	vel.Y = 0
	w.player.SetVelocity(vel)
}

func (w *World) sampleRoadEdgeAssist(pos voplay.Vec3) (roadEdgeAssistSample, bool) {
	if w.track == nil {
		return roadEdgeAssistSample{}, false
	}
	cp := w.track.ClosestPoint(pos)
	if cp.HalfWidth <= kartRoadEdgeAssistCenterInset || cp.Right.LengthSq() == 0 {
		return roadEdgeAssistSample{}, false
	}
	right := cp.Right
	right.Y = 0
	if right.LengthSq() == 0 {
		return roadEdgeAssistSample{}, false
	}
	right = right.Normalize()
	side := 1.0
	if cp.LateralDistance < 0 {
		side = -1.0
	}
	edgeHalfWidth := cp.HalfWidth - kartRoadEdgeAssistCenterInset
	return roadEdgeAssistSample{Point: cp, Right: right, Inward: right.Scale(-side), EdgeHalfWidth: edgeHalfWidth, AssistStart: edgeHalfWidth - kartRoadEdgeAssistSoftZone, LateralAbs: math.Abs(cp.LateralDistance), Side: side}, true
}

func (w *World) kartRotation() voplay.Quat {
	if w.vehicle != nil {
		return w.vehicle.Rotation()
	}
	return voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, w.kartYaw)
}

func (w *World) setKartPose(position voplay.Vec3, yaw float64) {
	w.kartYaw = yaw
	w.kartSpeed = 0
	w.roadEdgeAssistActive = false
	w.physicsIdleFrames = 0
	if w.kartController != nil {
		w.kartController.Respawn(scene3d.TrackPose{Position: position, Yaw: yaw})
		w.primeIdleStartPhysicsSleep()
		w.resetKartRenderPose(position, w.kartRotation())
		w.drifting = false
		w.syncKartVisuals()
		return
	}
	if w.vehicle != nil {
		w.vehicle.SetPose(position, yaw)
		w.primeIdleStartPhysicsSleep()
		w.resetKartRenderPose(position, w.kartRotation())
		w.drifting = false
		w.syncKartVisuals()
		return
	}
	if w.player != nil {
		w.player.SetPosition(position)
		w.player.SetRotation(w.kartRotation())
		w.player.SetVelocity(voplay.Vec3{})
	}
	w.resetKartRenderPose(position, w.kartRotation())
	w.syncKartVisuals()
}

func (w *World) stopKartForFinish() {
	w.boostTimer = 0
	w.driftCharge = 0
	w.drifting = false
	w.kartSpeed = 0
	w.roadEdgeAssistActive = false
	if w.player != nil {
		w.player.SetVelocity(voplay.Vec3{})
		w.player.SetAngularVelocity(voplay.Vec3{})
		w.resetKartRenderPose(w.player.Position(), w.kartRotation())
	}
	if w.vehicle != nil {
		w.vehicle.Speed = 0
		w.vehicle.SteerAngle = 0
		w.vehicle.WheelSpin = 0
		w.vehicle.Drifting = false
	}
	if w.kartController != nil {
		position := w.checkpointPosition
		if w.player != nil {
			position = w.player.Position()
		} else if w.vehicle != nil && w.vehicle.Body != nil {
			position = w.vehicle.Body.Position()
		}
		w.kartController.Respawn(scene3d.TrackPose{Position: position, Yaw: w.kartYaw})
	}
}

func (w *World) activateBoost(duration float64) {
	if duration > w.boostTimer {
		w.boostTimer = duration
	}
	if w.kartController != nil {
		w.kartController.ActivateBoost(duration)
	}
}

func (w *World) syncKartVisuals() {
	if w.player == nil {
		return
	}
	pos := w.player.Position()
	rot := w.kartVisualRotation()
	w.syncKartVisualsAt(pos, rot)
}

func (w *World) syncKartVisualsAt(pos voplay.Vec3, rot voplay.Quat) {
	if w.kartChassisPrimitive != nil {
		w.syncPrimitiveKartVisuals(pos, rot)
	}
}

func (w *World) updateVehicleAudio() {
	if w.vehicleAudio == nil {
		return
	}
	input := scene3d.VehicleAudioInputFromVehicle(w.vehicle)
	input.Boost = w.isBoosting()
	if w.kartController != nil {
		state := w.kartController.State()
		if state.SurfaceID != "" {
			if !state.SurfaceOnRoad {
				input.SurfaceAmount = 1
			}
			w.vehicleAudio.Update(input)
			return
		}
	}
	if w.track != nil && w.player != nil {
		surface := w.track.SurfaceAt(w.player.Position())
		if !surface.OnRoad {
			input.SurfaceAmount = 1
		}
	}
	w.vehicleAudio.Update(input)
}

func (w *World) updateIdleVehicleAudio() {
	if w.vehicleAudio == nil {
		return
	}
	w.vehicleAudio.Update(scene3d.VehicleAudioInput{})
}

func (w *World) kartVisualRotation() voplay.Quat {
	if w.vehicle != nil {
		return w.vehicle.VisualRotation()
	}
	return w.kartRotation()
}

func blockKartElapsedMs(start time.Time, end time.Time) float64 {
	return float64(end.Sub(start).Nanoseconds()) / 1000000.0
}

type blockKartStartupProfiler struct {
	label string
	start time.Time
	last time.Time
}

func newBlockKartStartupProfiler(label string) *blockKartStartupProfiler {
	now := time.Now()
	return &blockKartStartupProfiler{label: label, start: now, last: now}
}

func (p *blockKartStartupProfiler) Mark(phase string) {
	if p == nil || !blockKartPerfReports {
		return
	}
	now := time.Now()
	println(p.label + " startup phase=" + phase + " delta=" + formatHudMs(blockKartElapsedMs(p.last, now)) + " total=" + formatHudMs(blockKartElapsedMs(p.start, now)))
	p.last = now
}

func moveTowardsFloat(current, target, maxDelta float64) float64 {
	if maxDelta <= 0 {
		return current
	}
	if current < target {
		current += maxDelta
		if current > target {
			return target
		}
		return current
	}
	current -= maxDelta
	if current < target {
		return target
	}
	return current
}

func clampFloat(v, lo, hi float64) float64 {
	if v < lo {
		return lo
	}
	if v > hi {
		return hi
	}
	return v
}

func (w *World) Update(g *voplay.GameCtx, dt float64, debugOverlayVisible bool) {
	w.updateKartRenderPose(g.Alpha)
	w.updateRacingCamera(dt, debugOverlayVisible)
	w.scene.UpdateAudio()
	w.scene.UpdateEmitters(dt)
	w.scene.TickAnimations(dt)
	if debugOverlayVisible && w.racingDebugOverlay != nil {
		w.racingDebugOverlay.Update(w.scene)
	}
}

func (w *World) updateRacingCamera(dt float64, debugOverlayVisible bool) {
	if w.camera == nil || w.scene == nil {
		return
	}
	if w.terrainCameraView > 0 {
		w.updateTerrainCaptureCamera()
		return
	}
	if w.heroCameraVisible {
		w.updateHeroInspectionCamera()
		return
	}
	target := scene3d.RacingCameraTarget{Position: w.startPosition, Forward: voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, w.startYaw).RotateVec3(voplay.Vec3{Z: -1})}
	if w.vehicle != nil {
		target = scene3d.RacingCameraTargetFromVehicle(w.vehicle)
		if sample, ok := w.kartRenderPose.RenderSample(); ok {
			target.Position = sample.Position
			target.Forward = sample.Rotation.RotateVec3(voplay.Vec3{Z: -1})
			target.Velocity = sample.Velocity
			target.Speed = sample.Speed
		}
		target.Position = w.stabilizedCameraTargetPosition(target.Position)
	}
	target.Boost = w.isBoosting()
	if w.drifting {
		target.Drift = w.lastSteer
	}
	if debugOverlayVisible {
		w.cameraTelemetry.Record(target, dt)
	}
	w.camera.UpdateCamera(&w.scene.Camera, w.scene, target, dt)
}

func (w *World) stabilizedCameraTargetPosition(position voplay.Vec3) voplay.Vec3 {
	if w.track == nil {
		return position
	}
	point := w.track.ClosestPoint(position)
	pose := w.track.PoseAt(point.Distance)
	minY := pose.Position.Y + kartSpawnRideHeight
	if position.Y < minY {
		position.Y = minY
	}
	return position
}

func (w *World) beginKartPhysicsStep() {
	if w.player == nil {
		return
	}
	if !w.kartRenderPose.Initialized() {
		w.resetKartRenderPose(w.player.Position(), w.kartVisualRotation())
		return
	}
	w.kartRenderPose.BeginStep()
}

func (w *World) endKartPhysicsStep() {
	if w.player == nil {
		return
	}
	pos := w.player.Position()
	rot := w.kartVisualRotation()
	vel := w.player.Velocity()
	speed := w.currentKartRenderSpeed()
	sample := NewKartRenderSample(pos, rot, vel, speed)
	if !w.kartRenderPose.Initialized() {
		w.resetKartRenderPose(pos, rot)
		return
	}
	w.kartRenderPose.Commit(sample)
}

func (w *World) resetKartRenderPose(pos voplay.Vec3, rot voplay.Quat) {
	sample := w.kartRenderPose.Reset(pos, rot)
	w.syncKartVisualsAt(sample.Position, sample.Rotation)
	w.cameraTelemetry.ResetAnchor()
}

func (w *World) updateKartRenderPose(alpha float64) {
	if w.player == nil {
		return
	}
	if !w.kartRenderPose.Initialized() {
		w.resetKartRenderPose(w.player.Position(), w.kartVisualRotation())
	}
	sample := w.kartRenderPose.Interpolate(alpha)
	w.syncKartVisualsAt(sample.Position, sample.Rotation)
}

func (w *World) currentKartRenderSpeed() float64 {
	if w.vehicle != nil {
		return w.vehicle.Speed
	}
	return w.kartSpeed
}

func (w *World) updateHeroInspectionCamera() {
	if w.scene == nil {
		return
	}
	target := voplay.Vec3{X: 76, Y: 5.4, Z: 113}
	position := voplay.Vec3{X: 91, Y: 10.2, Z: 98}
	if w.track != nil {
		pose := w.track.PoseAt(48)
		target = pose.Position.Sub(pose.Right.Scale(pose.HalfWidth + 34.0)).Add(voplay.Vec3{Y: 4.8})
		position = target.Add(pose.Right.Scale(24.0)).Sub(pose.Forward.Scale(32.0)).Add(voplay.Vec3{Y: 27.0})
	}
	w.scene.Camera.LookAt(position, target)
	w.scene.Camera.Fov = 42
}

func (w *World) CycleTerrainCameraView() int {
	w.terrainCameraView++
	if w.terrainCameraView > 4 {
		w.terrainCameraView = 0
	}
	return w.terrainCameraView
}

func (w *World) updateTerrainCaptureCamera() {
	if w.scene == nil {
		return
	}
	if w.track == nil {
		w.scene.Camera.LookAt(voplay.Vec3{X: 0, Y: 58, Z: 96}, voplay.Vec3{X: 0, Y: 0, Z: 0})
		w.scene.Camera.Fov = 48
		return
	}
	start := w.track.DistanceAlongTrack(w.startPosition)
	length := w.track.Length()
	if length <= 0 {
		length = 1
	}
	if w.terrainCameraView == 1 {
		target := voplay.Vec3{X: 0, Y: 0.0, Z: 1}
		position := voplay.Vec3{X: 0, Y: 950, Z: 0}
		w.scene.Camera.LookAt(position, target)
		w.scene.Camera.Fov = 62
		return
	}
	if w.terrainCameraView == 2 {
		pose := w.track.PoseAt(start + length * 0.02)
		target := pose.Position.Add(pose.Forward.Scale(92)).Add(voplay.Vec3{Y: 5.0})
		position := pose.Position.Sub(pose.Forward.Scale(178)).Sub(pose.Right.Scale(34)).Add(voplay.Vec3{Y: 104})
		w.scene.Camera.LookAt(position, target)
		w.scene.Camera.Fov = 54
		return
	}
	if w.terrainCameraView == 3 {
		target := voplay.Vec3{X: 12, Y: 1.6, Z: -8}
		position := voplay.Vec3{X: 440, Y: 185, Z: 305}
		w.scene.Camera.LookAt(position, target)
		w.scene.Camera.Fov = 56
		return
	}
	target := voplay.Vec3{X: -36, Y: 2.8, Z: 6}
	position := voplay.Vec3{X: -485, Y: 170, Z: 255}
	w.scene.Camera.LookAt(position, target)
	w.scene.Camera.Fov = 55
}

func (w *World) Draw(g *voplay.GameCtx, debugOverlayVisible bool) {
	w.scene.Draw(g.Draw)
	perf := voplay.DebugOverlayStats{}
	if debugOverlayVisible {
		perf = g.DebugOverlayStats()
	}
	perfSnapshot := voplay.PerfSnapshot{}
	if debugOverlayVisible || w.shouldPollPerfSnapshotForConsoleReport() {
		perfSnapshot = g.GetPerfSnapshot()
	}
	if w.perfAnalyzer.ShouldReport(perfSnapshot) {
		w.perfAnalyzer.Report(perfSnapshot, w.fixedProfiler.Stats(), g.Screen)
	}
	if w.terrainCameraView > 0 {
		return
	}
	hud := w.hudState(debugOverlayVisible, perf, perfSnapshot)
	if debugOverlayVisible {
		w.updateDebugHUDLines(&hud, perfSnapshot)
	}
	drawWorldHUD(&w.theme, g, &hud)
	w.touchControls.Draw(g.Draw)
}

func (w *World) shouldPollPerfSnapshotForConsoleReport() bool {
	if !blockKartPerfReports {
		return false
	}
	w.perfSnapshotPollFrame++
	firstReportFrame := blockKartPerfWarmupFrames + blockKartPerfWindowFrames
	if w.perfSnapshotPollFrame < firstReportFrame {
		return false
	}
	return (w.perfSnapshotPollFrame - firstReportFrame) % blockKartPerfSnapshotPollFrames == 0
}

func (w *World) PrepareRender(g *voplay.GameCtx) {
	if w == nil || w.scene == nil || g == nil || g.Draw == nil {
		return
	}
	w.scene.Prepare(g.Draw)
}

func (w *World) updateTouchControls(g *voplay.GameCtx) {
	snapshot := w.touchControls.Read(g)
	w.touchInput = snapshot.Input
	w.touchInputActive = snapshot.Active
	w.touchResetPressed = snapshot.ResetPressed
}

func (w *World) resetPlayer() {
	w.respawnAtCheckpoint()
}

func (w *World) hudState(debugOverlayVisible bool, perf voplay.DebugOverlayStats, perfSnapshot voplay.PerfSnapshot) WorldHUDState {
	if w.vehicle != nil {
		w.kartSpeed = w.vehicle.Speed
	}
	renderDebugMode := scene3d.RenderDebugLit
	stats := scene3d.SceneRenderStats{}
	primitiveInstances := 0
	primitiveVisibleInstances := 0
	primitiveChunks := 0
	primitiveVisibleChunks := 0
	primitiveGroups := 0
	primitiveDrawCalls := 0
	primitiveUploadBytes := 0
	if w.scene != nil {
		renderDebugMode = w.scene.RenderDebugMode
	}
	if debugOverlayVisible && w.scene != nil {
		stats = w.scene.RenderStats()
		primitiveStats := w.scene.PrimitiveStats()
		primitiveInstances = primitiveStats.TotalInstances
		primitiveVisibleInstances = primitiveStats.VisibleInstances
		primitiveChunks = primitiveStats.TotalChunks
		primitiveVisibleChunks = primitiveStats.VisibleChunks
		primitiveGroups = primitiveStats.ShapeMaterialGroups
		primitiveDrawCalls = primitiveStats.DrawCalls
		primitiveUploadBytes = primitiveStats.UploadBytes
	}
	trackEntities := 0
	if debugOverlayVisible && w.trackResult != nil {
		trackEntities = len(w.trackResult.Entities)
	}
	vehicleGrounded := false
	wheelContacts := 0
	wheelCount := 0
	wheelMaxSlip := 0.0
	wheelMaxCompression := 0.0
	if debugOverlayVisible && w.vehicle != nil {
		vehicleGrounded = w.vehicle.Grounded
		wheelCount = w.vehicle.WheelCount()
		for i := 0; i < wheelCount; i++ {
			state, ok := w.vehicle.WheelState(i)
			if !ok {
				continue
			}
			if state.InContact {
				wheelContacts++
			}
			slip := math.Abs(state.LongitudinalSlip)
			if math.Abs(state.LateralSlip) > slip {
				slip = math.Abs(state.LateralSlip)
			}
			if slip > wheelMaxSlip {
				wheelMaxSlip = slip
			}
			if state.SuspensionCompression > wheelMaxCompression {
				wheelMaxCompression = state.SuspensionCompression
			}
		}
	}
	camera := w.cameraTelemetry.Snapshot()
	hud := WorldHUDState{RaceState: w.raceState, Time: w.courseTime, FinishTime: w.finishTime, BestTime: w.bestTime, BestTimeSet: w.bestTimeSet, Collected: w.collected, TotalCollectibles: len(w.collectibles), Checkpoint: w.checkpointLabel, NextGate: w.nextGateLabel, Lap: w.lap, TotalLaps: w.totalLaps, Speed: math.Abs(w.kartSpeed), Boosting: w.isBoosting(), Drifting: w.drifting, DriftCharge: w.driftCharge, Message: w.message, MessageTimer: w.messageTimer, Finished: w.finished, DebugOverlayVisible: debugOverlayVisible, RenderDebugMode: renderDebugMode, HeroCameraVisible: w.heroCameraVisible, SettingsStorageStatus: w.settings.StorageStatus, PerfFPS: perf.FPS, PerfFrameMs: perf.FrameMs, PerfLogicMs: perf.LogicMs, PerfInputMs: perf.InputMs, PerfAdvanceMs: perf.AdvanceMs, PerfDrawMs: perf.DrawMs, PerfOverlayMs: perf.OverlayMs, PerfBudgetMs: perf.FrameBudgetMs, PerfMaxFrameMs: perf.MaxFrameMs, PerfMaxLogicMs: perf.MaxLogicMs, PerfDrawBytes: perf.DrawBytes, PerfSubmitBytes: perf.SubmitBytes, PerfFixedSteps: perf.FixedSteps, PerfSlowFrames: perf.SlowFrames, PerfSlowLogs: perf.SlowLogs, PerfWorkSlowFrames: perf.WorkSlowFrames, PerfWorkSlowLogs: perf.WorkSlowLogs, PerfLastSlowReason: perf.LastSlowReason, PerfLastSlowFrameMs: perf.LastSlowFrameMs, PerfLastSlowLogicMs: perf.LastSlowLogicMs, PerfLastWorkSlowReason: perf.LastWorkSlowReason, PerfLastWorkSlowFrameMs: perf.LastWorkSlowFrameMs, PerfLastWorkSlowLogicMs: perf.LastWorkSlowLogicMs, PerfWindowFrames: perf.WindowFrames, PerfWindowSlowFrames: perf.WindowSlowFrames, PerfWindowLastSlowGapFrames: perf.WindowLastSlowGapFrames, PerfWindowLastSlowGapMs: perf.WindowLastSlowGapMs, PerfWindowWorkSlowFrames: perf.WindowWorkSlowFrames, PerfWindowLastWorkSlowGapFrames: perf.WindowLastWorkSlowGapFrames, PerfWindowLastWorkSlowGapMs: perf.WindowLastWorkSlowGapMs, PerfFrameP50Ms: perf.FrameP50Ms, PerfFrameP90Ms: perf.FrameP90Ms, PerfFrameP99Ms: perf.FrameP99Ms, PerfLogicP50Ms: perf.LogicP50Ms, PerfLogicP90Ms: perf.LogicP90Ms, PerfLogicP99Ms: perf.LogicP99Ms, PerfAdvanceP90Ms: perf.AdvanceP90Ms, PerfDrawP90Ms: perf.DrawP90Ms, PerfDrawP99Ms: perf.DrawP99Ms, PerfRenderFrame: perf.RenderFrame, PerfRenderLoopMs: perf.RenderLoopMs, PerfRenderPaceWaitMs: perf.RenderPaceWaitMs, PerfRenderReplyWaitMs: perf.RenderReplyWaitMs, PerfRenderSubmitMs: perf.RenderSubmitMs, PerfRenderDisplayPulseMs: perf.RenderDisplayPulseMs, PerfRenderDrawBytes: perf.RenderDrawBytes, PerfRenderFrameDivisor: perf.RenderFrameDivisor, PerfRenderAttribution: perf.RenderAttribution, PerfRenderWindowFrames: perf.RenderWindowFrames, PerfRenderWindowSlowFrames: perf.RenderWindowSlowFrames, PerfRenderWindowLastSlowGapFrames: perf.RenderWindowLastSlowGapFrames, PerfRenderWindowLastSlowGapMs: perf.RenderWindowLastSlowGapMs, PerfRenderCadenceSlowFrames: perf.RenderCadenceSlowFrames, PerfRenderReplySlowFrames: perf.RenderReplySlowFrames, PerfRenderSubmitSlowFrames: perf.RenderSubmitSlowFrames, PerfRenderUnattributedSlowFrames: perf.RenderUnattributedSlowFrames, PerfRenderLoopP50Ms: perf.RenderLoopP50Ms, PerfRenderLoopP90Ms: perf.RenderLoopP90Ms, PerfRenderLoopP99Ms: perf.RenderLoopP99Ms, PerfRenderPaceWaitP90Ms: perf.RenderPaceWaitP90Ms, PerfRenderReplyWaitP90Ms: perf.RenderReplyWaitP90Ms, PerfRenderSubmitP90Ms: perf.RenderSubmitP90Ms, SceneActive: stats.ActiveEntities, SceneVisible: stats.VisibleEntities, SceneCulled: stats.CulledEntities, SceneModels: stats.ModelEntities, SceneUpserts: stats.UpsertedObjects, SceneDestroyed: stats.DestroyedObjects, SceneBatchEligible: stats.BatchEligibleObjects, SceneBatchGroups: stats.BatchGroups, SceneFlushMs: stats.FlushCpuMs, SceneFrameMs: stats.FrameCpuMs, TrackEntities: trackEntities, PrimitiveInstances: primitiveInstances, PrimitiveVisibleInstances: primitiveVisibleInstances, PrimitiveChunks: primitiveChunks, PrimitiveVisibleChunks: primitiveVisibleChunks, PrimitiveGroups: primitiveGroups, PrimitiveDrawCalls: primitiveDrawCalls, PrimitiveUploadBytes: primitiveUploadBytes, VehicleGrounded: vehicleGrounded, WheelContacts: wheelContacts, WheelCount: wheelCount, WheelMaxSlip: wheelMaxSlip, WheelMaxCompression: wheelMaxCompression, CameraTargetStep: camera.Step, CameraTargetStepMax: camera.StepMax, CameraTargetResidual: camera.Residual, CameraTargetResidualMax: camera.ResidualMax, CameraTargetYStep: camera.YStep, CameraTargetYStepMax: camera.YStepMax, CameraSpeedStep: camera.SpeedStep, CameraSpeedStepMax: camera.SpeedStepMax}
	if debugOverlayVisible {
		blockKartApplyPerfSnapshotToHUD(&hud, perfSnapshot)
	}
	return hud
}

func (w *World) updateDebugHUDLines(hud *WorldHUDState, perfSnapshot voplay.PerfSnapshot) {
	w.debugHudFrame++
	if w.debugHudLineCount == 0 || w.debugHudFrame >= 10 {
		fixed := w.fixedProfiler.Stats()
		w.debugHudFrame = 0
		w.debugHudLineCount = 18
		w.debugHudLines[0] = "F3 perf  fps " + formatHudFloat(hud.PerfFPS, 1) + "  frame " + formatHudMs(hud.PerfFrameMs) + " / budget " + formatHudMs(hud.PerfBudgetMs) + "  logic " + formatHudMs(hud.PerfLogicMs)
		w.debugHudLines[1] = "slow " + itoa(hud.PerfSlowFrames) + " logs " + itoa(hud.PerfSlowLogs) + " work " + itoa(hud.PerfWorkSlowFrames) + " logs " + itoa(hud.PerfWorkSlowLogs)
		w.debugHudLines[2] = "max frame " + formatHudMs(hud.PerfMaxFrameMs) + "  max logic " + formatHudMs(hud.PerfMaxLogicMs) + "  fixed steps " + itoa(hud.PerfFixedSteps) + "  bytes " + formatHudBytes(hud.PerfDrawBytes)
		w.debugHudLines[3] = "BK fixed last/peak " + formatHudMs(fixed.TotalMs) + "/" + formatHudMs(fixed.PeakTotalMs) + "  slow " + itoa(fixed.WindowSlowFrames) + "/" + itoa(fixed.WindowFrames) + "  worst " + fixed.SlowestPhase + ":" + formatHudMs(fixed.SlowestPhaseMs)
		w.debugHudLines[4] = "BK phase touch/game/drive/assist/phys/audio " + formatHudMs(fixed.TouchMs) + "/" + formatHudMs(fixed.GameplayMs) + "/" + formatHudMs(fixed.DriveMs) + "/" + formatHudMs(fixed.AssistMs) + "/" + formatHudMs(fixed.PhysicsMs) + "/" + formatHudMs(fixed.AudioMs) + " slept " + boolHud(fixed.Slept)
		w.debugHudLines[5] = "engine phase input/advance/draw/overlay " + formatHudMs(hud.PerfInputMs) + "/" + formatHudMs(hud.PerfAdvanceMs) + "/" + formatHudMs(hud.PerfDrawMs) + "/" + formatHudMs(hud.PerfOverlayMs)
		if perfSnapshot.Enabled {
			window := blockKartPerfReportingWindow(perfSnapshot)
			current := perfSnapshot.Current
			workload := current.RendererWorkload
			gpu := current.GpuQueue
			w.debugHudLines[6] = "perf frame p50/90/99/max " + formatHudMs(window.FrameP50Ms) + "/" + formatHudMs(window.FrameP90Ms) + "/" + formatHudMs(window.FrameP99Ms) + "/" + formatHudMs(window.FrameMaxMs) + "  slow " + itoa(window.SlowFrames) + "/" + itoa(window.Frames)
			w.debugHudLines[7] = "perf p90 game/draw/render/gpu/hud " + formatHudMs(window.GameCpuP90Ms) + "/" + formatHudMs(window.DrawEncodeP90Ms) + "/" + formatHudMs(window.RenderSubmitP90Ms) + "/" + formatHudMs(window.GpuWorkDoneP90Ms) + "/" + formatHudMs(window.HudP90Ms)
			w.debugHudLines[8] = "perf cause " + current.Classification.PrimaryCause + "  secondary " + current.Classification.SecondaryCause + "  queue " + gpu.QueueDepthClass
			w.debugHudLines[9] = "gpu now work/inflight/probe " + formatHudMs(gpu.SubmittedWorkDoneMs) + "/" + itoa(gpu.InFlightSubmits) + "/" + formatHudMs(gpu.ProbeOverheadMs) + "  submit " + formatHudMs(current.RendererCpu.QueueSubmitCpuMs)
			w.debugHudLines[10] = "work draws model/prim/sprite/text/batch " + itoa(workload.ModelDraws) + "/" + itoa(workload.PrimitiveDraws) + "/" + itoa(workload.SpriteDraws) + "/" + itoa(workload.TextDraws) + "/" + itoa(workload.InstancedBatches)
			w.debugHudLines[11] = "work inst/tri/upload/chunks " + itoa(workload.Instances) + "/" + itoa(workload.Triangles) + "/" + formatHudBytes(workload.UploadBytes) + "/" + itoa(workload.PrimitiveChunks) + " churn " + itoa(workload.BufferCreates) + "/" + itoa(workload.BindGroupCreates) + "/" + itoa(workload.TextureUploads)
		} else {
			w.debugHudLines[6] = "240f frame p50/90/99 " + formatHudMs(hud.PerfFrameP50Ms) + "/" + formatHudMs(hud.PerfFrameP90Ms) + "/" + formatHudMs(hud.PerfFrameP99Ms) + "  slow " + itoa(hud.PerfWindowSlowFrames) + "/" + itoa(hud.PerfWindowFrames) + " gap " + itoa(hud.PerfWindowLastSlowGapFrames) + "/" + formatHudMs(hud.PerfWindowLastSlowGapMs)
			w.debugHudLines[7] = "240f logic p50/90/99 " + formatHudMs(hud.PerfLogicP50Ms) + "/" + formatHudMs(hud.PerfLogicP90Ms) + "/" + formatHudMs(hud.PerfLogicP99Ms) + "  work " + itoa(hud.PerfWindowWorkSlowFrames) + " gap " + itoa(hud.PerfWindowLastWorkSlowGapFrames) + "/" + formatHudMs(hud.PerfWindowLastWorkSlowGapMs)
			w.debugHudLines[8] = "240f advance/draw p90/99 " + formatHudMs(hud.PerfAdvanceP90Ms) + "/" + formatHudMs(hud.PerfDrawP90Ms) + "/" + formatHudMs(hud.PerfDrawP99Ms)
			w.debugHudLines[9] = "render now loop/pace/reply/submit " + formatHudMs(hud.PerfRenderLoopMs) + "/" + formatHudMs(hud.PerfRenderPaceWaitMs) + "/" + formatHudMs(hud.PerfRenderReplyWaitMs) + "/" + formatHudMs(hud.PerfRenderSubmitMs) + "  attr " + hud.PerfRenderAttribution + "  bytes " + formatHudBytes(hud.PerfRenderDrawBytes)
			w.debugHudLines[10] = "render 240f loop p50/90/99 " + formatHudMs(hud.PerfRenderLoopP50Ms) + "/" + formatHudMs(hud.PerfRenderLoopP90Ms) + "/" + formatHudMs(hud.PerfRenderLoopP99Ms) + "  pulse " + formatHudMs(hud.PerfRenderDisplayPulseMs) + " x" + itoa(hud.PerfRenderFrameDivisor)
			w.debugHudLines[11] = "render p90 pace/reply/submit " + formatHudMs(hud.PerfRenderPaceWaitP90Ms) + "/" + formatHudMs(hud.PerfRenderReplyWaitP90Ms) + "/" + formatHudMs(hud.PerfRenderSubmitP90Ms) + "  slow " + itoa(hud.PerfRenderWindowSlowFrames) + "/" + itoa(hud.PerfRenderWindowFrames) + " gap " + itoa(hud.PerfRenderWindowLastSlowGapFrames) + "/" + formatHudMs(hud.PerfRenderWindowLastSlowGapMs) + " c/r/s/u " + itoa(hud.PerfRenderCadenceSlowFrames) + "/" + itoa(hud.PerfRenderReplySlowFrames) + "/" + itoa(hud.PerfRenderSubmitSlowFrames) + "/" + itoa(hud.PerfRenderUnattributedSlowFrames)
		}
		w.debugHudLines[12] = "scene active/visible/culled/model " + itoa(hud.SceneActive) + "/" + itoa(hud.SceneVisible) + "/" + itoa(hud.SceneCulled) + "/" + itoa(hud.SceneModels)
		w.debugHudLines[13] = "scene upsert/destroy/batch/groups " + itoa(hud.SceneUpserts) + "/" + itoa(hud.SceneDestroyed) + "/" + itoa(hud.SceneBatchEligible) + "/" + itoa(hud.SceneBatchGroups)
		w.debugHudLines[14] = "scene cpu flush " + formatHudMs(hud.SceneFlushMs) + "  frame " + formatHudMs(hud.SceneFrameMs) + "  track ents " + itoa(hud.TrackEntities)
		w.debugHudLines[15] = "primitive inst visible/total " + itoa(hud.PrimitiveVisibleInstances) + "/" + itoa(hud.PrimitiveInstances) + "  chunks " + itoa(hud.PrimitiveVisibleChunks) + "/" + itoa(hud.PrimitiveChunks)
		w.debugHudLines[16] = "primitive groups/draws/upload " + itoa(hud.PrimitiveGroups) + "/" + itoa(hud.PrimitiveDrawCalls) + "/" + formatHudBytes(hud.PrimitiveUploadBytes)
		w.debugHudLines[17] = "vehicle grounded " + boolHud(hud.VehicleGrounded) + "  wheels " + itoa(hud.WheelContacts) + "/" + itoa(hud.WheelCount) + "  slip " + formatHudFloat(hud.WheelMaxSlip, 2) + "  comp " + formatHudFloat(hud.WheelMaxCompression, 2)
	}
	hud.DebugLines = w.debugHudLines
	hud.DebugLineCount = w.debugHudLineCount
}

func (w *World) isBoosting() bool {
	if w.boostTimer > 0 {
		return true
	}
	return w.kartController != nil && w.kartController.BoostTimer > 0
}

func (w *World) SetRacingDebugOverlayVisible(visible bool) {
	if !visible {
		w.destroyRacingDebugOverlay()
		return
	}
	if w.racingDebugOverlay != nil {
		w.racingDebugOverlay.Update(w.scene)
		return
	}
	if w.scene == nil || w.track == nil || w.vehicle == nil {
		return
	}
	overlay, err := scene3d.SpawnRacingDebugOverlay(w.scene, w.track, w.vehicle, scene3d.RacingDebugOptions{Model: w.cubeModel, SurfaceMarker: true, Track: scene3d.TrackDebugOptions{Model: w.cubeModel, HeightOffset: 0.55, LineThickness: 0.2}, Vehicle: scene3d.VehicleDebugOptions{Model: w.cubeModel, MarkerSize: 0.35, LineThickness: 0.12}})
	if err == nil {
		w.racingDebugOverlay = overlay
	}
}

func (w *World) SetRenderDebugMode(mode int) {
	if w.scene != nil {
		w.scene.RenderDebugMode = mode
	}
}

func (w *World) SetHeroCameraVisible(visible bool) {
	w.heroCameraVisible = visible
}

func (w *World) destroyRacingDebugOverlay() {
	if w.racingDebugOverlay != nil {
		w.racingDebugOverlay.Destroy(w.scene)
		w.racingDebugOverlay = nil
	}
}

func (w *World) Close() {
	w.destroyRacingDebugOverlay()
	if w.vehicleAudio != nil {
		w.vehicleAudio.Destroy()
		w.vehicleAudio = nil
	}
	if w.scene != nil {
		w.scene.Skybox = 0
		w.scene.Close()
	}
	if w.trackResult != nil {
		w.trackResult.ReleaseTextures()
		w.trackResult = nil
	}
	w.primitive = nil
	w.track = nil
	w.kartController = nil
	if w.assets != nil {
		if w.assetGroup != "" && !w.assetGroupOwnedByRuntime {
			w.assets.ReleaseGroup(w.assetGroup)
			w.assetGroup = ""
		}
		w.assets = nil
	}
	if w.cubeModel != 0 {
		w.cubeModel.Free()
		w.cubeModel = 0
	}
}
