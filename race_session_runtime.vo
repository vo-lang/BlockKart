package main

import (
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

func (w *World) Update(g *voplay.GameCtx, dt float64, debugOverlayVisible bool) {
	if w.core.trackRuntime.advanceRenderStress(&w.core, &w.hud.renderStress) {
		blockKartResetRenderStressPerfWindow(diagnosticsPortsFromStates(&w.core, &w.input, &w.race, &w.kart, &w.hud), g)
		w.hud.presentation.message = "Render stress: " + blockKartRenderStressPrimitive10k
		w.hud.presentation.messageTimer = 1.5
		blockKartReportWorldDiagnostics(g, BlockKartLifecycleRunning, "renderStress", blockKartRenderStressPrimitive10k, w)
	}
	w.race.raceSession.updateKartRenderPose(&w.core, &w.race, &w.kart, &w.hud.presentation, g.Alpha)
	w.race.raceSession.updateRacingCamera(&w.core, &w.race, &w.kart, &w.hud.presentation, dt, debugOverlayVisible)
	w.core.scene.UpdateAudio()
	w.core.scene.UpdateEmitters(dt)
	w.core.scene.TickAnimations(dt)
	if debugOverlayVisible && w.hud.racingDebugOverlay != nil {
		w.hud.racingDebugOverlay.Update(w.core.scene)
	}
}

func (r *RaceSession) updateRacingCamera(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, presentation *RacePresentationState, dt float64, debugOverlayVisible bool) {
	if core.camera == nil || core.scene == nil {
		return
	}
	if presentation.terrainCameraView > 0 {
		race.raceSession.updateTerrainCaptureCamera(core, race, presentation)
		return
	}
	if presentation.heroCameraVisible {
		race.raceSession.updateHeroInspectionCamera(core)
		return
	}
	target := scene3d.RacingCameraTarget{Position: race.startPosition, Forward: voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, race.startYaw).RotateVec3(voplay.Vec3{Z: -1})}
	if core.vehicle != nil {
		target = scene3d.RacingCameraTargetFromVehicle(core.vehicle)
		if sample, ok := kart.kartRenderPose.RenderSample(); ok {
			target.Position = sample.Position
			target.Forward = sample.Rotation.RotateVec3(voplay.Vec3{Z: -1})
			target.Velocity = sample.Velocity
			target.Speed = sample.Speed
		}
		target.Position = race.raceSession.stabilizedCameraTargetPosition(core, target.Position)
	}
	target.Boost = blockKartIsBoosting(core, kart)
	if kart.drifting {
		target.Drift = kart.lastSteer
	}
	if debugOverlayVisible {
		presentation.cameraTelemetry.Record(target, dt)
	}
	core.camera.UpdateCamera(&core.scene.Camera, core.scene, target, dt)
}

func (r *RaceSession) stabilizedCameraTargetPosition(core *BlockKartRuntimeCore, position voplay.Vec3) voplay.Vec3 {
	if core.track == nil {
		return position
	}
	point := core.track.ClosestPoint(position)
	pose := core.track.PoseAt(point.Distance)
	minY := pose.Position.Y + kartSpawnRideHeight
	if position.Y < minY {
		position.Y = minY
	}
	return position
}

func (r *RaceSession) beginKartPhysicsStep(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, presentation *RacePresentationState) {
	if core.player == nil {
		return
	}
	if !kart.kartRenderPose.Initialized() {
		race.raceSession.resetKartRenderPose(core, kart, presentation, core.player.Position(), kart.kartRig.kartVisualRotation(core, kart))
		return
	}
	kart.kartRenderPose.BeginStep()
}

func (r *RaceSession) endKartPhysicsStep(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, presentation *RacePresentationState) {
	if core.player == nil {
		return
	}
	pos := core.player.Position()
	if core.vehicle != nil {
		pos = core.vehicle.Position()
	}
	rot := kart.kartRig.kartVisualRotation(core, kart)
	vel := voplay.Vec3{}
	if core.vehicle != nil {
		vel = core.vehicle.LinearVelocity()
	}
	speed := race.raceSession.currentKartRenderSpeed(core, kart)
	sample := NewKartRenderSample(pos, rot, vel, speed)
	if !kart.kartRenderPose.Initialized() {
		race.raceSession.resetKartRenderPose(core, kart, presentation, pos, rot)
		return
	}
	kart.kartRenderPose.Commit(sample)
}

func (r *RaceSession) resetKartRenderPose(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState, presentation *RacePresentationState, pos voplay.Vec3, rot voplay.Quat) {
	sample := kart.kartRenderPose.Reset(pos, rot)
	kart.kartRig.syncKartVisualsAt(core, kart, sample.Position, sample.Rotation)
	presentation.cameraTelemetry.ResetAnchor()
}

func (r *RaceSession) updateKartRenderPose(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, presentation *RacePresentationState, alpha float64) {
	if core.player == nil {
		return
	}
	if !kart.kartRenderPose.Initialized() {
		race.raceSession.resetKartRenderPose(core, kart, presentation, core.player.Position(), kart.kartRig.kartVisualRotation(core, kart))
	}
	sample := kart.kartRenderPose.Interpolate(alpha)
	kart.kartRig.syncKartVisualsAt(core, kart, sample.Position, sample.Rotation)
}

func (r *RaceSession) currentKartRenderSpeed(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState) float64 {
	if core.vehicle != nil {
		telemetry := core.vehicle.Telemetry()
		return telemetry.Speed
	}
	return kart.kartSpeed
}

func (r *RaceSession) updateHeroInspectionCamera(core *BlockKartRuntimeCore) {
	if core.scene == nil {
		return
	}
	target := voplay.Vec3{X: 76, Y: 5.4, Z: 113}
	position := voplay.Vec3{X: 91, Y: 10.2, Z: 98}
	if core.track != nil {
		pose := core.track.PoseAt(48)
		target = pose.Position.Sub(pose.Right.Scale(pose.HalfWidth + 34.0)).Add(voplay.Vec3{Y: 4.8})
		position = target.Add(pose.Right.Scale(24.0)).Sub(pose.Forward.Scale(32.0)).Add(voplay.Vec3{Y: 27.0})
	}
	core.scene.Camera.LookAt(position, target)
	core.scene.Camera.Fov = 42
}

func (w *World) CycleTerrainCameraView() int {
	w.hud.presentation.terrainCameraView++
	if w.hud.presentation.terrainCameraView > 4 {
		w.hud.presentation.terrainCameraView = 0
	}
	return w.hud.presentation.terrainCameraView
}

func (r *RaceSession) updateTerrainCaptureCamera(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, presentation *RacePresentationState) {
	if core.scene == nil {
		return
	}
	if core.track == nil {
		core.scene.Camera.LookAt(voplay.Vec3{X: 0, Y: 58, Z: 96}, voplay.Vec3{X: 0, Y: 0, Z: 0})
		core.scene.Camera.Fov = 48
		return
	}
	start := core.track.DistanceAlongTrack(race.startPosition)
	length := core.track.Length()
	if length <= 0 {
		length = 1
	}
	if presentation.terrainCameraView == 1 {
		target := voplay.Vec3{X: 0, Y: 0.0, Z: 1}
		position := voplay.Vec3{X: 0, Y: 950, Z: 0}
		core.scene.Camera.LookAt(position, target)
		core.scene.Camera.Fov = 62
		return
	}
	if presentation.terrainCameraView == 2 {
		pose := core.track.PoseAt(start + length * 0.02)
		target := pose.Position.Add(pose.Forward.Scale(92)).Add(voplay.Vec3{Y: 5.0})
		position := pose.Position.Sub(pose.Forward.Scale(178)).Sub(pose.Right.Scale(34)).Add(voplay.Vec3{Y: 104})
		core.scene.Camera.LookAt(position, target)
		core.scene.Camera.Fov = 54
		return
	}
	if presentation.terrainCameraView == 3 {
		target := voplay.Vec3{X: 12, Y: 1.6, Z: -8}
		position := voplay.Vec3{X: 440, Y: 185, Z: 305}
		core.scene.Camera.LookAt(position, target)
		core.scene.Camera.Fov = 56
		return
	}
	target := voplay.Vec3{X: -36, Y: 2.8, Z: 6}
	position := voplay.Vec3{X: -485, Y: 170, Z: 255}
	core.scene.Camera.LookAt(position, target)
	core.scene.Camera.Fov = 55
}
