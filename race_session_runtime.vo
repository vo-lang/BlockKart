package main

import (
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

func (w *World) Update(g *voplay.GameCtx, dt float64, debugOverlayVisible bool) {
	w.race.raceSession.updateKartRenderPose(w.BlockKartRuntimeContext, g.Alpha)
	w.race.raceSession.updateRacingCamera(w.BlockKartRuntimeContext, dt, debugOverlayVisible)
	w.core.scene.UpdateAudio()
	w.core.scene.UpdateEmitters(dt)
	w.core.scene.TickAnimations(dt)
	if debugOverlayVisible && w.hud.racingDebugOverlay != nil {
		w.hud.racingDebugOverlay.Update(w.core.scene)
	}
}

func (r *RaceSession) updateRacingCamera(w *BlockKartRuntimePorts, dt float64, debugOverlayVisible bool) {
	if w.core.camera == nil || w.core.scene == nil {
		return
	}
	if w.hud.terrainCameraView > 0 {
		w.race.raceSession.updateTerrainCaptureCamera(w)
		return
	}
	if w.hud.heroCameraVisible {
		w.race.raceSession.updateHeroInspectionCamera(w)
		return
	}
	target := scene3d.RacingCameraTarget{Position: w.race.startPosition, Forward: voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, w.race.startYaw).RotateVec3(voplay.Vec3{Z: -1})}
	if w.core.vehicle != nil {
		target = scene3d.RacingCameraTargetFromVehicle(w.core.vehicle)
		if sample, ok := w.kart.kartRenderPose.RenderSample(); ok {
			target.Position = sample.Position
			target.Forward = sample.Rotation.RotateVec3(voplay.Vec3{Z: -1})
			target.Velocity = sample.Velocity
			target.Speed = sample.Speed
		}
		target.Position = w.race.raceSession.stabilizedCameraTargetPosition(w, target.Position)
	}
	target.Boost = w.hud.hudPresenter.isBoosting(w)
	if w.kart.drifting {
		target.Drift = w.kart.lastSteer
	}
	if debugOverlayVisible {
		w.hud.cameraTelemetry.Record(target, dt)
	}
	w.core.camera.UpdateCamera(&w.core.scene.Camera, w.core.scene, target, dt)
}

func (r *RaceSession) stabilizedCameraTargetPosition(w *BlockKartRuntimePorts, position voplay.Vec3) voplay.Vec3 {
	if w.core.track == nil {
		return position
	}
	point := w.core.track.ClosestPoint(position)
	pose := w.core.track.PoseAt(point.Distance)
	minY := pose.Position.Y + kartSpawnRideHeight
	if position.Y < minY {
		position.Y = minY
	}
	return position
}

func (r *RaceSession) beginKartPhysicsStep(w *BlockKartRuntimePorts) {
	if w.core.player == nil {
		return
	}
	if !w.kart.kartRenderPose.Initialized() {
		w.race.raceSession.resetKartRenderPose(w, w.core.player.Position(), w.kart.kartRig.kartVisualRotation(w))
		return
	}
	w.kart.kartRenderPose.BeginStep()
}

func (r *RaceSession) endKartPhysicsStep(w *BlockKartRuntimePorts) {
	if w.core.player == nil {
		return
	}
	pos := w.core.player.Position()
	if w.core.vehicle != nil {
		pos = w.core.vehicle.Position()
	}
	rot := w.kart.kartRig.kartVisualRotation(w)
	vel := voplay.Vec3{}
	if w.core.vehicle != nil {
		vel = w.core.vehicle.LinearVelocity()
	}
	speed := w.race.raceSession.currentKartRenderSpeed(w)
	sample := NewKartRenderSample(pos, rot, vel, speed)
	if !w.kart.kartRenderPose.Initialized() {
		w.race.raceSession.resetKartRenderPose(w, pos, rot)
		return
	}
	w.kart.kartRenderPose.Commit(sample)
}

func (r *RaceSession) resetKartRenderPose(w *BlockKartRuntimePorts, pos voplay.Vec3, rot voplay.Quat) {
	sample := w.kart.kartRenderPose.Reset(pos, rot)
	w.kart.kartRig.syncKartVisualsAt(w, sample.Position, sample.Rotation)
	w.hud.cameraTelemetry.ResetAnchor()
}

func (r *RaceSession) updateKartRenderPose(w *BlockKartRuntimePorts, alpha float64) {
	if w.core.player == nil {
		return
	}
	if !w.kart.kartRenderPose.Initialized() {
		w.race.raceSession.resetKartRenderPose(w, w.core.player.Position(), w.kart.kartRig.kartVisualRotation(w))
	}
	sample := w.kart.kartRenderPose.Interpolate(alpha)
	w.kart.kartRig.syncKartVisualsAt(w, sample.Position, sample.Rotation)
}

func (r *RaceSession) currentKartRenderSpeed(w *BlockKartRuntimePorts) float64 {
	if w.core.vehicle != nil {
		telemetry := scene3d.ProductVehicleTelemetry(w.core.vehicle)
		return telemetry.Speed
	}
	return w.kart.kartSpeed
}

func (r *RaceSession) updateHeroInspectionCamera(w *BlockKartRuntimePorts) {
	if w.core.scene == nil {
		return
	}
	target := voplay.Vec3{X: 76, Y: 5.4, Z: 113}
	position := voplay.Vec3{X: 91, Y: 10.2, Z: 98}
	if w.core.track != nil {
		pose := w.core.track.PoseAt(48)
		target = pose.Position.Sub(pose.Right.Scale(pose.HalfWidth + 34.0)).Add(voplay.Vec3{Y: 4.8})
		position = target.Add(pose.Right.Scale(24.0)).Sub(pose.Forward.Scale(32.0)).Add(voplay.Vec3{Y: 27.0})
	}
	w.core.scene.Camera.LookAt(position, target)
	w.core.scene.Camera.Fov = 42
}

func (w *World) CycleTerrainCameraView() int {
	w.hud.terrainCameraView++
	if w.hud.terrainCameraView > 4 {
		w.hud.terrainCameraView = 0
	}
	return w.hud.terrainCameraView
}

func (r *RaceSession) updateTerrainCaptureCamera(w *BlockKartRuntimePorts) {
	if w.core.scene == nil {
		return
	}
	if w.core.track == nil {
		w.core.scene.Camera.LookAt(voplay.Vec3{X: 0, Y: 58, Z: 96}, voplay.Vec3{X: 0, Y: 0, Z: 0})
		w.core.scene.Camera.Fov = 48
		return
	}
	start := w.core.track.DistanceAlongTrack(w.race.startPosition)
	length := w.core.track.Length()
	if length <= 0 {
		length = 1
	}
	if w.hud.terrainCameraView == 1 {
		target := voplay.Vec3{X: 0, Y: 0.0, Z: 1}
		position := voplay.Vec3{X: 0, Y: 950, Z: 0}
		w.core.scene.Camera.LookAt(position, target)
		w.core.scene.Camera.Fov = 62
		return
	}
	if w.hud.terrainCameraView == 2 {
		pose := w.core.track.PoseAt(start + length * 0.02)
		target := pose.Position.Add(pose.Forward.Scale(92)).Add(voplay.Vec3{Y: 5.0})
		position := pose.Position.Sub(pose.Forward.Scale(178)).Sub(pose.Right.Scale(34)).Add(voplay.Vec3{Y: 104})
		w.core.scene.Camera.LookAt(position, target)
		w.core.scene.Camera.Fov = 54
		return
	}
	if w.hud.terrainCameraView == 3 {
		target := voplay.Vec3{X: 12, Y: 1.6, Z: -8}
		position := voplay.Vec3{X: 440, Y: 185, Z: 305}
		w.core.scene.Camera.LookAt(position, target)
		w.core.scene.Camera.Fov = 56
		return
	}
	target := voplay.Vec3{X: -36, Y: 2.8, Z: 6}
	position := voplay.Vec3{X: -485, Y: 170, Z: 255}
	w.core.scene.Camera.LookAt(position, target)
	w.core.scene.Camera.Fov = 55
}
