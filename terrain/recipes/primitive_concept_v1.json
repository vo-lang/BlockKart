      "dirt and gravel shoulder around asphalt",
      "rock or exposed soil on steeper cut faces",
      "grass remains bright but not fluorescent",
      "meadow patches appear away from the immediate road edge"
    ]
  },
  "agentIteration": {
    "paradigm": "docs/terrain-agent-editing-paradigm.md",
    "method": "layer-mask-operation-stroke-review",
    "editIntent": {
      "problem": "The old terrain used an ellipse-like road and independent hill patches, so it could not approach the concept composition.",
      "targetView": "panorama",
      "mask": "whole-map base form plus explicit closed-loop track corridor",
      "operation": "replace generated ellipse with explicit control-point spline, then rebuild inner basin and outer highlands around that spline",
      "expectedVisualResult": "The panorama first reads as a concept-like closed racing loop with a front straight, left and right S bends, far straight, lower inner basin, and broad outer hill masses.",
      "rollbackCondition": "If the panorama still reads as a plain oval or if the road no longer aligns with the generated terrain cut."
    },
    "editObject": "terrain/recipes/primitive_concept_v1.json",
    "generatorInputs": [
      "tools/terrain_heightfield_spec.mjs",
      "tools/generate_terrain_heightfield_spec.mjs",
      "tools/generate_primitive_terrain.mjs"
    ],
    "reviewViews": [
      "panorama_45",
      "approach_cut",
      "inner_basin",
      "ridge_profile"
    ],
    "acceptance": [
      "track topology visibly matches the concept before small terrain detail work",
      "heightmap changes come from recipe changes or named generator terms",
      "agent review metrics are regenerated after each terrain pass",
      "fixed gameplay screenshots are compared against the concept reference",
      "no human-facing editor UI is part of this terrain plan"
    ]
  }
