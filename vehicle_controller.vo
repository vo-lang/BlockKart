package main

import (
	"errors"
	"math"
	"github.com/vo-lang/voplay"
)

const (
	blockKartVehicleSubsteps uint32 = 2
	blockKartVehicleNormalMaximumSpeed float64 = 26000.0
	blockKartVehicleBoostMaximumSpeed float64 = 34000.0
	blockKartVehicleOffRoadMaximumSpeed float64 = 15000.0
	blockKartVehicleReverseMaximumSpeed float64 = 8500.0
	blockKartVehicleWheelbase float64 = 2350.0
)

// BlockKartVehicleController owns the complete simulated state of the hero kart.
// Control commands, wheel angle, rigid-body yaw, and tire slip are intentionally
// separate so a digital input edge can never rotate or translate the kart directly.
type BlockKartVehicleController struct {
	Initialized bool
	Heading_radians float64
	Camera_heading_radians float64
	Steer_command float64
	Wheel_angle_radians float64
	Forward_speed float64
	Lateral_speed float64
	Yaw_rate float64
	Longitudinal_acceleration float64
	Drift_blend float64
}

func (vehicle *BlockKartVehicleController) Reset(transform Transform) {
	if vehicle == nil {
		return
	}
	vehicle.Initialized = true
	vehicle.Heading_radians = float64(transform.Yaw_milliradians) / 1000.0
	vehicle.Camera_heading_radians = vehicle.Heading_radians
	vehicle.Steer_command = 0
	vehicle.Wheel_angle_radians = 0
	vehicle.Forward_speed = 0
	vehicle.Lateral_speed = 0
	vehicle.Yaw_rate = 0
	vehicle.Longitudinal_acceleration = 0
	vehicle.Drift_blend = 0
}

func (game *BlockKart) drive(tick voplay.TickBatch) error {
	control, ok := game.Controls.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: read vehicle control")
	}
	velocity, ok := game.Velocities.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: read vehicle velocity")
	}
	transform, ok := game.Transforms.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: read vehicle transform")
	}
	state, ok := game.KartStates.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: read vehicle state")
	}
	if !game.Vehicle.Initialized {
		game.Vehicle.Reset(transform)
	}
	if game.Paused || state.Countdown_ticks != 0 || state.Finished {
		return game.holdVehicle(velocity, transform, state)
	}
	deltaSeconds := float64(tick.FixedTickNanos) / 1000000000.0
	if deltaSeconds <= 0 || deltaSeconds > 0.1 {
		return errors.New("blockkart: invalid vehicle delta")
	}
	if game.StartFlash_ticks != 0 {
		game.StartFlash_ticks--
	}
	road := game.nearestRoadSample(transform)
	game.OffRoad = road.Distance_milli >
		road.Half_width_milli - 900
	game.Vehicle.Forward_speed = float64(state.Speed_per_second)
	game.updateVehicleDrift(control, deltaSeconds)
	miniTurbo := game.MiniTurbo_ticks != 0
	if game.MiniTurbo_ticks != 0 {
		game.MiniTurbo_ticks--
	}
	boosting := control.Boost || state.Boost_ticks != 0 || miniTurbo
	// Gameplay input is expressed in screen space. The authored kart and camera
	// mirror the simulation's horizontal basis, so convert once at the vehicle
	// boundary and keep the rest of the controller internally consistent.
	steerTarget := blockKartVehicleSteeringInput(
		-float64(control.Steer_milli) / 1000.0, -1, 1,
	)
	throttle := blockKartVehicleClamp(
		float64(control.Throttle_milli) / 1000.0, 0, 1,
	)
	brake := blockKartVehicleClamp(
		float64(control.Brake_milli) / 1000.0, 0, 1,
	)
	previousSpeed := game.Vehicle.Forward_speed
	substepSeconds := deltaSeconds / float64(blockKartVehicleSubsteps)
	guidanceDistance := blockKartVehicleClamp(
		math.Abs(game.Vehicle.Forward_speed) * 0.38,
		2800, 10500,
	)
	guidanceTransform := transform
	guidanceTransform.X += int64(
		math.Sin(game.Vehicle.Heading_radians) * guidanceDistance,
	)
	guidanceTransform.Z += int64(
		math.Cos(game.Vehicle.Heading_radians) * guidanceDistance,
	)
	guidance := game.nearestRoadSample(guidanceTransform)
	roadHeading := math.Atan2(
		float64(guidance.Tangent_x_milli),
		float64(guidance.Tangent_z_milli),
	)
	roadHeadingError := blockKartVehicleWrapRadians(
		roadHeading - game.Vehicle.Heading_radians,
	)
	roadOffsetRatio := blockKartVehicleClamp(
		float64(guidance.Signed_offset_milli) /
			float64(guidance.Half_width_milli),
		-2, 2,
	)
	for substep := uint32(0); substep < blockKartVehicleSubsteps; substep++ {
		game.Vehicle.step(
			steerTarget, throttle, brake, boosting, miniTurbo,
			game.OffRoad, game.Drifting, -game.DriftDirection,
			roadHeadingError, roadOffsetRatio,
			substepSeconds,
		)
	}
	game.Vehicle.Longitudinal_acceleration =
		(game.Vehicle.Forward_speed - previousSpeed) / deltaSeconds
	transform.Yaw_milliradians = blockKartWrapMilliRadians(
		int32(game.Vehicle.Heading_radians * 1000.0),
	)
	heading := game.Vehicle.Heading_radians
	forwardX := math.Sin(heading)
	forwardZ := math.Cos(heading)
	rightX := math.Cos(heading)
	rightZ := -math.Sin(heading)
	velocity.X_per_second = int64(
		forwardX * game.Vehicle.Forward_speed +
			rightX * game.Vehicle.Lateral_speed,
	)
	velocity.Z_per_second = int64(
		forwardZ * game.Vehicle.Forward_speed +
			rightZ * game.Vehicle.Lateral_speed,
	)
	velocity.Yaw_per_second = int32(game.Vehicle.Yaw_rate * 1000.0)
	state.Speed_per_second = int64(game.Vehicle.Forward_speed)
	elapsedNanos := tick.FixedTickNanos + game.ElapsedNanosRemainder
	state.Elapsed_millis += elapsedNanos / 1000000
	game.ElapsedNanosRemainder = elapsedNanos % 1000000
	if state.Boost_ticks != 0 {
		state.Boost_ticks--
	}
	if game.CollisionShake_ticks != 0 {
		game.CollisionShake_ticks--
	}
	game.publishVehiclePresentation(deltaSeconds)
	if !game.Transforms.Upsert(game.KartEntity, transform) ||
		!game.Velocities.Upsert(game.KartEntity, velocity) ||
		!game.KartStates.Upsert(game.KartEntity, state) {
		return errors.New("blockkart: publish vehicle state")
	}
	game.BoostPressed = boosting
	return nil
}

func (game *BlockKart) holdVehicle(
	velocity Velocity,
	transform Transform,
	state KartState,
) error {
	if state.Countdown_ticks != 0 && !game.Paused {
		state.Countdown_ticks--
		if state.Countdown_ticks == 0 {
			game.StartFlash_ticks = blockKartTicksPerSecond * 4 / 5
		}
	}
	game.Vehicle.Reset(transform)
	state.Speed_per_second = 0
	velocity.X_per_second = 0
	velocity.Z_per_second = 0
	velocity.Yaw_per_second = 0
	game.BoostPressed = false
	game.Steering_milli = 0
	game.ChassisLean_milliradians = blockKartApproachInt32(
		game.ChassisLean_milliradians, 0, 12,
	)
	game.ChassisPitch_milliradians = blockKartApproachInt32(
		game.ChassisPitch_milliradians, 0, 10,
	)
	game.Drifting = false
	game.WasDrifting = false
	game.DriftCharge_milli = 0
	game.DriftStage = 0
	game.DriftDirection = 0
	if !game.Velocities.Upsert(game.KartEntity, velocity) ||
		!game.KartStates.Upsert(game.KartEntity, state) {
		return errors.New("blockkart: hold vehicle state")
	}
	return nil
}

func (vehicle *BlockKartVehicleController) step(
	steerTarget float64,
	throttle float64,
	brake float64,
	boosting bool,
	miniTurbo bool,
	offRoad bool,
	drifting bool,
	driftDirection int32,
	roadHeadingError float64,
	roadOffsetRatio float64,
	deltaSeconds float64,
) {
	vehicle.stepSteering(steerTarget, offRoad, deltaSeconds)
	vehicle.stepDriftBlend(drifting, deltaSeconds)
	vehicle.stepLongitudinal(
		throttle, brake, boosting, miniTurbo, offRoad, deltaSeconds,
	)
	vehicle.stepTires(
		offRoad, drifting, driftDirection,
		roadHeadingError, roadOffsetRatio,
		deltaSeconds,
	)
	vehicle.Heading_radians += vehicle.Yaw_rate * deltaSeconds
	vehicle.Heading_radians = blockKartVehicleWrapRadians(
		vehicle.Heading_radians,
	)
	vehicle.stepCamera(drifting, deltaSeconds)
}

func (vehicle *BlockKartVehicleController) stepDriftBlend(
	drifting bool,
	deltaSeconds float64,
) {
	target := 0.0
	rate := 8.5
	if drifting {
		target = 1.0
		rate = 6.5
	}
	vehicle.Drift_blend = blockKartVehicleApproach(
		vehicle.Drift_blend, target, rate * deltaSeconds,
	)
}

func (vehicle *BlockKartVehicleController) stepCamera(
	drifting bool,
	deltaSeconds float64,
) {
	lookAhead := blockKartVehicleClamp(vehicle.Yaw_rate * 0.065, -0.06, 0.06)
	target := blockKartVehicleWrapRadians(
		vehicle.Heading_radians + lookAhead,
	)
	error := blockKartVehicleWrapRadians(
		target - vehicle.Camera_heading_radians,
	)
	maximumLag := 0.12
	response := 14.0
	if drifting || vehicle.Drift_blend > 0 {
		maximumLag = 0.18
		response = 10.0
	}
	error = blockKartVehicleClamp(error, -maximumLag, maximumLag)
	blend := 1.0 - math.Exp(-response * deltaSeconds)
	vehicle.Camera_heading_radians = blockKartVehicleWrapRadians(
		vehicle.Camera_heading_radians + error * blend,
	)
}

func (vehicle *BlockKartVehicleController) stepSteering(
	target float64,
	offRoad bool,
	deltaSeconds float64,
) {
	reversing := target != 0 && vehicle.Steer_command != 0 &&
		(vehicle.Steer_command < 0) != (target < 0)
	speedRatio := blockKartVehicleClamp(
		math.Abs(vehicle.Forward_speed) /
			blockKartVehicleNormalMaximumSpeed,
		0, 1,
	)
	commandRate := 7.8 - speedRatio * 2.6
	if target == 0 {
		commandRate = 10.5
	} else if reversing {
		commandRate = 13.0
	}
	vehicle.Steer_command = blockKartVehicleApproach(
		vehicle.Steer_command, target, commandRate * deltaSeconds,
	)
	maximumWheelAngle := 0.48 + (0.17 - 0.48) * math.Sqrt(speedRatio)
	if offRoad {
		maximumWheelAngle *= 0.88
	}
	shapedCommand := math.Pow(math.Abs(vehicle.Steer_command), 1.05)
	if vehicle.Steer_command < 0 {
		shapedCommand = -shapedCommand
	}
	wheelTarget := shapedCommand * maximumWheelAngle
	wheelReversing := wheelTarget != 0 &&
		vehicle.Wheel_angle_radians != 0 &&
		(vehicle.Wheel_angle_radians < 0) != (wheelTarget < 0)
	wheelRate := 6.5
	if target == 0 {
		wheelRate = 9.5
	} else if reversing || wheelReversing {
		wheelRate = 12.0
	}
	vehicle.Wheel_angle_radians = blockKartVehicleApproach(
		vehicle.Wheel_angle_radians,
		wheelTarget,
		wheelRate * deltaSeconds,
	)
}

func (vehicle *BlockKartVehicleController) stepLongitudinal(
	throttle float64,
	brake float64,
	boosting bool,
	miniTurbo bool,
	offRoad bool,
	deltaSeconds float64,
) {
	speed := vehicle.Forward_speed
	absoluteSpeed := math.Abs(speed)
	speedRatio := blockKartVehicleClamp(
		absoluteSpeed / blockKartVehicleNormalMaximumSpeed, 0, 1,
	)
	engineAcceleration := 8800.0 * (1.0 - speedRatio * 0.72)
	if engineAcceleration < 2200 {
		engineAcceleration = 2200
	}
	surfaceDrive := 1.0
	if offRoad {
		surfaceDrive = 0.52
	}
	acceleration := 0.0
	if throttle > 0 {
		if speed < -300 {
			acceleration += 19000.0 * throttle
		} else {
			acceleration += engineAcceleration * throttle * surfaceDrive
		}
	}
	if brake > 0 {
		if speed > 300 {
			acceleration -= 21000.0 * brake
		} else {
			acceleration -= 7200.0 * brake
		}
	}
	if boosting && speed >= 0 {
		boostAcceleration := 5200.0
		if miniTurbo {
			boostAcceleration = 6800.0
		}
		acceleration += boostAcceleration
	}
	if throttle == 0 && brake == 0 {
		rollingResistance := 750.0 + absoluteSpeed * 0.032
		if speed > 0 {
			acceleration -= rollingResistance
		} else if speed < 0 {
			acceleration += rollingResistance
		}
	} else {
		acceleration -= speed * 0.035
	}
	if !boosting && speed > blockKartVehicleNormalMaximumSpeed {
		acceleration -= (speed - blockKartVehicleNormalMaximumSpeed) * 0.85
	}
	if offRoad {
		acceleration -= speed * 0.12
		if speed > blockKartVehicleOffRoadMaximumSpeed {
			acceleration -= (speed - blockKartVehicleOffRoadMaximumSpeed) * 0.70
		}
	}
	nextSpeed := speed + acceleration * deltaSeconds
	if throttle == 0 && brake == 0 &&
		(speed > 0 && nextSpeed < 0 || speed < 0 && nextSpeed > 0) {
		nextSpeed = 0
	}
	if nextSpeed > blockKartVehicleBoostMaximumSpeed {
		nextSpeed = blockKartVehicleBoostMaximumSpeed
	}
	if nextSpeed < -blockKartVehicleReverseMaximumSpeed {
		nextSpeed = -blockKartVehicleReverseMaximumSpeed
	}
	vehicle.Forward_speed = nextSpeed
}

func (vehicle *BlockKartVehicleController) stepTires(
	offRoad bool,
	drifting bool,
	driftDirection int32,
	roadHeadingError float64,
	roadOffsetRatio float64,
	deltaSeconds float64,
) {
	absoluteSpeed := math.Abs(vehicle.Forward_speed)
	desiredYawRate := 0.0
	if absoluteSpeed > 100 {
		desiredYawRate = vehicle.Forward_speed /
			blockKartVehicleWheelbase *
			math.Tan(vehicle.Wheel_angle_radians)
	}
	maximumLateralAcceleration := 31000.0
	if offRoad {
		maximumLateralAcceleration = 14500.0
	}
	driftBlend := vehicle.Drift_blend
	driftCommit := 0.0
	counterSteer := 0.0
	if driftDirection != 0 {
		signedSteer := vehicle.Steer_command * float64(driftDirection)
		driftCommit = blockKartVehicleClamp(signedSteer, 0, 1)
		counterSteer = blockKartVehicleClamp(-signedSteer, 0, 1)
	}
	if driftBlend > 0 {
		driftLateralAcceleration := 46000.0
		if offRoad {
			driftLateralAcceleration = 20000.0
		}
		maximumLateralAcceleration +=
			(driftLateralAcceleration - maximumLateralAcceleration) * driftBlend
		driftYawAssist := 0.24 + driftCommit * 0.18 - counterSteer * 0.12
		desiredYawRate +=
			float64(driftDirection) * driftYawAssist * driftBlend
	}
	roadAssist := blockKartVehicleClamp(
		(math.Abs(roadOffsetRatio) - 0.62) / 0.38,
		0, 1,
	)
	driverBlend := 1.0 - 0.68 * blockKartVehicleClamp(
		math.Abs(vehicle.Steer_command), 0, 1,
	)
	if roadAssist > 0 &&
		!drifting && vehicle.Forward_speed > 2500 {
		assistYawRate := blockKartVehicleClamp(
			roadHeadingError * 0.95 - roadOffsetRatio * 0.52,
			-0.72, 0.72,
		)
		desiredYawRate += assistYawRate * roadAssist * driverBlend
		maximumLateralAcceleration += 18000.0 * roadAssist
	}
	maximumYawRate := 1.9
	if absoluteSpeed > 3500 {
		maximumYawRate = maximumLateralAcceleration / absoluteSpeed
		if maximumYawRate > 1.9 {
			maximumYawRate = 1.9
		}
	}
	desiredYawRate = blockKartVehicleClamp(
		desiredYawRate, -maximumYawRate, maximumYawRate,
	)
	speedRatio := blockKartVehicleClamp(
		absoluteSpeed / blockKartVehicleNormalMaximumSpeed, 0, 1,
	)
	yawAcceleration := 7.2 - speedRatio * 2.0
	if desiredYawRate == 0 {
		yawAcceleration = 8.5
	} else if vehicle.Yaw_rate != 0 &&
		(vehicle.Yaw_rate < 0) != (desiredYawRate < 0) {
		yawAcceleration = 11.0
	}
	vehicle.Yaw_rate = blockKartVehicleApproach(
		vehicle.Yaw_rate,
		desiredYawRate,
		yawAcceleration * deltaSeconds,
	)
	if driftBlend > 0 {
		slipRatio := 0.12 + driftCommit * 0.12 - counterSteer * 0.08
		targetSlip := -float64(driftDirection) *
			absoluteSpeed * slipRatio * driftBlend
		vehicle.Lateral_speed = blockKartVehicleApproach(
			vehicle.Lateral_speed, targetSlip,
			(11000.0 + counterSteer * 7000.0) * deltaSeconds,
		)
	} else {
		gripAcceleration := 34000.0
		if offRoad {
			gripAcceleration = 19000.0
		}
		vehicle.Lateral_speed = blockKartVehicleApproach(
			vehicle.Lateral_speed, 0, gripAcceleration * deltaSeconds,
		)
	}
	maximumSlip := absoluteSpeed * 0.28
	vehicle.Lateral_speed = blockKartVehicleClamp(
		vehicle.Lateral_speed, -maximumSlip, maximumSlip,
	)
}

func (vehicle *BlockKartVehicleController) ApplyImpact(
	obstacleDirectionX float64,
	obstacleDirectionZ float64,
) float64 {
	if vehicle == nil {
		return 0
	}
	heading := vehicle.Heading_radians
	forwardX := math.Sin(heading)
	forwardZ := math.Cos(heading)
	rightX := math.Cos(heading)
	rightZ := -math.Sin(heading)
	forwardImpact := blockKartVehicleClamp(
		obstacleDirectionX * forwardX +
			obstacleDirectionZ * forwardZ,
		-1, 1,
	)
	sideImpact := blockKartVehicleClamp(
		obstacleDirectionX * rightX +
			obstacleDirectionZ * rightZ,
		-1, 1,
	)
	retainedSpeed := 0.70 - math.Abs(forwardImpact) * 0.22
	if retainedSpeed < 0.44 {
		retainedSpeed = 0.44
	}
	vehicle.Forward_speed *= retainedSpeed
	vehicle.Lateral_speed -= sideImpact * 4200.0
	vehicle.Yaw_rate -= sideImpact * 0.58
	vehicle.Yaw_rate = blockKartVehicleClamp(
		vehicle.Yaw_rate, -1.15, 1.15,
	)
	vehicle.Steer_command *= 0.38
	vehicle.Wheel_angle_radians *= 0.52
	vehicle.Drift_blend *= 0.35
	return sideImpact
}

func (game *BlockKart) updateVehicleDrift(
	control KartControl,
	deltaSeconds float64,
) {
	absoluteSpeed := math.Abs(game.Vehicle.Forward_speed)
	driftEligible := control.Drift && absoluteSpeed > 10000 &&
		(game.WasDrifting || math.Abs(float64(control.Steer_milli)) > 280)
	if driftEligible {
		if !game.WasDrifting {
			if control.Steer_milli < 0 {
				game.DriftDirection = -1
			} else {
				game.DriftDirection = 1
			}
			game.DriftCharge_milli = 0
		}
		game.Drifting = true
		chargePerSecond := 120.0 + absoluteSpeed / 180.0 +
			math.Abs(float64(control.Steer_milli)) / 12.0
		if control.Steer_milli != 0 &&
			(control.Steer_milli < 0) != (game.DriftDirection < 0) {
			chargePerSecond += 100.0
		}
		chargeGain := uint32(
			chargePerSecond * deltaSeconds,
		)
		if chargeGain == 0 {
			chargeGain = 1
		}
		game.DriftCharge_milli += chargeGain
		if game.DriftCharge_milli > 1800 {
			game.DriftCharge_milli = 1800
		}
		game.DriftStage = 0
		if game.DriftCharge_milli >= 480 {
			game.DriftStage = 1
		}
		if game.DriftCharge_milli >= 980 {
			game.DriftStage = 2
		}
		if game.DriftCharge_milli >= 1520 {
			game.DriftStage = 3
		}
	} else {
		game.Drifting = false
		if game.WasDrifting {
			if game.DriftCharge_milli >= 1520 {
				game.MiniTurbo_ticks = blockKartTicksPerSecond * 3 / 2
			} else if game.DriftCharge_milli >= 980 {
				game.MiniTurbo_ticks = blockKartTicksPerSecond
			} else if game.DriftCharge_milli >= 480 {
				game.MiniTurbo_ticks = blockKartTicksPerSecond / 2
			}
		}
		game.DriftCharge_milli = 0
		game.DriftStage = 0
		game.DriftDirection = 0
	}
	game.WasDrifting = game.Drifting
}

func (game *BlockKart) publishVehiclePresentation(deltaSeconds float64) {
	game.Steering_milli = int32(
		-game.Vehicle.Wheel_angle_radians * 1000.0,
	)
	speedRatio := blockKartVehicleClamp(
		math.Abs(game.Vehicle.Forward_speed) /
			blockKartVehicleNormalMaximumSpeed,
		0, 1,
	)
	leanTarget := int32(-game.Vehicle.Yaw_rate * speedRatio * 78.0)
	leanTarget = blockKartClampInt32(leanTarget, -82, 82)
	game.ChassisLean_milliradians = blockKartApproachInt32(
		game.ChassisLean_milliradians,
		leanTarget,
		int32(250.0 * deltaSeconds),
	)
	pitchTarget := int32(
		game.Vehicle.Longitudinal_acceleration / 15000.0 * 46.0,
	)
	pitchTarget = blockKartClampInt32(pitchTarget, -54, 54)
	game.ChassisPitch_milliradians = blockKartApproachInt32(
		game.ChassisPitch_milliradians,
		pitchTarget,
		int32(210.0 * deltaSeconds),
	)
	spinStep := int32(
		game.Vehicle.Forward_speed * deltaSeconds / 440.0 * 1000.0,
	)
	game.WheelSpin_milliradians = blockKartWrapMilliRadians(
		game.WheelSpin_milliradians + spinStep,
	)
}

func blockKartVehicleApproach(
	current float64,
	target float64,
	maximumStep float64,
) float64 {
	if current < target {
		current += maximumStep
		if current > target {
			return target
		}
		return current
	}
	if current > target {
		current -= maximumStep
		if current < target {
			return target
		}
	}
	return current
}

func blockKartVehicleWrapRadians(value float64) float64 {
	for value > math.Pi {
		value -= math.Pi * 2.0
	}
	for value < -math.Pi {
		value += math.Pi * 2.0
	}
	return value
}

func blockKartVehicleClamp(
	value float64,
	minimum float64,
	maximum float64,
) float64 {
	if value < minimum {
		return minimum
	}
	if value > maximum {
		return maximum
	}
	return value
}

func blockKartVehicleSteeringInput(
	value float64,
	minimum float64,
	maximum float64,
) float64 {
	value = blockKartVehicleClamp(value, minimum, maximum)
	magnitude := math.Abs(value)
	const deadzone = 0.045
	if magnitude <= deadzone {
		return 0
	}
	magnitude = (magnitude - deadzone) / (1.0 - deadzone)
	if value < 0 {
		return -magnitude
	}
	return magnitude
}

func blockKartClampInt32(value int32, minimum int32, maximum int32) int32 {
	if value < minimum {
		return minimum
	}
	if value > maximum {
		return maximum
	}
	return value
}

func blockKartApproachInt32(current int32, target int32, step int32) int32 {
	if current < target {
		current += step
		if current > target {
			return target
		}
		return current
	}
	if current > target {
		current -= step
		if current < target {
			return target
		}
	}
	return current
}
