package main

import (
	"errors"
	"math"
	"github.com/vo-lang/voplay"
)

const (
	blockKartVehicleSubsteps uint32 = 3
	blockKartVehicleNormalMaximumSpeed float64 = 30000.0
	blockKartVehicleBoostMaximumSpeed float64 = 36000.0
	blockKartVehicleOffRoadMaximumSpeed float64 = 18000.0
	blockKartVehicleReverseMaximumSpeed float64 = 9500.0
)

// BlockKartVehicleController stores the complete planar dynamics, road-contact,
// suspension and camera state. Values exposed to the game use milli-units;
// the dynamics integrator converts them to SI units at its boundary.
type BlockKartVehicleController struct {
	Initialized bool
	Heading_radians float64
	Camera_heading_radians float64
	Camera_yaw_velocity float64
	Steer_command float64
	Wheel_angle_radians float64
	Forward_speed float64
	Lateral_speed float64
	Yaw_rate float64
	Longitudinal_acceleration float64
	Lateral_acceleration float64
	Body_slip_radians float64
	Front_slip_radians float64
	Rear_slip_radians float64
	Front_lateral_force_newtons float64
	Rear_lateral_force_newtons float64
	Drive_force_newtons float64
	Front_normal_load_newtons float64
	Rear_normal_load_newtons float64
	Stability_yaw_moment_newton_meters float64
	Drift_blend float64
	Surface_friction float64
	Suspended_height_milli float64
	Suspension_velocity_milli_per_second float64
	Suspension_offset_milli float64
	Road_pitch_radians float64
	Road_roll_radians float64
	Wheel_compression_milli [4]float64
	Wheel_visual_offset_milli [4]float64
}

func (vehicle *BlockKartVehicleController) Reset(transform Transform) {
	if vehicle == nil {
		return
	}
	vehicle.Initialized = true
	vehicle.Heading_radians = float64(transform.Yaw_milliradians) / 1000.0
	vehicle.Camera_heading_radians = vehicle.Heading_radians
	vehicle.Camera_yaw_velocity = 0
	vehicle.Steer_command = 0
	vehicle.Wheel_angle_radians = 0
	vehicle.Forward_speed = 0
	vehicle.Lateral_speed = 0
	vehicle.Yaw_rate = 0
	vehicle.Longitudinal_acceleration = 0
	vehicle.Lateral_acceleration = 0
	vehicle.Body_slip_radians = 0
	vehicle.Front_slip_radians = 0
	vehicle.Rear_slip_radians = 0
	vehicle.Front_lateral_force_newtons = 0
	vehicle.Rear_lateral_force_newtons = 0
	vehicle.Drive_force_newtons = 0
	vehicle.Front_normal_load_newtons = blockKartVehicleMassKg * 9.81 * 0.53
	vehicle.Rear_normal_load_newtons = blockKartVehicleMassKg * 9.81 * 0.47
	vehicle.Stability_yaw_moment_newton_meters = 0
	vehicle.Drift_blend = 0
	vehicle.Surface_friction = 1.42
	vehicle.Suspended_height_milli = float64(transform.Y)
	vehicle.Suspension_velocity_milli_per_second = 0
	vehicle.Suspension_offset_milli = 0
	vehicle.Road_pitch_radians = 0
	vehicle.Road_roll_radians = 0
	vehicle.Wheel_compression_milli = [4]float64{}
	vehicle.Wheel_visual_offset_milli = [4]float64{}
}

func (game *BlockKart) drive(tick voplay.TickBatch) error {
	control, ok := game.Controls.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: read vehicle control")
	}
	velocity, ok := game.Velocities.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: read vehicle velocity")
	}
	transform, ok := game.Transforms.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: read vehicle transform")
	}
	state, ok := game.KartStates.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: read vehicle state")
	}
	if !game.Vehicle.Initialized {
		game.Vehicle.Reset(transform)
	}
	if game.Paused || state.Countdown_ticks != 0 || state.Finished {
		return game.holdVehicle(velocity, transform, state)
	}
	deltaSeconds := float64(tick.FixedTickNanos) / 1000000000.0
	if deltaSeconds <= 0 || deltaSeconds > 0.1 {
		return errors.New("blockkart: invalid vehicle delta")
	}
	if game.StartFlash_ticks != 0 {
		game.StartFlash_ticks--
	}
	road := game.nearestRoadSample(transform)
	game.OffRoad = road.Surface == blockKartRoadSurfaceGrass
	game.updateVehicleDrift(control, deltaSeconds)
	miniTurbo := game.MiniTurbo_ticks != 0
	if game.MiniTurbo_ticks != 0 {
		game.MiniTurbo_ticks--
	}
	boosting := control.Boost || state.Boost_ticks != 0 || miniTurbo
	// Driver-left is positive throughout the vehicle model. Keyboard, gamepad
	// and touch axes are converted once at the platform-input boundary.
	steerTarget := blockKartVehicleSteeringInput(float64(control.Steer_milli) / 1000.0, -1, 1)
	throttle := blockKartVehicleClamp(float64(control.Throttle_milli) / 1000.0, 0, 1)
	brake := blockKartVehicleClamp(float64(control.Brake_milli) / 1000.0, 0, 1)
	previousSpeed := game.Vehicle.Forward_speed
	substepSeconds := deltaSeconds / float64(blockKartVehicleSubsteps)
	for substep := uint32(0); substep < blockKartVehicleSubsteps; substep++ {
		game.Vehicle.stepDynamics(road, steerTarget, throttle, brake, boosting, miniTurbo, game.Drifting, game.DriftDirection, substepSeconds)
	}
	game.Vehicle.Longitudinal_acceleration = (game.Vehicle.Forward_speed - previousSpeed) /
		deltaSeconds
	transform.Yaw_milliradians = blockKartWrapMilliRadians(int32(game.Vehicle.Heading_radians * 1000.0))
	heading := game.Vehicle.Heading_radians
	forwardX := math.Sin(heading)
	forwardZ := math.Cos(heading)
	rightX := math.Cos(heading)
	rightZ := -math.Sin(heading)
	velocity.X_per_second = int64(forwardX * game.Vehicle.Forward_speed +
		rightX * game.Vehicle.Lateral_speed)
	velocity.Z_per_second = int64(forwardZ * game.Vehicle.Forward_speed +
		rightZ * game.Vehicle.Lateral_speed)
	velocity.Y_per_second = 0
	velocity.Yaw_per_second = int32(game.Vehicle.Yaw_rate * 1000.0)
	state.Speed_per_second = int64(game.Vehicle.Forward_speed)
	elapsedNanos := tick.FixedTickNanos + game.ElapsedNanosRemainder
	state.Elapsed_millis += elapsedNanos / 1000000
	game.ElapsedNanosRemainder = elapsedNanos % 1000000
	if state.Boost_ticks != 0 {
		state.Boost_ticks--
	}
	if game.CollisionShake_ticks != 0 {
		game.CollisionShake_ticks--
	}
	game.Vehicle.stepCamera(game.Drifting, deltaSeconds)
	game.publishVehiclePresentation(deltaSeconds)
	if !game.Transforms.Upsert(game.KartEntity, transform) ||
		!game.Velocities.Upsert(game.KartEntity, velocity) ||
		!game.KartStates.Upsert(game.KartEntity, state) {
		return errors.New("blockkart: publish vehicle state")
	}
	game.BoostPressed = boosting
	return nil
}

func (game *BlockKart) holdVehicle(velocity Velocity, transform Transform, state KartState) error {
	if state.Countdown_ticks != 0 && !game.Paused {
		state.Countdown_ticks--
		if state.Countdown_ticks == 0 {
			game.StartFlash_ticks = blockKartTicksPerSecond * 4 / 5
		}
	}
	game.Vehicle.Reset(transform)
	state.Speed_per_second = 0
	velocity.X_per_second = 0
	velocity.Y_per_second = 0
	velocity.Z_per_second = 0
	velocity.Yaw_per_second = 0
	game.BoostPressed = false
	game.Steering_milli = 0
	game.ChassisLean_milliradians = blockKartApproachInt32(game.ChassisLean_milliradians, 0, 12)
	game.ChassisPitch_milliradians = blockKartApproachInt32(game.ChassisPitch_milliradians, 0, 10)
	game.SuspensionHeave_milli = blockKartApproachInt32(game.SuspensionHeave_milli, 0, 18)
	game.Drifting = false
	game.WasDrifting = false
	game.DriftCharge_milli = 0
	game.DriftStage = 0
	game.DriftDirection = 0
	if !game.Velocities.Upsert(game.KartEntity, velocity) ||
		!game.KartStates.Upsert(game.KartEntity, state) {
		return errors.New("blockkart: hold vehicle state")
	}
	return nil
}

func (vehicle *BlockKartVehicleController) stepCamera(drifting bool, deltaSeconds float64) {
	speedMps := math.Abs(vehicle.Forward_speed) / 1000.0
	speedForSlip := math.Max(speedMps, 1.5)
	slipAngle := math.Atan2(vehicle.Lateral_speed / 1000.0, speedForSlip)
	velocityLead := blockKartVehicleClamp(vehicle.Yaw_rate * 0.055 + slipAngle * 0.20, -0.09, 0.09)
	target := blockKartVehicleWrapRadians(vehicle.Heading_radians + velocityLead)
	maximumLag := 0.105
	springFrequency := 15.0
	if drifting || vehicle.Drift_blend > 0.2 {
		maximumLag = 0.17
		springFrequency = 11.5
	}
	error := blockKartVehicleWrapRadians(target - vehicle.Camera_heading_radians)
	error = blockKartVehicleClamp(error, -maximumLag, maximumLag)
	acceleration := error * springFrequency * springFrequency -
		vehicle.Camera_yaw_velocity * 2.0 * springFrequency
	vehicle.Camera_yaw_velocity += acceleration * deltaSeconds
	vehicle.Camera_yaw_velocity = blockKartVehicleClamp(vehicle.Camera_yaw_velocity, -4.2, 4.2)
	vehicle.Camera_heading_radians = blockKartVehicleWrapRadians(vehicle.Camera_heading_radians +
		vehicle.Camera_yaw_velocity * deltaSeconds)
	remaining := blockKartVehicleWrapRadians(target - vehicle.Camera_heading_radians)
	if remaining > maximumLag {
		vehicle.Camera_heading_radians = blockKartVehicleWrapRadians(target - maximumLag)
	} else if remaining < -maximumLag {
		vehicle.Camera_heading_radians = blockKartVehicleWrapRadians(target + maximumLag)
	}
}

func (game *BlockKart) updateVehicleDrift(control KartControl, deltaSeconds float64) {
	absoluteSpeed := math.Abs(game.Vehicle.Forward_speed)
	steer := control.Steer_milli
	driftEligible := control.Drift && absoluteSpeed > 9500 &&
		(game.WasDrifting || math.Abs(float64(steer)) > 260)
	if driftEligible {
		if !game.WasDrifting {
			if steer < 0 {
				game.DriftDirection = -1
			} else {
				game.DriftDirection = 1
			}
			game.DriftCharge_milli = 0
		}
		game.Drifting = true
		chargePerSecond := 125.0 + absoluteSpeed / 170.0 + math.Abs(float64(steer)) / 11.0
		if steer != 0 && (steer < 0) != (game.DriftDirection < 0) {
			chargePerSecond += 105.0
		}
		chargeGain := uint32(chargePerSecond * deltaSeconds)
		if chargeGain == 0 {
			chargeGain = 1
		}
		game.DriftCharge_milli += chargeGain
		if game.DriftCharge_milli > 1800 {
			game.DriftCharge_milli = 1800
		}
		game.DriftStage = 0
		if game.DriftCharge_milli >= 480 {
			game.DriftStage = 1
		}
		if game.DriftCharge_milli >= 980 {
			game.DriftStage = 2
		}
		if game.DriftCharge_milli >= 1520 {
			game.DriftStage = 3
		}
	} else {
		game.Drifting = false
		if game.WasDrifting {
			if game.DriftCharge_milli >= 1520 {
				game.MiniTurbo_ticks = blockKartTicksPerSecond * 3 / 2
			} else if game.DriftCharge_milli >= 980 {
				game.MiniTurbo_ticks = blockKartTicksPerSecond
			} else if game.DriftCharge_milli >= 480 {
				game.MiniTurbo_ticks = blockKartTicksPerSecond / 2
			}
		}
		game.DriftCharge_milli = 0
		game.DriftStage = 0
		game.DriftDirection = 0
	}
	game.WasDrifting = game.Drifting
}

func (game *BlockKart) publishVehiclePresentation(deltaSeconds float64) {
	game.Steering_milli = int32(-game.Vehicle.Wheel_angle_radians * 1000.0)
	speedRatio := blockKartVehicleClamp(math.Abs(game.Vehicle.Forward_speed) /
		blockKartVehicleNormalMaximumSpeed, 0, 1)
	dynamicRoll := -game.Vehicle.Lateral_acceleration / 1000.0 * 0.0065
	leanRadians := game.Vehicle.Road_roll_radians + dynamicRoll
	leanTarget := blockKartClampInt32(int32(leanRadians * 1000.0), -145, 145)
	game.ChassisLean_milliradians = blockKartApproachInt32(game.ChassisLean_milliradians, leanTarget, int32(420.0 *
		deltaSeconds))
	dynamicPitch := -game.Vehicle.Longitudinal_acceleration / 1000.0 * 0.0042
	pitchRadians := game.Vehicle.Road_pitch_radians + dynamicPitch
	pitchTarget := blockKartClampInt32(int32(pitchRadians * 1000.0), -115, 115)
	game.ChassisPitch_milliradians = blockKartApproachInt32(game.ChassisPitch_milliradians, pitchTarget, int32(360.0 *
		deltaSeconds))
	suspensionTarget := int32(game.Vehicle.Suspension_offset_milli)
	suspensionTarget = blockKartClampInt32(suspensionTarget, -110, 95)
	game.SuspensionHeave_milli = blockKartApproachInt32(game.SuspensionHeave_milli, suspensionTarget, int32(1100.0 *
		deltaSeconds))
	spinStep := int32(game.Vehicle.Forward_speed * deltaSeconds / blockKartVehicleWheelRadiusMilli *
		1000.0)
	game.WheelSpin_milliradians = blockKartWrapMilliRadians(game.WheelSpin_milliradians + spinStep)
	if speedRatio < 0.02 {
		game.WheelSpin_milliradians = blockKartWrapMilliRadians(game.WheelSpin_milliradians)
	}
}

func blockKartVehicleApproach(current float64, target float64, maximumStep float64) float64 {
	if current < target {
		current += maximumStep
		if current > target {
			return target
		}
		return current
	}
	if current > target {
		current -= maximumStep
		if current < target {
			return target
		}
	}
	return current
}

func blockKartVehicleWrapRadians(value float64) float64 {
	for value > math.Pi {
		value -= math.Pi * 2.0
	}
	for value < -math.Pi {
		value += math.Pi * 2.0
	}
	return value
}

func blockKartVehicleClamp(value float64, minimum float64, maximum float64) float64 {
	if value < minimum {
		return minimum
	}
	if value > maximum {
		return maximum
	}
	return value
}

func blockKartVehicleSteeringInput(value float64, minimum float64, maximum float64) float64 {
	value = blockKartVehicleClamp(value, minimum, maximum)
	magnitude := math.Abs(value)
	const deadzone = 0.035
	if magnitude <= deadzone {
		return 0
	}
	magnitude = (magnitude - deadzone) / (1.0 - deadzone)
	if value < 0 {
		return -magnitude
	}
	return magnitude
}

func blockKartClampInt32(value int32, minimum int32, maximum int32) int32 {
	if value < minimum {
		return minimum
	}
	if value > maximum {
		return maximum
	}
	return value
}

func blockKartApproachInt32(current int32, target int32, step int32) int32 {
	if current < target {
		current += step
		if current > target {
			return target
		}
		return current
	}
	if current > target {
		current -= step
		if current < target {
			return target
		}
	}
	return current
}
