package main

import (
	"errors"
	"math"
	"github.com/vo-lang/voplay"
)

const (
	blockKartVehicleSubsteps uint32 = 2
	blockKartVehicleNormalMaximumSpeed float64 = 26000.0
	blockKartVehicleBoostMaximumSpeed float64 = 34000.0
	blockKartVehicleOffRoadMaximumSpeed float64 = 14000.0
	blockKartVehicleReverseMaximumSpeed float64 = 8500.0
	blockKartVehicleWheelbase float64 = 2350.0
)

// BlockKartVehicleController owns the complete simulated state of the hero kart.
// Control commands, wheel angle, rigid-body yaw, and tire slip are intentionally
// separate so a digital input edge can never rotate or translate the kart directly.
type BlockKartVehicleController struct {
	Initialized bool
	Heading_radians float64
	Camera_heading_radians float64
	Camera_yaw_velocity float64
	Steer_command float64
	Wheel_angle_radians float64
	Forward_speed float64
	Lateral_speed float64
	Yaw_rate float64
	Longitudinal_acceleration float64
	Drift_blend float64
	Suspended_height_milli float64
	Suspension_velocity_milli_per_second float64
	Suspension_offset_milli float64
}

func (vehicle *BlockKartVehicleController) Reset(transform Transform) {
	if vehicle == nil {
		return
	}
	vehicle.Initialized = true
	vehicle.Heading_radians = float64(transform.Yaw_milliradians) / 1000.0
	vehicle.Camera_heading_radians = vehicle.Heading_radians
	vehicle.Camera_yaw_velocity = 0
	vehicle.Steer_command = 0
	vehicle.Wheel_angle_radians = 0
	vehicle.Forward_speed = 0
	vehicle.Lateral_speed = 0
	vehicle.Yaw_rate = 0
	vehicle.Longitudinal_acceleration = 0
	vehicle.Drift_blend = 0
	vehicle.Suspended_height_milli = float64(transform.Y)
	vehicle.Suspension_velocity_milli_per_second = 0
	vehicle.Suspension_offset_milli = 0
}

func (game *BlockKart) drive(tick voplay.TickBatch) error {
	control, ok := game.Controls.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: read vehicle control")
	}
	velocity, ok := game.Velocities.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: read vehicle velocity")
	}
	transform, ok := game.Transforms.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: read vehicle transform")
	}
	state, ok := game.KartStates.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: read vehicle state")
	}
	if !game.Vehicle.Initialized {
		game.Vehicle.Reset(transform)
	}
	if game.Paused || state.Countdown_ticks != 0 || state.Finished {
		return game.holdVehicle(velocity, transform, state)
	}
	deltaSeconds := float64(tick.FixedTickNanos) / 1000000000.0
	if deltaSeconds <= 0 || deltaSeconds > 0.1 {
		return errors.New("blockkart: invalid vehicle delta")
	}
	if game.StartFlash_ticks != 0 {
		game.StartFlash_ticks--
	}
	road := game.nearestRoadSample(transform)
	game.OffRoad = road.Distance_milli > road.Half_width_milli - 900
	game.Vehicle.Forward_speed = float64(state.Speed_per_second)
	game.updateVehicleDrift(control, deltaSeconds)
	miniTurbo := game.MiniTurbo_ticks != 0
	if game.MiniTurbo_ticks != 0 {
		game.MiniTurbo_ticks--
	}
	boosting := control.Boost || state.Boost_ticks != 0 || miniTurbo
	// Gameplay and simulation share the same steering sign: negative turns left
	// and positive turns right. The authored kart's mirrored mesh basis is handled
	// only by presentation and must never leak back into vehicle motion.
	steerTarget := blockKartVehicleSteeringInput(float64(control.Steer_milli) / 1000.0, -1, 1)
	throttle := blockKartVehicleClamp(float64(control.Throttle_milli) / 1000.0, 0, 1)
	brake := blockKartVehicleClamp(float64(control.Brake_milli) / 1000.0, 0, 1)
	previousSpeed := game.Vehicle.Forward_speed
	substepSeconds := deltaSeconds / float64(blockKartVehicleSubsteps)
	for substep := uint32(0); substep < blockKartVehicleSubsteps; substep++ {
		game.Vehicle.step(steerTarget, throttle, brake, boosting, miniTurbo, game.OffRoad, game.Drifting, game.DriftDirection, substepSeconds)
	}
	game.Vehicle.stepSuspension(float64(transform.Y), deltaSeconds)
	game.Vehicle.Longitudinal_acceleration = (game.Vehicle.Forward_speed - previousSpeed) /
		deltaSeconds
	transform.Yaw_milliradians = blockKartWrapMilliRadians(int32(game.Vehicle.Heading_radians * 1000.0))
	heading := game.Vehicle.Heading_radians
	forwardX := math.Sin(heading)
	forwardZ := math.Cos(heading)
	rightX := math.Cos(heading)
	rightZ := -math.Sin(heading)
	velocity.X_per_second = int64(forwardX * game.Vehicle.Forward_speed +
		rightX * game.Vehicle.Lateral_speed)
	velocity.Z_per_second = int64(forwardZ * game.Vehicle.Forward_speed +
		rightZ * game.Vehicle.Lateral_speed)
	velocity.Yaw_per_second = int32(game.Vehicle.Yaw_rate * 1000.0)
	state.Speed_per_second = int64(game.Vehicle.Forward_speed)
	elapsedNanos := tick.FixedTickNanos + game.ElapsedNanosRemainder
	state.Elapsed_millis += elapsedNanos / 1000000
	game.ElapsedNanosRemainder = elapsedNanos % 1000000
	if state.Boost_ticks != 0 {
		state.Boost_ticks--
	}
	if game.CollisionShake_ticks != 0 {
		game.CollisionShake_ticks--
	}
	game.publishVehiclePresentation(deltaSeconds)
	if !game.Transforms.Upsert(game.KartEntity, transform) ||
		!game.Velocities.Upsert(game.KartEntity, velocity) ||
		!game.KartStates.Upsert(game.KartEntity, state) {
		return errors.New("blockkart: publish vehicle state")
	}
	game.BoostPressed = boosting
	return nil
}

func (game *BlockKart) holdVehicle(velocity Velocity, transform Transform, state KartState) error {
	if state.Countdown_ticks != 0 && !game.Paused {
		state.Countdown_ticks--
		if state.Countdown_ticks == 0 {
			game.StartFlash_ticks = blockKartTicksPerSecond * 4 / 5
		}
	}
	game.Vehicle.Reset(transform)
	state.Speed_per_second = 0
	velocity.X_per_second = 0
	velocity.Z_per_second = 0
	velocity.Yaw_per_second = 0
	game.BoostPressed = false
	game.Steering_milli = 0
	game.ChassisLean_milliradians = blockKartApproachInt32(game.ChassisLean_milliradians, 0, 12)
	game.ChassisPitch_milliradians = blockKartApproachInt32(game.ChassisPitch_milliradians, 0, 10)
	game.SuspensionHeave_milli = blockKartApproachInt32(game.SuspensionHeave_milli, 0, 18)
	game.Drifting = false
	game.WasDrifting = false
	game.DriftCharge_milli = 0
	game.DriftStage = 0
	game.DriftDirection = 0
	if !game.Velocities.Upsert(game.KartEntity, velocity) ||
		!game.KartStates.Upsert(game.KartEntity, state) {
		return errors.New("blockkart: hold vehicle state")
	}
	return nil
}

func (vehicle *BlockKartVehicleController) step(steerTarget float64, throttle float64, brake float64, boosting bool, miniTurbo bool, offRoad bool, drifting bool, driftDirection int32, deltaSeconds float64) {
	vehicle.stepSteering(steerTarget, offRoad, deltaSeconds)
	vehicle.stepDriftBlend(drifting, deltaSeconds)
	vehicle.stepLongitudinal(throttle, brake, boosting, miniTurbo, offRoad, drifting, deltaSeconds)
	vehicle.stepTires(offRoad, drifting, driftDirection, throttle, brake, deltaSeconds)
	vehicle.Heading_radians += vehicle.Yaw_rate * deltaSeconds
	vehicle.Heading_radians = blockKartVehicleWrapRadians(vehicle.Heading_radians)
	vehicle.stepCamera(drifting, deltaSeconds)
}

func (vehicle *BlockKartVehicleController) stepDriftBlend(drifting bool, deltaSeconds float64) {
	target := 0.0
	rate := 8.5
	if drifting {
		target = 1.0
		rate = 6.5
	}
	vehicle.Drift_blend = blockKartVehicleApproach(vehicle.Drift_blend, target, rate * deltaSeconds)
}

func (vehicle *BlockKartVehicleController) stepCamera(drifting bool, deltaSeconds float64) {
	speedForSlip := math.Max(math.Abs(vehicle.Forward_speed), 1200.0)
	slipAngle := math.Atan2(vehicle.Lateral_speed, speedForSlip)
	lookAhead := blockKartVehicleClamp(vehicle.Yaw_rate * 0.085 + slipAngle * 0.28, -0.13, 0.13)
	target := blockKartVehicleWrapRadians(vehicle.Heading_radians + lookAhead)
	maximumLag := 0.16
	springFrequency := 12.5
	if drifting || vehicle.Drift_blend > 0 {
		maximumLag = 0.24
		springFrequency = 9.0
	}
	error := blockKartVehicleWrapRadians(target - vehicle.Camera_heading_radians)
	error = blockKartVehicleClamp(error, -maximumLag, maximumLag)
	acceleration := error * springFrequency * springFrequency -
		vehicle.Camera_yaw_velocity * 2.0 * springFrequency
	vehicle.Camera_yaw_velocity += acceleration * deltaSeconds
	vehicle.Camera_yaw_velocity = blockKartVehicleClamp(vehicle.Camera_yaw_velocity, -3.2, 3.2)
	vehicle.Camera_heading_radians = blockKartVehicleWrapRadians(vehicle.Camera_heading_radians +
		vehicle.Camera_yaw_velocity * deltaSeconds)
	remainingError := blockKartVehicleWrapRadians(target - vehicle.Camera_heading_radians)
	if remainingError > maximumLag {
		vehicle.Camera_heading_radians = blockKartVehicleWrapRadians(target - maximumLag)
		if vehicle.Camera_yaw_velocity < 0 {
			vehicle.Camera_yaw_velocity = 0
		}
	} else if remainingError < -maximumLag {
		vehicle.Camera_heading_radians = blockKartVehicleWrapRadians(target + maximumLag)
		if vehicle.Camera_yaw_velocity > 0 {
			vehicle.Camera_yaw_velocity = 0
		}
	}
}

func (vehicle *BlockKartVehicleController) stepSteering(target float64, offRoad bool, deltaSeconds float64) {
	reversing := target != 0 && vehicle.Steer_command != 0 &&
		(vehicle.Steer_command < 0) != (target < 0)
	speedRatio := blockKartVehicleClamp(math.Abs(vehicle.Forward_speed) /
		blockKartVehicleNormalMaximumSpeed, 0, 1)
	commandRate := 10.0 - speedRatio * 1.8
	if target == 0 {
		commandRate = 13.5
	} else if reversing {
		commandRate = 17.0
	}
	vehicle.Steer_command = blockKartVehicleApproach(vehicle.Steer_command, target, commandRate *
		deltaSeconds)
	speedBlend := speedRatio * speedRatio * (3.0 - 2.0 * speedRatio)
	maximumWheelAngle := 0.46 + (0.205 - 0.46) * speedBlend
	if offRoad {
		maximumWheelAngle *= 0.96
	}
	shapedCommand := math.Pow(math.Abs(vehicle.Steer_command), 1.14)
	if vehicle.Steer_command < 0 {
		shapedCommand = -shapedCommand
	}
	wheelTarget := shapedCommand * maximumWheelAngle
	wheelReversing := wheelTarget != 0 && vehicle.Wheel_angle_radians != 0 &&
		(vehicle.Wheel_angle_radians < 0) != (wheelTarget < 0)
	wheelRate := 8.5
	if target == 0 {
		wheelRate = 13.0
	} else if reversing || wheelReversing {
		wheelRate = 17.0
	}
	vehicle.Wheel_angle_radians = blockKartVehicleApproach(vehicle.Wheel_angle_radians, wheelTarget, wheelRate *
		deltaSeconds)
}

func (vehicle *BlockKartVehicleController) stepLongitudinal(throttle float64, brake float64, boosting bool, miniTurbo bool, offRoad bool, drifting bool, deltaSeconds float64) {
	speed := vehicle.Forward_speed
	absoluteSpeed := math.Abs(speed)
	speedRatio := blockKartVehicleClamp(absoluteSpeed / blockKartVehicleNormalMaximumSpeed, 0, 1)
	engineAcceleration := 10800.0 * (1.0 - speedRatio * 0.70)
	if engineAcceleration < 3000 {
		engineAcceleration = 3000
	}
	surfaceDrive := 1.0
	if offRoad {
		surfaceDrive = 0.55
	}
	acceleration := 0.0
	if throttle > 0 {
		if speed < -300 {
			acceleration += 19000.0 * throttle
		} else {
			acceleration += engineAcceleration * throttle * surfaceDrive
		}
	}
	if brake > 0 {
		if speed > 300 {
			acceleration -= 21000.0 * brake
		} else {
			acceleration -= 7200.0 * brake
		}
	}
	if boosting && speed >= 0 {
		boostAcceleration := 5200.0
		if miniTurbo {
			boostAcceleration = 6800.0
		}
		acceleration += boostAcceleration
	}
	if throttle == 0 && brake == 0 {
		rollingResistance := 750.0 + absoluteSpeed * 0.032
		if speed > 0 {
			acceleration -= rollingResistance
		} else if speed < 0 {
			acceleration += rollingResistance
		}
	} else {
		acceleration -= speed * 0.035
	}
	corneringLoad := math.Abs(vehicle.Yaw_rate * speed)
	cornerScrub := corneringLoad * (0.032 + math.Abs(vehicle.Steer_command) * 0.072)
	if drifting {
		cornerScrub *= 0.48
	}
	if speed > 0 {
		acceleration -= cornerScrub
	} else if speed < 0 {
		acceleration += cornerScrub
	}
	if !boosting && speed > blockKartVehicleNormalMaximumSpeed {
		acceleration -= (speed - blockKartVehicleNormalMaximumSpeed) * 0.85
	}
	if offRoad {
		acceleration -= speed * 0.20
		if speed > blockKartVehicleOffRoadMaximumSpeed {
			acceleration -= (speed - blockKartVehicleOffRoadMaximumSpeed) * 1.10
		}
	}
	nextSpeed := speed + acceleration * deltaSeconds
	if throttle == 0 && brake == 0 && (speed > 0 && nextSpeed < 0 || speed < 0 && nextSpeed > 0) {
		nextSpeed = 0
	}
	if nextSpeed > blockKartVehicleBoostMaximumSpeed {
		nextSpeed = blockKartVehicleBoostMaximumSpeed
	}
	if nextSpeed < -blockKartVehicleReverseMaximumSpeed {
		nextSpeed = -blockKartVehicleReverseMaximumSpeed
	}
	vehicle.Forward_speed = nextSpeed
}

func (vehicle *BlockKartVehicleController) stepTires(offRoad bool, drifting bool, driftDirection int32, throttle float64, brake float64, deltaSeconds float64) {
	absoluteSpeed := math.Abs(vehicle.Forward_speed)
	desiredYawRate := 0.0
	if absoluteSpeed > 100 {
		desiredYawRate = vehicle.Forward_speed / blockKartVehicleWheelbase *
			math.Tan(vehicle.Wheel_angle_radians)
	}
	speedRatio := blockKartVehicleClamp(absoluteSpeed / blockKartVehicleNormalMaximumSpeed, 0, 1)
	maximumLateralAcceleration := 33500.0 - speedRatio * 4500.0
	if offRoad {
		maximumLateralAcceleration = 19500.0 - speedRatio * 2500.0
	}
	driftBlend := vehicle.Drift_blend
	driftCommit := 0.0
	counterSteer := 0.0
	if driftDirection != 0 {
		signedSteer := vehicle.Steer_command * float64(driftDirection)
		driftCommit = blockKartVehicleClamp(signedSteer, 0, 1)
		counterSteer = blockKartVehicleClamp(-signedSteer, 0, 1)
	}
	if driftBlend > 0 {
		driftLateralAcceleration := 46000.0
		if offRoad {
			driftLateralAcceleration = 20000.0
		}
		maximumLateralAcceleration += (driftLateralAcceleration - maximumLateralAcceleration) * driftBlend
		driftYawAssist := 0.30 + driftCommit * 0.17 - counterSteer * 0.20
		desiredYawRate += float64(driftDirection) * driftYawAssist * driftBlend
	}
	loadTransfer := blockKartVehicleClamp(brake * 0.20 - throttle * 0.055, -0.055, 0.20)
	desiredYawRate *= 1.0 + loadTransfer
	if driftBlend == 0 && absoluteSpeed > 1200 {
		slipAngle := math.Atan2(vehicle.Lateral_speed, math.Max(absoluteSpeed, 1200.0))
		stabilityStrength := 3.2 * (1.0 - math.Abs(vehicle.Steer_command) * 0.55)
		desiredYawRate += blockKartVehicleClamp(slipAngle * stabilityStrength, -0.42, 0.42)
	}
	maximumYawRate := 2.05
	if absoluteSpeed > 3500 {
		maximumYawRate = maximumLateralAcceleration / absoluteSpeed
		if maximumYawRate > 2.05 {
			maximumYawRate = 2.05
		}
	}
	desiredYawRate = blockKartVehicleClamp(desiredYawRate, -maximumYawRate, maximumYawRate)
	yawAcceleration := 11.0 - speedRatio * 2.0
	if math.Abs(vehicle.Steer_command) < 0.025 && driftBlend == 0 {
		desiredYawRate = 0
		yawAcceleration = 13.0
	} else if vehicle.Yaw_rate != 0 && (vehicle.Yaw_rate < 0) != (desiredYawRate < 0) {
		yawAcceleration = 15.0
	}
	if offRoad {
		yawAcceleration *= 0.86
	}
	vehicle.Yaw_rate = blockKartVehicleApproach(vehicle.Yaw_rate, desiredYawRate, yawAcceleration *
		deltaSeconds)
	if driftBlend > 0 {
		targetSlipAngle := -float64(driftDirection) *
			(0.13 + driftCommit * 0.10 - counterSteer * 0.085) * driftBlend
		targetSlip := math.Tan(targetSlipAngle) * absoluteSpeed
		vehicle.Lateral_speed = blockKartVehicleApproach(vehicle.Lateral_speed, targetSlip, (13000.0 +
			counterSteer * 10500.0) *
			deltaSeconds)
	} else {
		gripAcceleration := 34000.0 - speedRatio * 6500.0
		if offRoad {
			gripAcceleration = 22000.0 - speedRatio * 2500.0
		}
		vehicle.Lateral_speed = blockKartVehicleApproach(vehicle.Lateral_speed, 0, gripAcceleration *
			deltaSeconds)
	}
	maximumSlip := absoluteSpeed * 0.28
	vehicle.Lateral_speed = blockKartVehicleClamp(vehicle.Lateral_speed, -maximumSlip, maximumSlip)
}

func (vehicle *BlockKartVehicleController) stepSuspension(roadHeight_milli float64, deltaSeconds float64) {
	displacement := roadHeight_milli - vehicle.Suspended_height_milli
	acceleration := displacement * 122.0 - vehicle.Suspension_velocity_milli_per_second * 18.5
	acceleration = blockKartVehicleClamp(acceleration, -42000, 42000)
	vehicle.Suspension_velocity_milli_per_second += acceleration * deltaSeconds
	vehicle.Suspended_height_milli += vehicle.Suspension_velocity_milli_per_second * deltaSeconds
	offset := vehicle.Suspended_height_milli - roadHeight_milli
	if offset < -135 {
		vehicle.Suspended_height_milli = roadHeight_milli - 135
		if vehicle.Suspension_velocity_milli_per_second < 0 {
			vehicle.Suspension_velocity_milli_per_second *= -0.16
		}
	} else if offset > 105 {
		vehicle.Suspended_height_milli = roadHeight_milli + 105
		if vehicle.Suspension_velocity_milli_per_second > 0 {
			vehicle.Suspension_velocity_milli_per_second *= -0.16
		}
	}
	vehicle.Suspension_offset_milli = vehicle.Suspended_height_milli - roadHeight_milli
}

func (vehicle *BlockKartVehicleController) ApplyImpact(obstacleDirectionX float64, obstacleDirectionZ float64) float64 {
	if vehicle == nil {
		return 0
	}
	heading := vehicle.Heading_radians
	forwardX := math.Sin(heading)
	forwardZ := math.Cos(heading)
	rightX := math.Cos(heading)
	rightZ := -math.Sin(heading)
	forwardImpact := blockKartVehicleClamp(obstacleDirectionX * forwardX +
		obstacleDirectionZ * forwardZ, -1, 1)
	sideImpact := blockKartVehicleClamp(obstacleDirectionX * rightX + obstacleDirectionZ * rightZ, -1, 1)
	retainedSpeed := 0.80 - math.Abs(forwardImpact) * 0.18
	if retainedSpeed < 0.58 {
		retainedSpeed = 0.58
	}
	vehicle.Forward_speed *= retainedSpeed
	vehicle.Lateral_speed -= sideImpact * 2800.0
	vehicle.Yaw_rate -= sideImpact * 0.34
	vehicle.Yaw_rate = blockKartVehicleClamp(vehicle.Yaw_rate, -0.82, 0.82)
	vehicle.Steer_command *= 0.72
	vehicle.Wheel_angle_radians *= 0.78
	vehicle.Drift_blend *= 0.45
	return sideImpact
}

func (game *BlockKart) updateVehicleDrift(control KartControl, deltaSeconds float64) {
	absoluteSpeed := math.Abs(game.Vehicle.Forward_speed)
	driftEligible := control.Drift && absoluteSpeed > 10000 &&
		(game.WasDrifting || math.Abs(float64(control.Steer_milli)) > 280)
	if driftEligible {
		if !game.WasDrifting {
			if control.Steer_milli < 0 {
				game.DriftDirection = -1
			} else {
				game.DriftDirection = 1
			}
			game.DriftCharge_milli = 0
		}
		game.Drifting = true
		chargePerSecond := 120.0 + absoluteSpeed / 180.0 + math.Abs(float64(control.Steer_milli)) / 12.0
		if control.Steer_milli != 0 && (control.Steer_milli < 0) != (game.DriftDirection < 0) {
			chargePerSecond += 100.0
		}
		chargeGain := uint32(chargePerSecond * deltaSeconds)
		if chargeGain == 0 {
			chargeGain = 1
		}
		game.DriftCharge_milli += chargeGain
		if game.DriftCharge_milli > 1800 {
			game.DriftCharge_milli = 1800
		}
		game.DriftStage = 0
		if game.DriftCharge_milli >= 480 {
			game.DriftStage = 1
		}
		if game.DriftCharge_milli >= 980 {
			game.DriftStage = 2
		}
		if game.DriftCharge_milli >= 1520 {
			game.DriftStage = 3
		}
	} else {
		game.Drifting = false
		if game.WasDrifting {
			if game.DriftCharge_milli >= 1520 {
				game.MiniTurbo_ticks = blockKartTicksPerSecond * 3 / 2
			} else if game.DriftCharge_milli >= 980 {
				game.MiniTurbo_ticks = blockKartTicksPerSecond
			} else if game.DriftCharge_milli >= 480 {
				game.MiniTurbo_ticks = blockKartTicksPerSecond / 2
			}
		}
		game.DriftCharge_milli = 0
		game.DriftStage = 0
		game.DriftDirection = 0
	}
	game.WasDrifting = game.Drifting
}

func (game *BlockKart) publishVehiclePresentation(deltaSeconds float64) {
	game.Steering_milli = int32(-game.Vehicle.Wheel_angle_radians * 1000.0)
	speedRatio := blockKartVehicleClamp(math.Abs(game.Vehicle.Forward_speed) /
		blockKartVehicleNormalMaximumSpeed, 0, 1)
	leanTarget := int32(-game.Vehicle.Yaw_rate * speedRatio * 78.0)
	leanTarget = blockKartClampInt32(leanTarget, -82, 82)
	game.ChassisLean_milliradians = blockKartApproachInt32(game.ChassisLean_milliradians, leanTarget, int32(250.0 *
		deltaSeconds))
	pitchTarget := int32(game.Vehicle.Longitudinal_acceleration / 15000.0 * 46.0)
	pitchTarget = blockKartClampInt32(pitchTarget, -54, 54)
	game.ChassisPitch_milliradians = blockKartApproachInt32(game.ChassisPitch_milliradians, pitchTarget, int32(210.0 *
		deltaSeconds))
	suspensionTarget := int32(game.Vehicle.Suspension_offset_milli)
	suspensionTarget = blockKartClampInt32(suspensionTarget, -135, 105)
	game.SuspensionHeave_milli = blockKartApproachInt32(game.SuspensionHeave_milli, suspensionTarget, int32(900.0 *
		deltaSeconds))
	spinStep := int32(game.Vehicle.Forward_speed * deltaSeconds / 440.0 * 1000.0)
	game.WheelSpin_milliradians = blockKartWrapMilliRadians(game.WheelSpin_milliradians + spinStep)
}

func blockKartVehicleApproach(current float64, target float64, maximumStep float64) float64 {
	if current < target {
		current += maximumStep
		if current > target {
			return target
		}
		return current
	}
	if current > target {
		current -= maximumStep
		if current < target {
			return target
		}
	}
	return current
}

func blockKartVehicleWrapRadians(value float64) float64 {
	for value > math.Pi {
		value -= math.Pi * 2.0
	}
	for value < -math.Pi {
		value += math.Pi * 2.0
	}
	return value
}

func blockKartVehicleClamp(value float64, minimum float64, maximum float64) float64 {
	if value < minimum {
		return minimum
	}
	if value > maximum {
		return maximum
	}
	return value
}

func blockKartVehicleSteeringInput(value float64, minimum float64, maximum float64) float64 {
	value = blockKartVehicleClamp(value, minimum, maximum)
	magnitude := math.Abs(value)
	const deadzone = 0.045
	if magnitude <= deadzone {
		return 0
	}
	magnitude = (magnitude - deadzone) / (1.0 - deadzone)
	if value < 0 {
		return -magnitude
	}
	return magnitude
}

func blockKartClampInt32(value int32, minimum int32, maximum int32) int32 {
	if value < minimum {
		return minimum
	}
	if value > maximum {
		return maximum
	}
	return value
}

func blockKartApproachInt32(current int32, target int32, step int32) int32 {
	if current < target {
		current += step
		if current > target {
			return target
		}
		return current
	}
	if current > target {
		current -= step
		if current < target {
			return target
		}
	}
	return current
}
