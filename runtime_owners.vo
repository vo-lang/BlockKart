package main

import (
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

type RaceSession struct {
	State string
	Lap int
	TotalLaps int
	Started bool
	Finished bool
}

type KartRig struct {
	Player *scene3d.Entity
	Vehicle *scene3d.Vehicle
	Controller *scene3d.KartController
	PhysicsSession *scene3d.VehiclePhysicsSession
}

type TrackRuntime struct {
	Track *scene3d.Track
	Spawn *scene3d.TrackSpawnResult
	Spec BlockKartTrackSpec
	renderStressPrimitive10kBatch *PrimitiveBatch
	renderStressPrimitive10kIndex int
	renderStressPrimitive10kCenter voplay.Vec3
	renderStressPrimitive10kRotations []voplay.Quat
	renderStressPrimitive10kScales []voplay.Vec3
}

type HUDPresenter struct {
	LastState BlockKartHUDState
	DebugLines []string
}

type PerfReporter struct {
	LastSnapshot voplay.PerfSnapshot
	PollFrame int
}

type AssetRuntimeCache struct {
	Cache *BlockKartRuntimeCache
	scope *voplay.AssetScope
}

type StructuredFailureReport struct {
	Report BlockKartFailureReport
}

func (r *RaceSession) Reset(totalLaps int) {
	if r == nil {
		return
	}
	r.State = BlockKartRaceStateReady
	r.Lap = 1
	r.TotalLaps = totalLaps
	r.Started = false
	r.Finished = false
}

func (k *KartRig) Bind(player *scene3d.Entity, vehicle *scene3d.Vehicle, controller *scene3d.KartController, session *scene3d.VehiclePhysicsSession) {
	if k == nil {
		return
	}
	k.Player = player
	k.Vehicle = vehicle
	k.Controller = controller
	k.PhysicsSession = session
}

func (k *KartRig) StepPhysics(delta float64, intent scene3d.VehicleIntent) scene3d.VehicleTelemetry {
	if k == nil || k.PhysicsSession == nil {
		return scene3d.VehicleTelemetry{}
	}
	return k.PhysicsSession.Step(delta, intent)
}

func (t *TrackRuntime) Bind(track *scene3d.Track, spawn *scene3d.TrackSpawnResult, spec BlockKartTrackSpec) {
	if t == nil {
		return
	}
	t.Track = track
	t.Spawn = spawn
	t.Spec = spec
}

func (h *HUDPresenter) Capture(state BlockKartHUDState, lines []string) {
	if h == nil {
		return
	}
	h.LastState = state
	h.DebugLines = lines
}

func (p *PerfReporter) Record(snapshot voplay.PerfSnapshot, frame int) {
	if p == nil {
		return
	}
	p.LastSnapshot = snapshot
	p.PollFrame = frame
}

func (a *AssetRuntimeCache) Bind(cache *BlockKartRuntimeCache) {
	if a == nil {
		return
	}
	a.Cache = cache
}

func (a *AssetRuntimeCache) Scope() *voplay.AssetScope {
	if a == nil {
		return nil
	}
	if a.Cache != nil {
		return a.Cache.scope
	}
	return a.scope
}

func (a *AssetRuntimeCache) Close() {
	if a == nil || a.scope == nil {
		return
	}
	a.scope.Close()
	a.scope = nil
}
