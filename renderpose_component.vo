package main

type RenderPose struct {
	Previous_tick uint64
	Current_tick uint64
	Previous_transform []byte
	Current_transform []byte
}

type RenderPoseStore struct {
	DenseEntities []uint64
	DenseValues []RenderPose
	Sparse []uint32
	Added []uint64
	Changed []uint64
	Removed []uint64
	Revision uint64
	MaxEntities uint32
	MaxChanges uint32
}

type RenderPoseQuery struct {
	Store *RenderPoseStore
	Cursor uint32
	ExpectedRevision uint64
}

func NewRenderPoseStore(maxEntities uint32, maxChanges uint32) (*RenderPoseStore, bool) {
	if maxEntities == 0 || maxEntities > 1000000 || maxChanges == 0 || maxChanges > 1000000 { return nil, false }
	return &RenderPoseStore{Sparse: make([]uint32, int(maxEntities)+1), MaxEntities: maxEntities, MaxChanges: maxChanges}, true
}

func (store *RenderPoseStore) Get(entity uint64) (RenderPose, bool) {
	var zero RenderPose
	if entity == 0 { return zero, false }
	index := uint32(entity)
	if index == 0 || index > store.MaxEntities { return zero, false }
	slot := store.Sparse[index]
	if slot == 0 { return zero, false }
	dense := int(slot-1)
	if dense >= len(store.DenseEntities) || store.DenseEntities[dense] != entity { return zero, false }
	return store.DenseValues[dense], true
}

func (store *RenderPoseStore) Upsert(entity uint64, value RenderPose) bool {
	changeCount := len(store.Added)+len(store.Changed)+len(store.Removed)
	if entity == 0 || store.Revision == 18446744073709551615 || changeCount >= int(store.MaxChanges) { return false }
	index := uint32(entity)
	if index == 0 || index > store.MaxEntities { return false }
	slot := store.Sparse[index]
	if slot != 0 {
		dense := int(slot-1)
		if dense >= len(store.DenseEntities) || store.DenseEntities[dense] != entity { return false }
		store.DenseValues[dense] = value
		store.Changed = append(store.Changed, entity)
		store.Revision++
		return true
	}
	if len(store.DenseEntities) >= int(store.MaxEntities) { return false }
	insert := 0
	for insert < len(store.DenseEntities) && store.DenseEntities[insert] < entity { insert++ }
	store.DenseEntities = append(store.DenseEntities, 0)
	store.DenseValues = append(store.DenseValues, value)
	cursor := len(store.DenseEntities)-1
	for cursor > insert {
		store.DenseEntities[cursor] = store.DenseEntities[cursor-1]
		store.DenseValues[cursor] = store.DenseValues[cursor-1]
		movedIndex := uint32(store.DenseEntities[cursor])
		store.Sparse[movedIndex] = uint32(cursor+1)
		cursor--
	}
	store.DenseEntities[insert] = entity
	store.DenseValues[insert] = value
	store.Sparse[index] = uint32(insert+1)
	store.Added = append(store.Added, entity)
	store.Revision++
	return true
}

func (store *RenderPoseStore) Remove(entity uint64) bool {
	changeCount := len(store.Added)+len(store.Changed)+len(store.Removed)
	if entity == 0 || store.Revision == 18446744073709551615 || changeCount >= int(store.MaxChanges) { return false }
	index := uint32(entity)
	if index == 0 || index > store.MaxEntities { return false }
	slot := store.Sparse[index]
	if slot == 0 { return false }
	dense := int(slot-1)
	if dense >= len(store.DenseEntities) || store.DenseEntities[dense] != entity { return false }
	for cursor := dense; cursor+1 < len(store.DenseEntities); cursor++ {
		store.DenseEntities[cursor] = store.DenseEntities[cursor+1]
		store.DenseValues[cursor] = store.DenseValues[cursor+1]
		movedIndex := uint32(store.DenseEntities[cursor])
		store.Sparse[movedIndex] = uint32(cursor+1)
	}
	store.DenseEntities = store.DenseEntities[:len(store.DenseEntities)-1]
	store.DenseValues = store.DenseValues[:len(store.DenseValues)-1]
	store.Sparse[index] = 0
	store.Removed = append(store.Removed, entity)
	store.Revision++
	return true
}

func (store *RenderPoseStore) Query() RenderPoseQuery {
	return RenderPoseQuery{Store: store, ExpectedRevision: store.Revision}
}

func (query *RenderPoseQuery) Next() (uint64, RenderPose, bool) {
	var zero RenderPose
	if query.Store == nil || query.ExpectedRevision != query.Store.Revision || int(query.Cursor) >= len(query.Store.DenseEntities) { return 0, zero, false }
	index := int(query.Cursor)
	query.Cursor++
	return query.Store.DenseEntities[index], query.Store.DenseValues[index], true
}

func (store *RenderPoseStore) TakeChanges() ([]uint64, []uint64, []uint64, uint64) {
	added := store.Added
	changed := store.Changed
	removed := store.Removed
	store.Added = nil
	store.Changed = nil
	store.Removed = nil
	return added, changed, removed, store.Revision
}
