package main

import "github.com/vo-lang/voplay/scene3d"

const primitiveAssetPackPath = "assets/blockkart.vpak"

const primitiveMapAssetPath = "assets/maps/primitive_track/blockkart.map.json"

func mustPack(err error) {
	if err != nil {
		panic(err.Error())
	}
}

func main() {
	mustPack(scene3d.WriteBlockKartRuntimePack(primitiveAssetPackPath, primitiveMapAssetPath, "assets/maps/primitive_track", []scene3d.BlockKartRuntimePackFile{
		scene3d.BlockKartRuntimePackFile{Path: "assets/effects/grass_card_atlas.png", Kind: "texture"},
		scene3d.BlockKartRuntimePackFile{Path: "assets/skybox/right.png", Kind: "texture"},
		scene3d.BlockKartRuntimePackFile{Path: "assets/skybox/left.png", Kind: "texture"},
		scene3d.BlockKartRuntimePackFile{Path: "assets/skybox/top.png", Kind: "texture"},
		scene3d.BlockKartRuntimePackFile{Path: "assets/skybox/bottom.png", Kind: "texture"},
		scene3d.BlockKartRuntimePackFile{Path: "assets/skybox/front.png", Kind: "texture"},
		scene3d.BlockKartRuntimePackFile{Path: "assets/skybox/back.png", Kind: "texture"},
		scene3d.BlockKartRuntimePackFile{Path: "assets/audio/kart_engine.wav", Kind: "audio"},
		scene3d.BlockKartRuntimePackFile{Path: "assets/audio/kart_skid.wav", Kind: "audio"},
		scene3d.BlockKartRuntimePackFile{Path: "assets/audio/kart_boost.wav", Kind: "audio"},
		scene3d.BlockKartRuntimePackFile{Path: "assets/audio/kart_grass.wav", Kind: "audio"},
		scene3d.BlockKartRuntimePackFile{Path: "assets/audio/kart_hit.wav", Kind: "audio"},
	}))
	println("packed", primitiveAssetPackPath)
}
