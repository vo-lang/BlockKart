package main

import (
	"github.com/vo-lang/blockkart/runtimepack"
	"os"
)

const primitiveAssetPackOutputEnv = "BLOCKKART_VPAK_OUTPUT"

const primitiveMapAssetPath = "assets/maps/primitive_track/blockkart.map.json"

func mustPack(err error) {
	if err != nil {
		panic(err.Error())
	}
}

func main() {
	outputPath := os.Getenv(primitiveAssetPackOutputEnv)
	if outputPath == "" {
		panic(primitiveAssetPackOutputEnv +
			" is required; publish VPAK files through the transaction builder")
	}
	mustPack(runtimepack.Write(outputPath, primitiveMapAssetPath, "assets/maps/primitive_track", []runtimepack.File{
		runtimepack.File{Path: "assets/effects/grass_card_atlas.png", Kind: "texture"},
		runtimepack.File{Path: "assets/skybox/right.png", Kind: "texture"},
		runtimepack.File{Path: "assets/skybox/left.png", Kind: "texture"},
		runtimepack.File{Path: "assets/skybox/top.png", Kind: "texture"},
		runtimepack.File{Path: "assets/skybox/bottom.png", Kind: "texture"},
		runtimepack.File{Path: "assets/skybox/front.png", Kind: "texture"},
		runtimepack.File{Path: "assets/skybox/back.png", Kind: "texture"},
		runtimepack.File{Path: "assets/audio/kart_engine.wav", Kind: "audio"},
		runtimepack.File{Path: "assets/audio/kart_skid.wav", Kind: "audio"},
		runtimepack.File{Path: "assets/audio/kart_boost.wav", Kind: "audio"},
		runtimepack.File{Path: "assets/audio/kart_grass.wav", Kind: "audio"},
		runtimepack.File{Path: "assets/audio/kart_hit.wav", Kind: "audio"},
	}))
	println("packed", outputPath)
}
