package main

import (
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

const (
	blockKartTargetFPS = 60
	blockKartMaxCatchUpSteps = 1
	blockKartPerfWindowFrames = 300
	blockKartPerfWarmupFrames = 180
	blockKartPerfSnapshotPollFrames = 300
	blockKartPerfStatsEnabled = true
	blockKartPerfReports = true
	blockKartPerfVerboseConsoleReports = false
	blockKartPerfReportMarker = "__VOPLAY_PERF_REPORT__"
	blockKartFixedPhaseConsoleReports = false
	blockKartFixedPhaseLogCooldownFrames = 60
	blockKartFixedStepBudgetMs = 1000.0 / blockKartTargetFPS * 0.85
	blockKartDefaultQualityPreset = "medium"
)

type BlockKartRenderBudget struct {
	TargetFPS int
	ShadowResolution int
	ShadowStrength float64
	ShadowSoftness float64
	ShadowDistance float64
	ShadowFade float64
	ShadowQuality int
	PostProcess scene3d.PostProcessConfig
}

func defaultBlockKartRenderBudget() BlockKartRenderBudget {
	return BlockKartRenderBudget{TargetFPS: blockKartTargetFPS, ShadowResolution: 1024, ShadowStrength: 0.44, ShadowSoftness: 1.4, ShadowDistance: 240, ShadowFade: 70, ShadowQuality: scene3d.ShadowQualityHigh, PostProcess: blockKartPerformancePostProcessConfig()}
}

func blockKartRenderingQuality(settings BlockKartSettings) int {
	settings = blockKartNormalizeSettings(settings)
	if settings.QualityPreset == "low" {
		return scene3d.SceneQualityLow
	}
	if settings.QualityPreset == "high" {
		return scene3d.SceneQualityHigh
	}
	if settings.QualityPreset == "cinematic" {
		return scene3d.SceneQualityCinematic
	}
	return scene3d.SceneQualityMedium
}

func applyBlockKartQualityProfile(scene *scene3d.Scene, settings BlockKartSettings) scene3d.RenderingQualityProfile {
	if scene == nil {
		return scene3d.RenderingQualityConfig(blockKartRenderingQuality(settings))
	}
	return scene.SetRenderingQuality(blockKartRenderingQuality(settings))
}

func blockKartPerformancePostProcessConfig() scene3d.PostProcessConfig {
	return scene3d.PostProcessConfig{BloomThreshold: 1.0, BloomStrength: 0.0, SharpenStrength: 0.0, FxaaStrength: 0.0, ContactAOStrength: 0.0, ContactAORadius: 0.5, ContactAODepthScale: 1.0, ContactAODetailStrength: 0.0, ContactAODetailRadius: 0.35, ContactAONormalBias: 0.0, ContactAOQuality: scene3d.ContactAOQualityOff}
}

func applyBlockKartRenderBudget(profile *scene3d.LightingProfile, budget BlockKartRenderBudget) {
	if profile == nil {
		return
	}
	profile.PostProcess = budget.PostProcess
	profile.ShadowsEnabled = true
	profile.ShadowResolution = budget.ShadowResolution
	profile.ShadowStrength = budget.ShadowStrength
	profile.ShadowSoftness = budget.ShadowSoftness
	profile.ShadowDistance = budget.ShadowDistance
	profile.ShadowFade = budget.ShadowFade
	profile.ShadowQuality = budget.ShadowQuality
}

func blockKartGameConfig(initial voplay.State) voplay.Game {
	return voplay.Game{Width: 1280, Height: 720, Title: "BlockKart", TargetFrameRate: blockKartTargetFPS, MaxCatchUpSteps: blockKartMaxCatchUpSteps, InitialState: initial}
}

type BlockKartPerfAnalyzer struct {
	lastReportRenderFrame int
}

type BlockKartFixedPhaseSample struct {
	TotalMs float64
	Slow bool
}

type BlockKartFixedPhaseStats struct {
	Frame int
	TotalMs float64
	TouchMs float64
	GameplayMs float64
	DriveMs float64
	AssistMs float64
	SleepMs float64
	PhysicsMs float64
	ResolveMs float64
	AudioMs float64
	ResetMs float64
	Slept bool
	Slow bool
	SlowestPhase string
	SlowestPhaseMs float64
	WindowFrames int
	WindowSlowFrames int
	PeakTotalMs float64
	PeakSlowestPhase string
	PeakSlowestPhaseMs float64
}

type BlockKartFixedStepProfiler struct {
	frame int
	samples [blockKartPerfWindowFrames]BlockKartFixedPhaseSample
	next int
	count int
	windowSlowFrames int
	stats BlockKartFixedPhaseStats
	peak BlockKartFixedPhaseStats
	slowLogCooldown int
}

func (p *BlockKartFixedStepProfiler) Record(stats BlockKartFixedPhaseStats) BlockKartFixedPhaseStats {
	p.frame++
	stats.Frame = p.frame
	stats.SlowestPhase, stats.SlowestPhaseMs = blockKartSlowestFixedPhase(stats)
	stats.Slow = stats.TotalMs > blockKartFixedStepBudgetMs
	if p.count == blockKartPerfWindowFrames {
		old := p.samples[p.next]
		if old.Slow {
			p.windowSlowFrames--
		}
	} else {
		p.count++
	}
	p.samples[p.next] = BlockKartFixedPhaseSample{TotalMs: stats.TotalMs, Slow: stats.Slow}
	if stats.Slow {
		p.windowSlowFrames++
	}
	p.next++
	if p.next >= blockKartPerfWindowFrames {
		p.next = 0
	}
	if stats.TotalMs > p.peak.TotalMs {
		p.peak = stats
	}
	stats.WindowFrames = p.count
	stats.WindowSlowFrames = p.windowSlowFrames
	stats.PeakTotalMs = p.peak.TotalMs
	stats.PeakSlowestPhase = p.peak.SlowestPhase
	stats.PeakSlowestPhaseMs = p.peak.SlowestPhaseMs
	p.stats = stats
	p.reportSlow(stats)
	return p.stats
}

func (p *BlockKartFixedStepProfiler) Stats() BlockKartFixedPhaseStats {
	return p.stats
}

func (p *BlockKartFixedStepProfiler) reportSlow(stats BlockKartFixedPhaseStats) {
	if p.slowLogCooldown > 0 {
		p.slowLogCooldown--
	}
	if !blockKartFixedPhaseConsoleReports || !stats.Slow || p.slowLogCooldown > 0 {
		return
	}
	println("BlockKart fixed slow frame=" + itoa(stats.Frame) + " total=" + formatHudMs(stats.TotalMs) + " slowest=" + stats.SlowestPhase + ":" + formatHudMs(stats.SlowestPhaseMs) + " touch=" + formatHudMs(stats.TouchMs) + " gameplay=" + formatHudMs(stats.GameplayMs) + " drive=" + formatHudMs(stats.DriveMs) + " assist=" + formatHudMs(stats.AssistMs) + " physics=" + formatHudMs(stats.PhysicsMs) + " resolve=" + formatHudMs(stats.ResolveMs) + " audio=" + formatHudMs(stats.AudioMs) + " reset=" + formatHudMs(stats.ResetMs) + " slept=" + boolHud(stats.Slept))
	p.slowLogCooldown = blockKartFixedPhaseLogCooldownFrames
}

func blockKartSlowestFixedPhase(stats BlockKartFixedPhaseStats) (string, float64) {
	name := "touch"
	value := stats.TouchMs
	name, value = blockKartPickSlowerPhase(name, value, "gameplay", stats.GameplayMs)
	name, value = blockKartPickSlowerPhase(name, value, "drive", stats.DriveMs)
	name, value = blockKartPickSlowerPhase(name, value, "assist", stats.AssistMs)
	name, value = blockKartPickSlowerPhase(name, value, "sleep", stats.SleepMs)
	name, value = blockKartPickSlowerPhase(name, value, "physics", stats.PhysicsMs)
	name, value = blockKartPickSlowerPhase(name, value, "resolve", stats.ResolveMs)
	name, value = blockKartPickSlowerPhase(name, value, "audio", stats.AudioMs)
	name, value = blockKartPickSlowerPhase(name, value, "reset", stats.ResetMs)
	return name, value
}

func blockKartPickSlowerPhase(name string, value float64, candidateName string, candidateValue float64) (string, float64) {
	if candidateValue > value {
		return candidateName, candidateValue
	}
	return name, value
}

func (a *BlockKartPerfAnalyzer) ShouldReport(snapshot voplay.PerfSnapshot) bool {
	if !blockKartPerfReports {
		return false
	}
	if !snapshot.Enabled {
		return false
	}
	frame := blockKartPerfFrameIndex(snapshot)
	if frame < blockKartPerfWarmupFrames + blockKartPerfWindowFrames {
		return false
	}
	window := blockKartPerfReportingWindow(snapshot)
	if window.Frames < blockKartPerfWindowFrames {
		return false
	}
	if a.lastReportRenderFrame > 0 && frame - a.lastReportRenderFrame < blockKartPerfWindowFrames {
		return false
	}
	return true
}

func (a *BlockKartPerfAnalyzer) Report(snapshot voplay.PerfSnapshot, fixed BlockKartFixedPhaseStats, screen voplay.ScreenMetrics) {
	frame := blockKartPerfFrameIndex(snapshot)
	a.lastReportRenderFrame = frame
	window := blockKartPerfReportingWindow(snapshot)
	gate := voplay.EvaluatePerfGate(snapshot, blockKartPerfGateConfig(snapshot))
	status := blockKartPerfStatus(snapshot)
	screenMPixels := float64(screen.PixelWidth * screen.PixelHeight) / 1000000.0
	println(blockKartPerfReportMarker + blockKartPerfReportJSON(frame, snapshot, window, status, gate, fixed, screen, screenMPixels))
	if !blockKartPerfVerboseConsoleReports {
		return
	}
	current := snapshot.Current
	renderer := current.RendererCpu
	workload := current.RendererWorkload
	hist := snapshot.SlowHistogram
	println("BlockKart perf summary frame=" + itoa(frame) + " mode=" + snapshot.Mode + " status=" + status + " gate=" + boolHud(gate.Passed) + " failure=" + gate.PrimaryFailure + " target=" + itoa(snapshot.TargetHz) + " budget=" + formatHudMs(snapshot.BudgetMs) + " screen css/pixel/dpr/mpix=" + itoa(screen.Width) + "x" + itoa(screen.Height) + "/" + itoa(screen.PixelWidth) + "x" + itoa(screen.PixelHeight) + "/" + formatHudFloat(screen.DevicePixelRatio, 2) + "/" + formatHudFloat(screenMPixels, 2) + " frame p50/p90/p99/max=" + formatHudMs(window.FrameP50Ms) + "/" + formatHudMs(window.FrameP90Ms) + "/" + formatHudMs(window.FrameP99Ms) + "/" + formatHudMs(window.FrameMaxMs) + " slow=" + itoa(window.SlowFrames) + "/" + itoa(window.Frames) + " hist budget/12/16/25/33/50/100/gt=" + itoa(hist.LeBudget) + "/" + itoa(hist.Le12Ms) + "/" + itoa(hist.Le16Ms) + "/" + itoa(hist.Le25Ms) + "/" + itoa(hist.Le33Ms) + "/" + itoa(hist.Le50Ms) + "/" + itoa(hist.Gt100Ms) + " cause=" + current.Classification.PrimaryCause + " latestSpike=" + blockKartLatestSpikeSummary(snapshot) + " windowWorst=" + blockKartFrameSummary(snapshot.WindowWorstFrame) + " fixed steps=" + itoa(current.GameCpu.FixedSteps) + " last/peak/slow/worst=" + formatHudMs(fixed.TotalMs) + "/" + formatHudMs(fixed.PeakTotalMs) + "/" + itoa(fixed.WindowSlowFrames) + "/" + itoa(fixed.WindowFrames) + "/" + fixed.SlowestPhase + ":" + formatHudMs(fixed.SlowestPhaseMs) + " phaseP90 game/draw/loop/submit/gpu/hud=" + formatHudMs(window.GameCpuP90Ms) + "/" + formatHudMs(window.DrawEncodeP90Ms) + "/" + formatHudMs(window.RenderLoopP90Ms) + "/" + formatHudMs(window.RenderSubmitP90Ms) + "/" + formatHudMs(window.GpuWorkDoneP90Ms) + "/" + formatHudMs(window.HudP90Ms) + " render loop/display/pace/reply/submit/work/input/req/encode/port/perf/divisor=" + formatHudMs(current.RenderWorker.LoopTotalMs) + "/" + formatHudMs(current.RenderWorker.DisplayPulseMs) + "/" + formatHudMs(current.RenderWorker.PaceWaitMs) + "/" + formatHudMs(current.RenderWorker.ReplyWaitMs) + "/" + formatHudMs(current.RenderWorker.SubmitCpuMs) + "/" + formatHudMs(current.RenderWorker.WorkMs) + "/" + formatHudMs(current.RenderWorker.InputPollMs) + "/" + formatHudMs(current.RenderWorker.RequestSendMs) + "/" + formatHudMs(current.RenderWorker.RequestEncodeMs) + "/" + formatHudMs(current.RenderWorker.RequestPortSendMs) + "/" + formatHudMs(current.RenderWorker.PerfPacketMs) + "/" + itoa(current.RenderWorker.FrameDivisor) + " bytes draw/submit/render=" + formatHudBytes(current.Framewire.DrawBytes) + "/" + formatHudBytes(current.Framewire.SubmitBytes) + "/" + formatHudBytes(current.RenderWorker.DrawBytes) + " renderer submit/decode/scene/depth/shadow/main/post/overlay/queue/present=" + formatHudMs(renderer.SubmitFrameMs) + "/" + formatHudMs(renderer.DecodeMs) + "/" + formatHudMs(renderer.SceneUpdateMs) + "/" + formatHudMs(renderer.DepthPassMs) + "/" + formatHudMs(renderer.ShadowPassMs) + "/" + formatHudMs(renderer.MainPassMs) + "/" + formatHudMs(renderer.PostPassMs) + "/" + formatHudMs(renderer.OverlayPassMs) + "/" + formatHudMs(renderer.QueueSubmitCpuMs) + "/" + formatHudMs(renderer.PresentCpuMs) + " renderer main setup/sky/model/primitive/close=" + formatHudMs(renderer.MainPassSetupMs) + "/" + formatHudMs(renderer.MainSkyboxMs) + "/" + formatHudMs(renderer.MainModelMs) + "/" + formatHudMs(renderer.MainPrimitiveMs) + "/" + formatHudMs(renderer.MainPassCloseMs) + " attr none/logic/draw/framewire/render/gpu/present/pacing/churn/hud/mixed=" + itoa(snapshot.Attribution.None) + "/" + itoa(snapshot.Attribution.LogicCpuBound) + "/" + itoa(snapshot.Attribution.DrawEncodeBound) + "/" + itoa(snapshot.Attribution.FramewireBound) + "/" + itoa(snapshot.Attribution.RenderCpuBound) + "/" + itoa(snapshot.Attribution.GpuQueueBound) + "/" + itoa(snapshot.Attribution.PresentBackpressure) + "/" + itoa(snapshot.Attribution.PacingLimited) + "/" + itoa(snapshot.Attribution.ResourceChurn) + "/" + itoa(snapshot.Attribution.HudOverhead) + "/" + itoa(snapshot.Attribution.Mixed) + " workload draws/model/primitive/batches=" + itoa(workload.DrawCalls) + "/" + itoa(workload.ModelDraws) + "/" + itoa(workload.PrimitiveDraws) + "/" + itoa(workload.InstancedBatches) + " cascades/chunks/post=" + itoa(workload.ShadowCascades) + "/" + itoa(workload.PrimitiveChunks) + "/" + itoa(workload.PostEffects) + " diag=" + voplay.PerfRendererDiagnosticLabel(workload.DiagnosticFlags) + " instances=" + itoa(workload.Instances) + " triangles=" + itoa(workload.Triangles) + " churn upload/buffer/bindGroup/texture/chunk=" + formatHudBytes(workload.UploadBytes) + "/" + itoa(workload.BufferCreates) + "/" + itoa(workload.BindGroupCreates) + "/" + itoa(workload.TextureUploads) + "/" + itoa(workload.ResidentChunkRebuilds))
}

func blockKartPerfReportJSON(frame int, snapshot voplay.PerfSnapshot, window voplay.PerfWindowSummary, status string, gate voplay.PerfGateResult, fixed BlockKartFixedPhaseStats, screen voplay.ScreenMetrics, screenMPixels float64) string {
	current := snapshot.Current
	renderer := current.RendererCpu
	workload := current.RendererWorkload
	gpu := current.GpuQueue
	hist := snapshot.SlowHistogram
	latestSpike := blockKartLatestSpike(snapshot)
	windowWorst := snapshot.WindowWorstFrame
	return "{" + "\"schemaVersion\":1" + ",\"source\":\"blockkart\"" + ",\"kind\":\"perf-summary\"" + ",\"frame\":" + itoa(frame) + ",\"mode\":" + jsonString(snapshot.Mode) + ",\"status\":" + jsonString(status) + ",\"gatePassed\":" + jsonBool(gate.Passed) + ",\"failure\":" + jsonString(gate.PrimaryFailure) + ",\"targetHz\":" + itoa(snapshot.TargetHz) + ",\"budgetMs\":" + jsonFloat(snapshot.BudgetMs) + ",\"screen\":{\"cssWidth\":" + itoa(screen.Width) + ",\"cssHeight\":" + itoa(screen.Height) + ",\"pixelWidth\":" + itoa(screen.PixelWidth) + ",\"pixelHeight\":" + itoa(screen.PixelHeight) + ",\"devicePixelRatio\":" + jsonFloat(screen.DevicePixelRatio) + ",\"mpix\":" + jsonFloat(screenMPixels) + "}" + ",\"window\":{\"frames\":" + itoa(window.Frames) + ",\"slowFrames\":" + itoa(window.SlowFrames) + ",\"frameP50Ms\":" + jsonFloat(window.FrameP50Ms) + ",\"frameP90Ms\":" + jsonFloat(window.FrameP90Ms) + ",\"frameP99Ms\":" + jsonFloat(window.FrameP99Ms) + ",\"frameMaxMs\":" + jsonFloat(window.FrameMaxMs) + ",\"gameCpuP90Ms\":" + jsonFloat(window.GameCpuP90Ms) + ",\"drawEncodeP90Ms\":" + jsonFloat(window.DrawEncodeP90Ms) + ",\"renderLoopP90Ms\":" + jsonFloat(window.RenderLoopP90Ms) + ",\"renderSubmitP90Ms\":" + jsonFloat(window.RenderSubmitP90Ms) + ",\"gpuWorkDoneP90Ms\":" + jsonFloat(window.GpuWorkDoneP90Ms) + ",\"hudP90Ms\":" + jsonFloat(window.HudP90Ms) + "}" + ",\"histogram\":{\"leBudget\":" + itoa(hist.LeBudget) + ",\"le12Ms\":" + itoa(hist.Le12Ms) + ",\"le16Ms\":" + itoa(hist.Le16Ms) + ",\"le25Ms\":" + itoa(hist.Le25Ms) + ",\"le33Ms\":" + itoa(hist.Le33Ms) + ",\"le50Ms\":" + itoa(hist.Le50Ms) + ",\"le100Ms\":" + itoa(hist.Le100Ms) + ",\"gt100Ms\":" + itoa(hist.Gt100Ms) + "}" + ",\"classification\":{\"primaryCause\":" + jsonString(current.Classification.PrimaryCause) + ",\"secondaryCause\":" + jsonString(current.Classification.SecondaryCause) + ",\"mixed\":" + jsonBool(current.Classification.Mixed) + ",\"latestSpikeFrame\":" + itoa(latestSpike.FrameId) + ",\"latestSpikeMs\":" + jsonFloat(latestSpike.FrameMs) + ",\"latestSpikeCause\":" + jsonString(latestSpike.PrimaryCause) + ",\"windowWorstFrame\":" + itoa(windowWorst.FrameId) + ",\"windowWorstMs\":" + jsonFloat(windowWorst.FrameMs) + ",\"windowWorstCause\":" + jsonString(windowWorst.Classification.PrimaryCause) + ",\"latestSpike\":" + blockKartPerfSpikeJSON(latestSpike) + ",\"windowWorst\":" + blockKartPerfFrameBreakdownJSON(windowWorst) + "}" + ",\"current\":{\"frameMs\":" + jsonFloat(current.FrameMs) + ",\"gameCpuMs\":" + jsonFloat(current.GameCpu.TotalMs) + ",\"fixedSteps\":" + itoa(current.GameCpu.FixedSteps) + ",\"drawEncodeMs\":" + jsonFloat(current.GameCpu.DrawEncodeMs) + ",\"renderLoopMs\":" + jsonFloat(current.RenderWorker.LoopTotalMs) + ",\"displayPulseMs\":" + jsonFloat(current.RenderWorker.DisplayPulseMs) + ",\"paceWaitMs\":" + jsonFloat(current.RenderWorker.PaceWaitMs) + ",\"frameDivisor\":" + itoa(current.RenderWorker.FrameDivisor) + ",\"replyWaitMs\":" + jsonFloat(current.RenderWorker.ReplyWaitMs) + ",\"requestSendMs\":" + jsonFloat(current.RenderWorker.RequestSendMs) + ",\"requestEncodeMs\":" + jsonFloat(current.RenderWorker.RequestEncodeMs) + ",\"requestPortSendMs\":" + jsonFloat(current.RenderWorker.RequestPortSendMs) + ",\"submitCpuMs\":" + jsonFloat(current.RenderWorker.SubmitCpuMs) + ",\"renderWorkMs\":" + jsonFloat(current.RenderWorker.WorkMs) + ",\"gpuWorkDoneMs\":" + jsonFloat(gpu.SubmittedWorkDoneMs) + ",\"gpuQueueDepth\":" + jsonString(gpu.QueueDepthClass) + "}" + ",\"renderer\":{\"submitFrameMs\":" + jsonFloat(renderer.SubmitFrameMs) + ",\"decodeMs\":" + jsonFloat(renderer.DecodeMs) + ",\"sceneUpdateMs\":" + jsonFloat(renderer.SceneUpdateMs) + ",\"depthPassMs\":" + jsonFloat(renderer.DepthPassMs) + ",\"shadowPassMs\":" + jsonFloat(renderer.ShadowPassMs) + ",\"mainPassMs\":" + jsonFloat(renderer.MainPassMs) + ",\"mainPassSetupMs\":" + jsonFloat(renderer.MainPassSetupMs) + ",\"mainSkyboxMs\":" + jsonFloat(renderer.MainSkyboxMs) + ",\"mainModelMs\":" + jsonFloat(renderer.MainModelMs) + ",\"mainPrimitiveMs\":" + jsonFloat(renderer.MainPrimitiveMs) + ",\"mainPassCloseMs\":" + jsonFloat(renderer.MainPassCloseMs) + ",\"postPassMs\":" + jsonFloat(renderer.PostPassMs) + ",\"overlayPassMs\":" + jsonFloat(renderer.OverlayPassMs) + ",\"queueSubmitCpuMs\":" + jsonFloat(renderer.QueueSubmitCpuMs) + ",\"presentCpuMs\":" + jsonFloat(renderer.PresentCpuMs) + "}" + ",\"workload\":{\"drawCalls\":" + itoa(workload.DrawCalls) + ",\"modelDraws\":" + itoa(workload.ModelDraws) + ",\"primitiveDraws\":" + itoa(workload.PrimitiveDraws) + ",\"instancedBatches\":" + itoa(workload.InstancedBatches) + ",\"shadowCascades\":" + itoa(workload.ShadowCascades) + ",\"primitiveChunks\":" + itoa(workload.PrimitiveChunks) + ",\"postEffects\":" + itoa(workload.PostEffects) + ",\"instances\":" + itoa(workload.Instances) + ",\"triangles\":" + itoa(workload.Triangles) + ",\"uploadBytes\":" + itoa(workload.UploadBytes) + ",\"bufferCreates\":" + itoa(workload.BufferCreates) + ",\"bindGroupCreates\":" + itoa(workload.BindGroupCreates) + ",\"textureUploads\":" + itoa(workload.TextureUploads) + ",\"residentChunkRebuilds\":" + itoa(workload.ResidentChunkRebuilds) + ",\"diagnosticFlags\":" + itoa(workload.DiagnosticFlags) + ",\"frameGraphPasses\":" + itoa(workload.FrameGraphPasses) + ",\"frameGraphResources\":" + itoa(workload.FrameGraphResources) + ",\"frameGraphTargets\":" + itoa(workload.FrameGraphTargets) + ",\"frameGraphReadyTargets\":" + itoa(workload.FrameGraphReadyTargets) + "}" + ",\"fixed\":{\"totalMs\":" + jsonFloat(fixed.TotalMs) + ",\"peakTotalMs\":" + jsonFloat(fixed.PeakTotalMs) + ",\"slowFrames\":" + itoa(fixed.WindowSlowFrames) + ",\"frames\":" + itoa(fixed.WindowFrames) + ",\"slowestPhase\":" + jsonString(fixed.SlowestPhase) + ",\"slowestPhaseMs\":" + jsonFloat(fixed.SlowestPhaseMs) + "}" + "}"
}

func blockKartPerfSpikeJSON(spike voplay.PerfSpike) string {
	return "{" + "\"frame\":" + itoa(spike.FrameId) + ",\"frameMs\":" + jsonFloat(spike.FrameMs) + ",\"overBudgetMs\":" + jsonFloat(spike.OverBudgetMs) + ",\"cause\":" + jsonString(spike.PrimaryCause) + ",\"secondaryCause\":" + jsonString(spike.SecondaryCause) + ",\"evidence\":" + jsonString(spike.Evidence) + ",\"gameCpuMs\":" + jsonFloat(spike.GameCpuMs) + ",\"fixedSteps\":" + itoa(spike.FixedSteps) + ",\"drawEncodeMs\":" + jsonFloat(spike.DrawEncodeMs) + ",\"renderLoopMs\":" + jsonFloat(spike.RenderLoopMs) + ",\"displayPulseMs\":" + jsonFloat(spike.RenderDisplayPulseMs) + ",\"paceWaitMs\":" + jsonFloat(spike.RenderPaceWaitMs) + ",\"replyWaitMs\":" + jsonFloat(spike.RenderReplyWaitMs) + ",\"submitCpuMs\":" + jsonFloat(spike.RenderSubmitMs) + ",\"renderWorkMs\":" + jsonFloat(spike.RenderWorkMs) + ",\"inputPollMs\":" + jsonFloat(spike.RenderInputPollMs) + ",\"requestSendMs\":" + jsonFloat(spike.RenderRequestSendMs) + ",\"requestEncodeMs\":" + jsonFloat(spike.RenderRequestEncodeMs) + ",\"requestPortSendMs\":" + jsonFloat(spike.RenderRequestPortSendMs) + ",\"perfPacketMs\":" + jsonFloat(spike.RenderPerfPacketMs) + ",\"gpuWorkDoneMs\":" + jsonFloat(spike.GpuWorkDoneMs) + ",\"gpuInFlight\":" + itoa(spike.GpuInFlight) + ",\"drawBytes\":" + itoa(spike.DrawBytes) + ",\"submitBytes\":" + itoa(spike.SubmitBytes) + ",\"hudCpuMs\":" + jsonFloat(spike.HudCpuMs) + "}"
}

func blockKartPerfFrameBreakdownJSON(frame voplay.PerfFrame) string {
	return "{" + "\"frame\":" + itoa(frame.FrameId) + ",\"frameMs\":" + jsonFloat(frame.FrameMs) + ",\"cause\":" + jsonString(frame.Classification.PrimaryCause) + ",\"secondaryCause\":" + jsonString(frame.Classification.SecondaryCause) + ",\"evidence\":" + jsonString(frame.Classification.Evidence) + ",\"gameCpuMs\":" + jsonFloat(frame.GameCpu.TotalMs) + ",\"fixedSteps\":" + itoa(frame.GameCpu.FixedSteps) + ",\"drawEncodeMs\":" + jsonFloat(frame.GameCpu.DrawEncodeMs) + ",\"renderLoopMs\":" + jsonFloat(frame.RenderWorker.LoopTotalMs) + ",\"displayPulseMs\":" + jsonFloat(frame.RenderWorker.DisplayPulseMs) + ",\"paceWaitMs\":" + jsonFloat(frame.RenderWorker.PaceWaitMs) + ",\"frameDivisor\":" + itoa(frame.RenderWorker.FrameDivisor) + ",\"replyWaitMs\":" + jsonFloat(frame.RenderWorker.ReplyWaitMs) + ",\"submitCpuMs\":" + jsonFloat(frame.RenderWorker.SubmitCpuMs) + ",\"renderWorkMs\":" + jsonFloat(frame.RenderWorker.WorkMs) + ",\"inputPollMs\":" + jsonFloat(frame.RenderWorker.InputPollMs) + ",\"requestSendMs\":" + jsonFloat(frame.RenderWorker.RequestSendMs) + ",\"requestEncodeMs\":" + jsonFloat(frame.RenderWorker.RequestEncodeMs) + ",\"requestPortSendMs\":" + jsonFloat(frame.RenderWorker.RequestPortSendMs) + ",\"perfPacketMs\":" + jsonFloat(frame.RenderWorker.PerfPacketMs) + ",\"gpuWorkDoneMs\":" + jsonFloat(frame.GpuQueue.SubmittedWorkDoneMs) + ",\"gpuInFlight\":" + itoa(frame.GpuQueue.InFlightSubmits) + ",\"rendererSubmitFrameMs\":" + jsonFloat(frame.RendererCpu.SubmitFrameMs) + ",\"rendererDecodeMs\":" + jsonFloat(frame.RendererCpu.DecodeMs) + ",\"rendererSceneUpdateMs\":" + jsonFloat(frame.RendererCpu.SceneUpdateMs) + ",\"rendererDepthPassMs\":" + jsonFloat(frame.RendererCpu.DepthPassMs) + ",\"rendererShadowPassMs\":" + jsonFloat(frame.RendererCpu.ShadowPassMs) + ",\"rendererMainPassMs\":" + jsonFloat(frame.RendererCpu.MainPassMs) + ",\"rendererMainPassSetupMs\":" + jsonFloat(frame.RendererCpu.MainPassSetupMs) + ",\"rendererMainSkyboxMs\":" + jsonFloat(frame.RendererCpu.MainSkyboxMs) + ",\"rendererMainModelMs\":" + jsonFloat(frame.RendererCpu.MainModelMs) + ",\"rendererMainPrimitiveMs\":" + jsonFloat(frame.RendererCpu.MainPrimitiveMs) + ",\"rendererMainPassCloseMs\":" + jsonFloat(frame.RendererCpu.MainPassCloseMs) + ",\"rendererPostPassMs\":" + jsonFloat(frame.RendererCpu.PostPassMs) + ",\"rendererOverlayPassMs\":" + jsonFloat(frame.RendererCpu.OverlayPassMs) + ",\"rendererQueueSubmitCpuMs\":" + jsonFloat(frame.RendererCpu.QueueSubmitCpuMs) + ",\"rendererPresentCpuMs\":" + jsonFloat(frame.RendererCpu.PresentCpuMs) + ",\"drawBytes\":" + itoa(frame.Framewire.DrawBytes) + ",\"submitBytes\":" + itoa(frame.Framewire.SubmitBytes) + ",\"renderDrawBytes\":" + itoa(frame.RenderWorker.DrawBytes) + ",\"hudCpuMs\":" + jsonFloat(frame.Hud.CpuMs) + "}"
}

func jsonFloat(value float64) string {
	return formatFixed(value, 2)
}

func jsonBool(value bool) string {
	if value {
		return "true"
	}
	return "false"
}

func jsonString(value string) string {
	out := "\""
	for i := 0; i < len(value); i++ {
		ch := value[i:i + 1]
		if ch == "\\" {
			out += "\\\\"
		} else if ch == "\"" {
			out += "\\\""
		} else {
			out += ch
		}
	}
	return out + "\""
}

func blockKartLatestSpike(snapshot voplay.PerfSnapshot) voplay.PerfSpike {
	if snapshot.RecentSpikeCount <= 0 || len(snapshot.RecentSpikes) <= 0 {
		return voplay.PerfSpike{}
	}
	window := blockKartPerfReportingWindow(snapshot)
	frame := blockKartPerfFrameIndex(snapshot)
	windowStart := frame - window.Frames + 1
	if window.Frames <= 0 || windowStart <= 0 {
		return snapshot.RecentSpikes[0]
	}
	for i := 0; i < snapshot.RecentSpikeCount && i < len(snapshot.RecentSpikes); i++ {
		spike := snapshot.RecentSpikes[i]
		if spike.FrameId >= windowStart {
			return spike
		}
	}
	return voplay.PerfSpike{}
}

func blockKartLatestSpikeSummary(snapshot voplay.PerfSnapshot) string {
	spike := blockKartLatestSpike(snapshot)
	if spike.FrameId <= 0 {
		return "none"
	}
	return "#" + itoa(spike.FrameId) + "/" + formatHudMs(spike.FrameMs) + "/" + spike.PrimaryCause + "/" + spike.Evidence + "/game:" + formatHudMs(spike.GameCpuMs) + "/steps:" + itoa(spike.FixedSteps) + "/draw:" + formatHudMs(spike.DrawEncodeMs) + "/loop:" + formatHudMs(spike.RenderLoopMs) + "/display:" + formatHudMs(spike.RenderDisplayPulseMs) + "/pace:" + formatHudMs(spike.RenderPaceWaitMs) + "/reply:" + formatHudMs(spike.RenderReplyWaitMs) + "/submit:" + formatHudMs(spike.RenderSubmitMs) + "/work:" + formatHudMs(spike.RenderWorkMs) + "/input:" + formatHudMs(spike.RenderInputPollMs) + "/req:" + formatHudMs(spike.RenderRequestSendMs) + "/encode:" + formatHudMs(spike.RenderRequestEncodeMs) + "/port:" + formatHudMs(spike.RenderRequestPortSendMs) + "/perf:" + formatHudMs(spike.RenderPerfPacketMs) + "/gpu:" + formatHudMs(spike.GpuWorkDoneMs)
}

func blockKartFrameSummary(frame voplay.PerfFrame) string {
	if frame.FrameId <= 0 {
		return "none"
	}
	return "#" + itoa(frame.FrameId) + "/" + formatHudMs(frame.FrameMs) + "/" + frame.Classification.PrimaryCause + "/" + frame.Classification.Evidence + "/game:" + formatHudMs(frame.GameCpu.TotalMs) + "/steps:" + itoa(frame.GameCpu.FixedSteps) + "/draw:" + formatHudMs(frame.GameCpu.DrawEncodeMs) + "/loop:" + formatHudMs(frame.RenderWorker.LoopTotalMs) + "/display:" + formatHudMs(frame.RenderWorker.DisplayPulseMs) + "/pace:" + formatHudMs(frame.RenderWorker.PaceWaitMs) + "/divisor:" + itoa(frame.RenderWorker.FrameDivisor) + "/reply:" + formatHudMs(frame.RenderWorker.ReplyWaitMs) + "/submit:" + formatHudMs(frame.RenderWorker.SubmitCpuMs) + "/work:" + formatHudMs(frame.RenderWorker.WorkMs) + "/input:" + formatHudMs(frame.RenderWorker.InputPollMs) + "/req:" + formatHudMs(frame.RenderWorker.RequestSendMs) + "/encode:" + formatHudMs(frame.RenderWorker.RequestEncodeMs) + "/port:" + formatHudMs(frame.RenderWorker.RequestPortSendMs) + "/perf:" + formatHudMs(frame.RenderWorker.PerfPacketMs) + "/gpu:" + formatHudMs(frame.GpuQueue.SubmittedWorkDoneMs)
}

func blockKartPerfStatus(snapshot voplay.PerfSnapshot) string {
	if !snapshot.Enabled {
		return "disabled"
	}
	window := blockKartPerfReportingWindow(snapshot)
	if snapshot.BudgetMs <= 0 || window.Frames <= 0 {
		return "unknown"
	}
	if snapshot.Attribution.ResourceChurn > window.Frames / 10 {
		return "resource-churn"
	}
	if snapshot.Attribution.PacingLimited > window.Frames / 3 && snapshot.Attribution.LogicCpuBound < window.Frames / 10 && snapshot.Attribution.DrawEncodeBound < window.Frames / 10 && snapshot.Attribution.GpuQueueBound == 0 {
		return "pacing-limited"
	}
	logicBudget := snapshot.BudgetMs * 0.85
	if window.GameCpuP90Ms > logicBudget {
		return "logic-over-budget"
	}
	if window.DrawEncodeP90Ms > logicBudget {
		return "draw-encode-over-budget"
	}
	if window.RenderSubmitP90Ms > snapshot.BudgetMs {
		return "render-submit-over-budget"
	}
	if window.GpuWorkDoneP90Ms > snapshot.BudgetMs * 1.35 || snapshot.Attribution.GpuQueueBound > window.Frames / 4 {
		return "gpu-queue-bound"
	}
	if snapshot.Attribution.PresentBackpressure > window.Frames / 4 {
		return "present-backpressure"
	}
	if snapshot.Attribution.ResourceChurn > 0 {
		return "resource-churn"
	}
	if snapshot.Attribution.HudOverhead > 0 {
		return "hud-overhead"
	}
	if window.SlowFrames > 0 {
		return "cadence-jitter"
	}
	return "clean"
}

func blockKartPerfFrameIndex(snapshot voplay.PerfSnapshot) int {
	if snapshot.Current.FrameId > 0 {
		return snapshot.Current.FrameId
	}
	return snapshot.FrameCount
}

func blockKartPerfReportingWindow(snapshot voplay.PerfSnapshot) voplay.PerfWindowSummary {
	if snapshot.ThirtySecond.Frames > 0 {
		return snapshot.ThirtySecond
	}
	if snapshot.FiveSecond.Frames > 0 {
		return snapshot.FiveSecond
	}
	return snapshot.OneSecond
}

func blockKartPerfGateConfig(snapshot voplay.PerfSnapshot) voplay.PerfGateConfig {
	budget := snapshot.BudgetMs
	if budget <= 0 {
		budget = 1000.0 / float64(blockKartTargetFPS)
	}
	return voplay.PerfGateConfig{MinFrames: blockKartPerfWindowFrames, MaxSlowFrames: 0, MaxFrameP99Ms: budget * 1.35, MaxFrameMaxMs: budget * 3.0, MaxGpuQueueBoundFrames: blockKartPerfWindowFrames / 4, MaxGpuWorkDoneP90Ms: budget * 1.35, MaxHudOverheadFrames: blockKartPerfWindowFrames / 10, MaxHudP90Ms: 1.0, MaxProbeOverheadMs: 0.35}
}

func blockKartApplyPerfSnapshotToHUD(hud *WorldHUDState, snapshot voplay.PerfSnapshot) {
	if hud == nil || !snapshot.Enabled {
		return
	}
	window := blockKartPerfReportingWindow(snapshot)
	current := snapshot.Current
	hud.PerfBudgetMs = snapshot.BudgetMs
	hud.PerfFrameMs = current.FrameMs
	if current.FrameMs > 0 {
		hud.PerfFPS = 1000.0 / current.FrameMs
	}
	hud.PerfLogicMs = current.GameCpu.TotalMs
	hud.PerfInputMs = current.GameCpu.InputMs
	hud.PerfAdvanceMs = current.GameCpu.AdvanceMs
	hud.PerfDrawMs = current.GameCpu.DrawEncodeMs
	hud.PerfOverlayMs = current.GameCpu.OverlayDrawMs
	hud.PerfDrawBytes = current.Framewire.DrawBytes
	hud.PerfSubmitBytes = current.Framewire.SubmitBytes
	hud.PerfFixedSteps = current.GameCpu.FixedSteps
	hud.PerfMaxFrameMs = window.FrameMaxMs
	hud.PerfSlowFrames = window.SlowFrames
	hud.PerfWindowFrames = window.Frames
	hud.PerfWindowSlowFrames = window.SlowFrames
	hud.PerfFrameP50Ms = window.FrameP50Ms
	hud.PerfFrameP90Ms = window.FrameP90Ms
	hud.PerfFrameP99Ms = window.FrameP99Ms
	hud.PerfLogicP90Ms = window.GameCpuP90Ms
	hud.PerfAdvanceP90Ms = window.GameCpuP90Ms
	hud.PerfDrawP90Ms = window.DrawEncodeP90Ms
	hud.PerfRenderFrame = blockKartPerfFrameIndex(snapshot)
	hud.PerfRenderLoopMs = current.RenderWorker.LoopTotalMs
	hud.PerfRenderPaceWaitMs = current.RenderWorker.PaceWaitMs
	hud.PerfRenderReplyWaitMs = current.RenderWorker.ReplyWaitMs
	hud.PerfRenderSubmitMs = current.RenderWorker.SubmitCpuMs
	hud.PerfRenderDisplayPulseMs = current.RenderWorker.DisplayPulseMs
	hud.PerfRenderDrawBytes = current.RenderWorker.DrawBytes
	hud.PerfRenderFrameDivisor = current.RenderWorker.FrameDivisor
	hud.PerfRenderAttribution = current.Classification.PrimaryCause
	hud.PerfRenderWindowFrames = window.Frames
	hud.PerfRenderWindowSlowFrames = window.SlowFrames
	hud.PerfRenderLoopP90Ms = window.RenderLoopP90Ms
	hud.PerfRenderSubmitP90Ms = window.RenderSubmitP90Ms
	hud.PerfRenderReplyWaitP90Ms = current.Framewire.ReplyWaitMs
}
