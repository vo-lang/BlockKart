package main

import (
	"math"
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

func (k *KartRig) applyKartRoadEdgeAssist(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState, dt float64) {
	if dt <= 0 || core.track == nil || core.vehicle == nil {
		kart.roadEdgeAssistActive = false
		return
	}
	pos := core.vehicle.Position()
	sample, ok := kart.kartRig.sampleRoadEdgeAssist(core, pos)
	if !ok {
		kart.roadEdgeAssistActive = false
		return
	}
	if sample.LateralAbs <= sample.AssistStart {
		kart.roadEdgeAssistActive = false
		return
	}
	enteringAssist := !kart.roadEdgeAssistActive
	result := scene3d.ApplyVehicleRoadEdgeAssist(core.vehicle, kart.kartRig.roadEdgeAssistCommand(sample, enteringAssist), dt)
	kart.roadEdgeAssistActive = result.Active
}

func (k *KartRig) resolveKartRoadEdgeAssistPose(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState) {
	if core.track == nil || core.vehicle == nil {
		return
	}
	pos := core.vehicle.Position()
	sample, ok := kart.kartRig.sampleRoadEdgeAssist(core, pos)
	if !ok || sample.LateralAbs <= sample.AssistStart {
		return
	}
	scene3d.ResolveVehicleRoadEdgeAssistPose(core.vehicle, kart.kartRig.roadEdgeAssistCommand(sample, false))
}

func (k *KartRig) roadEdgeAssistCommand( sample roadEdgeAssistSample, entering bool) scene3d.VehicleRoadEdgeAssistCommand {
	return scene3d.VehicleRoadEdgeAssistCommand{RoadPosition: sample.Point.Position, Right: sample.Right, Inward: sample.Inward, EdgeHalfWidth: sample.EdgeHalfWidth, AssistStart: sample.AssistStart, LateralAbs: sample.LateralAbs, Side: sample.Side, SoftZone: kartRoadEdgeAssistSoftZone, MaxPushSpeed: kartRoadEdgeAssistMaxPushSpeed, VelocityBlend: kartRoadEdgeAssistVelocityBlend, OutwardDamping: kartRoadEdgeAssistOutwardDamping, ImpactSpeed: kartRoadEdgeAssistImpactSpeed, PositionBlend: kartRoadEdgeAssistPositionBlend, MaxCorrection: kartRoadEdgeAssistMaxCorrection, PostMaxCorrection: kartRoadEdgeAssistPostMaxCorrection, SnapOverflow: kartRoadEdgeAssistSnapOverflow, RideHeight: kartSpawnRideHeight, Lift: kartRoadEdgeAssistLift, Entering: entering}
}

func (k *KartRig) sampleRoadEdgeAssist(core *BlockKartRuntimeCore, pos voplay.Vec3) (roadEdgeAssistSample, bool) {
	if core.track == nil {
		return roadEdgeAssistSample{}, false
	}
	cp := core.track.ClosestPoint(pos)
	if cp.HalfWidth <= kartRoadEdgeAssistCenterInset || cp.Right.LengthSq() == 0 {
		return roadEdgeAssistSample{}, false
	}
	right := cp.Right
	right.Y = 0
	if right.LengthSq() == 0 {
		return roadEdgeAssistSample{}, false
	}
	right = right.Normalize()
	side := 1.0
	if cp.LateralDistance < 0 {
		side = -1.0
	}
	edgeHalfWidth := cp.HalfWidth - kartRoadEdgeAssistCenterInset
	return roadEdgeAssistSample{Point: cp, Right: right, Inward: right.Scale(-side), EdgeHalfWidth: edgeHalfWidth, AssistStart: edgeHalfWidth - kartRoadEdgeAssistSoftZone, LateralAbs: math.Abs(cp.LateralDistance), Side: side}, true
}

func (k *KartRig) kartRotation(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState) voplay.Quat {
	if core.vehicle != nil {
		return core.vehicle.Rotation()
	}
	return voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, kart.kartYaw)
}

func (k *KartRig) setKartPose(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, presentation *RacePresentationState, position voplay.Vec3, yaw float64) {
	kart.kartYaw = yaw
	kart.kartSpeed = 0
	kart.roadEdgeAssistActive = false
	kart.physicsIdleFrames = 0
	if core.kartController != nil {
		core.kartController.Respawn(scene3d.TrackPose{Position: position, Yaw: yaw})
		kart.kartRig.primeIdleStartPhysicsSleep(core, kart)
		race.raceSession.resetKartRenderPose(core, kart, presentation, position, kart.kartRig.kartRotation(core, kart))
		kart.drifting = false
		kart.kartRig.syncKartVisuals(core, kart)
		return
	}
	if core.vehicle != nil {
		scene3d.ResetVehiclePose(core.vehicle, position, yaw)
		kart.kartRig.primeIdleStartPhysicsSleep(core, kart)
		race.raceSession.resetKartRenderPose(core, kart, presentation, position, kart.kartRig.kartRotation(core, kart))
		kart.drifting = false
		kart.kartRig.syncKartVisuals(core, kart)
		return
	}
	race.raceSession.resetKartRenderPose(core, kart, presentation, position, kart.kartRig.kartRotation(core, kart))
	kart.kartRig.syncKartVisuals(core, kart)
}

func (k *KartRig) stopKartForFinish(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState) {
	kart.boostTimer = 0
	kart.driftCharge = 0
	kart.drifting = false
	kart.kartSpeed = 0
	kart.roadEdgeAssistActive = false
	if core.vehicle != nil {
		scene3d.ResetVehicleMotionState(core.vehicle)
	}
	if core.kartController != nil {
		position := race.checkpointPosition
		if core.vehicle != nil {
			position = core.vehicle.Position()
		} else if core.player != nil {
			position = core.player.Position()
		}
		core.kartController.Respawn(scene3d.TrackPose{Position: position, Yaw: kart.kartYaw})
	}
}

func (k *KartRig) activateBoost(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState, duration float64) {
	if duration > kart.boostTimer {
		kart.boostTimer = duration
	}
	if core.kartController != nil {
		core.kartController.ActivateBoost(duration)
	}
}

func (k *KartRig) syncKartVisuals(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState) {
	if core.player == nil {
		return
	}
	pos := core.player.Position()
	rot := kart.kartRig.kartVisualRotation(core, kart)
	kart.kartRig.syncKartVisualsAt(core, kart, pos, rot)
}

func (k *KartRig) syncKartVisualsAt(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState, pos voplay.Vec3, rot voplay.Quat) {
	if kart.kartChassisPrimitive != nil {
		core.trackRuntime.syncPrimitiveKartVisuals(core, kart, pos, rot)
	}
}

func (k *KartRig) updateVehicleAudio(core *BlockKartRuntimeCore) {
	if core.vehicleAudio == nil {
		return
	}
	telemetry := scene3d.VehicleTelemetry{}
	if core.vehicle != nil {
		telemetry = scene3d.ProductVehicleTelemetry(core.vehicle)
	}
	input := scene3d.VehicleAudioInputFromTelemetry(telemetry)
	if core.kartController != nil {
		state := core.kartController.State()
		if state.SurfaceID != "" {
			if !state.SurfaceOnRoad {
				input.SurfaceAmount = 1
			}
			core.vehicleAudio.Update(input)
			return
		}
	}
	core.vehicleAudio.Update(input)
}

func (k *KartRig) updateIdleVehicleAudio(core *BlockKartRuntimeCore) {
	if core.vehicleAudio == nil {
		return
	}
	core.vehicleAudio.Update(scene3d.VehicleAudioInput{})
}

func (k *KartRig) kartVisualRotation(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState) voplay.Quat {
	if core.vehicle != nil {
		return core.vehicle.VisualRotation()
	}
	return kart.kartRig.kartRotation(core, kart)
}
