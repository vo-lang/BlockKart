package main

import (
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

const (
	blockKartAssetReportMarker = "__BLOCKKART_ASSET_REPORT__"
	blockKartSceneReportMarker = "__BLOCKKART_SCENE_REPORT__"
)

func blockKartReportWorldDiagnostics(g *voplay.GameCtx, lifecycleState, startupPhase, phase string, w *World) {
	blockKartReportAssetDiagnostics(g, lifecycleState, startupPhase, phase, w)
	blockKartReportSceneDiagnostics(g, lifecycleState, startupPhase, phase, w)
	blockKartReportVehicleDiagnostics(g, lifecycleState, startupPhase, phase, w)
	blockKartReportRaceDiagnostics(g, lifecycleState, startupPhase, phase, w)
}

func blockKartReportAssetDiagnostics(g *voplay.GameCtx, lifecycleState, startupPhase, phase string, w *World) {
	assetReport := voplay.AssetReport{}
	assetGroup := ""
	skyboxLoaded := false
	cubeModelLoaded := false
	runtimeCacheReady := false
	preparedMapCached := false
	primitiveTemplateCached := false
	preparedMapBuilds := 0
	preparedMapReuses := 0
	primitiveTemplateBuilds := 0
	primitiveTemplateReuses := 0
	if w != nil {
		assetGroup = w.assetGroup
		cubeModelLoaded = w.cubeModel != 0
		if w.assets != nil {
			assetReport = w.assets.Report()
		}
		if w.scene != nil {
			skyboxLoaded = w.scene.Skybox != 0
		}
		if w.runtimeCache != nil {
			runtimeCacheReady = w.runtimeCache.assetGroupActive
			preparedMapCached = w.runtimeCache.primitiveMap != nil
			primitiveTemplateCached = w.runtimeCache.primitiveTemplate != nil
			preparedMapBuilds = w.runtimeCache.preparedMapBuilds
			preparedMapReuses = w.runtimeCache.preparedMapReuses
			primitiveTemplateBuilds = w.runtimeCache.primitiveTemplateBuilds
			primitiveTemplateReuses = w.runtimeCache.primitiveTemplateReuses
		}
	}
	blockKartEmitJSON(blockKartAssetReportMarker, []blockKartJSONField{
		blockKartJSONText("lifecycleState", lifecycleState),
		blockKartJSONText("startupPhase", startupPhase),
		blockKartJSONText("phase", phase),
		blockKartJSONText("assetPackPath", blockKartAssetPath("blockkart.vpak")),
		blockKartJSONBool("assetPackMounted", assetGroup == worldAssetGroup),
		blockKartJSONText("assetGroup", assetGroup),
		blockKartJSONBool("assetGroupActive", assetGroup == worldAssetGroup),
		blockKartJSONBool("skyboxLoaded", skyboxLoaded),
		blockKartJSONBool("cubeModelLoaded", cubeModelLoaded),
		blockKartJSONBool("runtimeCacheReady", runtimeCacheReady),
		blockKartJSONBool("preparedMapCached", preparedMapCached),
		blockKartJSONInt("preparedMapBuilds", preparedMapBuilds),
		blockKartJSONInt("preparedMapReuses", preparedMapReuses),
		blockKartJSONBool("primitiveTemplateCached", primitiveTemplateCached),
		blockKartJSONInt("primitiveTemplateBuilds", primitiveTemplateBuilds),
		blockKartJSONInt("primitiveTemplateReuses", primitiveTemplateReuses),
		blockKartJSONText("restartRootCause", blockKartRestartResourceRootCause),
		blockKartJSONInt("mountCount", assetReport.MountCount),
		blockKartJSONInt("groupCount", assetReport.GroupCount),
		blockKartJSONInt("activeGroupDepth", assetReport.ActiveGroupDepth),
		blockKartJSONInt("textureCount", assetReport.TextureCount),
		blockKartJSONInt("linearTextureCount", assetReport.LinearTextureCount),
		blockKartJSONInt("cubemapCount", assetReport.CubemapCount),
		blockKartJSONInt("fontCount", assetReport.FontCount),
		blockKartJSONInt("modelCount", assetReport.ModelCount),
		blockKartJSONInt("audioCount", assetReport.AudioCount),
	})
}

func blockKartReportSceneDiagnostics(g *voplay.GameCtx, lifecycleState, startupPhase, phase string, w *World) {
	activeEntities := 0
	modelEntities := 0
	staticRenderableEntities := 0
	physicsBodies := 0
	terrainBodies := 0
	vehicles := 0
	contactEvents := 0
	vehicleTelemetryIssues := 0
	primitiveLayers := 0
	visibleEntities := 0
	culledEntities := 0
	primitiveInstances := 0
	primitiveVisibleInstances := 0
	primitiveChunks := 0
	primitiveVisibleChunks := 0
	primitiveGroups := 0
	waterSurfaces := 0
	visibleWaterSurfaces := 0
	renderStressProfile := ""
	renderStressApplied := false
	collectibles := 0
	checkpoints := 0
	boostPads := 0
	obstacles := 0
	trackEntities := 0
	kartWheelPrimitives := 0
	hasScene := false
	hasTrack := false
	hasTrackResult := false
	hasMap := false
	preparedMapReused := false
	primitiveTemplateReused := false
	hasPlayer := false
	hasVehicle := false
	hasVehicleAudio := false
	if w != nil {
		collectibles = len(w.collectibles)
		checkpoints = len(w.checkpoints)
		boostPads = len(w.boostPads)
		obstacles = len(w.obstacles)
		kartWheelPrimitives = len(w.kartWheelPrimitives)
		hasTrack = w.track != nil
		hasTrackResult = w.trackResult != nil
		hasMap = w.primitiveMap != nil
		preparedMapReused = w.preparedMapReused
		primitiveTemplateReused = w.primitiveTemplateReused
		renderStressProfile = w.renderStressProfile
		renderStressApplied = w.renderStressApplied
		hasPlayer = w.player != nil
		hasVehicle = w.vehicle != nil
		hasVehicleAudio = w.vehicleAudio != nil
		if w.trackResult != nil {
			trackEntities = len(w.trackResult.Entities)
		}
		if w.scene != nil {
			hasScene = true
			diag := scene3d.ProductSceneDiagnostics(w.scene)
			content := diag.PrimitiveContent
			if content.TotalInstances == 0 && diag.Primitive.TotalInstances > 0 {
				content = diag.Primitive
			}
			activeEntities = diag.ActiveEntities
			modelEntities = diag.ModelEntities
			staticRenderableEntities = diag.StaticRenderableEntities
			physicsBodies = diag.PhysicsBodies
			terrainBodies = diag.TerrainBodies
			vehicles = diag.Vehicles
			contactEvents = diag.ContactEvents
			vehicleTelemetryIssues = diag.VehicleTelemetryIssues
			primitiveLayers = diag.PrimitiveLayers
			visibleEntities = diag.Render.VisibleEntities
			culledEntities = diag.Render.CulledEntities
			primitiveInstances = content.TotalInstances
			primitiveVisibleInstances = diag.Primitive.VisibleInstances
			primitiveChunks = content.TotalChunks
			primitiveVisibleChunks = diag.Primitive.VisibleChunks
			primitiveGroups = content.ShapeMaterialGroups
			waterSurfaces = content.WaterInstances
			visibleWaterSurfaces = diag.Primitive.VisibleWaterInstances
		}
	}
	blockKartEmitJSON(blockKartSceneReportMarker, []blockKartJSONField{
		blockKartJSONText("lifecycleState", lifecycleState),
		blockKartJSONText("startupPhase", startupPhase),
		blockKartJSONText("phase", phase),
		blockKartJSONBool("hasScene", hasScene),
		blockKartJSONInt("activeEntities", activeEntities),
		blockKartJSONInt("modelEntities", modelEntities),
		blockKartJSONInt("staticRenderableEntities", staticRenderableEntities),
		blockKartJSONInt("physicsBodies", physicsBodies),
		blockKartJSONInt("terrainBodies", terrainBodies),
		blockKartJSONInt("vehicles", vehicles),
		blockKartJSONInt("contactEvents", contactEvents),
		blockKartJSONInt("vehicleTelemetryIssues", vehicleTelemetryIssues),
		blockKartJSONInt("primitiveLayers", primitiveLayers),
		blockKartJSONInt("visibleEntities", visibleEntities),
		blockKartJSONInt("culledEntities", culledEntities),
		blockKartJSONInt("primitiveInstances", primitiveInstances),
		blockKartJSONInt("primitiveVisibleInstances", primitiveVisibleInstances),
		blockKartJSONInt("primitiveChunks", primitiveChunks),
		blockKartJSONInt("primitiveVisibleChunks", primitiveVisibleChunks),
		blockKartJSONInt("primitiveGroups", primitiveGroups),
		blockKartJSONInt("waterSurfaces", waterSurfaces),
		blockKartJSONInt("visibleWaterSurfaces", visibleWaterSurfaces),
		blockKartJSONText("renderStressProfile", renderStressProfile),
		blockKartJSONBool("renderStressApplied", renderStressApplied),
		blockKartJSONInt("collectibles", collectibles),
		blockKartJSONInt("checkpoints", checkpoints),
		blockKartJSONInt("boostPads", boostPads),
		blockKartJSONInt("obstacles", obstacles),
		blockKartJSONInt("trackEntities", trackEntities),
		blockKartJSONInt("kartWheelPrimitives", kartWheelPrimitives),
		blockKartJSONBool("hasTrack", hasTrack),
		blockKartJSONBool("hasTrackResult", hasTrackResult),
		blockKartJSONBool("hasMap", hasMap),
		blockKartJSONBool("preparedMapReused", preparedMapReused),
		blockKartJSONBool("primitiveTemplateReused", primitiveTemplateReused),
		blockKartJSONBool("hasPlayer", hasPlayer),
		blockKartJSONBool("hasVehicle", hasVehicle),
		blockKartJSONBool("hasVehicleAudio", hasVehicleAudio),
	})
}
