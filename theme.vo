package main

import (
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

type WorldTheme struct {
	SkyColor voplay.Color
	FogColor voplay.Color
	AmbientColor voplay.Color
	GroundColor voplay.Color
	PathColor voplay.Color
	BridgeColor voplay.Color
	WallColor voplay.Color
	RailColor voplay.Color
	RampColor voplay.Color
	AccentColor voplay.Color
	BarrierColor voplay.Color
	HazardColor voplay.Color
	CheckpointColor voplay.Color
	BannerColor voplay.Color
	SupportColor voplay.Color
	GoalColor voplay.Color
	GoalTrimColor voplay.Color
	PlayerColor voplay.Color
	KartTrimColor voplay.Color
	DriverColor voplay.Color
	WheelColor voplay.Color
	BoostColor voplay.Color
	TrackMarkColor voplay.Color
	TreeTrunkColor voplay.Color
	TreeLeafColor voplay.Color
	BushColor voplay.Color
	CloudColor voplay.Color
	CloudShadowColor voplay.Color
	OrbColor voplay.Color
	HudPanelColor voplay.Color
	HudShadowColor voplay.Color
	HudTrimColor voplay.Color
	HudTextColor voplay.Color
	HudSubtextColor voplay.Color
	HudAccentTextColor voplay.Color
}

func defaultWorldTheme() WorldTheme {
	return WorldTheme{SkyColor: voplay.Hex(0x58cfff), FogColor: voplay.Hex(0xafefff), AmbientColor: voplay.Hex(0x84bdd8), GroundColor: voplay.Hex(0x5f9b3c), PathColor: voplay.Hex(0x2b3032), BridgeColor: voplay.Hex(0xd7a95c), WallColor: voplay.Hex(0x7d93b6), RailColor: voplay.Hex(0xf4efe0), RampColor: voplay.Hex(0xe69c24), AccentColor: voplay.Hex(0xe7c82f), BarrierColor: voplay.Hex(0x304d82), HazardColor: voplay.Hex(0xff3154), CheckpointColor: voplay.Hex(0x25e8d0), BannerColor: voplay.Hex(0xff405a), SupportColor: voplay.Hex(0xa7b7d0), GoalColor: voplay.Hex(0xff4056), GoalTrimColor: voplay.Hex(0xe7c82f), PlayerColor: voplay.Hex(0x008cff), KartTrimColor: voplay.Hex(0xffe36b), DriverColor: voplay.Hex(0xff3d48), WheelColor: voplay.Hex(0x202838), BoostColor: voplay.Hex(0x21dfff), TrackMarkColor: voplay.Hex(0xf4efe0), TreeTrunkColor: voplay.Hex(0x855325), TreeLeafColor: voplay.Hex(0x347f38), BushColor: voplay.Hex(0x437f36), CloudColor: voplay.Hex(0xffffff), CloudShadowColor: voplay.Hex(0xd9eff8), OrbColor: voplay.Hex(0xff7fc9), HudPanelColor: voplay.Hex(0x10233d), HudShadowColor: voplay.Hex(0x08111e), HudTrimColor: voplay.Hex(0x3b7eff), HudTextColor: voplay.Hex(0xffffff), HudSubtextColor: voplay.Hex(0xd9efff), HudAccentTextColor: voplay.Hex(0xfff2b0)}
}

func applyWorldTheme(theme WorldTheme, scene *scene3d.Scene) {
	scene.Camera.Fov = 64
	profile := scene3d.KartRacingLightingProfile()
	profile.Ambient = voplay.Color{R: 0.47, G: 0.56, B: 0.56, A: 1}
	profile.AmbientGround = voplay.Color{R: 0.25, G: 0.32, B: 0.25, A: 1}
	profile.Lights = []scene3d.Light{{Type: scene3d.DirectionalLight, Direction: voplay.Vec3{X: -0.56, Y: 0.68, Z: -0.46}.Normalize(), Color: voplay.Hex(0xffd79a), Intensity: 2.48}, {Type: scene3d.DirectionalLight, Direction: voplay.Vec3{X: 0.48, Y: 0.30, Z: 0.52}.Normalize(), Color: voplay.Hex(0x8fcaff), Intensity: 0.12}}
	profile.Fog.Color = voplay.Color{R: 0.66, G: 0.84, B: 0.84, A: 1}
	profile.Fog.Start = 300
	profile.Fog.End = 980
	profile.ColorGrading = scene3d.ColorGradingConfig{ToneMap: scene3d.ToneMapACES, Exposure: 1.08, Contrast: 1.08, Saturation: 1.02}
	applyBlockKartRenderBudget(&profile, defaultBlockKartRenderBudget())
	scene.ApplyLightingProfile(profile)
}

type WorldHUDState struct {
	Time float64
	FinishTime float64
	Collected int
	TotalCollectibles int
	Checkpoint string
	NextGate string
	Lap int
	TotalLaps int
	Speed float64
	Boosting bool
	Drifting bool
	DriftCharge float64
	Message string
	MessageTimer float64
	Finished bool
	DebugOverlayVisible bool
	RenderDebugMode int
	HeroCameraVisible bool
	PerfFPS float64
	PerfFrameMs float64
	PerfLogicMs float64
	PerfInputMs float64
	PerfAdvanceMs float64
	PerfDrawMs float64
	PerfOverlayMs float64
	PerfBudgetMs float64
	PerfMaxFrameMs float64
	PerfMaxLogicMs float64
	PerfDrawBytes int
	PerfSubmitBytes int
	PerfFixedSteps int
	PerfSlowFrames int
	PerfSlowLogs int
	PerfWorkSlowFrames int
	PerfWorkSlowLogs int
	PerfLastSlowReason string
	PerfLastSlowFrameMs float64
	PerfLastSlowLogicMs float64
	PerfLastWorkSlowReason string
	PerfLastWorkSlowFrameMs float64
	PerfLastWorkSlowLogicMs float64
	PerfWindowFrames int
	PerfWindowSlowFrames int
	PerfWindowLastSlowGapFrames int
	PerfWindowLastSlowGapMs float64
	PerfWindowWorkSlowFrames int
	PerfWindowLastWorkSlowGapFrames int
	PerfWindowLastWorkSlowGapMs float64
	PerfFrameP50Ms float64
	PerfFrameP90Ms float64
	PerfFrameP99Ms float64
	PerfLogicP50Ms float64
	PerfLogicP90Ms float64
	PerfLogicP99Ms float64
	PerfAdvanceP90Ms float64
	PerfDrawP90Ms float64
	PerfDrawP99Ms float64
	PerfRenderFrame int
	PerfRenderLoopMs float64
	PerfRenderPaceWaitMs float64
	PerfRenderReplyWaitMs float64
	PerfRenderSubmitMs float64
	PerfRenderDisplayPulseMs float64
	PerfRenderDrawBytes int
	PerfRenderFrameDivisor int
	PerfRenderAttribution string
	PerfRenderWindowFrames int
	PerfRenderWindowSlowFrames int
	PerfRenderWindowLastSlowGapFrames int
	PerfRenderWindowLastSlowGapMs float64
	PerfRenderCadenceSlowFrames int
	PerfRenderReplySlowFrames int
	PerfRenderSubmitSlowFrames int
	PerfRenderUnattributedSlowFrames int
	PerfRenderLoopP50Ms float64
	PerfRenderLoopP90Ms float64
	PerfRenderLoopP99Ms float64
	PerfRenderPaceWaitP90Ms float64
	PerfRenderReplyWaitP90Ms float64
	PerfRenderSubmitP90Ms float64
	SceneActive int
	SceneVisible int
	SceneCulled int
	SceneModels int
	SceneUpserts int
	SceneDestroyed int
	SceneBatchEligible int
	SceneBatchGroups int
