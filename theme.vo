	WheelContacts int
	WheelCount int
	WheelMaxSlip float64
	WheelMaxCompression float64
	CameraTargetStep float64
	CameraTargetStepMax float64
	CameraTargetResidual float64
	CameraTargetResidualMax float64
	CameraTargetYStep float64
	CameraTargetYStepMax float64
	CameraSpeedStep float64
	CameraSpeedStepMax float64
	DebugLines [18]string
	DebugLineCount int
}

func drawWorldHUD(theme *WorldTheme, g *voplay.GameCtx, hud *WorldHUDState) {
	if voplay.IsCompactTouchLayout(g.Screen.Width, g.Screen.Height) {
		drawCompactWorldHUD(theme, g, hud)
		return
	}
	screen := g.Screen.Rect()
	normalSceneHUD := !hud.DebugOverlayVisible && hud.RenderDebugMode == scene3d.RenderDebugLit && !hud.HeroCameraVisible && !hud.Finished
	if normalSceneHUD {
		if hud.Boosting {
			boostPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTopRight, 126, 32, voplay.ScreenInsets{Right: 24, Top: 22})
			drawHudPanel(g.Draw, theme, boostPanel.X, boostPanel.Y, boostPanel.W, boostPanel.H, 0.58)
			g.Draw.DrawRect(boostPanel.X, boostPanel.Y, boostPanel.W, 5, theme.BoostColor.WithAlpha(0.82))
			g.Draw.DrawText("BOOST", boostPanel.X + 27, boostPanel.Y + 24, 18, theme.HudTextColor.WithAlpha(0.86))
		}
		if hud.Drifting || hud.DriftCharge > 0 {
			driftPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTopRight, 164, 36, voplay.ScreenInsets{Right: 24, Top: 62})
			charge := clampFloat(hud.DriftCharge / kartSuperTurboCharge, 0, 1)
			label := "DRIFT"
			fillColor := theme.BoostColor
			if hud.DriftCharge >= kartSuperTurboCharge {
				label = "SUPER"
				fillColor = theme.GoalTrimColor
			} else if hud.DriftCharge >= kartMiniTurboCharge {
				label = "MINI"
				fillColor = theme.AccentColor
			}
			drawHudPanel(g.Draw, theme, driftPanel.X, driftPanel.Y, driftPanel.W, driftPanel.H, 0.58)
			g.Draw.DrawText(label, driftPanel.X + 13, driftPanel.Y + 24, 16, theme.HudTextColor.WithAlpha(0.86))
			g.Draw.DrawRect(driftPanel.X + 72, driftPanel.Y + 14, 76, 8, theme.HudShadowColor.WithAlpha(0.26))
			g.Draw.DrawRect(driftPanel.X + 72, driftPanel.Y + 14, 76 * charge, 8, fillColor.WithAlpha(0.86))
		}
		if hud.MessageTimer > 0 {
			msgPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTop, 260, 34, voplay.ScreenInsets{Top: 24})
			drawHudPanel(g.Draw, theme, msgPanel.X, msgPanel.Y, msgPanel.W, msgPanel.H, 0.42)
			g.Draw.DrawText(hud.Message, msgPanel.X + 20, msgPanel.Y + 24, 18, theme.HudTextColor.WithAlpha(0.82))
		}
		return
	}
	topPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTopLeft, 430, 112, voplay.ScreenInsets{Left: 24, Top: 22})
	drawHudPanel(g.Draw, theme, topPanel.X, topPanel.Y, topPanel.W, topPanel.H, 0.88)
	g.Draw.DrawRect(topPanel.X, topPanel.Y, topPanel.W, 10, theme.HudTrimColor)
	g.Draw.DrawText("BlockKart", topPanel.X + 18, topPanel.Y + 36, 30, theme.HudTextColor)
	g.Draw.DrawText("Primitive Track", topPanel.X + 18, topPanel.Y + 64, 20, theme.HudAccentTextColor)
	g.Draw.DrawText("Retained primitive render path", topPanel.X + 18, topPanel.Y + 90, 18, theme.HudSubtextColor)
	coursePanel := voplay.AnchorScreenRect(screen, voplay.AnchorTopRight, 330, 100, voplay.ScreenInsets{Right: 24, Top: 22})
	if coursePanel.X < topPanel.X + topPanel.W + 18 {
		coursePanel.X = topPanel.X
		coursePanel.Y = topPanel.Y + topPanel.H + 12
	}
	drawHudPanel(g.Draw, theme, coursePanel.X, coursePanel.Y, coursePanel.W, coursePanel.H, 0.86)
	g.Draw.DrawRect(coursePanel.X, coursePanel.Y, coursePanel.W, 8, theme.GoalTrimColor)
	g.Draw.DrawText("Time " + formatTime(hud.Time), coursePanel.X + 18, coursePanel.Y + 32, 24, theme.HudTextColor)
	g.Draw.DrawText("Speed " + itoa(int(hud.Speed + 0.5)), coursePanel.X + 18, coursePanel.Y + 60, 20, theme.HudAccentTextColor)
	g.Draw.DrawText("Generated primitive scene", coursePanel.X + 18, coursePanel.Y + 86, 18, theme.HudSubtextColor)
	bottomPanel := voplay.AnchorScreenRect(screen, voplay.AnchorBottomLeft, 820, 28, voplay.ScreenInsets{Left: 24, Bottom: 20})
	drawHudPanel(g.Draw, theme, bottomPanel.X, bottomPanel.Y, bottomPanel.W, bottomPanel.H, 0.72)
	g.Draw.DrawText("W gas   S brake/reverse   A/D steer   Space drift   R restart   F3 stats   F4 material view   F5 inspect", bottomPanel.X + 14, bottomPanel.Y + 22, 16, theme.HudSubtextColor)
	if hud.Boosting {
		boostPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTopRight, 140, 36, voplay.ScreenInsets{Right: 40, Top: 134})
		drawHudPanel(g.Draw, theme, boostPanel.X, boostPanel.Y, boostPanel.W, boostPanel.H, 0.82)
		g.Draw.DrawRect(boostPanel.X, boostPanel.Y, boostPanel.W, 6, theme.BoostColor)
		g.Draw.DrawText("BOOST", boostPanel.X + 32, boostPanel.Y + 28, 22, theme.HudTextColor)
	}
	if hud.Drifting || hud.DriftCharge > 0 {
		driftPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTopRight, 184, 42, voplay.ScreenInsets{Right: 40, Top: 178})
		charge := clampFloat(hud.DriftCharge / kartSuperTurboCharge, 0, 1)
		label := "DRIFT"
		fillColor := theme.BoostColor
		if hud.DriftCharge >= kartSuperTurboCharge {
			label = "SUPER"
			fillColor = theme.GoalTrimColor
		} else if hud.DriftCharge >= kartMiniTurboCharge {
			label = "MINI"
			fillColor = theme.AccentColor
		}
		drawHudPanel(g.Draw, theme, driftPanel.X, driftPanel.Y, driftPanel.W, driftPanel.H, 0.82)
		g.Draw.DrawText(label, driftPanel.X + 16, driftPanel.Y + 27, 18, theme.HudTextColor)
		g.Draw.DrawRect(driftPanel.X + 80, driftPanel.Y + 15, 82, 10, theme.HudShadowColor.WithAlpha(0.3))
		g.Draw.DrawRect(driftPanel.X + 80, driftPanel.Y + 15, 82 * charge, 10, fillColor)
	}
	if hud.DebugOverlayVisible {
		debugX := 24.0
		debugY := 190.0
		debugW := 700.0
		debugH := 414.0
		drawHudPanel(g.Draw, theme, debugX, debugY, debugW, debugH, 0.80)
		g.Draw.DrawRect(debugX, debugY, debugW, 6, theme.AccentColor)
		lineY := debugY + 27
		lineH := 20.0
		for i := 0; i < hud.DebugLineCount; i++ {
			lineColor := theme.HudSubtextColor
			if debugHudPrimaryLine(i) {
				lineColor = theme.HudTextColor
			}
			g.Draw.DrawText(hud.DebugLines[i], debugX + 14, lineY, 15, lineColor)
			lineY += lineH
			if i == 3 || i == 7 || i == 10 || i == 13 || i == 15 {
				lineY += 3
			}
		}
	}
	if hud.RenderDebugMode != scene3d.RenderDebugLit {
		viewW := 240.0
		viewPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTop, viewW, 42, voplay.ScreenInsets{Top: 22})
		drawHudPanel(g.Draw, theme, viewPanel.X, viewPanel.Y, viewPanel.W, viewPanel.H, 0.84)
		g.Draw.DrawRect(viewPanel.X, viewPanel.Y, viewPanel.W, 6, theme.AccentColor)
		g.Draw.DrawText("View " + renderDebugLabel(hud.RenderDebugMode), viewPanel.X + 18, viewPanel.Y + 30, 20, theme.HudTextColor)
	}
	if hud.HeroCameraVisible {
		viewW := 260.0
		viewPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTop, viewW, 36, voplay.ScreenInsets{Top: 70})
		drawHudPanel(g.Draw, theme, viewPanel.X, viewPanel.Y, viewPanel.W, viewPanel.H, 0.82)
		g.Draw.DrawRect(viewPanel.X, viewPanel.Y, viewPanel.W, 5, theme.GoalTrimColor)
		g.Draw.DrawText("Hero inspect camera", viewPanel.X + 18, viewPanel.Y + 26, 18, theme.HudTextColor)
	}
	if hud.MessageTimer > 0 && !hud.Finished {
		msgW := 340.0
		msgPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTop, msgW, 42, voplay.ScreenInsets{Top: 132})
		drawHudPanel(g.Draw, theme, msgPanel.X, msgPanel.Y, msgPanel.W, msgPanel.H, 0.82)
		g.Draw.DrawRect(msgPanel.X, msgPanel.Y, msgPanel.W, 6, theme.AccentColor)
		g.Draw.DrawText(hud.Message, msgPanel.X + 24, msgPanel.Y + 30, 22, theme.HudTextColor)
	}
	if hud.Finished {
		panelW := 430.0
		panelH := 170.0
		panel := voplay.AnchorScreenRect(screen, voplay.AnchorCenter, panelW, panelH, voplay.ScreenInsets{})
		drawHudPanel(g.Draw, theme, panel.X, panel.Y, panel.W, panel.H, 0.92)
		g.Draw.DrawRect(panel.X, panel.Y, panel.W, 10, theme.GoalTrimColor)
		g.Draw.DrawText("RACE COMPLETE!", panel.X + 64, panel.Y + 52, 34, theme.HudAccentTextColor)
		g.Draw.DrawText("Time " + formatTime(hud.FinishTime), panel.X + 54, panel.Y + 92, 24, theme.HudTextColor)
		g.Draw.DrawText("Items " + itoa(hud.Collected) + "/" + itoa(hud.TotalCollectibles), panel.X + 54, panel.Y + 122, 22, theme.HudSubtextColor)
		g.Draw.DrawText("Press R to race again", panel.X + 54, panel.Y + 150, 20, theme.HudAccentTextColor)
	}
}

func drawCompactWorldHUD(theme *WorldTheme, g *voplay.GameCtx, hud *WorldHUDState) {
	if blockKartIsPortraitLayout(g.Screen.Width, g.Screen.Height) {
		drawPortraitWorldHUD(theme, g, hud)
		return
	}
	w := float64(g.Screen.Width)
	screen := g.Screen.Rect()
	leftW := 214.0
	if w < 430 {
		leftW = w * 0.50 - 20
	}
	if leftW < 158 {
		leftW = 158
	}
	rightW := 154.0
	if w < 430 {
		rightW = w * 0.42 - 16
	}
	if rightW < 126 {
		rightW = 126
	}
	leftPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTopLeft, leftW, 82, voplay.ScreenInsets{Left: 12, Top: 12})
	rightPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTopRight, rightW, 82, voplay.ScreenInsets{Right: 14, Top: 12})
	drawHudPanel(g.Draw, theme, leftPanel.X, leftPanel.Y, leftPanel.W, leftPanel.H, 0.82)
	g.Draw.DrawRect(leftPanel.X, leftPanel.Y, leftPanel.W, 6, theme.HudTrimColor)
	g.Draw.DrawText("BlockKart", leftPanel.X + 12, leftPanel.Y + 30, 21, theme.HudTextColor)
	g.Draw.DrawText("Lap " + itoa(hud.Lap) + "/" + itoa(hud.TotalLaps) + "  Items " + itoa(hud.Collected) + "/" + itoa(hud.TotalCollectibles), leftPanel.X + 12, leftPanel.Y + 58, 15, theme.HudAccentTextColor)
	drawHudPanel(g.Draw, theme, rightPanel.X, rightPanel.Y, rightPanel.W, rightPanel.H, 0.82)
	g.Draw.DrawRect(rightPanel.X, rightPanel.Y, rightPanel.W, 6, theme.GoalTrimColor)
	g.Draw.DrawText(itoa(int(hud.Speed + 0.5)) + " km/h", rightPanel.X + 14, rightPanel.Y + 30, 20, theme.HudTextColor)
	g.Draw.DrawText(formatTime(hud.Time), rightPanel.X + 14, rightPanel.Y + 58, 16, theme.HudAccentTextColor)
	if hud.Boosting {
		boostW := 116.0
		boostPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTopRight, boostW, 32, voplay.ScreenInsets{Right: 14, Top: 102})
		drawHudPanel(g.Draw, theme, boostPanel.X, boostPanel.Y, boostPanel.W, boostPanel.H, 0.80)
		g.Draw.DrawRect(boostPanel.X, boostPanel.Y, boostPanel.W, 5, theme.BoostColor)
		g.Draw.DrawText("BOOST", boostPanel.X + 24, boostPanel.Y + 24, 17, theme.HudTextColor)
	}
	if hud.Drifting || hud.DriftCharge > 0 {
		charge := clampFloat(hud.DriftCharge / kartSuperTurboCharge, 0, 1)
		barW := 128.0
		barPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTopLeft, barW, 34, voplay.ScreenInsets{Left: 12, Top: 102})
		label := "DRIFT"
		fillColor := theme.BoostColor
		if hud.DriftCharge >= kartSuperTurboCharge {
			label = "SUPER"
			fillColor = theme.GoalTrimColor
		} else if hud.DriftCharge >= kartMiniTurboCharge {
			label = "MINI"
			fillColor = theme.AccentColor
		}
		drawHudPanel(g.Draw, theme, barPanel.X, barPanel.Y, barPanel.W, barPanel.H, 0.80)
		g.Draw.DrawText(label, barPanel.X + 12, barPanel.Y + 23, 15, theme.HudTextColor)
		g.Draw.DrawRect(barPanel.X + 62, barPanel.Y + 14, 52, 8, theme.HudShadowColor.WithAlpha(0.3))
		g.Draw.DrawRect(barPanel.X + 62, barPanel.Y + 14, 52 * charge, 8, fillColor)
	}
	if hud.MessageTimer > 0 && !hud.Finished {
		msgW := w - 56
		if msgW > 320 {
			msgW = 320
		}
		msgPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTop, msgW, 38, voplay.ScreenInsets{Top: 142})
		drawHudPanel(g.Draw, theme, msgPanel.X, msgPanel.Y, msgPanel.W, msgPanel.H, 0.84)
		g.Draw.DrawRect(msgPanel.X, msgPanel.Y, msgPanel.W, 5, theme.AccentColor)
		g.Draw.DrawText(hud.Message, msgPanel.X + 18, msgPanel.Y + 26, 18, theme.HudTextColor)
	}
	if hud.RenderDebugMode != scene3d.RenderDebugLit {
		viewW := 180.0
		viewPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTop, viewW, 32, voplay.ScreenInsets{Top: 98})
		drawHudPanel(g.Draw, theme, viewPanel.X, viewPanel.Y, viewPanel.W, viewPanel.H, 0.82)
		g.Draw.DrawRect(viewPanel.X, viewPanel.Y, viewPanel.W, 5, theme.AccentColor)
		g.Draw.DrawText("View " + renderDebugLabel(hud.RenderDebugMode), viewPanel.X + 14, viewPanel.Y + 24, 16, theme.HudTextColor)
	}
	if hud.Finished {
		panelW := w - 46
		if panelW > 350 {
			panelW = 350
		}
		panelH := 150.0
		panel := voplay.AnchorScreenRect(screen, voplay.AnchorCenter, panelW, panelH, voplay.ScreenInsets{})
		drawHudPanel(g.Draw, theme, panel.X, panel.Y, panel.W, panel.H, 0.92)
		g.Draw.DrawRect(panel.X, panel.Y, panel.W, 8, theme.GoalTrimColor)
		g.Draw.DrawText("RACE COMPLETE", panel.X + 36, panel.Y + 46, 25, theme.HudAccentTextColor)
		g.Draw.DrawText("Time " + formatTime(hud.FinishTime), panel.X + 36, panel.Y + 82, 20, theme.HudTextColor)
		g.Draw.DrawText("Items " + itoa(hud.Collected) + "/" + itoa(hud.TotalCollectibles), panel.X + 36, panel.Y + 112, 18, theme.HudSubtextColor)
		g.Draw.DrawText("Tap RST to race again", panel.X + 36, panel.Y + 138, 16, theme.HudAccentTextColor)
	}
}

func drawPortraitWorldHUD(theme *WorldTheme, g *voplay.GameCtx, hud *WorldHUDState) {
	w := float64(g.Screen.Width)
	screen := g.Screen.Rect()
	panelInset := 10.0
	panelW := w - panelInset * 2
	if panelW < 280 {
		panelInset = 6
		panelW = w - panelInset * 2
	}
	panelH := 60.0
	panel := voplay.AnchorScreenRect(screen, voplay.AnchorTop, panelW, panelH, voplay.ScreenInsets{Top: 10})
	titleSize := clampFloat(w / 25.0, 14, 18)
	metaSize := clampFloat(w / 34.0, 11, 14)
	drawHudPanel(g.Draw, theme, panel.X, panel.Y, panel.W, panel.H, 0.82)
	g.Draw.DrawRect(panel.X, panel.Y, panel.W, 6, theme.HudTrimColor)
	g.Draw.DrawText("BlockKart", panel.X + 12, panel.Y + 27, titleSize, theme.HudTextColor)
	speedX := panel.X + panel.W - 116
	if panelW < 340 {
		speedX = panel.X + panel.W - 102
	}
	g.Draw.DrawText(itoa(int(hud.Speed + 0.5)) + " km/h", speedX, panel.Y + 27, titleSize, theme.HudTextColor)
	g.Draw.DrawText("Lap " + itoa(hud.Lap) + "/" + itoa(hud.TotalLaps) + "  Items " + itoa(hud.Collected) + "/" + itoa(hud.TotalCollectibles), panel.X + 12, panel.Y + 50, metaSize, theme.HudAccentTextColor)
	g.Draw.DrawText(formatTime(hud.Time), panel.X + panel.W - 74, panel.Y + 50, metaSize, theme.HudAccentTextColor)
	statusY := panel.Y + panel.H + 8
	if hud.Drifting || hud.DriftCharge > 0 {
		charge := clampFloat(hud.DriftCharge / kartSuperTurboCharge, 0, 1)
		barW := 118.0
		barPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTopLeft, barW, 32, voplay.ScreenInsets{Left: panelInset, Top: statusY})
		label := "DRIFT"
		fillColor := theme.BoostColor
		if hud.DriftCharge >= kartSuperTurboCharge {
			label = "SUPER"
			fillColor = theme.GoalTrimColor
		} else if hud.DriftCharge >= kartMiniTurboCharge {
			label = "MINI"
			fillColor = theme.AccentColor
		}
		drawHudPanel(g.Draw, theme, barPanel.X, barPanel.Y, barPanel.W, barPanel.H, 0.80)
		g.Draw.DrawText(label, barPanel.X + 11, barPanel.Y + 22, 14, theme.HudTextColor)
		g.Draw.DrawRect(barPanel.X + 60, barPanel.Y + 13, 46, 8, theme.HudShadowColor.WithAlpha(0.3))
		g.Draw.DrawRect(barPanel.X + 60, barPanel.Y + 13, 46 * charge, 8, fillColor)
	}
	if hud.Boosting {
		boostW := 102.0
		boostPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTop, boostW, 32, voplay.ScreenInsets{Top: statusY})
		drawHudPanel(g.Draw, theme, boostPanel.X, boostPanel.Y, boostPanel.W, boostPanel.H, 0.80)
		g.Draw.DrawRect(boostPanel.X, boostPanel.Y, boostPanel.W, 5, theme.BoostColor)
		g.Draw.DrawText("BOOST", boostPanel.X + 19, boostPanel.Y + 22, 15, theme.HudTextColor)
	}
	if hud.MessageTimer > 0 && !hud.Finished {
		msgW := w - 40
		if msgW > 320 {
			msgW = 320
		}
		msgY := statusY + 40
		msgPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTop, msgW, 36, voplay.ScreenInsets{Top: msgY})
		drawHudPanel(g.Draw, theme, msgPanel.X, msgPanel.Y, msgPanel.W, msgPanel.H, 0.84)
		g.Draw.DrawRect(msgPanel.X, msgPanel.Y, msgPanel.W, 5, theme.AccentColor)
		g.Draw.DrawText(hud.Message, msgPanel.X + 16, msgPanel.Y + 25, 17, theme.HudTextColor)
	}
	if hud.RenderDebugMode != scene3d.RenderDebugLit {
		viewW := 164.0
		viewPanel := voplay.AnchorScreenRect(screen, voplay.AnchorTop, viewW, 32, voplay.ScreenInsets{Top: statusY})
		drawHudPanel(g.Draw, theme, viewPanel.X, viewPanel.Y, viewPanel.W, viewPanel.H, 0.82)
		g.Draw.DrawRect(viewPanel.X, viewPanel.Y, viewPanel.W, 5, theme.AccentColor)
		g.Draw.DrawText("View " + renderDebugLabel(hud.RenderDebugMode), viewPanel.X + 12, viewPanel.Y + 22, 15, theme.HudTextColor)
	}
	if hud.Finished {
		panelW := w - 42
		if panelW > 340 {
			panelW = 340
		}
		panelH := 150.0
		finishedPanel := voplay.AnchorScreenRect(screen, voplay.AnchorCenter, panelW, panelH, voplay.ScreenInsets{})
		drawHudPanel(g.Draw, theme, finishedPanel.X, finishedPanel.Y, finishedPanel.W, finishedPanel.H, 0.92)
		g.Draw.DrawRect(finishedPanel.X, finishedPanel.Y, finishedPanel.W, 8, theme.GoalTrimColor)
		g.Draw.DrawText("RACE COMPLETE", finishedPanel.X + 32, finishedPanel.Y + 46, 24, theme.HudAccentTextColor)
		g.Draw.DrawText("Time " + formatTime(hud.FinishTime), finishedPanel.X + 32, finishedPanel.Y + 82, 19, theme.HudTextColor)
		g.Draw.DrawText("Items " + itoa(hud.Collected) + "/" + itoa(hud.TotalCollectibles), finishedPanel.X + 32, finishedPanel.Y + 112, 17, theme.HudSubtextColor)
		g.Draw.DrawText("Tap RST to race again", finishedPanel.X + 32, finishedPanel.Y + 138, 15, theme.HudAccentTextColor)
	}
}

func drawHudPanel(d *voplay.DrawCtx, theme *WorldTheme, x, y, width, height float64, alpha float64) {
	d.DrawRect(x + 4, y + 5, width, height, theme.HudShadowColor.WithAlpha(0.18))
	d.DrawRect(x, y, width, height, theme.HudPanelColor.WithAlpha(alpha))
}

func formatTime(seconds float64) string {
	return formatFixed(seconds, 1) + "s"
}

func formatHudFloat(value float64, digits int) string {
	if digits <= 1 {
		return formatFixed(value, 1)
	}
	return formatFixed(value, 2)
}

func formatHudMs(value float64) string {
	return formatFixed(value, 2) + "ms"
}

func formatHudBytes(value int) string {
	if value >= 1024 * 1024 {
		return formatFixed(float64(value) / (1024.0 * 1024.0), 2) + "MB"
	}
	if value >= 1024 {
		return formatFixed(float64(value) / 1024.0, 1) + "KB"
	}
	return itoa(value) + "B"
}

func formatFixed(value float64, digits int) string {
	sign := ""
	if value < 0 {
		sign = "-"
		value = -value
	}
	scale := 1
	for i := 0; i < digits; i++ {
		scale *= 10
	}
	scaled := int(value * float64(scale) + 0.5)
	if digits <= 0 {
		return sign + itoa(scaled)
	}
	whole := scaled / scale
	frac := scaled - whole * scale
	if digits == 1 {
		return sign + itoa(whole) + "." + itoa(frac)
	}
	if frac < 10 {
		return sign + itoa(whole) + ".0" + itoa(frac)
	}
	return sign + itoa(whole) + "." + itoa(frac)
}

func boolHud(value bool) string {
	if value {
		return "yes"
	}
	return "no"
}

func debugHudPrimaryLine(i int) bool {
	return i == 0 || i == 3 || i == 6 || i == 9 || i == 12 || i == 15 || i == 17
}

func renderDebugLabel(mode int) string {
	if mode == scene3d.RenderDebugAlbedo {
		return "Albedo"
	}
	if mode == scene3d.RenderDebugNormal {
		return "Normal"
	}
	if mode == scene3d.RenderDebugRoughness {
		return "Roughness"
	}
	if mode == scene3d.RenderDebugMetallic {
		return "Metallic"
	}
	if mode == scene3d.RenderDebugShadow {
		return "Shadow"
	}
	if mode == scene3d.RenderDebugDirect {
		return "Direct"
	}
	if mode == scene3d.RenderDebugAmbient {
		return "Ambient"
	}
	return "Lit"
}
