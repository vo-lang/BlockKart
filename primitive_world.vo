type primitiveTrackPointDef struct {
	X float64
	Z float64
	Y float64
	Width float64
}

func (w *World) ensurePrimitiveScene() *BlockKartVisualContent {
	if w.primitive != nil {
		return w.primitive
	}
	if w.assets == nil {
		panic("BlockKart primitive scene requires loaded assets")
	}
	if w.runtimeCache != nil && w.runtimeCache.primitiveTemplate != nil {
		primitive := w.runtimeCache.primitiveTemplate.Instantiate(w.scene)
		w.primitive = primitive
		w.primitiveTemplateReused = true
		w.runtimeCache.primitiveTemplateReuses++
		return w.primitive
	}
	w.assets.BeginGroup(worldAssetGroup)
	primitive, err := newBlockKartVisualContent(w.scene, w.assets)
	w.assets.EndGroup()
	if err != nil {
		panic("BlockKart primitive scene asset load failed: " + err.Error())
	}
	w.primitive = primitive
	return w.primitive
}


func newBlockKartPrimitiveLayer(desc primitive3d.LayerDesc) *primitive3d.Layer {
	return primitive3d.NewBuilder(primitive3d.BuilderDesc{Kind: desc.Kind, Shapes: desc.Shapes, Materials: desc.Materials, Chunking: desc.Chunking, PreloadChunks: desc.PreloadChunks, Name: desc.Name}).Build()
}

func newBlockKartPrimitiveTemplate(primitive *BlockKartVisualContent) *BlockKartPrimitiveTemplate {
	if primitive == nil {
		return nil
	}
	return &BlockKartPrimitiveTemplate{Scene: primitive}
}

func (t *BlockKartPrimitiveTemplate) Instantiate(scene *scene3d.Scene) *BlockKartVisualContent {
	if t == nil || t.Scene == nil {
		return nil
	}
	source := t.Scene
	primitive := *source
	primitive.Static = source.Static.Clone()
	primitive.TreeDetailStatic = source.TreeDetailStatic.Clone()
	primitive.RoadsideDetailStatic = source.RoadsideDetailStatic.Clone()
	primitive.SmallDetailStatic = source.SmallDetailStatic.Clone()
	primitive.FlowerDetailStatic = source.FlowerDetailStatic.Clone()
	primitive.ScatterStatic = source.ScatterStatic.Clone()
	primitive.Dynamic = newBlockKartPrimitiveLayer(primitive3d.LayerDesc{Kind: primitive3d.DynamicLayer, Shapes: source.Shapes, Materials: source.Materials, Name: "blockkart_dynamic_primitives"})
	if scene != nil {
		scene.AddPrimitiveLayer(primitive.Static)
		scene.AddPrimitiveLayer(primitive.TreeDetailStatic)
		scene.AddPrimitiveLayer(primitive.RoadsideDetailStatic)
		scene.AddPrimitiveLayer(primitive.SmallDetailStatic)
		scene.AddPrimitiveLayer(primitive.FlowerDetailStatic)
		scene.AddPrimitiveLayer(primitive.ScatterStatic)
		scene.AddPrimitiveLayer(primitive.Dynamic)
	}
	return &primitive
}

func newBlockKartVisualContent(scene *scene3d.Scene, assets *voplay.Assets) (*BlockKartVisualContent, error) {
	shapes := primitive3d.NewShapeRegistry()
	materials := primitive3d.NewMaterialPalette()
	staticLayer := newBlockKartPrimitiveLayer(primitive3d.LayerDesc{Kind: primitive3d.StaticLayer, Shapes: shapes, Materials: materials, Chunking: primitive3d.ChunkingDesc{CellSize: primitiveStaticBatchCellSize}, PreloadChunks: true, Name: "blockkart_static_primitives"})
	treeDetailLayer := newBlockKartPrimitiveLayer(primitive3d.LayerDesc{Kind: primitive3d.StaticLayer, Shapes: shapes, Materials: materials, Chunking: primitive3d.ChunkingDesc{CellSize: primitiveTreeDetailBatchCellSize}, PreloadChunks: true, Name: "blockkart_tree_detail_primitives"})
	roadsideDetailLayer := newBlockKartPrimitiveLayer(primitive3d.LayerDesc{Kind: primitive3d.StaticLayer, Shapes: shapes, Materials: materials, Chunking: primitive3d.ChunkingDesc{CellSize: primitiveRoadsideDetailBatchCellSize}, PreloadChunks: true, Name: "blockkart_roadside_detail_primitives"})
	smallDetailLayer := newBlockKartPrimitiveLayer(primitive3d.LayerDesc{Kind: primitive3d.StaticLayer, Shapes: shapes, Materials: materials, Chunking: primitive3d.ChunkingDesc{CellSize: primitiveSmallDetailBatchCellSize}, PreloadChunks: true, Name: "blockkart_small_detail_primitives"})
	flowerDetailLayer := newBlockKartPrimitiveLayer(primitive3d.LayerDesc{Kind: primitive3d.StaticLayer, Shapes: shapes, Materials: materials, Chunking: primitive3d.ChunkingDesc{CellSize: primitiveFlowerDetailBatchCellSize}, PreloadChunks: true, Name: "blockkart_flower_detail_primitives"})
	scatterLayer := newBlockKartPrimitiveLayer(primitive3d.LayerDesc{Kind: primitive3d.StaticLayer, Shapes: shapes, Materials: materials, Chunking: primitive3d.ChunkingDesc{CellSize: primitiveScatterBatchCellSize}, PreloadChunks: true, Name: "blockkart_scatter_primitives"})
	dynamicLayer := newBlockKartPrimitiveLayer(primitive3d.LayerDesc{Kind: primitive3d.DynamicLayer, Shapes: shapes, Materials: materials, Name: "blockkart_dynamic_primitives"})
	p := &BlockKartVisualContent{Shapes: shapes, Materials: materials, Static: staticLayer, TreeDetailStatic: treeDetailLayer, RoadsideDetailStatic: roadsideDetailLayer, SmallDetailStatic: smallDetailLayer, FlowerDetailStatic: flowerDetailLayer, ScatterStatic: scatterLayer, Dynamic: dynamicLayer}
	grassCardTexture, grassCardErr := assets.Texture(blockKartAssetPath("effects/grass_card_atlas.png"))
	if grassCardErr != nil {
		return nil, grassCardErr
	}
	p.Box = shapes.Shape(primitive3d.ShapeDesc{Kind: primitive3d.ShapeBox})
	p.RoundedBox = shapes.Shape(primitive3d.ShapeDesc{Kind: primitive3d.ShapeRoundedBox, BevelRadius: 0.08, Segments: 4})
	p.Sphere = shapes.Shape(primitive3d.ShapeDesc{Kind: primitive3d.ShapeSphere, Segments: 8})
	p.Cylinder = shapes.Shape(primitive3d.ShapeDesc{Kind: primitive3d.ShapeCylinder, Segments: 10})
	p.Cone = shapes.Shape(primitive3d.ShapeDesc{Kind: primitive3d.ShapeCone, Segments: 8})
	p.Wedge = shapes.Shape(primitive3d.ShapeDesc{Kind: primitive3d.ShapeWedge})
	p.GrassCard = shapes.Shape(primitive3d.ShapeDesc{Kind: primitive3d.ShapePlane, Width: 1, Depth: 1, SubX: 1, SubZ: 1})
	p.NeedleLeaf = shapes.Shape(primitive3d.ShapeDesc{Kind: primitive3d.ShapeCone, Segments: 5})
	p.RoadMat = p.material(primitive3d.MaterialRoadAsphalt, voplay.Hex(0x414443), 0.84, 0, voplay.Color{})
	p.RoadStripeMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0xfff4dd), 0.48, 0, voplay.Color{})
	p.GrassMat = p.material(primitive3d.MaterialGrass, voplay.Hex(0x4f9737), 0.64, 0, voplay.Color{})
	p.GrassCardMat = p.grassCardMaterial(grassCardTexture)
	p.MeadowMat = p.material(primitive3d.MaterialGrass, voplay.Hex(0x86a346), 0.66, 0, voplay.Color{})
	p.DirtDetailMat = p.material(primitive3d.MaterialStone, voplay.Hex(0x9a6738), 0.88, 0, voplay.Color{})
	p.StoneMat = p.material(primitive3d.MaterialStone, voplay.Hex(0x8f8778), 0.82, 0, voplay.Color{})
	p.PebbleMat = p.material(primitive3d.MaterialStone, voplay.Hex(0xa89a84), 0.82, 0, voplay.Color{})
	p.CliffMat = p.material(primitive3d.MaterialStone, voplay.Hex(0x82684f), 0.84, 0, voplay.Color{})
	p.PaleStoneMat = p.material(primitive3d.MaterialStone, voplay.Hex(0xa99c84), 0.78, 0, voplay.Color{})
	p.WoodMat = p.material(primitive3d.MaterialWood, voplay.Hex(0x7a4a26), 0.76, 0, voplay.Color{})
	p.LeafMat = p.material(primitive3d.MaterialGrass, voplay.Hex(0x205f34), 0.66, 0, voplay.Color{})
	p.BushMat = p.material(primitive3d.MaterialGrass, voplay.Hex(0x327638), 0.66, 0, voplay.Color{})
	p.FlowerYellowMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0xffdd35), 0.42, 0, voplay.Color{})
	p.FlowerWhiteMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0xfff7df), 0.46, 0, voplay.Color{})
	p.WaterMat = p.material(primitive3d.MaterialWater, voplay.Hex(0x2ba6ee).WithAlpha(0.74), 0.14, 0, voplay.Color{})
	p.SignMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0xffd234), 0.30, 0, voplay.Color{})
	p.SignArrowMat = p.material(primitive3d.MaterialRubber, voplay.Hex(0x121519), 0.72, 0, voplay.Color{})
	p.PlayerMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0x0078ff), 0.18, 0, voplay.Color{})
	p.TrimMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0xffe43a), 0.20, 0, voplay.Color{})
	p.OrangeTrimMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0xff8a00), 0.20, 0, voplay.Color{})
	p.WhiteMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0xfffbec), 0.16, 0, voplay.Color{})
	p.TopBlueMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0x19c9ff), 0.16, 0, voplay.Color{})
	p.VisorMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0x061742), 0.18, 0, voplay.Color{})
	p.DriverMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0xff7f18), 0.20, 0, voplay.Color{})
	p.WheelMat = p.material(primitive3d.MaterialRubber, voplay.Hex(0x171d29), 0.82, 0, voplay.Color{})
	p.MetalMat = p.material(primitive3d.MaterialStone, voplay.Hex(0xdce8f4), 0.34, 0.02, voplay.Color{})
	p.BoostMat = p.material(primitive3d.MaterialGlow, voplay.Hex(0x28cfff), 0.22, 0, voplay.Hex(0x28cfff))
	p.GlowMat = p.material(primitive3d.MaterialGlow, voplay.Hex(0xffe45c), 0.24, 0, voplay.Hex(0xffe45c))
	p.OrbMat = p.material(primitive3d.MaterialGlow, voplay.Hex(0xff85cc), 0.26, 0, voplay.Hex(0xff65be))
	p.HazardMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0xf23b58), 0.38, 0, voplay.Color{})
	p.CloudMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0xffffff), 0.47, 0, voplay.Color{})
	p.CloudShadowMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0xd9eef7), 0.55, 0, voplay.Color{})
	p.ContactShadowMat = p.material(primitive3d.MaterialRubber, voplay.Hex(0x11100d).WithAlpha(0.16), 0.98, 0, voplay.Color{})
	p.TowerWallMat = p.material(primitive3d.MaterialStone, voplay.Hex(0xcfae72), 0.68, 0, voplay.Color{})
	p.TowerRoofMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0xf04a32), 0.34, 0, voplay.Color{})
	scene.AddPrimitiveLayer(staticLayer)
	scene.AddPrimitiveLayer(treeDetailLayer)
	scene.AddPrimitiveLayer(roadsideDetailLayer)
	scene.AddPrimitiveLayer(smallDetailLayer)
	scene.AddPrimitiveLayer(flowerDetailLayer)
	scene.AddPrimitiveLayer(scatterLayer)
	scene.AddPrimitiveLayer(dynamicLayer)
	return p, nil
}

func (p *BlockKartVisualContent) material(preset primitive3d.MaterialPreset, color voplay.Color, roughness, metallic float64, emissive voplay.Color) primitive3d.MaterialID {
	base := voplay.MaterialDesc{BaseColor: color, Roughness: roughness, Metallic: metallic, UVScale: 1}
	if emissive != (voplay.Color{}) {
		base.EmissiveColor = emissive
	}
	return p.Materials.Material(primitive3d.MaterialDesc{Preset: preset, Base: base})
}

func (p *BlockKartVisualContent) grassCardMaterial(albedo voplay.TextureID) primitive3d.MaterialID {
	base := voplay.MaterialDesc{BaseColor: voplay.Color{R: 1.0, G: 1.0, B: 0.96, A: 1}, Albedo: albedo, Roughness: 0.88, Metallic: 0, UVScale: 1, DetailStrength: 0.006, MacroBlend: 0.001, RoughnessResponse: 0.38, ToonRampResponse: 0.34, EmissiveColor: voplay.Color{R: 0.135, G: 0.235, B: 0.060, A: 1}, ShadingMode: voplay.MaterialShadingToon, FilterMode: voplay.MaterialFilterNearest}
	return p.Materials.Material(primitive3d.MaterialDesc{Preset: primitive3d.MaterialGrass, Base: base})
}

func (p *BlockKartVisualContent) PlaceStatic(shape primitive3d.ShapeID, material primitive3d.MaterialID, position voplay.Vec3, rotation voplay.Quat, scale voplay.Vec3, tint voplay.Color) primitive3d.ObjectID {
	return p.Static.Add(primitive3d.Instance{Shape: shape, Material: material, Position: position, Rotation: normalizePrimitiveQuat(rotation), Scale: normalizePrimitiveVecScale(scale), Tint: tint})
}

func (p *BlockKartVisualContent) PlaceStaticWithFlags(shape primitive3d.ShapeID, material primitive3d.MaterialID, position voplay.Vec3, rotation voplay.Quat, scale voplay.Vec3, tint voplay.Color, flags primitive3d.InstanceFlags) primitive3d.ObjectID {
	return p.Static.Add(primitive3d.Instance{Shape: shape, Material: material, Position: position, Rotation: normalizePrimitiveQuat(rotation), Scale: normalizePrimitiveVecScale(scale), Tint: tint, Flags: flags})
}

func (p *BlockKartVisualContent) PlaceDetail(shape primitive3d.ShapeID, material primitive3d.MaterialID, position voplay.Vec3, rotation voplay.Quat, scale voplay.Vec3, tint voplay.Color, lodFar float64) primitive3d.ObjectID {
	if material == p.ContactShadowMat {
		return 0
	}
	flags := p.detailFlags(shape, material, lodFar)
	detailLodFar := lodFar
	return p.detailLayerForLod(detailLodFar).Add(primitive3d.Instance{Shape: shape, Material: material, Position: position, Rotation: normalizePrimitiveQuat(rotation), Scale: normalizePrimitiveVecScale(scale), Tint: tint, Flags: flags, LodFar: detailLodFar})
}

func (p *BlockKartVisualContent) detailFlags(shape primitive3d.ShapeID, material primitive3d.MaterialID, lodFar float64) primitive3d.InstanceFlags {
	if shape == p.GrassCard || material == p.GrassCardMat || lodFar <= primitiveFlowerClumpLodFar {
		return primitive3d.InstanceNoShadow
	}
	return primitive3d.InstanceFlags(0)
}

func (p *BlockKartVisualContent) detailLayerForLod(lodFar float64) *primitive3d.Layer {
	if lodFar >= primitiveTreeLodFar {
		return p.TreeDetailStatic
	}
	if lodFar >= primitiveRoadsidePropLodFar {
		return p.RoadsideDetailStatic
	}
	if lodFar <= primitiveFlowerClumpLodFar {
		return p.FlowerDetailStatic
	}
	return p.SmallDetailStatic
}

func (p *BlockKartVisualContent) AddDynamic(shape primitive3d.ShapeID, material primitive3d.MaterialID, position voplay.Vec3, rotation voplay.Quat, scale voplay.Vec3, tint voplay.Color) *PrimitivePart {
	return p.AddDynamicWithFlags(shape, material, position, rotation, scale, tint, primitive3d.InstanceFlags(0))
}

func (p *BlockKartVisualContent) AddDynamicWithFlags(shape primitive3d.ShapeID, material primitive3d.MaterialID, position voplay.Vec3, rotation voplay.Quat, scale voplay.Vec3, tint voplay.Color, flags primitive3d.InstanceFlags) *PrimitivePart {
	instance := primitive3d.Instance{Shape: shape, Material: material, Position: position, Rotation: normalizePrimitiveQuat(rotation), Scale: normalizePrimitiveVecScale(scale), Tint: tint, Flags: flags}
	id := p.Dynamic.Add(instance)
	return &PrimitivePart{Layer: p.Dynamic, Object: id, Shape: shape, Material: material, Flags: flags, Position: position, Rotation: normalizePrimitiveQuat(rotation), Scale: normalizePrimitiveVecScale(scale), Tint: tint, Visible: true}
}

func (p *PrimitivePart) SetPose(position voplay.Vec3, rotation voplay.Quat) {
	p.setPose(position, rotation, false)
}

func (p *PrimitivePart) setPose(position voplay.Vec3, rotation voplay.Quat, force bool) {
	if p == nil || p.Layer == nil || p.Object == 0 {
		return
	}
	nextRotation := normalizePrimitiveQuat(rotation)
	if !force && p.Position == position && p.Rotation == nextRotation {
		return
	}
	p.Position = position
	p.Rotation = nextRotation
	p.write()
}

func (p *PrimitivePart) SetPoseScale(position voplay.Vec3, rotation voplay.Quat, scale voplay.Vec3) {
	if p == nil {
		return
	}
	nextScale := normalizePrimitiveVecScale(scale)
	scaleChanged := p.Scale != nextScale
	p.Scale = nextScale
	p.setPose(position, rotation, scaleChanged)
}

func (p *PrimitivePart) SetVisible(visible bool) {
	if p == nil || p.Layer == nil || p.Object == 0 {
		return
	}
	if p.Visible == visible {
		return
	}
	p.Visible = visible
	p.write()
}

func (p *PrimitivePart) write() {
	if p == nil || p.Layer == nil || p.Object == 0 {
		return
	}
	scale := p.Scale
	if !p.Visible {
		scale = voplay.Vec3{X: 0.001, Y: 0.001, Z: 0.001}
	}
	p.Layer.Set(p.Object, primitive3d.Instance{Shape: p.Shape, Material: p.Material, Flags: p.Flags, Position: p.Position, Rotation: normalizePrimitiveQuat(p.Rotation), Scale: normalizePrimitiveVecScale(scale), Tint: p.Tint, Object: p.Object})
}

func blockKartHighFrequencyPrimitiveFlags() primitive3d.InstanceFlags {
	return primitive3d.InstanceNoShadow
}

func hidePrimitivePart(part *PrimitivePart) {
	if part != nil {
		part.SetVisible(false)
	}
}

func showPrimitivePart(part *PrimitivePart) {
	if part != nil {
		part.SetVisible(true)
	}
}

func (w *World) buildPrimitiveLevel() error {
	prof := newBlockKartStartupProfiler("BlockKart primitive")
	primitive := w.ensurePrimitiveScene()
	templateReused := w.primitiveTemplateReused
	prof.Mark("ensurePrimitiveScene")
	mapErr := w.preparePrimitiveMapAsset()
	if mapErr != nil {
		w.message = "Primitive map failed: " + mapErr.Error()
		w.messageTimer = 4
		fmt.Println(w.message)
		return errors.New(w.message)
	}
	prof.Mark("preparePrimitiveMapAsset")
	asset := newPrimitiveTrackAsset()
	prof.Mark("newPrimitiveTrackAsset")
	track, err := scene3d.NewTrack(asset)
	if err != nil {
		w.message = "Primitive track failed: " + err.Error()
		w.messageTimer = 4
		fmt.Println(w.message)
		return errors.New(w.message)
	}
	w.track = track
	prof.Mark("NewTrack")
	result, terrainErr := w.spawnPrimitiveTrackTerrain(track)
	if terrainErr != nil {
		w.message = "Terrain failed: " + terrainErr.Error()
		w.messageTimer = 4
		fmt.Println(w.message)
		return errors.New(w.message)
	}
	w.trackResult = result
	prof.Mark("spawnPrimitiveTrackTerrain")
	w.applyPrimitiveTrackSpawn(track)
	w.populatePrimitiveTrackCheckpoints(track)
	prof.Mark("trackSpawnAndCheckpoints")
	if templateReused {
		w.spawnPrimitiveCachedMapMeshes(track)
		prof.Mark("reusePrimitiveStaticTemplate")
	} else {
		w.buildPrimitiveTrackVisuals(track)
		prof.Mark("buildPrimitiveTrackVisuals")
	}
	w.spawnPrimitiveTrackPhysics(track)
	prof.Mark("spawnPrimitiveTrackPhysics")
	w.spawnPrimitiveGameplay(track, !templateReused)
	prof.Mark("spawnPrimitiveGameplay")
	if templateReused {
		prof.Mark("reuseStaticLayerChunks")
		return nil
	}
	primitive.Static.Build()
	prof.Mark("buildStaticLayer")
	primitive.TreeDetailStatic.Build()
	prof.Mark("buildTreeDetailLayer")
	primitive.RoadsideDetailStatic.Build()
	prof.Mark("buildRoadsideDetailLayer")
	primitive.SmallDetailStatic.Build()
	prof.Mark("buildSmallDetailLayer")
	primitive.FlowerDetailStatic.Build()
	prof.Mark("buildFlowerDetailLayer")
	primitive.ScatterStatic.Build()
	prof.Mark("buildScatterLayer")
	if w.runtimeCache != nil && w.runtimeCache.primitiveTemplate == nil {
		w.runtimeCache.primitiveTemplate = newBlockKartPrimitiveTemplate(primitive)
		if w.runtimeCache.primitiveTemplate != nil {
			w.runtimeCache.primitiveTemplateBuilds++
		}
	}
	return nil
}

func (w *World) preparePrimitiveMapAsset() error {
	if w.primitiveMap != nil {
		return nil
	}
	if w.runtimeCache != nil && w.runtimeCache.primitiveMap != nil {
		w.primitiveMap = w.runtimeCache.primitiveMap
		w.preparedMapReused = true
		w.runtimeCache.preparedMapReuses++
		return nil
	}
	if w.assets == nil {
		return errors.New("BlockKart assets unavailable")
	}
	w.assets.BeginGroup(worldAssetGroup)
	prepared, err := scene3d.PrepareMapWithAssets(w.assets, blockKartAssetPath("maps/primitive_track/blockkart.map.json"))
	w.assets.EndGroup()
	if err != nil {
		return err
	}
	w.primitiveMap = prepared
	if w.runtimeCache != nil {
		w.runtimeCache.primitiveMap = prepared
		w.runtimeCache.preparedMapBuilds++
	}
	return nil
}

func newPrimitiveTrackAsset() *scene3d.TrackAsset {
	points := primitiveTrackControlPoints()
	length := primitiveTrackLength(points)
	start := length * 0.052
	return &scene3d.TrackAsset{Version: 1, Name: "primitive_block_kart", ClosedLoop: true, Centerline: points, Surfaces: []scene3d.TrackSurface{scene3d.TrackSurface{Name: "primitive_road", Kind: scene3d.TrackSurfaceRoad, Start: 0, End: 0, Friction: 1.05}, scene3d.TrackSurface{Name: "primitive_boost_1", Kind: scene3d.TrackSurfaceBoost, Start: length * 0.12, End: length * 0.15, Left: -4.2, Right: 4.2, Priority: 4, Friction: 1.08, Boost: 1.0}, scene3d.TrackSurface{Name: "primitive_boost_2", Kind: scene3d.TrackSurfaceBoost, Start: length * 0.58, End: length * 0.61, Left: -4.2, Right: 4.2, Priority: 4, Friction: 1.08, Boost: 1.0}}, Gates: []scene3d.TrackGate{scene3d.TrackGate{Name: "Gate 1", Distance: start, Width: primitiveTrackWidth, Radius: 15}, scene3d.TrackGate{Name: "Gate 2", Distance: length * 0.58, Width: primitiveTrackWidth, Radius: 15}, scene3d.TrackGate{Name: "Gate 3", Distance: length * 0.72, Width: primitiveTrackWidth, Radius: 15}, scene3d.TrackGate{Name: "Gate 4", Distance: length * 0.86, Width: primitiveTrackWidth, Radius: 15}}, Spawns: []scene3d.TrackSpawn{scene3d.TrackSpawn{Name: "player_start", Distance: start}}, Respawns: []scene3d.TrackRespawn{scene3d.TrackRespawn{Name: "respawn_start", Distance: start}, scene3d.TrackRespawn{Name: "respawn_2", Distance: length * 0.58}, scene3d.TrackRespawn{Name: "respawn_3", Distance: length * 0.72}, scene3d.TrackRespawn{Name: "respawn_4", Distance: length * 0.86}}}
}

func (w *World) spawnPrimitiveTrackTerrain(track *scene3d.Track) (*scene3d.TrackSpawnResult, error) {
	if track == nil {
		return nil, errors.New("BlockKart primitive track unavailable")
	}
	if w.assets == nil {
		return nil, errors.New("BlockKart assets unavailable")
	}
	if w.primitiveMap == nil {
		err := w.preparePrimitiveMapAsset()
		if err != nil {
			return nil, err
		}
	}
	return scene3d.SpawnPreparedMapTrackMeshTerrain(w.scene, track, w.primitiveMap, "lowpoly_terrain")
}

func primitiveTrackControlPoints() []scene3d.TrackControlPoint {
	points := []scene3d.TrackControlPoint{}
	anchors := primitiveConceptTrackAnchors()
	samplesPerSegment := 18
	for i := 0; i < len(anchors); i++ {
		a := anchors[(i + len(anchors) - 1) % len(anchors)]
		b := anchors[i]
		c := anchors[(i + 1) % len(anchors)]
		d := anchors[(i + 2) % len(anchors)]
		for s := 0; s < samplesPerSegment; s++ {
			t := float64(s) / float64(samplesPerSegment)
			def := primitiveTrackCatmull(a, b, c, d, t)
			position := voplay.Vec3{X: def.X * primitiveMapPlanarScale, Y: def.Y, Z: def.Z * primitiveMapPlanarScale}
			points = append(points, scene3d.TrackControlPoint{Position: primitiveMapVec3(position), Width: def.Width})
		}
	}
	if len(points) > 0 {
		points = append(points, points[0])
	}
	return points
}

func primitiveConceptTrackAnchors() []primitiveTrackPointDef {
	return []primitiveTrackPointDef{{X: 8, Z: 150, Y: 0.0, Width: 19.0}, {X: 104, Z: 150, Y: 0.02, Width: 19.0}, {X: 168, Z: 128, Y: 0.14, Width: 18.8}, {X: 190, Z: 90, Y: 0.28, Width: 18.4}, {X: 128, Z: 44, Y: 0.36, Width: 18.0}, {X: 184, Z: -24, Y: 0.5, Width: 18.4}, {X: 162, Z: -104, Y: 0.62, Width: 18.6}, {X: 82, Z: -136, Y: 0.68, Width: 18.8}, {X: -18, Z: -136, Y: 0.64, Width: 18.8}, {X: -116, Z: -132, Y: 0.54, Width: 18.6}, {X: -184, Z: -88, Y: 0.42, Width: 18.4}, {X: -158, Z: -34, Y: 0.28, Width: 18.0}, {X: -124, Z: 4, Y: 0.2, Width: 18.2}, {X: -178, Z: 62, Y: 0.08, Width: 18.4}, {X: -168, Z: 118, Y: 0.02, Width: 18.8}, {X: -94, Z: 150, Y: 0.0, Width: 19.0}}
}

func primitiveTrackCatmull(a, b, c, d primitiveTrackPointDef, t float64) primitiveTrackPointDef {
	return primitiveTrackPointDef{X: primitiveCatmullValue(a.X, b.X, c.X, d.X, t), Z: primitiveCatmullValue(a.Z, b.Z, c.Z, d.Z, t), Y: primitiveCatmullValue(a.Y, b.Y, c.Y, d.Y, t), Width: primitiveCatmullValue(a.Width, b.Width, c.Width, d.Width, t)}
}

func primitiveCatmullValue(a, b, c, d, t float64) float64 {
	t2 := t * t
	t3 := t2 * t
	return 0.5 * (2.0 * b + (-a + c) * t + (2.0 * a - 5.0 * b + 4.0 * c - d) * t2 + (-a + 3.0 * b - 3.0 * c + d) * t3)
}

func primitiveTrackLength(points []scene3d.TrackControlPoint) float64 {
	total := 0.0
	for i := 0; i < len(points) - 1; i++ {
		total += points[i].Position.Vec3().Distance(points[i + 1].Position.Vec3())
	}
	return total
}

func primitiveMapVec3(v voplay.Vec3) scene3d.MapVec3 {
	return scene3d.MapVec3{X: v.X, Y: v.Y, Z: v.Z}
}

func primitiveSceneryVec3(x, y, z float64) voplay.Vec3 {
	return voplay.Vec3{X: x * primitiveMapPlanarScale, Y: y, Z: z * primitiveMapPlanarScale}
}

func primitiveLandmarkVec3(x, y, z float64) voplay.Vec3 {
	return voplay.Vec3{X: x * primitiveLandmarkScale, Y: y * primitiveLandmarkScale, Z: z * primitiveLandmarkScale}
}

func (w *World) buildPrimitiveTrackVisuals(track *scene3d.Track) {
	w.addPrimitiveLandmarks(track)
	w.addContinuousPrimitiveRoadVisuals(track)
	w.addPrimitiveRoadsideMicroDetails(track)
	w.addPrimitiveTerrainGroves()
	w.addPrimitiveHeroRoadsideClusters(track)
	count := primitiveTrackSampleCount(track)
	length := track.Length()
	step := length / float64(count)
	for i := 0; i < count; i++ {
		distance := float64(i) * step + step * 0.5
		pose := track.PoseAt(distance)
		if i % 7 == 0 {
			w.addPrimitiveFencePair(pose, step * 2.35)
		}
		if i % 3 == 1 {
			w.addPrimitiveTreeAtPose(pose, pose.HalfWidth + 18.0 + float64((i * 7) % 18), 0.88 + float64(i % 5) * 0.10)
		}
		if i % 4 == 2 {
			w.addPrimitiveTreeAtPose(pose, -(pose.HalfWidth + 22.0 + float64((i * 5) % 24)), 0.82 + float64(i % 4) * 0.09)
		}
		if i % 5 == 2 {
			w.addPrimitiveBushClusterAtPose(pose, pose.HalfWidth + 8.4)
		}
		if i % 5 == 4 {
			w.addPrimitiveBushClusterAtPose(pose, -(pose.HalfWidth + 8.8))
		}
		if i % 10 == 4 {
			w.addPrimitiveSignAtPose(pose, pose.HalfWidth + 5.6)
		}
		if i % 8 == 2 {
			w.addPrimitiveRocksAtPose(pose, -(pose.HalfWidth + 12.5))
		}
	}
	w.addPrimitiveStartGantry(primitiveTrackStartPose(track))
	w.addPrimitiveClouds()
}

func primitiveTrackStartPose(track *scene3d.Track) scene3d.TrackPose {
	if track == nil || track.Asset() == nil {
		return scene3d.TrackPose{}
	}
	for _, spawn := range track.Asset().Spawns {
		if spawn.Name == "player_start" {
			return track.PoseAt(spawn.Distance)
		}
	}
	return track.PoseAt(0)
}

func primitiveTrackStartDistance(track *scene3d.Track) float64 {
	if track == nil || track.Asset() == nil {
		return 0
	}
	for _, spawn := range track.Asset().Spawns {
		if spawn.Name == "player_start" {
			return spawn.Distance
		}
	}
	return 0
}

func (w *World) applyPrimitiveTrackSpawn(track *scene3d.Track) {
	pose := primitiveTrackStartPose(track)
	w.startPosition = primitiveRidePosition(pose.Position)
	w.startYaw = pose.Yaw
	w.checkpointPosition = w.startPosition
	w.checkpointYaw = w.startYaw
	w.kartYaw = w.startYaw
}

func (w *World) populatePrimitiveTrackCheckpoints(track *scene3d.Track) {
	if track == nil || track.Asset() == nil {
		return
	}
	w.checkpoints = nil
	for _, gate := range track.Asset().Gates {
		pose := track.PoseAt(gate.Distance)
		respawn := track.RespawnPoseNear(pose.Position)
		radius := gate.Radius
		if radius <= 0 {
			radius = checkpointRadius
		}
		w.checkpoints = append(w.checkpoints, newCheckpoint(primitiveRidePosition(pose.Position), primitiveRidePosition(respawn.Position), respawn.Yaw, gate.Name, radius))
	}
	w.refreshNextGateLabel()
}

func primitiveRidePosition(position voplay.Vec3) voplay.Vec3 {
	return position.Add(voplay.Vec3{Y: kartSpawnRideHeight})
}

func (w *World) addContinuousPrimitiveRoadVisuals(track *scene3d.Track) {
	if track == nil {
		return
	}
	if w.primitiveMap == nil {
		w.message = "Primitive map unavailable"
		w.messageTimer = 3
		return
	}
	names := []string{"road_shoulders", "road_asphalt", "road_curbs", "road_tire_grime", "road_edge_lines", "road_center_dashes"}
	for _, name := range names {
		_, err := scene3d.SpawnPreparedMapMesh(w.scene, w.primitiveMap, name)
		if err != nil {
			w.message = "Road assets failed"
			w.messageTimer = 3
			fmt.Println(w.message)
			fmt.Println(name + ": " + err.Error())
			return
		}
	}
}

func (w *World) spawnPrimitiveCachedMapMeshes(track *scene3d.Track) {
	w.addContinuousPrimitiveRoadVisuals(track)
	if track == nil || w.primitiveMap == nil {
		return
	}
	_, creekErr := scene3d.SpawnPreparedMapMesh(w.scene, w.primitiveMap, "hero_creek")
	if creekErr != nil {
		w.message = "Creek asset failed"
		w.messageTimer = 3
		fmt.Println(w.message + ": " + creekErr.Error())
	}
}

func primitiveRoadsideBakedSlots(primitive *BlockKartVisualContent) []scene3d.BakedPrimitiveLayerSlot {
	return []scene3d.BakedPrimitiveLayerSlot{scene3d.BakedPrimitiveLayerSlot{Shape: primitive.GrassCard, Material: primitive.GrassCardMat}, scene3d.BakedPrimitiveLayerSlot{Shape: primitive.RoundedBox, Material: primitive.DirtDetailMat}, scene3d.BakedPrimitiveLayerSlot{Shape: primitive.RoundedBox, Material: primitive.PaleStoneMat}, scene3d.BakedPrimitiveLayerSlot{Shape: primitive.RoundedBox, Material: primitive.PebbleMat}, scene3d.BakedPrimitiveLayerSlot{Shape: primitive.RoundedBox, Material: primitive.StoneMat}, scene3d.BakedPrimitiveLayerSlot{Shape: primitive.Cylinder, Material: primitive.LeafMat}, scene3d.BakedPrimitiveLayerSlot{Shape: primitive.Sphere, Material: primitive.FlowerYellowMat}, scene3d.BakedPrimitiveLayerSlot{Shape: primitive.Sphere, Material: primitive.FlowerWhiteMat}}
}

func primitiveRoadsideBakedSlotNames() []string {
	return []string{"grass_card", "dirt_stroke", "pale_stone", "pebble", "stone", "flower_stem", "flower_yellow", "flower_white"}
}

func (w *World) addPrimitiveRoadsideMicroDetails(track *scene3d.Track) {
	if track == nil {
		return
	}
	if w.primitiveMap == nil {
		w.message = "Roadside primitive map unavailable"
		w.messageTimer = 3
		return
	}
	primitive := w.ensurePrimitiveScene()
	_, err := scene3d.SpawnBakedMapPrimitiveContentWithAssets(w.scene, w.assets, w.primitiveMap, []scene3d.MapPrimitiveLayerTarget{scene3d.MapPrimitiveLayerTarget{Name: "roadside_meadow", Layer: primitive.ScatterStatic, Slots: primitiveRoadsideBakedSlots(primitive), SlotNames: primitiveRoadsideBakedSlotNames()}})
	if err != nil {
		w.message = "Roadside primitive asset failed: " + err.Error()
		w.messageTimer = 3
		fmt.Println(w.message)
	}
}

func primitiveScatterNoise2D(x, z float64) float64 {
	v := math.Sin(x * 127.1 + z * 311.7) * 43758.5453123
	v = v - math.Floor(v)
	if v < 0 {
		return v + 1
	}
	return v
}

func (w *World) addPrimitiveLandmarks(track *scene3d.Track) {
	w.addPrimitiveMountainRange()
	w.addPrimitiveHeroCreek(track)
	w.addPrimitiveHeroHillTower(track)
}

func (w *World) addPrimitiveHeroHillTower(track *scene3d.Track) {
	if track == nil {
		w.addPrimitiveHillTowerAtWorld(primitiveSceneryVec3(126, 0.8, 206))
		return
	}
	length := track.Length()
	distance := primitiveTrackStartDistance(track) + length * 0.085
	pose := track.PoseAt(distance)
	base := pose.Position.Add(pose.Right.Scale(pose.HalfWidth + 60.0)).Add(pose.Forward.Scale(18.0)).Add(voplay.Vec3{Y: 1.6})
	w.addPrimitiveHillTowerAtWorld(base)
}

func (w *World) addPrimitiveHeroCreek(track *scene3d.Track) {
	if track == nil {
		return
	}
	if w.primitiveMap == nil {
		w.message = "Primitive map unavailable"
		w.messageTimer = 3
		return
	}
	primitive := w.ensurePrimitiveScene()
	length := track.Length()
	startDistance := primitiveTrackStartDistance(track)
	start := startDistance - length * 0.025
	end := startDistance + length * 0.130
	_, creekErr := scene3d.SpawnPreparedMapMesh(w.scene, w.primitiveMap, "hero_creek")
	if creekErr != nil {
		w.message = "Creek asset failed"
		w.messageTimer = 3
		fmt.Println(w.message + ": " + creekErr.Error())
		return
	}
	count := 42
	step := (end - start) / float64(count)
	for i := 0; i < count; i++ {
		distance := start + (float64(i) + 0.5) * step
		pose := track.PoseAt(distance)
		wobble := math.Sin(float64(i) * 0.72) * 3.8
		base := pose.Position.Add(pose.Right.Scale(-(pose.HalfWidth + 30.0 + wobble)))
		base = w.primitiveTerrainSurfacePosition(base, 0.12)
		if i % 2 == 0 {
			bank := w.primitiveTerrainSurfacePosition(base.Add(pose.Right.Scale(3.4)), 0.20)
			primitive.PlaceDetail(primitive.RoundedBox, primitive.PebbleMat, bank, pose.Rotation, voplay.Vec3{X: 1.05, Y: 0.16, Z: step * 0.48}, voplay.Color{}, primitiveSmallPropLodFar)
		}
		if i % 3 == 1 {
			rockPos := w.primitiveTerrainSurfacePosition(base.Add(pose.Right.Scale(-4.5)), 0)
			primitive.PlaceDetail(primitive.RoundedBox, primitive.StoneMat, rockPos.Add(voplay.Vec3{Y: 0.42}), pose.Rotation, voplay.Vec3{X: 2.15, Y: 0.74, Z: 1.45}, voplay.Color{}, primitiveSmallPropLodFar)
			primitive.PlaceDetail(primitive.RoundedBox, primitive.PaleStoneMat, rockPos.Add(pose.Forward.Scale(1.15)).Add(voplay.Vec3{Y: 0.24}), pose.Rotation, voplay.Vec3{X: 1.02, Y: 0.42, Z: 0.82}, voplay.Color{}, primitiveSmallPropLodFar)
		}
		if i % 4 == 2 {
			w.addPrimitiveBushClusterAtPose(pose, -(pose.HalfWidth + 34.0 + wobble))
		}
	}
}

func (w *World) addPrimitiveLakeAndBridge(track *scene3d.Track) {
	primitive := w.ensurePrimitiveScene()
	lake := primitiveSceneryVec3(44, -0.30, 8)
	primitive.PlaceStatic(primitive.RoundedBox, primitive.WaterMat, lake, voplay.QuatIdentity(), primitiveLandmarkVec3(62, 0.12, 39), voplay.Color{})
	for i := 0; i < 12; i++ {
		a := float64(i) / 12.0 * math.Pi * 2
		x := lake.X + math.Cos(a) * 33.0 * primitiveLandmarkScale
		z := lake.Z + math.Sin(a) * 21.0 * primitiveLandmarkScale
		scale := 1.2 + float64(i % 4) * 0.16
		primitive.PlaceStatic(primitive.RoundedBox, primitive.StoneMat, voplay.Vec3{X: x, Y: 0.12, Z: z}, voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, a), primitiveLandmarkVec3(2.2 * scale, 0.54, 1.45 * scale), voplay.Color{})
	}
	w.addPrimitiveStoneBridge(track.PoseAt(track.Length() * 0.46))
}

func (w *World) addPrimitiveStoneBridge(pose scene3d.TrackPose) {
	primitive := w.ensurePrimitiveScene()
	deckPos := pose.Position.Add(voplay.Vec3{Y: -0.10})
	primitive.PlaceStatic(primitive.RoundedBox, primitive.PaleStoneMat, deckPos, pose.Rotation, voplay.Vec3{X: pose.HalfWidth * 2 + 4.0, Y: 0.72, Z: 8.6}, voplay.Color{})
	for i := -2; i <= 2; i++ {
		lateral := float64(i) * 4.6
		col := deckPos.Add(pose.Right.Scale(lateral)).Add(voplay.Vec3{Y: -1.55})
		primitive.PlaceStatic(primitive.RoundedBox, primitive.PaleStoneMat, col, pose.Rotation, voplay.Vec3{X: 1.25, Y: 2.9, Z: 1.2}, voplay.Color{})
		if i < 2 {
			archCenter := deckPos.Add(pose.Right.Scale(lateral + 2.3)).Add(voplay.Vec3{Y: -0.55})
			primitive.PlaceStatic(primitive.RoundedBox, primitive.PaleStoneMat, archCenter, pose.Rotation, voplay.Vec3{X: 2.7, Y: 0.55, Z: 1.1}, voplay.Color{})
		}
	}
	railY := deckPos.Add(voplay.Vec3{Y: 1.0})
	primitive.PlaceStatic(primitive.RoundedBox, primitive.WoodMat, railY.Add(pose.Right.Scale(pose.HalfWidth + 1.8)), pose.Rotation, voplay.Vec3{X: 0.26, Y: 0.22, Z: 9.2}, voplay.Color{})
	primitive.PlaceStatic(primitive.RoundedBox, primitive.WoodMat, railY.Sub(pose.Right.Scale(pose.HalfWidth + 1.8)), pose.Rotation, voplay.Vec3{X: 0.26, Y: 0.22, Z: 9.2}, voplay.Color{})
}

func (w *World) addPrimitiveWaterfall() {
	primitive := w.ensurePrimitiveScene()
	base := primitiveSceneryVec3(-96, 0, -24)
	primitive.PlaceStatic(primitive.RoundedBox, primitive.CliffMat, base.Add(primitiveLandmarkVec3(0, 2.2, 0)), voplay.QuatIdentity(), primitiveLandmarkVec3(34, 4.8, 17), voplay.Color{})
	primitive.PlaceStatic(primitive.RoundedBox, primitive.GrassMat, base.Add(primitiveLandmarkVec3(0, 4.95, -0.4)), voplay.QuatIdentity(), primitiveLandmarkVec3(36, 0.52, 18), voplay.Color{})
	primitive.PlaceStatic(primitive.RoundedBox, primitive.CliffMat, base.Add(primitiveLandmarkVec3(-8, 6.5, -3)), voplay.QuatIdentity(), primitiveLandmarkVec3(16, 3.1, 10), voplay.Color{})
	primitive.PlaceStatic(primitive.RoundedBox, primitive.MeadowMat, base.Add(primitiveLandmarkVec3(-8, 8.25, -3)), voplay.QuatIdentity(), primitiveLandmarkVec3(17, 0.46, 11), voplay.Color{})
	for i := 0; i < 5; i++ {
		x := base.X + (-7.5 + float64(i) * 3.4) * primitiveLandmarkScale
		primitive.PlaceStatic(primitive.RoundedBox, primitive.WaterMat, voplay.Vec3{X: x, Y: 4.3 * primitiveLandmarkScale, Z: base.Z + 8.55 * primitiveLandmarkScale}, voplay.QuatIdentity(), primitiveLandmarkVec3(2.4, 7.8, 0.45), voplay.Color{})
	}
	primitive.PlaceStatic(primitive.RoundedBox, primitive.WaterMat, base.Add(primitiveLandmarkVec3(0, -0.22, 17)), voplay.QuatIdentity(), primitiveLandmarkVec3(38, 0.12, 20), voplay.Color{})
	for i := 0; i < 7; i++ {
		w.addPrimitiveTreeAtWorld(base.Add(primitiveLandmarkVec3(-14 + float64(i) * 4.8, 8.5, -9 + float64((i * 5) % 7))), (0.78 + float64(i % 3) * 0.08) * primitiveLandmarkScale)
	}
}

func (w *World) addPrimitiveMountainRange() {
	primitive := w.ensurePrimitiveScene()
	for i := 0; i < 8; i++ {
		x := (-126.0 + float64(i) * 36.0) * primitiveMapPlanarScale
		z := (-148.0 - float64((i * 13) % 24)) * primitiveMapPlanarScale
		h := (6.5 + float64((i * 7) % 5)) * primitiveLandmarkScale
		rot := voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, float64(i) * 0.21)
		primitive.PlaceStatic(primitive.RoundedBox, primitive.CliffMat, voplay.Vec3{X: x, Y: h * 0.25, Z: z}, rot, primitiveLandmarkVec3(24, h * 0.55 / primitiveLandmarkScale, 16), voplay.Color{})
		primitive.PlaceStatic(primitive.RoundedBox, primitive.MeadowMat, voplay.Vec3{X: x + 1.5 * primitiveLandmarkScale, Y: h * 0.55, Z: z - 0.5 * primitiveLandmarkScale}, rot, primitiveLandmarkVec3(21, 0.9, 14), voplay.Color{})
		primitive.PlaceStatic(primitive.Cone, primitive.PaleStoneMat, voplay.Vec3{X: x + 3 * primitiveLandmarkScale, Y: h + 1.4 * primitiveLandmarkScale, Z: z}, voplay.QuatIdentity(), primitiveLandmarkVec3(13, 9.4, 13), voplay.Color{})
	}
}

func (w *World) addPrimitiveHillTower(pose scene3d.TrackPose) {
	base := pose.Position.Sub(pose.Right.Scale(pose.HalfWidth + 42)).Add(voplay.Vec3{Y: 0.8})
	w.addPrimitiveHillTowerAtWorld(base)
}

func (w *World) addPrimitiveHillTowerAtWorld(base voplay.Vec3) {
	primitive := w.ensurePrimitiveScene()
	base = w.primitiveTerrainSurfacePosition(base, 0.8)
	primitive.PlaceStatic(primitive.Cylinder, primitive.CliffMat, base.Add(voplay.Vec3{Y: 2.15}), voplay.QuatIdentity(), voplay.Vec3{X: 37, Y: 4.4, Z: 27}, voplay.Color{})
	primitive.PlaceStatic(primitive.Cylinder, primitive.CliffMat, base.Add(voplay.Vec3{X: -3.8, Y: 3.42, Z: 2.4}), voplay.QuatIdentity(), voplay.Vec3{X: 32, Y: 2.4, Z: 23}, voplay.Color{R: 0.90, G: 0.82, B: 0.68, A: 1})
	primitive.PlaceStatic(primitive.Cylinder, primitive.GrassMat, base.Add(voplay.Vec3{Y: 4.92}), voplay.QuatIdentity(), voplay.Vec3{X: 36, Y: 0.70, Z: 26}, voplay.Color{R: 0.86, G: 0.96, B: 0.70, A: 1})
	tower := base.Add(voplay.Vec3{Y: 5.55})
	primitive.PlaceStatic(primitive.Cylinder, primitive.TowerWallMat, tower.Add(voplay.Vec3{Y: 3.7}), voplay.QuatIdentity(), voplay.Vec3{X: 5.8, Y: 7.5, Z: 5.8}, voplay.Color{})
	primitive.PlaceStatic(primitive.RoundedBox, primitive.TowerWallMat, tower.Add(voplay.Vec3{Y: 8.05}), voplay.QuatIdentity(), voplay.Vec3{X: 8.6, Y: 1.55, Z: 8.6}, voplay.Color{})
	primitive.PlaceStatic(primitive.Cone, primitive.TowerRoofMat, tower.Add(voplay.Vec3{Y: 10.0}), voplay.QuatIdentity(), voplay.Vec3{X: 9.8, Y: 3.8, Z: 9.8}, voplay.Color{})
	for i := 0; i < 8; i++ {
		a := float64(i) / 8.0 * math.Pi * 2
		post := tower.Add(voplay.Vec3{X: math.Cos(a) * 13.2, Y: 6.75, Z: math.Sin(a) * 10.4})
		primitive.PlaceDetail(primitive.Cylinder, primitive.WoodMat, post, voplay.QuatIdentity(), voplay.Vec3{X: 0.28, Y: 1.34, Z: 0.28}, voplay.Color{}, primitiveRoadsidePropLodFar)
	}
	w.addPrimitiveTreeAtWorld(base.Add(voplay.Vec3{X: -15, Y: 5.75, Z: -8}), 0.96)
	w.addPrimitiveTreeAtWorld(base.Add(voplay.Vec3{X: 15, Y: 5.75, Z: 9}), 0.90)
}

func (w *World) addPrimitiveTunnelPortal(pose scene3d.TrackPose) {
	primitive := w.ensurePrimitiveScene()
	center := pose.Position.Add(voplay.Vec3{Y: 2.0})
	primitive.PlaceStatic(primitive.RoundedBox, primitive.CliffMat, center.Add(voplay.Vec3{Y: 1.6}), pose.Rotation, voplay.Vec3{X: pose.HalfWidth * 2 + 12, Y: 7.6, Z: 8.5}, voplay.Color{})
	primitive.PlaceStatic(primitive.RoundedBox, primitive.RoadMat, center.Add(voplay.Vec3{Y: -1.25}), pose.Rotation, voplay.Vec3{X: pose.HalfWidth * 2 + 2.0, Y: 3.9, Z: 9.0}, voplay.Color{})
	primitive.PlaceStatic(primitive.RoundedBox, primitive.PaleStoneMat, center.Add(pose.Right.Scale(-(pose.HalfWidth + 1.4))), pose.Rotation, voplay.Vec3{X: 2.0, Y: 5.6, Z: 9.6}, voplay.Color{})
	primitive.PlaceStatic(primitive.RoundedBox, primitive.PaleStoneMat, center.Add(pose.Right.Scale(pose.HalfWidth + 1.4)), pose.Rotation, voplay.Vec3{X: 2.0, Y: 5.6, Z: 9.6}, voplay.Color{})
	primitive.PlaceStatic(primitive.RoundedBox, primitive.PaleStoneMat, center.Add(voplay.Vec3{Y: 3.2}), pose.Rotation, voplay.Vec3{X: pose.HalfWidth * 2 + 6.0, Y: 1.7, Z: 9.7}, voplay.Color{})
	primitive.PlaceStatic(primitive.Sphere, primitive.GlowMat, center.Add(pose.Right.Scale(-pose.HalfWidth * 0.62)).Add(voplay.Vec3{Y: 0.15}), pose.Rotation, voplay.Vec3{X: 0.6, Y: 0.6, Z: 0.6}, voplay.Color{})
	primitive.PlaceStatic(primitive.Sphere, primitive.GlowMat, center.Add(pose.Right.Scale(pose.HalfWidth * 0.62)).Add(voplay.Vec3{Y: 0.15}), pose.Rotation, voplay.Vec3{X: 0.6, Y: 0.6, Z: 0.6}, voplay.Color{})
}

func (w *World) addPrimitiveFencePair(pose scene3d.TrackPose, step float64) {
	primitive := w.ensurePrimitiveScene()
	for _, side := range []float64{-1, 1} {
		base := pose.Position.Add(pose.Right.Scale(side * (pose.HalfWidth + 6.4)))
		base = w.primitiveTerrainSurfacePosition(base, 0.06)
		postRot := voplay.QuatIdentity()
		primitive.PlaceDetail(primitive.Cylinder, primitive.WoodMat, base.Add(voplay.Vec3{Y: 0.90}), postRot, voplay.Vec3{X: 0.26, Y: 1.80, Z: 0.26}, voplay.Color{}, primitiveRoadsidePropLodFar)
		lowRail := base.Add(voplay.Vec3{Y: 0.82})
		highRail := base.Add(voplay.Vec3{Y: 1.26})
		primitive.PlaceDetail(primitive.RoundedBox, primitive.WoodMat, lowRail, pose.Rotation, voplay.Vec3{X: 0.18, Y: 0.16, Z: step * 1.16}, voplay.Color{}, primitiveRoadsidePropLodFar)
		primitive.PlaceDetail(primitive.RoundedBox, primitive.WoodMat, highRail, pose.Rotation, voplay.Vec3{X: 0.20, Y: 0.17, Z: step * 1.16}, voplay.Color{}, primitiveRoadsidePropLodFar)
	}
}

func (w *World) addPrimitiveTreeAtPose(pose scene3d.TrackPose, lateral, scale float64) {
	base := pose.Position.Add(pose.Right.Scale(lateral))
	base = w.primitiveTerrainSurfacePosition(base, 0)
	w.addPrimitiveTreeAtWorld(base, scale)
}

func (w *World) primitiveTerrainSurfacePosition(pos voplay.Vec3, lift float64) voplay.Vec3 {
	if w.trackResult != nil {
		probe := w.trackResult.HeightProbe()
		if probe != nil {
			if h, ok := probe(pos); ok {
				pos.Y = h + lift
				return pos
			}
		}
	}
	pos.Y += lift
	return pos
}

func (w *World) addPrimitiveTreeAtWorld(base voplay.Vec3, scale float64) {
	primitive := w.ensurePrimitiveScene()
	scale *= 2.06
	primitive.PlaceDetail(primitive.RoundedBox, primitive.ContactShadowMat, base.Add(voplay.Vec3{Y: 0.035}), voplay.QuatIdentity(), voplay.Vec3{X: 3.10 * scale, Y: 0.028, Z: 2.35 * scale}, voplay.Color{}, primitiveTreeLodFar)
	primitive.PlaceDetail(primitive.Cylinder, primitive.WoodMat, base.Add(voplay.Vec3{Y: 1.08 * scale}), voplay.QuatIdentity(), voplay.Vec3{X: 0.52 * scale, Y: 2.16 * scale, Z: 0.52 * scale}, voplay.Color{}, primitiveTreeLodFar)
	primitive.PlaceDetail(primitive.Cylinder, primitive.LeafMat, base.Add(voplay.Vec3{Y: 1.50 * scale}), voplay.QuatIdentity(), voplay.Vec3{X: 2.72 * scale, Y: 0.068 * scale, Z: 2.72 * scale}, voplay.Color{R: 0.22, G: 0.36, B: 0.21, A: 1}, primitiveTreeLodFar)
	primitive.PlaceDetail(primitive.NeedleLeaf, primitive.BushMat, base.Add(voplay.Vec3{Y: 2.08 * scale}), voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, 0.10), voplay.Vec3{X: 4.28 * scale, Y: 2.64 * scale, Z: 4.28 * scale}, voplay.Color{R: 0.30, G: 0.50, B: 0.27, A: 1}, primitiveTreeLodFar)
	primitive.PlaceDetail(primitive.Cylinder, primitive.LeafMat, base.Add(voplay.Vec3{Y: 2.40 * scale}), voplay.QuatIdentity(), voplay.Vec3{X: 2.22 * scale, Y: 0.062 * scale, Z: 2.22 * scale}, voplay.Color{R: 0.22, G: 0.36, B: 0.21, A: 1}, primitiveTreeLodFar)
	primitive.PlaceDetail(primitive.NeedleLeaf, primitive.LeafMat, base.Add(voplay.Vec3{Y: 2.70 * scale}), voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, 0.38), voplay.Vec3{X: 3.56 * scale, Y: 2.92 * scale, Z: 3.56 * scale}, voplay.Color{R: 0.36, G: 0.58, B: 0.31, A: 1}, primitiveTreeLodFar)
	primitive.PlaceDetail(primitive.Cylinder, primitive.LeafMat, base.Add(voplay.Vec3{Y: 3.68 * scale}), voplay.QuatIdentity(), voplay.Vec3{X: 1.58 * scale, Y: 0.055 * scale, Z: 1.58 * scale}, voplay.Color{R: 0.22, G: 0.36, B: 0.21, A: 1}, primitiveTreeLodFar)
	primitive.PlaceDetail(primitive.NeedleLeaf, primitive.LeafMat, base.Add(voplay.Vec3{Y: 4.08 * scale}), voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, 0.72), voplay.Vec3{X: 2.66 * scale, Y: 2.58 * scale, Z: 2.66 * scale}, voplay.Color{R: 0.44, G: 0.66, B: 0.36, A: 1}, primitiveTreeLodFar)
}

func (w *World) addPrimitiveTerrainGroves() {
	centers := []voplay.Vec3{primitiveSceneryVec3(-170, 0, 122), primitiveSceneryVec3(-118, 0, 44), primitiveSceneryVec3(130, 0, 112), primitiveSceneryVec3(176, 0, 26), primitiveSceneryVec3(-112, 0, -118), primitiveSceneryVec3(92, 0, -126), primitiveSceneryVec3(206, 0, -88)}
	for c, center := range centers {
		count := 5 + (c % 3)
		for i := 0; i < count; i++ {
			a := float64((i * 137 + c * 43) % 360) / 360.0 * math.Pi * 2
			radius := primitiveMapPlanarScale * (12.0 + float64((i * 17 + c * 11) % 26))
			pos := voplay.Vec3{X: center.X + math.Cos(a) * radius, Z: center.Z + math.Sin(a) * radius}
			if w.track != nil {
				cp := w.track.ClosestPoint(pos)
				if math.Abs(cp.LateralDistance) < cp.HalfWidth + 15.0 {
					continue
				}
			}
			scale := 0.76 + float64((i * 5 + c * 3) % 9) * 0.075
			if c == 0 || c == 3 {
				scale += 0.18
			}
			pos = w.primitiveTerrainSurfacePosition(pos, 0)
			w.addPrimitiveTreeAtWorld(pos, scale)
			if i % 3 == 1 {
				w.addPrimitiveRockClusterAtWorld(pos.Add(voplay.Vec3{X: math.Sin(a) * 5.8, Z: math.Cos(a) * 4.8}), 0.82 + float64(c % 3) * 0.10)
			}
		}
	}
}

func (w *World) addPrimitiveRockClusterAtWorld(pos voplay.Vec3, scale float64) {
	primitive := w.ensurePrimitiveScene()
	base := w.primitiveTerrainSurfacePosition(pos, 0)
	primitive.PlaceDetail(primitive.RoundedBox, primitive.ContactShadowMat, base.Add(voplay.Vec3{Y: 0.04}), voplay.QuatIdentity(), voplay.Vec3{X: 4.2 * scale, Y: 0.03, Z: 2.8 * scale}, voplay.Color{}, primitiveSmallPropLodFar)
	primitive.PlaceDetail(primitive.RoundedBox, primitive.StoneMat, base.Add(voplay.Vec3{Y: 0.38 * scale}), voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, scale), voplay.Vec3{X: 1.8 * scale, Y: 0.72 * scale, Z: 1.15 * scale}, voplay.Color{}, primitiveSmallPropLodFar)
	primitive.PlaceDetail(primitive.RoundedBox, primitive.PaleStoneMat, base.Add(voplay.Vec3{X: 1.25 * scale, Y: 0.22 * scale, Z: 0.65 * scale}), voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, 0.7 + scale), voplay.Vec3{X: 0.92 * scale, Y: 0.42 * scale, Z: 0.72 * scale}, voplay.Color{}, primitiveSmallPropLodFar)
	primitive.PlaceDetail(primitive.Sphere, primitive.BushMat, base.Add(voplay.Vec3{X: -1.35 * scale, Y: 0.34 * scale, Z: -0.82 * scale}), voplay.QuatIdentity(), voplay.Vec3{X: 1.25 * scale, Y: 0.74 * scale, Z: 1.25 * scale}, voplay.Color{}, primitiveSmallPropLodFar)
}

func (w *World) addPrimitiveHeroRoadsideClusters(track *scene3d.Track) {
	if track == nil {
		return
	}
	length := track.Length()
	startDistance := primitiveTrackStartDistance(track)
	for i := 0; i < 30; i++ {
		distance := startDistance + length * (0.004 + float64(i) * 0.0058)
		pose := track.PoseAt(distance)
		for sideIndex, side := range []float64{-1, 1} {
			n := primitiveScatterNoise2D(float64(i * 37 + sideIndex * 13) * 0.23, float64(i * 19 - sideIndex * 7) * 0.31)
			lateral := side * (pose.HalfWidth + 5.8 + n * 12.5)
			base := pose.Position.Add(pose.Right.Scale(lateral)).Add(pose.Forward.Scale((n - 0.5) * 4.2))
			base = w.primitiveTerrainSurfacePosition(base, 0)
			if (i + sideIndex) % 3 != 1 {
				w.addPrimitiveRockClusterAtWorld(base, 1.05 + float64((i + sideIndex) % 4) * 0.18)
			}
			if i % 2 == 0 || sideIndex == 1 {
				w.addPrimitiveFlowerClumpAtWorld(base.Add(pose.Right.Scale(side * 2.4)).Add(pose.Forward.Scale(1.2)), 1.05 + float64((i + sideIndex) % 3) * 0.16, i * 29 + sideIndex * 113)
			}
			if (i + sideIndex) % 5 == 2 {
				w.addPrimitiveHeroShrubAtWorld(base.Add(pose.Forward.Scale(-2.4)), 1.0 + float64((i + sideIndex) % 3) * 0.18)
			}
		}
	}
}

func (w *World) addPrimitiveFlowerClumpAtWorld(pos voplay.Vec3, scale float64, seed int) {
	primitive := w.ensurePrimitiveScene()
	base := w.primitiveTerrainSurfacePosition(pos, 0.06)
	count := 5 + seed % 5
	for i := 0; i < count; i++ {
		n := primitiveScatterNoise2D(float64(seed + i * 13) * 0.41, float64(seed - i * 17) * 0.29)
		angle := n * math.Pi * 2
		radius := (0.24 + n * 1.15) * scale
		stemHeight := (0.42 + n * 0.34) * scale
		stem := base.Add(voplay.Vec3{X: math.Cos(angle) * radius, Z: math.Sin(angle) * radius})
		stem = w.primitiveTerrainSurfacePosition(stem, 0.08)
		primitive.PlaceDetail(primitive.Cylinder, primitive.LeafMat, stem.Add(voplay.Vec3{Y: stemHeight * 0.5}), voplay.QuatIdentity(), voplay.Vec3{X: 0.045 * scale, Y: stemHeight, Z: 0.045 * scale}, voplay.Color{R: 0.70, G: 0.92, B: 0.58, A: 1}, primitiveFlowerClumpLodFar)
		mat := primitive.FlowerYellowMat
		if i % 3 == 0 {
			mat = primitive.FlowerWhiteMat
		}
		headScale := 0.19 + n * 0.13
		primitive.PlaceDetail(primitive.Sphere, mat, stem.Add(voplay.Vec3{Y: stemHeight + 0.10 * scale}), voplay.QuatIdentity(), voplay.Vec3{X: headScale * scale, Y: headScale * 0.58 * scale, Z: headScale * scale}, voplay.Color{}, primitiveFlowerClumpLodFar)
	}
}

func (w *World) addPrimitiveHeroShrubAtWorld(pos voplay.Vec3, scale float64) {
	primitive := w.ensurePrimitiveScene()
	base := w.primitiveTerrainSurfacePosition(pos, 0.18)
	primitive.PlaceDetail(primitive.RoundedBox, primitive.ContactShadowMat, base.Add(voplay.Vec3{Y: -0.12}), voplay.QuatIdentity(), voplay.Vec3{X: 4.4 * scale, Y: 0.026, Z: 2.8 * scale}, voplay.Color{}, primitiveSmallPropLodFar)
	for i := 0; i < 4; i++ {
		n := primitiveScatterNoise2D(float64(i) * 0.31 + scale, float64(i) * 0.47 - scale)
		offset := voplay.Vec3{X: (float64(i) - 1.5) * 0.92 * scale, Y: n * 0.14, Z: (n - 0.5) * 1.25 * scale}
		primitive.PlaceDetail(primitive.Sphere, primitive.BushMat, base.Add(offset), voplay.QuatIdentity(), voplay.Vec3{X: (1.12 + n * 0.34) * scale, Y: (0.62 + n * 0.22) * scale, Z: (1.12 + n * 0.34) * scale}, voplay.Color{R: 0.74, G: 0.92, B: 0.58, A: 1}, primitiveSmallPropLodFar)
	}
}

func (w *World) addPrimitiveBushClusterAtPose(pose scene3d.TrackPose, lateral float64) {
	primitive := w.ensurePrimitiveScene()
	base := w.primitiveTerrainSurfacePosition(pose.Position.Add(pose.Right.Scale(lateral)), 0.32)
	primitive.PlaceDetail(primitive.RoundedBox, primitive.ContactShadowMat, base.Add(voplay.Vec3{Y: -0.28}), pose.Rotation, voplay.Vec3{X: 3.8, Y: 0.026, Z: 2.2}, voplay.Color{}, primitiveSmallPropLodFar)
	for i := 0; i < 3; i++ {
		offset := pose.Right.Scale(float64(i - 1) * 1.15).Add(pose.Forward.Scale(float64((i * 7) % 5 - 2) * 0.48))
		scale := 0.78 + float64(i) * 0.12
		primitive.PlaceDetail(primitive.Sphere, primitive.BushMat, base.Add(offset), voplay.QuatIdentity(), voplay.Vec3{X: 1.4 * scale, Y: 0.86 * scale, Z: 1.4 * scale}, voplay.Color{}, primitiveSmallPropLodFar)
	}
}

func (w *World) addPrimitiveSignAtPose(pose scene3d.TrackPose, lateral float64) {
	primitive := w.ensurePrimitiveScene()
	base := pose.Position.Add(pose.Right.Scale(lateral))
	rot := pose.Rotation
	primitive.PlaceDetail(primitive.Cylinder, primitive.WoodMat, base.Add(voplay.Vec3{Y: 1.0}), voplay.QuatIdentity(), voplay.Vec3{X: 0.18, Y: 2.0, Z: 0.18}, voplay.Color{}, primitiveRoadsidePropLodFar)
	board := base.Add(voplay.Vec3{Y: 2.35})
	primitive.PlaceDetail(primitive.RoundedBox, primitive.SignMat, board, rot, voplay.Vec3{X: 3.2, Y: 1.15, Z: 0.22}, voplay.Color{}, primitiveRoadsidePropLodFar)
	barRot := rot.Mul(voplay.QuatFromAxisAngle(voplay.Vec3{Z: 1}, 0.55))
	for _, face := range []float64{-1, 1} {
		faceOffset := pose.Forward.Scale(face * 0.34)
		primitive.PlaceDetail(primitive.RoundedBox, primitive.SignArrowMat, board.Add(faceOffset).Add(pose.Right.Scale(-0.72)).Add(voplay.Vec3{Y: 0.06}), barRot, voplay.Vec3{X: 1.08, Y: 0.28, Z: 0.16}, voplay.Color{}, primitiveRoadsidePropLodFar)
		primitive.PlaceDetail(primitive.RoundedBox, primitive.SignArrowMat, board.Add(faceOffset).Add(voplay.Vec3{Y: 0.06}), barRot, voplay.Vec3{X: 1.08, Y: 0.28, Z: 0.16}, voplay.Color{}, primitiveRoadsidePropLodFar)
		primitive.PlaceDetail(primitive.RoundedBox, primitive.SignArrowMat, board.Add(faceOffset).Add(pose.Right.Scale(0.72)).Add(voplay.Vec3{Y: 0.06}), barRot, voplay.Vec3{X: 1.08, Y: 0.28, Z: 0.16}, voplay.Color{}, primitiveRoadsidePropLodFar)
	}
}

func (w *World) addPrimitiveRocksAtPose(pose scene3d.TrackPose, lateral float64) {
	primitive := w.ensurePrimitiveScene()
	base := w.primitiveTerrainSurfacePosition(pose.Position.Add(pose.Right.Scale(lateral)), 0)
	primitive.PlaceDetail(primitive.RoundedBox, primitive.ContactShadowMat, base.Add(voplay.Vec3{Y: 0.045}), pose.Rotation, voplay.Vec3{X: 3.8, Y: 0.03, Z: 2.4}, voplay.Color{}, primitiveSmallPropLodFar)
	primitive.PlaceDetail(primitive.RoundedBox, primitive.StoneMat, base.Add(voplay.Vec3{Y: 0.35}), voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, 0.4), voplay.Vec3{X: 1.8, Y: 0.72, Z: 1.2}, voplay.Color{}, primitiveSmallPropLodFar)
	primitive.PlaceDetail(primitive.Sphere, primitive.BushMat, base.Add(voplay.Vec3{X: 1.4, Y: 0.38, Z: 0.7}), voplay.QuatIdentity(), voplay.Vec3{X: 1.4, Y: 0.8, Z: 1.4}, voplay.Color{}, primitiveSmallPropLodFar)
}

func (w *World) addPrimitiveStartGantry(pose scene3d.TrackPose) {
	primitive := w.ensurePrimitiveScene()
	for _, side := range []float64{-1, 1} {
		base := pose.Position.Add(pose.Right.Scale(side * (pose.HalfWidth + 2.8))).Sub(pose.Forward.Scale(2.5))
		primitive.PlaceStatic(primitive.Cylinder, primitive.WoodMat, base.Add(voplay.Vec3{Y: 0.70}), voplay.QuatIdentity(), voplay.Vec3{X: 0.22, Y: 1.4, Z: 0.22}, voplay.Color{})
	}
}

func (w *World) addPrimitiveClouds() {
	primitive := w.ensurePrimitiveScene()
	for i := 0; i < 12; i++ {
		x := -72.0 + float64(i % 6) * 54.0 + float64((i * 11) % 23 - 11)
		z := 108.0 + float64(i / 6) * 72.0 + float64((i * 13) % 27 - 13)
		y := 58.0 + float64((i * 7) % 17)
		scale := 0.82 + float64((i * 5) % 9) * 0.045
		base := primitiveSceneryVec3(x, y, z)
		primitive.PlaceStatic(primitive.Sphere, primitive.CloudMat, base, voplay.QuatIdentity(), primitiveLandmarkVec3(12.0 * scale, 7.2 * scale, 8.8 * scale), voplay.Color{})
		primitive.PlaceStatic(primitive.Sphere, primitive.CloudShadowMat, base.Add(primitiveLandmarkVec3(-7.2 * scale, -1.45 * scale, 2.0 * scale)), voplay.QuatIdentity(), primitiveLandmarkVec3(7.2 * scale, 4.4 * scale, 5.6 * scale), voplay.Color{})
		primitive.PlaceStatic(primitive.Sphere, primitive.CloudMat, base.Add(primitiveLandmarkVec3(7.4 * scale, -0.45 * scale, -2.2 * scale)), voplay.QuatIdentity(), primitiveLandmarkVec3(6.8 * scale, 4.2 * scale, 5.4 * scale), voplay.Color{})
		primitive.PlaceStatic(primitive.Sphere, primitive.CloudMat, base.Add(primitiveLandmarkVec3(1.4 * scale, 1.1 * scale, 3.1 * scale)), voplay.QuatIdentity(), primitiveLandmarkVec3(5.8 * scale, 3.8 * scale, 4.6 * scale), voplay.Color{})
	}
}

func (w *World) spawnPrimitiveTrackPhysics(track *scene3d.Track) {
	length := track.Length()
	count := primitiveTrackPhysicsSampleCount(track)
	step := length / float64(count)
	ground := w.scene.Spawn(scene3d.EntityDesc{Position: voplay.Vec3{Y: primitiveTerrainY + 1.42}, Tag: "primitive_ground_physics", Physics: &scene3d.Physics{Type: scene3d.Static, Collider: scene3d.Box(primitiveTerrainWidth * 0.5, 0.18, primitiveTerrainDepth * 0.5), Layer: voplay.CollisionLayerDefault, Mask: voplay.CollisionMaskAll, Friction: 0.72, Restitution: 0.02}, PickMode: scene3d.PickDisabled})
	ground.Visible = false
	w.trackResult.Entities = append(w.trackResult.Entities, ground)
	w.spawnRoadColliderStrip(track, count, step)
}

func (w *World) spawnRoadColliderStrip(track *scene3d.Track, count int, step float64) {
	for i := 0; i < count; i++ {
		pose := track.PoseAt(float64(i) * step + step * 0.5)
		ent := w.scene.Spawn(scene3d.EntityDesc{Position: pose.Position.Add(voplay.Vec3{Y: -0.08}), Rotation: pose.Rotation, Tag: "primitive_road_physics", Physics: &scene3d.Physics{Type: scene3d.Static, Collider: scene3d.Box(pose.HalfWidth + primitiveRoadPhysicsOuterOffset, 0.18, step * primitiveRoadPhysicsSegmentOverlap), Layer: voplay.CollisionLayerDefault, Mask: voplay.CollisionMaskAll, Friction: 1.05, Restitution: 0.01}, PickMode: scene3d.PickDisabled})
		ent.Visible = false
		w.trackResult.Entities = append(w.trackResult.Entities, ent)
	}
}

func (w *World) spawnPrimitiveGameplay(track *scene3d.Track, includeStaticVisuals bool) {
	length := track.Length()
	startDistance := primitiveTrackStartDistance(track)
	for i := 0; i < 8; i++ {
		d := startDistance + length * (0.10 + float64(i) * 0.095)
		pose := track.PoseAt(d)
		w.addCollectible(pose.Position.Add(voplay.Vec3{Y: 2.1}), "primitive_collectible_" + itoa(i))
	}
	for _, d := range []float64{length * 0.13, length * 0.59} {
		pose := track.PoseAt(d)
		w.addBoostPad(pose.Position, 7.0)
		if includeStaticVisuals {
			w.addPrimitiveBoostPadVisual(pose)
		}
	}
}

func (w *World) addPrimitiveBoostPadVisual(pose scene3d.TrackPose) {
	primitive := w.ensurePrimitiveScene()
	primitive.PlaceStatic(primitive.RoundedBox, primitive.BoostMat, pose.Position.Add(voplay.Vec3{Y: 0.22}), pose.Rotation, voplay.Vec3{X: 6.2, Y: 0.12, Z: 3.2}, voplay.Color{})
	primitive.PlaceStatic(primitive.RoundedBox, primitive.GlowMat, pose.Position.Add(voplay.Vec3{Y: 0.32}).Add(pose.Right.Scale(-2.2)), pose.Rotation, voplay.Vec3{X: 0.38, Y: 0.08, Z: 2.65}, voplay.Color{})
	primitive.PlaceStatic(primitive.RoundedBox, primitive.GlowMat, pose.Position.Add(voplay.Vec3{Y: 0.32}).Add(pose.Right.Scale(2.2)), pose.Rotation, voplay.Vec3{X: 0.38, Y: 0.08, Z: 2.65}, voplay.Color{})
}

func primitiveTrackSampleCount(track *scene3d.Track) int {
	count := int(math.Ceil(track.Length() / primitiveTrackSegmentLength))
	if count < 24 {
		count = 24
	}
	return count
}

func primitiveTrackPhysicsSampleCount(track *scene3d.Track) int {
	count := int(math.Ceil(track.Length() / primitiveTrackPhysicsSegmentLength))
	if count < 24 {
		count = 24
	}
	return count
}

func (w *World) spawnPrimitiveKartVisuals() {
	primitive := w.ensurePrimitiveScene()
	pos := w.startPosition
	rot := w.kartRotation()
	w.kartBodyPrimitiveParts = nil
	w.kartWheelVisuals = nil
	w.kartWheelPrimitives = nil
	w.kartPrimitiveVisualStateValid = false
	identity := voplay.QuatIdentity()
	w.addPrimitiveKartBodyPart(primitive, pos, rot, primitive.RoundedBox, primitive.WheelMat, voplay.Vec3{Y: 0.00, Z: 0.08}, identity, voplay.Vec3{X: 1.58, Y: 0.18, Z: 2.36}, voplay.Color{})
	w.kartChassisPrimitive = w.addPrimitiveKartBodyPart(primitive, pos, rot, primitive.RoundedBox, primitive.PlayerMat, voplay.Vec3{Y: 0.28, Z: 0.02}, identity, voplay.Vec3{X: 1.42, Y: 0.46, Z: 2.05}, voplay.Color{})
	w.kartNosePrimitive = w.addPrimitiveKartBodyPart(primitive, pos, rot, primitive.RoundedBox, primitive.TopBlueMat, voplay.Vec3{Y: 0.35, Z: -1.08}, identity, voplay.Vec3{X: 1.06, Y: 0.34, Z: 0.78}, voplay.Color{})
	w.kartBumperPrimitive = w.addPrimitiveKartBodyPart(primitive, pos, rot, primitive.RoundedBox, primitive.OrangeTrimMat, voplay.Vec3{Y: 0.21, Z: -1.58}, identity, voplay.Vec3{X: 1.20, Y: 0.18, Z: 0.22}, voplay.Color{})
	w.addPrimitiveKartBodyPart(primitive, pos, rot, primitive.RoundedBox, primitive.PlayerMat, voplay.Vec3{X: -0.72, Y: 0.28, Z: 0.08}, identity, voplay.Vec3{X: 0.30, Y: 0.38, Z: 1.58}, voplay.Color{})
	w.addPrimitiveKartBodyPart(primitive, pos, rot, primitive.RoundedBox, primitive.PlayerMat, voplay.Vec3{X: 0.72, Y: 0.28, Z: 0.08}, identity, voplay.Vec3{X: 0.30, Y: 0.38, Z: 1.58}, voplay.Color{})
	w.addPrimitiveKartBodyPart(primitive, pos, rot, primitive.RoundedBox, primitive.WhiteMat, voplay.Vec3{Y: 0.56, Z: -0.34}, identity, voplay.Vec3{X: 0.24, Y: 0.06, Z: 1.72}, voplay.Color{})
	w.kartCabinPrimitive = w.addPrimitiveKartBodyPart(primitive, pos, rot, primitive.RoundedBox, primitive.VisorMat, voplay.Vec3{Y: 0.64, Z: 0.28}, identity, voplay.Vec3{X: 0.58, Y: 0.18, Z: 0.46}, voplay.Color{})
	w.kartDriverPrimitive = w.addPrimitiveKartBodyPart(primitive, pos, rot, primitive.Sphere, primitive.DriverMat, voplay.Vec3{Y: 0.88, Z: 0.10}, identity, voplay.Vec3{X: 0.38, Y: 0.36, Z: 0.34}, voplay.Color{})
	w.addPrimitiveKartBodyPart(primitive, pos, rot, primitive.Sphere, primitive.WhiteMat, voplay.Vec3{Y: 1.14, Z: -0.06}, identity, voplay.Vec3{X: 0.42, Y: 0.43, Z: 0.42}, voplay.Color{})
	w.addPrimitiveKartBodyPart(primitive, pos, rot, primitive.RoundedBox, primitive.VisorMat, voplay.Vec3{Y: 1.15, Z: -0.39}, identity, voplay.Vec3{X: 0.32, Y: 0.075, Z: 0.055}, voplay.Color{})
	w.addPrimitiveKartBodyPart(primitive, pos, rot, primitive.RoundedBox, primitive.OrangeTrimMat, voplay.Vec3{Y: 1.25, Z: 0.16}, identity, voplay.Vec3{X: 0.44, Y: 0.09, Z: 0.32}, voplay.Color{})
	w.addPrimitiveKartBodyPart(primitive, pos, rot, primitive.RoundedBox, primitive.OrangeTrimMat, voplay.Vec3{X: -0.48, Y: 0.62, Z: 1.14}, identity, voplay.Vec3{X: 0.12, Y: 0.38, Z: 0.12}, voplay.Color{})
	w.addPrimitiveKartBodyPart(primitive, pos, rot, primitive.RoundedBox, primitive.OrangeTrimMat, voplay.Vec3{X: 0.48, Y: 0.62, Z: 1.14}, identity, voplay.Vec3{X: 0.12, Y: 0.38, Z: 0.12}, voplay.Color{})
	w.kartSpoilerPrimitive = w.addPrimitiveKartBodyPart(primitive, pos, rot, primitive.RoundedBox, primitive.WhiteMat, voplay.Vec3{Y: 0.84, Z: 1.28}, identity, voplay.Vec3{X: 1.08, Y: 0.12, Z: 0.24}, voplay.Color{})
	fastFlags := blockKartHighFrequencyPrimitiveFlags()
	w.kartFlameLeftPrimitive = w.addPrimitiveKartBodyPartWithFlags(primitive, pos, rot, primitive.Sphere, primitive.BoostMat, voplay.Vec3{X: -0.36, Y: 0.14, Z: 1.52}, identity, voplay.Vec3{X: 0.20, Y: 0.16, Z: 0.32}, voplay.Color{}, fastFlags)
	w.kartFlameRightPrimitive = w.addPrimitiveKartBodyPartWithFlags(primitive, pos, rot, primitive.Sphere, primitive.BoostMat, voplay.Vec3{X: 0.36, Y: 0.14, Z: 1.52}, identity, voplay.Vec3{X: 0.20, Y: 0.16, Z: 0.32}, voplay.Color{}, fastFlags)
	w.addPrimitiveKartWheelVisual(primitive, pos, rot, voplay.Vec3{X: -0.96, Y: 0.12, Z: -0.76}, true, 0, -1)
	w.addPrimitiveKartWheelVisual(primitive, pos, rot, voplay.Vec3{X: 0.96, Y: 0.12, Z: -0.76}, true, 1, 1)
	w.addPrimitiveKartWheelVisual(primitive, pos, rot, voplay.Vec3{X: -0.96, Y: 0.12, Z: 0.78}, false, 2, -1)
	w.addPrimitiveKartWheelVisual(primitive, pos, rot, voplay.Vec3{X: 0.96, Y: 0.12, Z: 0.78}, false, 3, 1)
	w.kartFlameLeftPrimitive.SetVisible(false)
	w.kartFlameRightPrimitive.SetVisible(false)
}

func (w *World) syncPrimitiveKartVisuals(pos voplay.Vec3, rot voplay.Quat) {
	boostVisible := w.isBoosting()
	state := w.currentPrimitiveKartVisualState(pos, rot, boostVisible)
	if w.kartPrimitiveVisualStateValid && w.kartPrimitiveVisualState == state {
		return
	}
	w.kartPrimitiveVisualState = state
	w.kartPrimitiveVisualStateValid = true
	if w.kartFlameLeftPrimitive != nil {
		w.kartFlameLeftPrimitive.SetVisible(boostVisible)
	}
	if w.kartFlameRightPrimitive != nil {
		w.kartFlameRightPrimitive.SetVisible(boostVisible)
	}
	for _, part := range w.kartBodyPrimitiveParts {
		w.syncPrimitiveKartBodyPart(part, pos, rot)
	}
	if len(w.kartWheelVisuals) > 0 {
		axisRot := voplay.QuatFromAxisAngle(voplay.Vec3{Z: 1}, math.Pi * 0.5)
		for _, wheel := range w.kartWheelVisuals {
			w.syncPrimitiveKartWheelVisual(wheel, pos, rot, axisRot, state)
		}
		return
	}
	axisRot := voplay.QuatFromAxisAngle(voplay.Vec3{Z: 1}, math.Pi * 0.5)
	if len(w.kartWheelPrimitives) >= 4 {
		w.syncPrimitiveKartWheel(w.kartWheelPrimitives[0], pos, rot, voplay.Vec3{X: -1.04, Y: 0.12, Z: -0.80}, true, 0, axisRot)
		w.syncPrimitiveKartWheel(w.kartWheelPrimitives[1], pos, rot, voplay.Vec3{X: 1.04, Y: 0.12, Z: -0.80}, true, 1, axisRot)
		w.syncPrimitiveKartWheel(w.kartWheelPrimitives[2], pos, rot, voplay.Vec3{X: -1.04, Y: 0.12, Z: 0.84}, false, 2, axisRot)
		w.syncPrimitiveKartWheel(w.kartWheelPrimitives[3], pos, rot, voplay.Vec3{X: 1.04, Y: 0.12, Z: 0.84}, false, 3, axisRot)
	}
}

func (w *World) currentPrimitiveKartVisualState(pos voplay.Vec3, rot voplay.Quat, boostVisible bool) PrimitiveKartVisualState {
	state := PrimitiveKartVisualState{Position: pos, Rotation: rot.Normalize(), BoostVisible: boostVisible}
	if w.vehicle == nil {
		return state
	}
	for _, wheel := range w.kartWheelVisuals {
		wheelState, ok := w.vehicle.VisualWheelSample(wheel.WheelIndex)
		if !ok {
			continue
		}
		w.assignPrimitiveKartWheelState(&state, wheel.WheelIndex, wheelState.Steering, wheelState.Rotation)
	}
	return state
}

func (w *World) assignPrimitiveKartWheelState(state *PrimitiveKartVisualState, index int, steer, spin float64) {
	if state == nil {
		return
	}
	if index == 0 {
		state.FrontSteer0 = steer
		state.WheelSpin0 = spin
		return
	}
	if index == 1 {
		state.FrontSteer1 = steer
		state.WheelSpin1 = spin
		return
	}
	if index == 2 {
		state.WheelSpin2 = spin
		return
	}
	if index == 3 {
		state.WheelSpin3 = spin
	}
}

func (w *World) addPrimitiveKartBodyPart(primitive *BlockKartVisualContent, pos voplay.Vec3, rot voplay.Quat, shape primitive3d.ShapeID, material primitive3d.MaterialID, local voplay.Vec3, localRot voplay.Quat, scale voplay.Vec3, tint voplay.Color) *PrimitivePart {
	return w.addPrimitiveKartBodyPartWithFlags(primitive, pos, rot, shape, material, local, localRot, scale, tint, primitive3d.InstanceFlags(0))
}

func (w *World) addPrimitiveKartBodyPartWithFlags(primitive *BlockKartVisualContent, pos voplay.Vec3, rot voplay.Quat, shape primitive3d.ShapeID, material primitive3d.MaterialID, local voplay.Vec3, localRot voplay.Quat, scale voplay.Vec3, tint voplay.Color, flags primitive3d.InstanceFlags) *PrimitivePart {
	local = primitiveKartScaleVec(local)
	scale = primitiveKartScaleVec(scale)
	part := primitive.AddDynamicWithFlags(shape, material, pos.Add(rot.RotateVec3(local)), rot.Mul(localRot), scale, tint, flags)
	w.kartBodyPrimitiveParts = append(w.kartBodyPrimitiveParts, PrimitiveKartBodyPart{Part: part, Local: local, LocalRotation: localRot})
	return part
}

func (w *World) addPrimitiveKartWheelVisual(primitive *BlockKartVisualContent, pos voplay.Vec3, rot voplay.Quat, local voplay.Vec3, steer bool, wheelIndex int, sideSign float64) {
	if sideSign == 0 {
		sideSign = 1
		if local.X < 0 {
			sideSign = -1
		}
	}
	local = primitiveKartScaleVec(local)
	wheelPos := pos.Add(rot.RotateVec3(local))
	axisRot := voplay.QuatFromAxisAngle(voplay.Vec3{Z: 1}, math.Pi * 0.5)
	wheelRot := rot.Mul(axisRot)
	flags := blockKartHighFrequencyPrimitiveFlags()
	tire := primitive.AddDynamicWithFlags(primitive.Cylinder, primitive.WheelMat, wheelPos, wheelRot, primitiveKartScaleVec(voplay.Vec3{X: 0.64, Y: 0.42, Z: 0.64}), voplay.Color{}, flags)
	rim := primitive.AddDynamicWithFlags(primitive.Cylinder, primitive.MetalMat, wheelPos, wheelRot, primitiveKartScaleVec(voplay.Vec3{X: 0.34, Y: 0.055, Z: 0.34}), voplay.Color{}, flags)
	hub := primitive.AddDynamicWithFlags(primitive.Cylinder, primitive.WhiteMat, wheelPos, wheelRot, primitiveKartScaleVec(voplay.Vec3{X: 0.18, Y: 0.07, Z: 0.18}), voplay.Color{}, flags)
	stripe := primitive.AddDynamicWithFlags(primitive.RoundedBox, primitive.OrangeTrimMat, wheelPos, wheelRot, primitiveKartScaleVec(voplay.Vec3{X: 0.032, Y: 0.06, Z: 0.20}), voplay.Color{}, flags)
	w.kartWheelPrimitives = append(w.kartWheelPrimitives, tire)
	w.kartWheelVisuals = append(w.kartWheelVisuals, PrimitiveKartWheelVisual{Tire: tire, Rim: rim, Hub: hub, Stripe: stripe, Local: local, Steer: steer, WheelIndex: wheelIndex, SideSign: sideSign})
}

func (w *World) syncPrimitiveKartBodyPart(body PrimitiveKartBodyPart, pos voplay.Vec3, rot voplay.Quat) {
	if body.Part == nil || !body.Part.Visible {
		return
	}
	body.Part.SetPose(pos.Add(rot.RotateVec3(body.Local)), rot.Mul(body.LocalRotation))
}

func (w *World) syncPrimitiveKartPart(part *PrimitivePart, pos voplay.Vec3, rot voplay.Quat, local voplay.Vec3, partRot voplay.Quat) {
	if part == nil {
		return
	}
	part.SetPose(pos.Add(rot.RotateVec3(local)), partRot)
}

func (w *World) syncPrimitiveKartWheelVisual(wheel PrimitiveKartWheelVisual, pos voplay.Vec3, rot voplay.Quat, axisRot voplay.Quat, visualState PrimitiveKartVisualState) {
	if wheel.Tire == nil {
		return
	}
	wheelRot := rot
	spinRot := rot
	wheelPos := pos.Add(rot.RotateVec3(wheel.Local))
	if w.vehicle != nil {
		steerAngle, spin := primitiveKartWheelVisualMotion(visualState, wheel.WheelIndex, 0, 0)
		if wheel.Steer {
			wheelRot = wheelRot.Mul(voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, -steerAngle))
		}
		spinRot = wheelRot.Mul(voplay.QuatFromAxisAngle(voplay.Vec3{X: 1}, spin))
	}
	cylinderRot := wheelRot.Mul(axisRot)
	wheel.Tire.SetPose(wheelPos, cylinderRot)
	sideDir := wheelRot.RotateVec3(voplay.Vec3{X: wheel.SideSign})
	facePos := wheelPos.Add(sideDir.Scale(0.29 * primitiveKartVisualScale))
	if wheel.Rim != nil {
		wheel.Rim.SetPose(facePos, cylinderRot)
	}
	if wheel.Hub != nil {
		wheel.Hub.SetPose(facePos.Add(sideDir.Scale(0.035 * primitiveKartVisualScale)), cylinderRot)
	}
	if wheel.Stripe != nil {
		radial := spinRot.RotateVec3(voplay.Vec3{Y: 0.17 * primitiveKartVisualScale})
		wheel.Stripe.SetPose(facePos.Add(sideDir.Scale(0.012 * primitiveKartVisualScale)).Add(radial), spinRot)
	}
}

func primitiveKartWheelVisualMotion(state PrimitiveKartVisualState, index int, fallbackSteer, fallbackSpin float64) (float64, float64) {
	if index == 0 {
		return state.FrontSteer0, state.WheelSpin0
	}
	if index == 1 {
		return state.FrontSteer1, state.WheelSpin1
	}
	if index == 2 {
		return fallbackSteer, state.WheelSpin2
	}
	if index == 3 {
		return fallbackSteer, state.WheelSpin3
	}
	return fallbackSteer, fallbackSpin
}

func primitiveKartScaleVec(v voplay.Vec3) voplay.Vec3 {
	return voplay.Vec3{X: v.X * primitiveKartVisualScale, Y: v.Y * primitiveKartVisualScale, Z: v.Z * primitiveKartVisualScale}
}

func (w *World) syncPrimitiveKartWheel(part *PrimitivePart, pos voplay.Vec3, rot voplay.Quat, local voplay.Vec3, steer bool, wheelIndex int, axisRot voplay.Quat) {
	if part == nil {
		return
	}
	wheelRot := rot
	wheelPos := pos.Add(rot.RotateVec3(local))
	if w.vehicle != nil {
		steerAngle := 0.0
		spin := 0.0
		if state, ok := w.vehicle.VisualWheelSample(wheelIndex); ok {
			wheelPos = state.Center
			steerAngle = state.Steering
			spin = state.Rotation
		}
		if steer {
			wheelRot = wheelRot.Mul(voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, -steerAngle))
		}
		wheelRot = wheelRot.Mul(voplay.QuatFromAxisAngle(voplay.Vec3{X: 1}, spin))
	}
	wheelRot = wheelRot.Mul(axisRot)
	part.SetPose(wheelPos, wheelRot)
}

func normalizePrimitiveQuat(rotation voplay.Quat) voplay.Quat {
	if rotation == (voplay.Quat{}) {
		return voplay.QuatIdentity()
	}
	return rotation
}

func normalizePrimitiveVecScale(scale voplay.Vec3) voplay.Vec3 {
	if scale == (voplay.Vec3{}) {
		return voplay.Vec3{X: 1, Y: 1, Z: 1}
	}
	return scale
}
