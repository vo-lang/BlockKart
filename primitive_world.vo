	primitiveTerrainDepth = 1127.0
	primitiveTerrainY = -4.0
	primitiveTerrainHeight = 38.0
	primitiveLandmarkScale = 1.42
	primitiveStaticBatchCellSize = 72.0
	primitiveTreeDetailBatchCellSize = 36.0
	primitiveRoadsideDetailBatchCellSize = 28.0
	primitiveSmallDetailBatchCellSize = 24.0
	primitiveFlowerDetailBatchCellSize = 16.0
	primitiveScatterBatchCellSize = 36.0
