	primitiveRoadsidePropLodFar = 190.0
	primitiveSmallPropLodFar = 150.0
	primitiveFlowerClumpLodFar = 88.0
	primitiveContactShadowLodFar = 118.0
	primitiveLayerStatic = "blockkart_static_primitives"
	primitiveLayerTreeDetail = "blockkart_tree_detail_primitives"
	primitiveLayerRoadsideDetail = "blockkart_roadside_detail_primitives"
