package main

import (
	"errors"
	"fmt"
	"math"
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

const (
	primitiveTrackWidth = 17.5
	primitiveTrackSegmentLength = 5.8
	primitiveTrackPhysicsSegmentLength = 54.0
	primitiveRoadPhysicsSegmentOverlap = 0.72
	primitiveRoadPhysicsOuterOffset = 2.45
	primitiveKartVisualScale = 1.72
	primitiveMapPlanarScale = 2.45
	primitiveTerrainWidth = 1127.0
	primitiveTerrainDepth = 1127.0
	primitiveTerrainY = -4.0
	primitiveTerrainHeight = 38.0
	primitiveLandmarkScale = 1.42
	primitiveTreeLodFar = 320.0
	primitiveRoadsidePropLodFar = 190.0
	primitiveSmallPropLodFar = 150.0
	primitiveFlowerClumpLodFar = 88.0
	primitiveContactShadowLodFar = 118.0
)

type PrimitiveVisualContent = scene3d.BlockKartPrimitiveContent

type BlockKartPrimitiveTemplate struct {
	Scene *PrimitiveVisualContent
}

type PrimitivePart = scene3d.BlockKartPrimitivePart

type PrimitiveKartBodyPart struct {
	Part *PrimitivePart
	Local voplay.Vec3
	LocalRotation voplay.Quat
}

type PrimitiveKartWheelVisual struct {
	Tire *PrimitivePart
	Rim *PrimitivePart
	Hub *PrimitivePart
	Stripe *PrimitivePart
	Local voplay.Vec3
	Steer bool
	WheelIndex int
	SideSign float64
}

type PrimitiveKartVisualState struct {
	Position voplay.Vec3
	Rotation voplay.Quat
	BoostVisible bool
	FrontSteer0 float64
	FrontSteer1 float64
	WheelSpin0 float64
	WheelSpin1 float64
	WheelSpin2 float64
	WheelSpin3 float64
}

type primitiveTrackPointDef struct {
	X float64
	Z float64
	Y float64
	Width float64
}

func (t *TrackRuntime) ensurePrimitiveScene(core *BlockKartRuntimeCore) *PrimitiveVisualContent {
	if core.primitive != nil {
		return core.primitive
	}
	if core.assets == nil {
		panic("BlockKart primitive scene requires loaded assets")
	}
	if core.runtimeCache != nil && core.runtimeCache.primitiveTemplate != nil {
		primitive := core.runtimeCache.primitiveTemplate.Instantiate(core.scene)
		core.primitive = primitive
		core.primitiveTemplateReused = true
		core.runtimeCache.primitiveTemplateReuses++
		return core.primitive
	}
	core.assets.BeginGroup(worldAssetGroup)
	primitive, err := newPrimitiveVisualContent(core.scene, core.assets)
	core.assets.EndGroup()
	if err != nil {
		panic("BlockKart primitive scene asset load failed: " + err.Error())
	}
	core.primitive = primitive
	return core.primitive
}


func newBlockKartPrimitiveTemplate(primitive *PrimitiveVisualContent) *BlockKartPrimitiveTemplate {
	if primitive == nil {
		return nil
	}
	return &BlockKartPrimitiveTemplate{Scene: primitive}
}

func (t *BlockKartPrimitiveTemplate) Instantiate(scene *scene3d.Scene) *PrimitiveVisualContent {
	if t == nil || t.Scene == nil {
		return nil
	}
	return t.Scene.CloneForScene(scene)
}

func newPrimitiveVisualContent(scene *scene3d.Scene, assets *voplay.Assets) (*PrimitiveVisualContent, error) {
	return scene3d.ProductBlockKartPrimitiveContent(scene, assets)
}

func blockKartHighFrequencyPrimitiveFlags() scene3d.BlockKartPrimitiveFlags {
	return scene3d.BlockKartPrimitiveNoShadow
}

func hidePrimitivePart(part *PrimitivePart) {
	if part != nil {
		part.SetVisible(false)
	}
}

func showPrimitivePart(part *PrimitivePart) {
	if part != nil {
		part.SetVisible(true)
	}
}

func (t *TrackRuntime) buildPrimitiveLevel(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, presentation *RacePresentationState, theme WorldTheme) error {
	prof := newBlockKartStartupProfiler("BlockKart primitive")
	primitive := core.trackRuntime.ensurePrimitiveScene(core)
	templateReused := core.primitiveTemplateReused
	prof.Mark("ensurePrimitiveScene")
	mapErr := core.trackRuntime.preparePrimitiveMapAsset(core)
	if mapErr != nil {
		presentation.message = "Primitive map failed: " + mapErr.Error()
		presentation.messageTimer = 4
		fmt.Println(presentation.message)
		return errors.New(presentation.message)
	}
	prof.Mark("preparePrimitiveMapAsset")
	asset := newPrimitiveTrackAsset()
	prof.Mark("newPrimitiveTrackAsset")
	track, err := scene3d.NewTrack(asset)
	if err != nil {
		presentation.message = "Primitive track failed: " + err.Error()
		presentation.messageTimer = 4
		fmt.Println(presentation.message)
		return errors.New(presentation.message)
	}
	core.track = track
	prof.Mark("NewTrack")
	result, terrainErr := core.trackRuntime.spawnPrimitiveTrackTerrain(core, track)
	if terrainErr != nil {
		presentation.message = "Terrain failed: " + terrainErr.Error()
		presentation.messageTimer = 4
		fmt.Println(presentation.message)
		return errors.New(presentation.message)
	}
	core.trackResult = result
	prof.Mark("spawnPrimitiveTrackTerrain")
	core.trackRuntime.applyPrimitiveTrackSpawn(race, kart, track)
	core.trackRuntime.populatePrimitiveTrackCheckpoints(race, track)
	prof.Mark("trackSpawnAndCheckpoints")
	if templateReused {
		core.trackRuntime.spawnPrimitiveCachedMapMeshes(core, presentation, track)
		prof.Mark("reusePrimitiveStaticTemplate")
	} else {
		core.trackRuntime.buildPrimitiveTrackVisuals(core, presentation, track)
		prof.Mark("buildPrimitiveTrackVisuals")
	}
	colliderErr := core.trackRuntime.bindTrackColliders(core, track)
	if colliderErr != nil {
		presentation.message = "Track collider failed: " + colliderErr.Error()
		presentation.messageTimer = 4
		fmt.Println(presentation.message)
		return errors.New(presentation.message)
	}
	prof.Mark("primitiveTrackColliders")
	core.trackRuntime.spawnPrimitiveGameplay(core, race, theme, track, !templateReused)
	prof.Mark("spawnPrimitiveGameplay")
	if templateReused {
		prof.Mark("reuseStaticLayerChunks")
		return nil
	}
	primitive.BuildStaticLayers()
	prof.Mark("buildStaticPrimitiveLayers")
	if core.runtimeCache != nil && core.runtimeCache.primitiveTemplate == nil {
		core.runtimeCache.primitiveTemplate = newBlockKartPrimitiveTemplate(primitive)
		if core.runtimeCache.primitiveTemplate != nil {
			core.runtimeCache.primitiveTemplateBuilds++
		}
	}
	return nil
}

func (t *TrackRuntime) preparePrimitiveMapAsset(core *BlockKartRuntimeCore) error {
	if core.primitiveMap != nil {
		return nil
	}
	if core.runtimeCache != nil && core.runtimeCache.primitiveMap != nil {
		core.primitiveMap = core.runtimeCache.primitiveMap
		core.preparedMapReused = true
		core.runtimeCache.preparedMapReuses++
		return nil
	}
	if core.assets == nil {
		return errors.New("BlockKart assets unavailable")
	}
	core.assets.BeginGroup(worldAssetGroup)
	prepared, err := scene3d.ProductBlockKartMapAsset(core.assets, blockKartAssetPath("maps/primitive_track/blockkart.map.json"))
	core.assets.EndGroup()
	if err != nil {
		return err
	}
	core.primitiveMap = prepared
	if core.runtimeCache != nil {
		core.runtimeCache.primitiveMap = prepared
		core.runtimeCache.preparedMapBuilds++
	}
	return nil
}

func newPrimitiveTrackAsset() *scene3d.TrackAsset {
	return defaultBlockKartTrackSpec().TrackAsset()
}

func (t *TrackRuntime) spawnPrimitiveTrackTerrain(core *BlockKartRuntimeCore, track *scene3d.Track) (*scene3d.TrackSpawnResult, error) {
	if track == nil {
		return nil, errors.New("BlockKart primitive track unavailable")
	}
	if core.assets == nil {
		return nil, errors.New("BlockKart assets unavailable")
	}
	if core.primitiveMap == nil {
		err := core.trackRuntime.preparePrimitiveMapAsset(core)
		if err != nil {
			return nil, err
		}
	}
	return scene3d.ProductBlockKartTrackTerrain(core.scene, track, core.primitiveMap, defaultBlockKartTrackSpec().TerrainMesh)
}

func primitiveTrackControlPoints() []scene3d.TrackControlPoint {
	points := []scene3d.TrackControlPoint{}
	anchors := primitiveConceptTrackAnchors()
	samplesPerSegment := 18
	for i := 0; i < len(anchors); i++ {
		a := anchors[(i + len(anchors) - 1) % len(anchors)]
		b := anchors[i]
		c := anchors[(i + 1) % len(anchors)]
		d := anchors[(i + 2) % len(anchors)]
		for s := 0; s < samplesPerSegment; s++ {
			t := float64(s) / float64(samplesPerSegment)
			def := primitiveTrackCatmull(a, b, c, d, t)
			position := voplay.Vec3{X: def.X * primitiveMapPlanarScale, Y: def.Y, Z: def.Z * primitiveMapPlanarScale}
			points = append(points, scene3d.TrackControlPoint{Position: primitiveMapVec3(position), Width: def.Width})
		}
	}
	if len(points) > 0 {
		points = append(points, points[0])
	}
	return points
}

func primitiveConceptTrackAnchors() []primitiveTrackPointDef {
	return []primitiveTrackPointDef{{X: 8, Z: 150, Y: 0.0, Width: 19.0}, {X: 104, Z: 150, Y: 0.02, Width: 19.0}, {X: 168, Z: 128, Y: 0.14, Width: 18.8}, {X: 190, Z: 90, Y: 0.28, Width: 18.4}, {X: 128, Z: 44, Y: 0.36, Width: 18.0}, {X: 184, Z: -24, Y: 0.5, Width: 18.4}, {X: 162, Z: -104, Y: 0.62, Width: 18.6}, {X: 82, Z: -136, Y: 0.68, Width: 18.8}, {X: -18, Z: -136, Y: 0.64, Width: 18.8}, {X: -116, Z: -132, Y: 0.54, Width: 18.6}, {X: -184, Z: -88, Y: 0.42, Width: 18.4}, {X: -158, Z: -34, Y: 0.28, Width: 18.0}, {X: -124, Z: 4, Y: 0.2, Width: 18.2}, {X: -178, Z: 62, Y: 0.08, Width: 18.4}, {X: -168, Z: 118, Y: 0.02, Width: 18.8}, {X: -94, Z: 150, Y: 0.0, Width: 19.0}}
}

func primitiveTrackCatmull(a, b, c, d primitiveTrackPointDef, t float64) primitiveTrackPointDef {
	return primitiveTrackPointDef{X: primitiveCatmullValue(a.X, b.X, c.X, d.X, t), Z: primitiveCatmullValue(a.Z, b.Z, c.Z, d.Z, t), Y: primitiveCatmullValue(a.Y, b.Y, c.Y, d.Y, t), Width: primitiveCatmullValue(a.Width, b.Width, c.Width, d.Width, t)}
}

func primitiveCatmullValue(a, b, c, d, t float64) float64 {
	t2 := t * t
	t3 := t2 * t
	return 0.5 * (2.0 * b + (-a + c) * t + (2.0 * a - 5.0 * b + 4.0 * c - d) * t2 + (-a + 3.0 * b - 3.0 * c + d) * t3)
}

func primitiveTrackLength(points []scene3d.TrackControlPoint) float64 {
	total := 0.0
	for i := 0; i < len(points) - 1; i++ {
		total += points[i].Position.Vec3().Distance(points[i + 1].Position.Vec3())
	}
	return total
}

func primitiveMapVec3(v voplay.Vec3) scene3d.MapVec3 {
	return scene3d.MapVec3{X: v.X, Y: v.Y, Z: v.Z}
}

func primitiveSceneryVec3(x, y, z float64) voplay.Vec3 {
	return voplay.Vec3{X: x * primitiveMapPlanarScale, Y: y, Z: z * primitiveMapPlanarScale}
}

func primitiveLandmarkVec3(x, y, z float64) voplay.Vec3 {
	return voplay.Vec3{X: x * primitiveLandmarkScale, Y: y * primitiveLandmarkScale, Z: z * primitiveLandmarkScale}
}

func primitiveTrackSegmentCount(track *scene3d.Track) int {
	count := int(math.Ceil(track.Length() / primitiveTrackSegmentLength))
	if count < 24 {
		count = 24
	}
	return count
}

func (t *TrackRuntime) spawnPrimitiveKartVisuals(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState, position voplay.Vec3) {
	primitive := core.trackRuntime.ensurePrimitiveScene(core)
	pos := position
	rot := kart.kartRig.kartRotation(core, kart)
	kart.kartBodyPrimitiveParts = nil
	kart.kartWheelVisuals = nil
	kart.kartWheelPrimitives = nil
	kart.kartPrimitiveVisualStateValid = false
	identity := voplay.QuatIdentity()
	core.trackRuntime.addPrimitiveKartBodyPart(core, kart, primitive, pos, rot, primitive.RoundedBox, primitive.WheelMat, voplay.Vec3{Y: 0.00, Z: 0.08}, identity, voplay.Vec3{X: 1.58, Y: 0.18, Z: 2.36}, voplay.Color{})
	kart.kartChassisPrimitive = core.trackRuntime.addPrimitiveKartBodyPart(core, kart, primitive, pos, rot, primitive.RoundedBox, primitive.PlayerMat, voplay.Vec3{Y: 0.28, Z: 0.02}, identity, voplay.Vec3{X: 1.42, Y: 0.46, Z: 2.05}, voplay.Color{})
	kart.kartNosePrimitive = core.trackRuntime.addPrimitiveKartBodyPart(core, kart, primitive, pos, rot, primitive.RoundedBox, primitive.TopBlueMat, voplay.Vec3{Y: 0.35, Z: -1.08}, identity, voplay.Vec3{X: 1.06, Y: 0.34, Z: 0.78}, voplay.Color{})
	kart.kartBumperPrimitive = core.trackRuntime.addPrimitiveKartBodyPart(core, kart, primitive, pos, rot, primitive.RoundedBox, primitive.OrangeTrimMat, voplay.Vec3{Y: 0.21, Z: -1.58}, identity, voplay.Vec3{X: 1.20, Y: 0.18, Z: 0.22}, voplay.Color{})
	core.trackRuntime.addPrimitiveKartBodyPart(core, kart, primitive, pos, rot, primitive.RoundedBox, primitive.PlayerMat, voplay.Vec3{X: -0.72, Y: 0.28, Z: 0.08}, identity, voplay.Vec3{X: 0.30, Y: 0.38, Z: 1.58}, voplay.Color{})
	core.trackRuntime.addPrimitiveKartBodyPart(core, kart, primitive, pos, rot, primitive.RoundedBox, primitive.PlayerMat, voplay.Vec3{X: 0.72, Y: 0.28, Z: 0.08}, identity, voplay.Vec3{X: 0.30, Y: 0.38, Z: 1.58}, voplay.Color{})
	core.trackRuntime.addPrimitiveKartBodyPart(core, kart, primitive, pos, rot, primitive.RoundedBox, primitive.WhiteMat, voplay.Vec3{Y: 0.56, Z: -0.34}, identity, voplay.Vec3{X: 0.24, Y: 0.06, Z: 1.72}, voplay.Color{})
	kart.kartCabinPrimitive = core.trackRuntime.addPrimitiveKartBodyPart(core, kart, primitive, pos, rot, primitive.RoundedBox, primitive.VisorMat, voplay.Vec3{Y: 0.64, Z: 0.28}, identity, voplay.Vec3{X: 0.58, Y: 0.18, Z: 0.46}, voplay.Color{})
	kart.kartDriverPrimitive = core.trackRuntime.addPrimitiveKartBodyPart(core, kart, primitive, pos, rot, primitive.Sphere, primitive.DriverMat, voplay.Vec3{Y: 0.88, Z: 0.10}, identity, voplay.Vec3{X: 0.38, Y: 0.36, Z: 0.34}, voplay.Color{})
	core.trackRuntime.addPrimitiveKartBodyPart(core, kart, primitive, pos, rot, primitive.Sphere, primitive.WhiteMat, voplay.Vec3{Y: 1.14, Z: -0.06}, identity, voplay.Vec3{X: 0.42, Y: 0.43, Z: 0.42}, voplay.Color{})
	core.trackRuntime.addPrimitiveKartBodyPart(core, kart, primitive, pos, rot, primitive.RoundedBox, primitive.VisorMat, voplay.Vec3{Y: 1.15, Z: -0.39}, identity, voplay.Vec3{X: 0.32, Y: 0.075, Z: 0.055}, voplay.Color{})
	core.trackRuntime.addPrimitiveKartBodyPart(core, kart, primitive, pos, rot, primitive.RoundedBox, primitive.OrangeTrimMat, voplay.Vec3{Y: 1.25, Z: 0.16}, identity, voplay.Vec3{X: 0.44, Y: 0.09, Z: 0.32}, voplay.Color{})
	core.trackRuntime.addPrimitiveKartBodyPart(core, kart, primitive, pos, rot, primitive.RoundedBox, primitive.OrangeTrimMat, voplay.Vec3{X: -0.48, Y: 0.62, Z: 1.14}, identity, voplay.Vec3{X: 0.12, Y: 0.38, Z: 0.12}, voplay.Color{})
	core.trackRuntime.addPrimitiveKartBodyPart(core, kart, primitive, pos, rot, primitive.RoundedBox, primitive.OrangeTrimMat, voplay.Vec3{X: 0.48, Y: 0.62, Z: 1.14}, identity, voplay.Vec3{X: 0.12, Y: 0.38, Z: 0.12}, voplay.Color{})
	kart.kartSpoilerPrimitive = core.trackRuntime.addPrimitiveKartBodyPart(core, kart, primitive, pos, rot, primitive.RoundedBox, primitive.WhiteMat, voplay.Vec3{Y: 0.84, Z: 1.28}, identity, voplay.Vec3{X: 1.08, Y: 0.12, Z: 0.24}, voplay.Color{})
	fastFlags := blockKartHighFrequencyPrimitiveFlags()
	kart.kartFlameLeftPrimitive = core.trackRuntime.addPrimitiveKartBodyPartWithFlags(kart, primitive, pos, rot, primitive.Sphere, primitive.BoostMat, voplay.Vec3{X: -0.36, Y: 0.14, Z: 1.52}, identity, voplay.Vec3{X: 0.20, Y: 0.16, Z: 0.32}, voplay.Color{}, fastFlags)
	kart.kartFlameRightPrimitive = core.trackRuntime.addPrimitiveKartBodyPartWithFlags(kart, primitive, pos, rot, primitive.Sphere, primitive.BoostMat, voplay.Vec3{X: 0.36, Y: 0.14, Z: 1.52}, identity, voplay.Vec3{X: 0.20, Y: 0.16, Z: 0.32}, voplay.Color{}, fastFlags)
	core.trackRuntime.addPrimitiveKartWheelVisual(kart, primitive, pos, rot, voplay.Vec3{X: -0.96, Y: 0.12, Z: -0.76}, true, 0, -1)
	core.trackRuntime.addPrimitiveKartWheelVisual(kart, primitive, pos, rot, voplay.Vec3{X: 0.96, Y: 0.12, Z: -0.76}, true, 1, 1)
	core.trackRuntime.addPrimitiveKartWheelVisual(kart, primitive, pos, rot, voplay.Vec3{X: -0.96, Y: 0.12, Z: 0.78}, false, 2, -1)
	core.trackRuntime.addPrimitiveKartWheelVisual(kart, primitive, pos, rot, voplay.Vec3{X: 0.96, Y: 0.12, Z: 0.78}, false, 3, 1)
	kart.kartFlameLeftPrimitive.SetVisible(false)
	kart.kartFlameRightPrimitive.SetVisible(false)
}

func (t *TrackRuntime) syncPrimitiveKartVisuals(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState, pos voplay.Vec3, rot voplay.Quat) {
	boostVisible := blockKartIsBoosting(core, kart)
	state := core.trackRuntime.currentPrimitiveKartVisualState(core, kart, pos, rot, boostVisible)
	if kart.kartPrimitiveVisualStateValid && kart.kartPrimitiveVisualState == state {
		return
	}
	kart.kartPrimitiveVisualState = state
	kart.kartPrimitiveVisualStateValid = true
	if kart.kartFlameLeftPrimitive != nil {
		kart.kartFlameLeftPrimitive.SetVisible(boostVisible)
	}
	if kart.kartFlameRightPrimitive != nil {
		kart.kartFlameRightPrimitive.SetVisible(boostVisible)
	}
	for _, part := range kart.kartBodyPrimitiveParts {
		core.trackRuntime.syncPrimitiveKartBodyPart(part, pos, rot)
	}
	if len(kart.kartWheelVisuals) > 0 {
		axisRot := voplay.QuatFromAxisAngle(voplay.Vec3{Z: 1}, math.Pi * 0.5)
		for _, wheel := range kart.kartWheelVisuals {
			core.trackRuntime.syncPrimitiveKartWheelVisual(core, wheel, pos, rot, axisRot, state)
		}
		return
	}
	axisRot := voplay.QuatFromAxisAngle(voplay.Vec3{Z: 1}, math.Pi * 0.5)
	if len(kart.kartWheelPrimitives) >= 4 {
		core.trackRuntime.syncPrimitiveKartWheel(core, kart.kartWheelPrimitives[0], pos, rot, voplay.Vec3{X: -1.04, Y: 0.12, Z: -0.80}, true, 0, axisRot)
		core.trackRuntime.syncPrimitiveKartWheel(core, kart.kartWheelPrimitives[1], pos, rot, voplay.Vec3{X: 1.04, Y: 0.12, Z: -0.80}, true, 1, axisRot)
		core.trackRuntime.syncPrimitiveKartWheel(core, kart.kartWheelPrimitives[2], pos, rot, voplay.Vec3{X: -1.04, Y: 0.12, Z: 0.84}, false, 2, axisRot)
		core.trackRuntime.syncPrimitiveKartWheel(core, kart.kartWheelPrimitives[3], pos, rot, voplay.Vec3{X: 1.04, Y: 0.12, Z: 0.84}, false, 3, axisRot)
	}
}

func (t *TrackRuntime) currentPrimitiveKartVisualState(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState, pos voplay.Vec3, rot voplay.Quat, boostVisible bool) PrimitiveKartVisualState {
	state := PrimitiveKartVisualState{Position: pos, Rotation: rot.Normalize(), BoostVisible: boostVisible}
	if core.vehicle == nil {
		return state
	}
	for _, wheel := range kart.kartWheelVisuals {
		wheelState, ok := core.vehicle.VisualWheelSample(wheel.WheelIndex)
		if !ok {
			continue
		}
		core.trackRuntime.assignPrimitiveKartWheelState(&state, wheel.WheelIndex, wheelState.Steering, wheelState.Rotation)
	}
	return state
}

func (t *TrackRuntime) assignPrimitiveKartWheelState( state *PrimitiveKartVisualState, index int, steer, spin float64) {
	if state == nil {
		return
	}
	if index == 0 {
		state.FrontSteer0 = steer
		state.WheelSpin0 = spin
		return
	}
	if index == 1 {
		state.FrontSteer1 = steer
		state.WheelSpin1 = spin
		return
	}
	if index == 2 {
		state.WheelSpin2 = spin
		return
	}
	if index == 3 {
		state.WheelSpin3 = spin
	}
}

func (t *TrackRuntime) addPrimitiveKartBodyPart(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState, primitive *PrimitiveVisualContent, pos voplay.Vec3, rot voplay.Quat, shape scene3d.BlockKartPrimitiveShape, material scene3d.BlockKartPrimitiveMaterial, local voplay.Vec3, localRot voplay.Quat, scale voplay.Vec3, tint voplay.Color) *PrimitivePart {
	return core.trackRuntime.addPrimitiveKartBodyPartWithFlags(kart, primitive, pos, rot, shape, material, local, localRot, scale, tint, scene3d.BlockKartPrimitiveFlags(0))
}

func (t *TrackRuntime) addPrimitiveKartBodyPartWithFlags(kart *BlockKartRuntimeKartState, primitive *PrimitiveVisualContent, pos voplay.Vec3, rot voplay.Quat, shape scene3d.BlockKartPrimitiveShape, material scene3d.BlockKartPrimitiveMaterial, local voplay.Vec3, localRot voplay.Quat, scale voplay.Vec3, tint voplay.Color, flags scene3d.BlockKartPrimitiveFlags) *PrimitivePart {
	local = primitiveKartScaleVec(local)
	scale = primitiveKartScaleVec(scale)
	part := scene3d.ProductBlockKartDynamicWithFlags(primitive, shape, material, pos.Add(rot.RotateVec3(local)), rot.Mul(localRot), scale, tint, flags)
	kart.kartBodyPrimitiveParts = append(kart.kartBodyPrimitiveParts, PrimitiveKartBodyPart{Part: part, Local: local, LocalRotation: localRot})
	return part
}

func (t *TrackRuntime) addPrimitiveKartWheelVisual(kart *BlockKartRuntimeKartState, primitive *PrimitiveVisualContent, pos voplay.Vec3, rot voplay.Quat, local voplay.Vec3, steer bool, wheelIndex int, sideSign float64) {
	if sideSign == 0 {
		sideSign = 1
		if local.X < 0 {
			sideSign = -1
		}
	}
	local = primitiveKartScaleVec(local)
	wheelPos := pos.Add(rot.RotateVec3(local))
	axisRot := voplay.QuatFromAxisAngle(voplay.Vec3{Z: 1}, math.Pi * 0.5)
	wheelRot := rot.Mul(axisRot)
	flags := blockKartHighFrequencyPrimitiveFlags()
	tire := scene3d.ProductBlockKartDynamicWithFlags(primitive, primitive.Cylinder, primitive.WheelMat, wheelPos, wheelRot, primitiveKartScaleVec(voplay.Vec3{X: 0.64, Y: 0.42, Z: 0.64}), voplay.Color{}, flags)
	rim := scene3d.ProductBlockKartDynamicWithFlags(primitive, primitive.Cylinder, primitive.MetalMat, wheelPos, wheelRot, primitiveKartScaleVec(voplay.Vec3{X: 0.34, Y: 0.055, Z: 0.34}), voplay.Color{}, flags)
	hub := scene3d.ProductBlockKartDynamicWithFlags(primitive, primitive.Cylinder, primitive.WhiteMat, wheelPos, wheelRot, primitiveKartScaleVec(voplay.Vec3{X: 0.18, Y: 0.07, Z: 0.18}), voplay.Color{}, flags)
	stripe := scene3d.ProductBlockKartDynamicWithFlags(primitive, primitive.RoundedBox, primitive.OrangeTrimMat, wheelPos, wheelRot, primitiveKartScaleVec(voplay.Vec3{X: 0.032, Y: 0.06, Z: 0.20}), voplay.Color{}, flags)
	kart.kartWheelPrimitives = append(kart.kartWheelPrimitives, tire)
	kart.kartWheelVisuals = append(kart.kartWheelVisuals, PrimitiveKartWheelVisual{Tire: tire, Rim: rim, Hub: hub, Stripe: stripe, Local: local, Steer: steer, WheelIndex: wheelIndex, SideSign: sideSign})
}

func (t *TrackRuntime) syncPrimitiveKartBodyPart( body PrimitiveKartBodyPart, pos voplay.Vec3, rot voplay.Quat) {
	if body.Part == nil || !body.Part.Visible {
		return
	}
	scene3d.ProductBlockKartPose(body.Part, pos.Add(rot.RotateVec3(body.Local)), rot.Mul(body.LocalRotation))
}

func (t *TrackRuntime) syncPrimitiveKartPart( part *PrimitivePart, pos voplay.Vec3, rot voplay.Quat, local voplay.Vec3, partRot voplay.Quat) {
	if part == nil {
		return
	}
	scene3d.ProductBlockKartPose(part, pos.Add(rot.RotateVec3(local)), partRot)
}

func (t *TrackRuntime) syncPrimitiveKartWheelVisual(core *BlockKartRuntimeCore, wheel PrimitiveKartWheelVisual, pos voplay.Vec3, rot voplay.Quat, axisRot voplay.Quat, visualState PrimitiveKartVisualState) {
	if wheel.Tire == nil {
		return
	}
	wheelRot := rot
	spinRot := rot
	wheelPos := pos.Add(rot.RotateVec3(wheel.Local))
	if core.vehicle != nil {
		steerAngle, spin := primitiveKartWheelVisualMotion(visualState, wheel.WheelIndex, 0, 0)
		if wheel.Steer {
			wheelRot = wheelRot.Mul(voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, -steerAngle))
		}
		spinRot = wheelRot.Mul(voplay.QuatFromAxisAngle(voplay.Vec3{X: 1}, spin))
	}
	cylinderRot := wheelRot.Mul(axisRot)
	scene3d.ProductBlockKartPose(wheel.Tire, wheelPos, cylinderRot)
	sideDir := wheelRot.RotateVec3(voplay.Vec3{X: wheel.SideSign})
	facePos := wheelPos.Add(sideDir.Scale(0.29 * primitiveKartVisualScale))
	if wheel.Rim != nil {
		scene3d.ProductBlockKartPose(wheel.Rim, facePos, cylinderRot)
	}
	if wheel.Hub != nil {
		scene3d.ProductBlockKartPose(wheel.Hub, facePos.Add(sideDir.Scale(0.035 * primitiveKartVisualScale)), cylinderRot)
	}
	if wheel.Stripe != nil {
		radial := spinRot.RotateVec3(voplay.Vec3{Y: 0.17 * primitiveKartVisualScale})
		scene3d.ProductBlockKartPose(wheel.Stripe, facePos.Add(sideDir.Scale(0.012 * primitiveKartVisualScale)).Add(radial), spinRot)
	}
}

func primitiveKartWheelVisualMotion(state PrimitiveKartVisualState, index int, fallbackSteer, fallbackSpin float64) (float64, float64) {
	if index == 0 {
		return state.FrontSteer0, state.WheelSpin0
	}
	if index == 1 {
		return state.FrontSteer1, state.WheelSpin1
	}
	if index == 2 {
		return fallbackSteer, state.WheelSpin2
	}
	if index == 3 {
		return fallbackSteer, state.WheelSpin3
	}
	return fallbackSteer, fallbackSpin
}

func primitiveKartScaleVec(v voplay.Vec3) voplay.Vec3 {
	return voplay.Vec3{X: v.X * primitiveKartVisualScale, Y: v.Y * primitiveKartVisualScale, Z: v.Z * primitiveKartVisualScale}
}

func (t *TrackRuntime) syncPrimitiveKartWheel(core *BlockKartRuntimeCore, part *PrimitivePart, pos voplay.Vec3, rot voplay.Quat, local voplay.Vec3, steer bool, wheelIndex int, axisRot voplay.Quat) {
	if part == nil {
		return
	}
	wheelRot := rot
	wheelPos := pos.Add(rot.RotateVec3(local))
	if core.vehicle != nil {
		steerAngle := 0.0
		spin := 0.0
		if state, ok := core.vehicle.VisualWheelSample(wheelIndex); ok {
			wheelPos = state.Center
			steerAngle = state.Steering
			spin = state.Rotation
		}
		if steer {
			wheelRot = wheelRot.Mul(voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, -steerAngle))
		}
		wheelRot = wheelRot.Mul(voplay.QuatFromAxisAngle(voplay.Vec3{X: 1}, spin))
	}
	wheelRot = wheelRot.Mul(axisRot)
	scene3d.ProductBlockKartPose(part, wheelPos, wheelRot)
}
