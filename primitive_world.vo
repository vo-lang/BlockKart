func (p *PrimitiveVisualContent) material(preset primitive3d.MaterialPreset, color voplay.Color, roughness, metallic float64, emissive voplay.Color) primitive3d.MaterialID {
	base := voplay.MaterialDesc{BaseColor: color, Roughness: roughness, Metallic: metallic, UVScale: 1}
	if emissive != (voplay.Color{}) {
		base.EmissiveColor = emissive
	}
	return p.ProductPrimitives.Material(scene3d.SurfaceMaterialAuthoring{Preset: preset, Base: base})
}

func (p *PrimitiveVisualContent) grassCardMaterial(albedo voplay.TextureID) primitive3d.MaterialID {
	base := voplay.MaterialDesc{BaseColor: voplay.Color{R: 1.0, G: 1.0, B: 0.96, A: 1}, Albedo: albedo, Roughness: 0.88, Metallic: 0, UVScale: 1, DetailStrength: 0.006, MacroBlend: 0.001, RoughnessResponse: 0.38, ToonRampResponse: 0.34, EmissiveColor: voplay.Color{R: 0.135, G: 0.235, B: 0.060, A: 1}, ShadingMode: voplay.MaterialShadingToon, FilterMode: voplay.MaterialFilterNearest}
	return p.ProductPrimitives.Material(scene3d.SurfaceMaterialAuthoring{Preset: primitive3d.MaterialGrass, Base: base})
}

func (p *PrimitiveVisualContent) PlaceStatic(shape primitive3d.ShapeID, material primitive3d.MaterialID, position voplay.Vec3, rotation voplay.Quat, scale voplay.Vec3, tint voplay.Color) primitive3d.ObjectID {
	return p.PlaceStaticWithFlags(shape, material, position, rotation, scale, tint, primitive3d.InstanceFlags(0))
}

func (p *PrimitiveVisualContent) PlaceStaticWithFlags(shape primitive3d.ShapeID, material primitive3d.MaterialID, position voplay.Vec3, rotation voplay.Quat, scale voplay.Vec3, tint voplay.Color, flags primitive3d.InstanceFlags) primitive3d.ObjectID {
	return scene3d.ProductPrimitivePlace(p.ProductPrimitives, primitiveLayerStatic, scene3d.PrimitiveInstanceAuthoring{Shape: shape, Material: material, Position: position, Rotation: rotation, Scale: scale, Tint: tint, Flags: flags})
}

func (p *PrimitiveVisualContent) PlaceDetail(shape primitive3d.ShapeID, material primitive3d.MaterialID, position voplay.Vec3, rotation voplay.Quat, scale voplay.Vec3, tint voplay.Color, lodFar float64) primitive3d.ObjectID {
	if material == p.ContactShadowMat {
		return 0
	}
	flags := p.detailFlags(shape, material, lodFar)
	detailLodFar := lodFar
	return scene3d.ProductPrimitivePlace(p.ProductPrimitives, p.detailLayerNameForLod(detailLodFar), scene3d.PrimitiveInstanceAuthoring{Shape: shape, Material: material, Position: position, Rotation: rotation, Scale: scale, Tint: tint, Flags: flags, LodFar: detailLodFar})
}

func (p *PrimitiveVisualContent) detailFlags(shape primitive3d.ShapeID, material primitive3d.MaterialID, lodFar float64) primitive3d.InstanceFlags {
	if shape == p.GrassCard || material == p.GrassCardMat || lodFar <= primitiveFlowerClumpLodFar {
		return primitive3d.InstanceNoShadow
	}
	return primitive3d.InstanceFlags(0)
}

func (p *PrimitiveVisualContent) detailLayerNameForLod(lodFar float64) string {
	if lodFar >= primitiveTreeLodFar {
		return primitiveLayerTreeDetail
	}
	if lodFar >= primitiveRoadsidePropLodFar {
		return primitiveLayerRoadsideDetail
	}
	if lodFar <= primitiveFlowerClumpLodFar {
		return primitiveLayerFlowerDetail
	}
	return primitiveLayerSmallDetail
}

func (p *PrimitiveVisualContent) AddDynamic(shape primitive3d.ShapeID, material primitive3d.MaterialID, position voplay.Vec3, rotation voplay.Quat, scale voplay.Vec3, tint voplay.Color) *PrimitivePart {
	return p.AddDynamicWithFlags(shape, material, position, rotation, scale, tint, primitive3d.InstanceFlags(0))
}

func (p *PrimitiveVisualContent) AddDynamicWithFlags(shape primitive3d.ShapeID, material primitive3d.MaterialID, position voplay.Vec3, rotation voplay.Quat, scale voplay.Vec3, tint voplay.Color, flags primitive3d.InstanceFlags) *PrimitivePart {
	return scene3d.ProductPrimitiveDynamic(p.ProductPrimitives, primitiveLayerDynamic, scene3d.PrimitiveInstanceAuthoring{Shape: shape, Material: material, Position: position, Rotation: rotation, Scale: scale, Tint: tint, Flags: flags})
}

func blockKartHighFrequencyPrimitiveFlags() primitive3d.InstanceFlags {
	return primitive3d.InstanceNoShadow
}

func hidePrimitivePart(part *PrimitivePart) {
	if part != nil {
		part.SetVisible(false)
	}
}

func showPrimitivePart(part *PrimitivePart) {
	if part != nil {
		part.SetVisible(true)
	}
}

func (t *TrackRuntime) buildPrimitiveLevel(w *World) error {
	prof := newBlockKartStartupProfiler("BlockKart primitive")
	primitive := w.trackRuntime.ensurePrimitiveScene(w)
	templateReused := w.primitiveTemplateReused
	prof.Mark("ensurePrimitiveScene")
	mapErr := w.trackRuntime.preparePrimitiveMapAsset(w)
	if mapErr != nil {
		w.message = "Primitive map failed: " + mapErr.Error()
		w.messageTimer = 4
		fmt.Println(w.message)
		return errors.New(w.message)
	}
	prof.Mark("preparePrimitiveMapAsset")
	asset := newPrimitiveTrackAsset()
	prof.Mark("newPrimitiveTrackAsset")
	track, err := scene3d.NewTrack(asset)
	if err != nil {
		w.message = "Primitive track failed: " + err.Error()
		w.messageTimer = 4
		fmt.Println(w.message)
		return errors.New(w.message)
	}
	w.track = track
	prof.Mark("NewTrack")
	result, terrainErr := w.trackRuntime.spawnPrimitiveTrackTerrain(w, track)
	if terrainErr != nil {
		w.message = "Terrain failed: " + terrainErr.Error()
		w.messageTimer = 4
		fmt.Println(w.message)
		return errors.New(w.message)
	}
	w.trackResult = result
	prof.Mark("spawnPrimitiveTrackTerrain")
	w.trackRuntime.applyPrimitiveTrackSpawn(w, track)
	w.trackRuntime.populatePrimitiveTrackCheckpoints(w, track)
	prof.Mark("trackSpawnAndCheckpoints")
	if templateReused {
		w.trackRuntime.spawnPrimitiveCachedMapMeshes(w, track)
		prof.Mark("reusePrimitiveStaticTemplate")
	} else {
		w.trackRuntime.buildPrimitiveTrackVisuals(w, track)
		prof.Mark("buildPrimitiveTrackVisuals")
	}
	colliderErr := w.trackRuntime.attachPrimitiveTrackColliderEntities(w, track)
	if colliderErr != nil {
		w.message = "Track collider failed: " + colliderErr.Error()
		w.messageTimer = 4
		fmt.Println(w.message)
		return errors.New(w.message)
	}
	prof.Mark("primitiveTrackColliders")
	w.trackRuntime.spawnPrimitiveGameplay(w, track, !templateReused)
	prof.Mark("spawnPrimitiveGameplay")
	if templateReused {
		prof.Mark("reuseStaticLayerChunks")
		return nil
	}
	primitive.ProductPrimitives.BuildLayer(primitiveLayerStatic)
	prof.Mark("buildStaticLayer")
	primitive.ProductPrimitives.BuildLayer(primitiveLayerTreeDetail)
	prof.Mark("buildTreeDetailLayer")
	primitive.ProductPrimitives.BuildLayer(primitiveLayerRoadsideDetail)
	prof.Mark("buildRoadsideDetailLayer")
	primitive.ProductPrimitives.BuildLayer(primitiveLayerSmallDetail)
	prof.Mark("buildSmallDetailLayer")
	primitive.ProductPrimitives.BuildLayer(primitiveLayerFlowerDetail)
	prof.Mark("buildFlowerDetailLayer")
	primitive.ProductPrimitives.BuildLayer(primitiveLayerScatter)
	prof.Mark("buildScatterLayer")
	if w.runtimeCache != nil && w.runtimeCache.primitiveTemplate == nil {
		w.runtimeCache.primitiveTemplate = newBlockKartPrimitiveTemplate(primitive)
		if w.runtimeCache.primitiveTemplate != nil {
			w.runtimeCache.primitiveTemplateBuilds++
		}
	}
	return nil
}

func (t *TrackRuntime) preparePrimitiveMapAsset(w *World) error {
	if w.primitiveMap != nil {
		return nil
	}
	if w.runtimeCache != nil && w.runtimeCache.primitiveMap != nil {
		w.primitiveMap = w.runtimeCache.primitiveMap
		w.preparedMapReused = true
		w.runtimeCache.preparedMapReuses++
		return nil
	}
	if w.assets == nil {
		return errors.New("BlockKart assets unavailable")
	}
	w.assets.BeginGroup(worldAssetGroup)
	prepared, err := scene3d.PrepareMapWithAssets(w.assets, blockKartAssetPath("maps/primitive_track/blockkart.map.json"))
	w.assets.EndGroup()
	if err != nil {
		return err
	}
	w.primitiveMap = prepared
	if w.runtimeCache != nil {
		w.runtimeCache.primitiveMap = prepared
		w.runtimeCache.preparedMapBuilds++
	}
	return nil
}

func newPrimitiveTrackAsset() *scene3d.TrackAsset {
	return defaultBlockKartTrackSpec().TrackAsset()
}

func (t *TrackRuntime) spawnPrimitiveTrackTerrain(w *World, track *scene3d.Track) (*scene3d.TrackSpawnResult, error) {
	if track == nil {
		return nil, errors.New("BlockKart primitive track unavailable")
	}
	if w.assets == nil {
		return nil, errors.New("BlockKart assets unavailable")
	}
	if w.primitiveMap == nil {
		err := w.trackRuntime.preparePrimitiveMapAsset(w)
		if err != nil {
			return nil, err
		}
	}
	return scene3d.SpawnPreparedMapTrackMeshTerrain(w.scene, track, w.primitiveMap, defaultBlockKartTrackSpec().TerrainMesh)
}

func primitiveTrackControlPoints() []scene3d.TrackControlPoint {
	points := []scene3d.TrackControlPoint{}
	anchors := primitiveConceptTrackAnchors()
	samplesPerSegment := 18
	for i := 0; i < len(anchors); i++ {
		a := anchors[(i + len(anchors) - 1) % len(anchors)]
		b := anchors[i]
		c := anchors[(i + 1) % len(anchors)]
		d := anchors[(i + 2) % len(anchors)]
		for s := 0; s < samplesPerSegment; s++ {
			t := float64(s) / float64(samplesPerSegment)
			def := primitiveTrackCatmull(a, b, c, d, t)
			position := voplay.Vec3{X: def.X * primitiveMapPlanarScale, Y: def.Y, Z: def.Z * primitiveMapPlanarScale}
			points = append(points, scene3d.TrackControlPoint{Position: primitiveMapVec3(position), Width: def.Width})
		}
	}
	if len(points) > 0 {
		points = append(points, points[0])
	}
	return points
}

func primitiveConceptTrackAnchors() []primitiveTrackPointDef {
	return []primitiveTrackPointDef{{X: 8, Z: 150, Y: 0.0, Width: 19.0}, {X: 104, Z: 150, Y: 0.02, Width: 19.0}, {X: 168, Z: 128, Y: 0.14, Width: 18.8}, {X: 190, Z: 90, Y: 0.28, Width: 18.4}, {X: 128, Z: 44, Y: 0.36, Width: 18.0}, {X: 184, Z: -24, Y: 0.5, Width: 18.4}, {X: 162, Z: -104, Y: 0.62, Width: 18.6}, {X: 82, Z: -136, Y: 0.68, Width: 18.8}, {X: -18, Z: -136, Y: 0.64, Width: 18.8}, {X: -116, Z: -132, Y: 0.54, Width: 18.6}, {X: -184, Z: -88, Y: 0.42, Width: 18.4}, {X: -158, Z: -34, Y: 0.28, Width: 18.0}, {X: -124, Z: 4, Y: 0.2, Width: 18.2}, {X: -178, Z: 62, Y: 0.08, Width: 18.4}, {X: -168, Z: 118, Y: 0.02, Width: 18.8}, {X: -94, Z: 150, Y: 0.0, Width: 19.0}}
}

func primitiveTrackCatmull(a, b, c, d primitiveTrackPointDef, t float64) primitiveTrackPointDef {
	return primitiveTrackPointDef{X: primitiveCatmullValue(a.X, b.X, c.X, d.X, t), Z: primitiveCatmullValue(a.Z, b.Z, c.Z, d.Z, t), Y: primitiveCatmullValue(a.Y, b.Y, c.Y, d.Y, t), Width: primitiveCatmullValue(a.Width, b.Width, c.Width, d.Width, t)}
}

func primitiveCatmullValue(a, b, c, d, t float64) float64 {
	t2 := t * t
	t3 := t2 * t
	return 0.5 * (2.0 * b + (-a + c) * t + (2.0 * a - 5.0 * b + 4.0 * c - d) * t2 + (-a + 3.0 * b - 3.0 * c + d) * t3)
}

func primitiveTrackLength(points []scene3d.TrackControlPoint) float64 {
	total := 0.0
	for i := 0; i < len(points) - 1; i++ {
		total += points[i].Position.Vec3().Distance(points[i + 1].Position.Vec3())
	}
	return total
}

func primitiveMapVec3(v voplay.Vec3) scene3d.MapVec3 {
	return scene3d.MapVec3{X: v.X, Y: v.Y, Z: v.Z}
}

func primitiveSceneryVec3(x, y, z float64) voplay.Vec3 {
	return voplay.Vec3{X: x * primitiveMapPlanarScale, Y: y, Z: z * primitiveMapPlanarScale}
}

func primitiveLandmarkVec3(x, y, z float64) voplay.Vec3 {
	return voplay.Vec3{X: x * primitiveLandmarkScale, Y: y * primitiveLandmarkScale, Z: z * primitiveLandmarkScale}
}

func primitiveTrackSegmentCount(track *scene3d.Track) int {
	count := int(math.Ceil(track.Length() / primitiveTrackSegmentLength))
	if count < 24 {
		count = 24
	}
	return count
}

func (t *TrackRuntime) spawnPrimitiveKartVisuals(w *World) {
	primitive := w.trackRuntime.ensurePrimitiveScene(w)
	pos := w.startPosition
	rot := w.kartRig.kartRotation(w)
	w.kartBodyPrimitiveParts = nil
	w.kartWheelVisuals = nil
	w.kartWheelPrimitives = nil
	w.kartPrimitiveVisualStateValid = false
	identity := voplay.QuatIdentity()
	w.trackRuntime.addPrimitiveKartBodyPart(w, primitive, pos, rot, primitive.RoundedBox, primitive.WheelMat, voplay.Vec3{Y: 0.00, Z: 0.08}, identity, voplay.Vec3{X: 1.58, Y: 0.18, Z: 2.36}, voplay.Color{})
	w.kartChassisPrimitive = w.trackRuntime.addPrimitiveKartBodyPart(w, primitive, pos, rot, primitive.RoundedBox, primitive.PlayerMat, voplay.Vec3{Y: 0.28, Z: 0.02}, identity, voplay.Vec3{X: 1.42, Y: 0.46, Z: 2.05}, voplay.Color{})
	w.kartNosePrimitive = w.trackRuntime.addPrimitiveKartBodyPart(w, primitive, pos, rot, primitive.RoundedBox, primitive.TopBlueMat, voplay.Vec3{Y: 0.35, Z: -1.08}, identity, voplay.Vec3{X: 1.06, Y: 0.34, Z: 0.78}, voplay.Color{})
	w.kartBumperPrimitive = w.trackRuntime.addPrimitiveKartBodyPart(w, primitive, pos, rot, primitive.RoundedBox, primitive.OrangeTrimMat, voplay.Vec3{Y: 0.21, Z: -1.58}, identity, voplay.Vec3{X: 1.20, Y: 0.18, Z: 0.22}, voplay.Color{})
	w.trackRuntime.addPrimitiveKartBodyPart(w, primitive, pos, rot, primitive.RoundedBox, primitive.PlayerMat, voplay.Vec3{X: -0.72, Y: 0.28, Z: 0.08}, identity, voplay.Vec3{X: 0.30, Y: 0.38, Z: 1.58}, voplay.Color{})
	w.trackRuntime.addPrimitiveKartBodyPart(w, primitive, pos, rot, primitive.RoundedBox, primitive.PlayerMat, voplay.Vec3{X: 0.72, Y: 0.28, Z: 0.08}, identity, voplay.Vec3{X: 0.30, Y: 0.38, Z: 1.58}, voplay.Color{})
	w.trackRuntime.addPrimitiveKartBodyPart(w, primitive, pos, rot, primitive.RoundedBox, primitive.WhiteMat, voplay.Vec3{Y: 0.56, Z: -0.34}, identity, voplay.Vec3{X: 0.24, Y: 0.06, Z: 1.72}, voplay.Color{})
	w.kartCabinPrimitive = w.trackRuntime.addPrimitiveKartBodyPart(w, primitive, pos, rot, primitive.RoundedBox, primitive.VisorMat, voplay.Vec3{Y: 0.64, Z: 0.28}, identity, voplay.Vec3{X: 0.58, Y: 0.18, Z: 0.46}, voplay.Color{})
	w.kartDriverPrimitive = w.trackRuntime.addPrimitiveKartBodyPart(w, primitive, pos, rot, primitive.Sphere, primitive.DriverMat, voplay.Vec3{Y: 0.88, Z: 0.10}, identity, voplay.Vec3{X: 0.38, Y: 0.36, Z: 0.34}, voplay.Color{})
	w.trackRuntime.addPrimitiveKartBodyPart(w, primitive, pos, rot, primitive.Sphere, primitive.WhiteMat, voplay.Vec3{Y: 1.14, Z: -0.06}, identity, voplay.Vec3{X: 0.42, Y: 0.43, Z: 0.42}, voplay.Color{})
	w.trackRuntime.addPrimitiveKartBodyPart(w, primitive, pos, rot, primitive.RoundedBox, primitive.VisorMat, voplay.Vec3{Y: 1.15, Z: -0.39}, identity, voplay.Vec3{X: 0.32, Y: 0.075, Z: 0.055}, voplay.Color{})
	w.trackRuntime.addPrimitiveKartBodyPart(w, primitive, pos, rot, primitive.RoundedBox, primitive.OrangeTrimMat, voplay.Vec3{Y: 1.25, Z: 0.16}, identity, voplay.Vec3{X: 0.44, Y: 0.09, Z: 0.32}, voplay.Color{})
	w.trackRuntime.addPrimitiveKartBodyPart(w, primitive, pos, rot, primitive.RoundedBox, primitive.OrangeTrimMat, voplay.Vec3{X: -0.48, Y: 0.62, Z: 1.14}, identity, voplay.Vec3{X: 0.12, Y: 0.38, Z: 0.12}, voplay.Color{})
	w.trackRuntime.addPrimitiveKartBodyPart(w, primitive, pos, rot, primitive.RoundedBox, primitive.OrangeTrimMat, voplay.Vec3{X: 0.48, Y: 0.62, Z: 1.14}, identity, voplay.Vec3{X: 0.12, Y: 0.38, Z: 0.12}, voplay.Color{})
	w.kartSpoilerPrimitive = w.trackRuntime.addPrimitiveKartBodyPart(w, primitive, pos, rot, primitive.RoundedBox, primitive.WhiteMat, voplay.Vec3{Y: 0.84, Z: 1.28}, identity, voplay.Vec3{X: 1.08, Y: 0.12, Z: 0.24}, voplay.Color{})
	fastFlags := blockKartHighFrequencyPrimitiveFlags()
	w.kartFlameLeftPrimitive = w.trackRuntime.addPrimitiveKartBodyPartWithFlags(w, primitive, pos, rot, primitive.Sphere, primitive.BoostMat, voplay.Vec3{X: -0.36, Y: 0.14, Z: 1.52}, identity, voplay.Vec3{X: 0.20, Y: 0.16, Z: 0.32}, voplay.Color{}, fastFlags)
	w.kartFlameRightPrimitive = w.trackRuntime.addPrimitiveKartBodyPartWithFlags(w, primitive, pos, rot, primitive.Sphere, primitive.BoostMat, voplay.Vec3{X: 0.36, Y: 0.14, Z: 1.52}, identity, voplay.Vec3{X: 0.20, Y: 0.16, Z: 0.32}, voplay.Color{}, fastFlags)
	w.trackRuntime.addPrimitiveKartWheelVisual(w, primitive, pos, rot, voplay.Vec3{X: -0.96, Y: 0.12, Z: -0.76}, true, 0, -1)
	w.trackRuntime.addPrimitiveKartWheelVisual(w, primitive, pos, rot, voplay.Vec3{X: 0.96, Y: 0.12, Z: -0.76}, true, 1, 1)
	w.trackRuntime.addPrimitiveKartWheelVisual(w, primitive, pos, rot, voplay.Vec3{X: -0.96, Y: 0.12, Z: 0.78}, false, 2, -1)
	w.trackRuntime.addPrimitiveKartWheelVisual(w, primitive, pos, rot, voplay.Vec3{X: 0.96, Y: 0.12, Z: 0.78}, false, 3, 1)
	w.kartFlameLeftPrimitive.SetVisible(false)
	w.kartFlameRightPrimitive.SetVisible(false)
}

func (t *TrackRuntime) syncPrimitiveKartVisuals(w *World, pos voplay.Vec3, rot voplay.Quat) {
	boostVisible := w.hudPresenter.isBoosting(w)
	state := w.trackRuntime.currentPrimitiveKartVisualState(w, pos, rot, boostVisible)
	if w.kartPrimitiveVisualStateValid && w.kartPrimitiveVisualState == state {
		return
	}
	w.kartPrimitiveVisualState = state
	w.kartPrimitiveVisualStateValid = true
	if w.kartFlameLeftPrimitive != nil {
		w.kartFlameLeftPrimitive.SetVisible(boostVisible)
	}
	if w.kartFlameRightPrimitive != nil {
		w.kartFlameRightPrimitive.SetVisible(boostVisible)
	}
	for _, part := range w.kartBodyPrimitiveParts {
		w.trackRuntime.syncPrimitiveKartBodyPart(w, part, pos, rot)
	}
	if len(w.kartWheelVisuals) > 0 {
		axisRot := voplay.QuatFromAxisAngle(voplay.Vec3{Z: 1}, math.Pi * 0.5)
		for _, wheel := range w.kartWheelVisuals {
			w.trackRuntime.syncPrimitiveKartWheelVisual(w, wheel, pos, rot, axisRot, state)
		}
		return
	}
	axisRot := voplay.QuatFromAxisAngle(voplay.Vec3{Z: 1}, math.Pi * 0.5)
	if len(w.kartWheelPrimitives) >= 4 {
		w.trackRuntime.syncPrimitiveKartWheel(w, w.kartWheelPrimitives[0], pos, rot, voplay.Vec3{X: -1.04, Y: 0.12, Z: -0.80}, true, 0, axisRot)
		w.trackRuntime.syncPrimitiveKartWheel(w, w.kartWheelPrimitives[1], pos, rot, voplay.Vec3{X: 1.04, Y: 0.12, Z: -0.80}, true, 1, axisRot)
		w.trackRuntime.syncPrimitiveKartWheel(w, w.kartWheelPrimitives[2], pos, rot, voplay.Vec3{X: -1.04, Y: 0.12, Z: 0.84}, false, 2, axisRot)
		w.trackRuntime.syncPrimitiveKartWheel(w, w.kartWheelPrimitives[3], pos, rot, voplay.Vec3{X: 1.04, Y: 0.12, Z: 0.84}, false, 3, axisRot)
	}
}

func (t *TrackRuntime) currentPrimitiveKartVisualState(w *World, pos voplay.Vec3, rot voplay.Quat, boostVisible bool) PrimitiveKartVisualState {
	state := PrimitiveKartVisualState{Position: pos, Rotation: rot.Normalize(), BoostVisible: boostVisible}
	if w.vehicle == nil {
		return state
	}
	for _, wheel := range w.kartWheelVisuals {
		wheelState, ok := w.vehicle.VisualWheelSample(wheel.WheelIndex)
		if !ok {
			continue
		}
		w.trackRuntime.assignPrimitiveKartWheelState(w, &state, wheel.WheelIndex, wheelState.Steering, wheelState.Rotation)
	}
	return state
}

func (t *TrackRuntime) assignPrimitiveKartWheelState(w *World, state *PrimitiveKartVisualState, index int, steer, spin float64) {
	if state == nil {
		return
	}
	if index == 0 {
		state.FrontSteer0 = steer
		state.WheelSpin0 = spin
		return
	}
	if index == 1 {
		state.FrontSteer1 = steer
		state.WheelSpin1 = spin
		return
	}
	if index == 2 {
		state.WheelSpin2 = spin
		return
	}
	if index == 3 {
		state.WheelSpin3 = spin
	}
}

func (t *TrackRuntime) addPrimitiveKartBodyPart(w *World, primitive *PrimitiveVisualContent, pos voplay.Vec3, rot voplay.Quat, shape primitive3d.ShapeID, material primitive3d.MaterialID, local voplay.Vec3, localRot voplay.Quat, scale voplay.Vec3, tint voplay.Color) *PrimitivePart {
	return w.trackRuntime.addPrimitiveKartBodyPartWithFlags(w, primitive, pos, rot, shape, material, local, localRot, scale, tint, primitive3d.InstanceFlags(0))
}

func (t *TrackRuntime) addPrimitiveKartBodyPartWithFlags(w *World, primitive *PrimitiveVisualContent, pos voplay.Vec3, rot voplay.Quat, shape primitive3d.ShapeID, material primitive3d.MaterialID, local voplay.Vec3, localRot voplay.Quat, scale voplay.Vec3, tint voplay.Color, flags primitive3d.InstanceFlags) *PrimitivePart {
	local = primitiveKartScaleVec(local)
	scale = primitiveKartScaleVec(scale)
	part := primitive.AddDynamicWithFlags(shape, material, pos.Add(rot.RotateVec3(local)), rot.Mul(localRot), scale, tint, flags)
	w.kartBodyPrimitiveParts = append(w.kartBodyPrimitiveParts, PrimitiveKartBodyPart{Part: part, Local: local, LocalRotation: localRot})
	return part
}

func (t *TrackRuntime) addPrimitiveKartWheelVisual(w *World, primitive *PrimitiveVisualContent, pos voplay.Vec3, rot voplay.Quat, local voplay.Vec3, steer bool, wheelIndex int, sideSign float64) {
	if sideSign == 0 {
		sideSign = 1
		if local.X < 0 {
			sideSign = -1
		}
	}
	local = primitiveKartScaleVec(local)
	wheelPos := pos.Add(rot.RotateVec3(local))
	axisRot := voplay.QuatFromAxisAngle(voplay.Vec3{Z: 1}, math.Pi * 0.5)
	wheelRot := rot.Mul(axisRot)
	flags := blockKartHighFrequencyPrimitiveFlags()
	tire := primitive.AddDynamicWithFlags(primitive.Cylinder, primitive.WheelMat, wheelPos, wheelRot, primitiveKartScaleVec(voplay.Vec3{X: 0.64, Y: 0.42, Z: 0.64}), voplay.Color{}, flags)
	rim := primitive.AddDynamicWithFlags(primitive.Cylinder, primitive.MetalMat, wheelPos, wheelRot, primitiveKartScaleVec(voplay.Vec3{X: 0.34, Y: 0.055, Z: 0.34}), voplay.Color{}, flags)
	hub := primitive.AddDynamicWithFlags(primitive.Cylinder, primitive.WhiteMat, wheelPos, wheelRot, primitiveKartScaleVec(voplay.Vec3{X: 0.18, Y: 0.07, Z: 0.18}), voplay.Color{}, flags)
	stripe := primitive.AddDynamicWithFlags(primitive.RoundedBox, primitive.OrangeTrimMat, wheelPos, wheelRot, primitiveKartScaleVec(voplay.Vec3{X: 0.032, Y: 0.06, Z: 0.20}), voplay.Color{}, flags)
	w.kartWheelPrimitives = append(w.kartWheelPrimitives, tire)
	w.kartWheelVisuals = append(w.kartWheelVisuals, PrimitiveKartWheelVisual{Tire: tire, Rim: rim, Hub: hub, Stripe: stripe, Local: local, Steer: steer, WheelIndex: wheelIndex, SideSign: sideSign})
}

func (t *TrackRuntime) syncPrimitiveKartBodyPart(w *World, body PrimitiveKartBodyPart, pos voplay.Vec3, rot voplay.Quat) {
	if body.Part == nil || !body.Part.Visible {
		return
	}
	scene3d.ProductPrimitiveSetPose(body.Part, pos.Add(rot.RotateVec3(body.Local)), rot.Mul(body.LocalRotation))
}

func (t *TrackRuntime) syncPrimitiveKartPart(w *World, part *PrimitivePart, pos voplay.Vec3, rot voplay.Quat, local voplay.Vec3, partRot voplay.Quat) {
	if part == nil {
		return
	}
	scene3d.ProductPrimitiveSetPose(part, pos.Add(rot.RotateVec3(local)), partRot)
}

func (t *TrackRuntime) syncPrimitiveKartWheelVisual(w *World, wheel PrimitiveKartWheelVisual, pos voplay.Vec3, rot voplay.Quat, axisRot voplay.Quat, visualState PrimitiveKartVisualState) {
	if wheel.Tire == nil {
		return
	}
	wheelRot := rot
	spinRot := rot
	wheelPos := pos.Add(rot.RotateVec3(wheel.Local))
	if w.vehicle != nil {
		steerAngle, spin := primitiveKartWheelVisualMotion(visualState, wheel.WheelIndex, 0, 0)
		if wheel.Steer {
			wheelRot = wheelRot.Mul(voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, -steerAngle))
		}
		spinRot = wheelRot.Mul(voplay.QuatFromAxisAngle(voplay.Vec3{X: 1}, spin))
	}
	cylinderRot := wheelRot.Mul(axisRot)
	scene3d.ProductPrimitiveSetPose(wheel.Tire, wheelPos, cylinderRot)
	sideDir := wheelRot.RotateVec3(voplay.Vec3{X: wheel.SideSign})
	facePos := wheelPos.Add(sideDir.Scale(0.29 * primitiveKartVisualScale))
	if wheel.Rim != nil {
		scene3d.ProductPrimitiveSetPose(wheel.Rim, facePos, cylinderRot)
	}
	if wheel.Hub != nil {
		scene3d.ProductPrimitiveSetPose(wheel.Hub, facePos.Add(sideDir.Scale(0.035 * primitiveKartVisualScale)), cylinderRot)
	}
	if wheel.Stripe != nil {
		radial := spinRot.RotateVec3(voplay.Vec3{Y: 0.17 * primitiveKartVisualScale})
		scene3d.ProductPrimitiveSetPose(wheel.Stripe, facePos.Add(sideDir.Scale(0.012 * primitiveKartVisualScale)).Add(radial), spinRot)
	}
}

func primitiveKartWheelVisualMotion(state PrimitiveKartVisualState, index int, fallbackSteer, fallbackSpin float64) (float64, float64) {
	if index == 0 {
		return state.FrontSteer0, state.WheelSpin0
	}
	if index == 1 {
		return state.FrontSteer1, state.WheelSpin1
	}
	if index == 2 {
		return fallbackSteer, state.WheelSpin2
	}
	if index == 3 {
		return fallbackSteer, state.WheelSpin3
	}
	return fallbackSteer, fallbackSpin
}

func primitiveKartScaleVec(v voplay.Vec3) voplay.Vec3 {
	return voplay.Vec3{X: v.X * primitiveKartVisualScale, Y: v.Y * primitiveKartVisualScale, Z: v.Z * primitiveKartVisualScale}
}

func (t *TrackRuntime) syncPrimitiveKartWheel(w *World, part *PrimitivePart, pos voplay.Vec3, rot voplay.Quat, local voplay.Vec3, steer bool, wheelIndex int, axisRot voplay.Quat) {
	if part == nil {
		return
	}
	wheelRot := rot
	wheelPos := pos.Add(rot.RotateVec3(local))
	if w.vehicle != nil {
		steerAngle := 0.0
		spin := 0.0
		if state, ok := w.vehicle.VisualWheelSample(wheelIndex); ok {
			wheelPos = state.Center
			steerAngle = state.Steering
			spin = state.Rotation
		}
		if steer {
			wheelRot = wheelRot.Mul(voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, -steerAngle))
		}
		wheelRot = wheelRot.Mul(voplay.QuatFromAxisAngle(voplay.Vec3{X: 1}, spin))
	}
	wheelRot = wheelRot.Mul(axisRot)
	scene3d.ProductPrimitiveSetPose(part, wheelPos, wheelRot)
}
