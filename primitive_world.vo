type primitiveTrackPointDef struct {
	X float64
	Z float64
	Y float64
	Width float64
}

func (t *TrackRuntime) ensurePrimitiveScene(w *World) *PrimitiveVisualContent {
	if w.primitive != nil {
		return w.primitive
	}
	if w.assets == nil {
		panic("BlockKart primitive scene requires loaded assets")
	}
	if w.runtimeCache != nil && w.runtimeCache.primitiveTemplate != nil {
		primitive := w.runtimeCache.primitiveTemplate.Instantiate(w.scene)
		w.primitive = primitive
		w.primitiveTemplateReused = true
		w.runtimeCache.primitiveTemplateReuses++
		return w.primitive
	}
	w.assets.BeginGroup(worldAssetGroup)
	primitive, err := newPrimitiveVisualContent(w.scene, w.assets)
	w.assets.EndGroup()
	if err != nil {
		panic("BlockKart primitive scene asset load failed: " + err.Error())
	}
	w.primitive = primitive
	return w.primitive
}


func newBlockKartPrimitiveTemplate(primitive *PrimitiveVisualContent) *BlockKartPrimitiveTemplate {
	if primitive == nil {
		return nil
	}
	return &BlockKartPrimitiveTemplate{Scene: primitive}
}

func (t *BlockKartPrimitiveTemplate) Instantiate(scene *scene3d.Scene) *PrimitiveVisualContent {
	if t == nil || t.Scene == nil {
		return nil
	}
	source := t.Scene
	primitive := *source
	primitive.ProductPrimitives = source.ProductPrimitives.CloneForScene(scene, blockKartPrimitiveLayer(primitiveLayerDynamic, primitive3d.DynamicLayer, 0, false))
	primitive.bindPrimitiveLayers()
	return &primitive
}

func blockKartPrimitiveLayer(name string, kind primitive3d.LayerKind, cellSize float64, preload bool) scene3d.PrimitiveBatchAuthoring {
	return scene3d.PrimitiveBatchAuthoring{Name: name, Kind: kind, Chunk: scene3d.ChunkAuthoring{CellSize: cellSize, PreloadChunks: preload}}
}

func blockKartPrimitiveLayers() []scene3d.PrimitiveBatchAuthoring {
	return []scene3d.PrimitiveBatchAuthoring{
		blockKartPrimitiveLayer(primitiveLayerStatic, primitive3d.StaticLayer, primitiveStaticBatchCellSize, true),
		blockKartPrimitiveLayer(primitiveLayerTreeDetail, primitive3d.StaticLayer, primitiveTreeDetailBatchCellSize, true),
		blockKartPrimitiveLayer(primitiveLayerRoadsideDetail, primitive3d.StaticLayer, primitiveRoadsideDetailBatchCellSize, true),
		blockKartPrimitiveLayer(primitiveLayerSmallDetail, primitive3d.StaticLayer, primitiveSmallDetailBatchCellSize, true),
		blockKartPrimitiveLayer(primitiveLayerFlowerDetail, primitive3d.StaticLayer, primitiveFlowerDetailBatchCellSize, true),
		blockKartPrimitiveLayer(primitiveLayerScatter, primitive3d.StaticLayer, primitiveScatterBatchCellSize, true),
		blockKartPrimitiveLayer(primitiveLayerDynamic, primitive3d.DynamicLayer, 0, false),
	}
}

func (p *PrimitiveVisualContent) bindPrimitiveLayers() {
	if p == nil || p.ProductPrimitives == nil {
		return
	}
	p.Static = p.ProductPrimitives.Layer(primitiveLayerStatic)
	p.TreeDetailStatic = p.ProductPrimitives.Layer(primitiveLayerTreeDetail)
	p.RoadsideDetailStatic = p.ProductPrimitives.Layer(primitiveLayerRoadsideDetail)
	p.SmallDetailStatic = p.ProductPrimitives.Layer(primitiveLayerSmallDetail)
	p.FlowerDetailStatic = p.ProductPrimitives.Layer(primitiveLayerFlowerDetail)
	p.ScatterStatic = p.ProductPrimitives.Layer(primitiveLayerScatter)
	p.Dynamic = p.ProductPrimitives.Layer(primitiveLayerDynamic)
}

func newPrimitiveVisualContent(scene *scene3d.Scene, assets *voplay.Assets) (*PrimitiveVisualContent, error) {
	authoring := scene3d.NewProductPrimitiveRuntime(scene, scene3d.ProductPrimitiveAuthoringDesc{Layers: blockKartPrimitiveLayers()})
	p := &PrimitiveVisualContent{ProductPrimitives: authoring}
	p.bindPrimitiveLayers()
	grassCardTexture, grassCardErr := assets.Texture(blockKartAssetPath("effects/grass_card_atlas.png"))
	if grassCardErr != nil {
		return nil, grassCardErr
	}
	p.Box = authoring.Shape(primitive3d.ShapeDesc{Kind: primitive3d.ShapeBox})
	p.RoundedBox = authoring.Shape(primitive3d.ShapeDesc{Kind: primitive3d.ShapeRoundedBox, BevelRadius: 0.08, Segments: 4})
	p.Sphere = authoring.Shape(primitive3d.ShapeDesc{Kind: primitive3d.ShapeSphere, Segments: 8})
	p.Cylinder = authoring.Shape(primitive3d.ShapeDesc{Kind: primitive3d.ShapeCylinder, Segments: 10})
	p.Cone = authoring.Shape(primitive3d.ShapeDesc{Kind: primitive3d.ShapeCone, Segments: 8})
	p.Wedge = authoring.Shape(primitive3d.ShapeDesc{Kind: primitive3d.ShapeWedge})
	p.GrassCard = authoring.Shape(primitive3d.ShapeDesc{Kind: primitive3d.ShapePlane, Width: 1, Depth: 1, SubX: 1, SubZ: 1})
	p.NeedleLeaf = authoring.Shape(primitive3d.ShapeDesc{Kind: primitive3d.ShapeCone, Segments: 5})
	p.RoadMat = p.material(primitive3d.MaterialRoadAsphalt, voplay.Hex(0x414443), 0.84, 0, voplay.Color{})
	p.RoadStripeMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0xfff4dd), 0.48, 0, voplay.Color{})
	p.GrassMat = p.material(primitive3d.MaterialGrass, voplay.Hex(0x4f9737), 0.64, 0, voplay.Color{})
	p.GrassCardMat = p.grassCardMaterial(grassCardTexture)
	p.MeadowMat = p.material(primitive3d.MaterialGrass, voplay.Hex(0x86a346), 0.66, 0, voplay.Color{})
	p.DirtDetailMat = p.material(primitive3d.MaterialStone, voplay.Hex(0x9a6738), 0.88, 0, voplay.Color{})
	p.StoneMat = p.material(primitive3d.MaterialStone, voplay.Hex(0x8f8778), 0.82, 0, voplay.Color{})
	p.PebbleMat = p.material(primitive3d.MaterialStone, voplay.Hex(0xa89a84), 0.82, 0, voplay.Color{})
	p.CliffMat = p.material(primitive3d.MaterialStone, voplay.Hex(0x82684f), 0.84, 0, voplay.Color{})
	p.PaleStoneMat = p.material(primitive3d.MaterialStone, voplay.Hex(0xa99c84), 0.78, 0, voplay.Color{})
	p.WoodMat = p.material(primitive3d.MaterialWood, voplay.Hex(0x7a4a26), 0.76, 0, voplay.Color{})
	p.LeafMat = p.material(primitive3d.MaterialGrass, voplay.Hex(0x205f34), 0.66, 0, voplay.Color{})
	p.BushMat = p.material(primitive3d.MaterialGrass, voplay.Hex(0x327638), 0.66, 0, voplay.Color{})
	p.FlowerYellowMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0xffdd35), 0.42, 0, voplay.Color{})
	p.FlowerWhiteMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0xfff7df), 0.46, 0, voplay.Color{})
	p.WaterMat = p.material(primitive3d.MaterialWater, voplay.Hex(0x2ba6ee).WithAlpha(0.74), 0.14, 0, voplay.Color{})
	p.SignMat = p.material(primitive3d.MaterialToyPlastic, voplay.Hex(0xffd234), 0.30, 0, voplay.Color{})
	p.SignArrowMat = p.material(primitive3d.MaterialRubber, voplay.Hex(0x121519), 0.72, 0, voplay.Color{})
