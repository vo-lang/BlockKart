package main

import (
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

type BlockKartTrackSpec struct {
	Name string
	Centerline []scene3d.TrackControlPoint
	Surfaces []scene3d.TrackSurface
	Gates []scene3d.TrackGate
	Spawns []scene3d.TrackSpawn
	Respawns []scene3d.TrackRespawn
	TerrainMesh string
	VisualRoadMeshes []string
	Collider scene3d.ColliderAuthoring
	MinimapScale float64
}

func defaultBlockKartTrackSpec() BlockKartTrackSpec {
	points := primitiveTrackControlPoints()
	length := primitiveTrackLength(points)
	start := length * 0.052
	return BlockKartTrackSpec{
		Name: "primitive_block_kart",
		Centerline: points,
		Surfaces: []scene3d.TrackSurface{
			scene3d.TrackSurface{Name: "primitive_road", Kind: scene3d.TrackSurfaceRoad, Start: 0, End: 0, Friction: 1.05},
			scene3d.TrackSurface{Name: "primitive_boost_1", Kind: scene3d.TrackSurfaceBoost, Start: length * 0.12, End: length * 0.15, Left: -4.2, Right: 4.2, Priority: 4, Friction: 1.08, Boost: 1.0},
			scene3d.TrackSurface{Name: "primitive_boost_2", Kind: scene3d.TrackSurfaceBoost, Start: length * 0.58, End: length * 0.61, Left: -4.2, Right: 4.2, Priority: 4, Friction: 1.08, Boost: 1.0},
		},
		Gates: []scene3d.TrackGate{
			scene3d.TrackGate{Name: "Gate 1", Distance: start, Width: primitiveTrackWidth, Radius: 15},
			scene3d.TrackGate{Name: "Gate 2", Distance: length * 0.58, Width: primitiveTrackWidth, Radius: 15},
			scene3d.TrackGate{Name: "Gate 3", Distance: length * 0.72, Width: primitiveTrackWidth, Radius: 15},
			scene3d.TrackGate{Name: "Gate 4", Distance: length * 0.86, Width: primitiveTrackWidth, Radius: 15},
		},
		Spawns: []scene3d.TrackSpawn{scene3d.TrackSpawn{Name: "player_start", Distance: start}},
		Respawns: []scene3d.TrackRespawn{
			scene3d.TrackRespawn{Name: "respawn_start", Distance: start},
			scene3d.TrackRespawn{Name: "respawn_2", Distance: length * 0.58},
			scene3d.TrackRespawn{Name: "respawn_3", Distance: length * 0.72},
			scene3d.TrackRespawn{Name: "respawn_4", Distance: length * 0.86},
		},
		TerrainMesh: "lowpoly_terrain",
		VisualRoadMeshes: []string{"road_shoulders", "road_asphalt", "road_curbs", "road_tire_grime", "road_edge_lines", "road_center_dashes"},
		Collider: scene3d.ColliderAuthoring{Layer: voplay.CollisionLayerDefault, Mask: voplay.CollisionMaskAll, SegmentLength: primitiveTrackPhysicsSegmentLength, MinSegments: 24, GroundTag: "primitive_ground_physics", GroundY: primitiveTerrainY + 1.42, GroundHalfExtents: voplay.Vec3{X: primitiveTerrainWidth * 0.5, Y: 0.18, Z: primitiveTerrainDepth * 0.5}, GroundFriction: 0.72, GroundRestitution: 0.02, RoadTag: "primitive_road_physics", RoadYOffset: -0.08, RoadHalfHeight: 0.18, RoadOuterOffset: primitiveRoadPhysicsOuterOffset, RoadSegmentOverlap: primitiveRoadPhysicsSegmentOverlap, RoadFriction: 1.05, RoadRestitution: 0.01},
		MinimapScale: 1.0,
	}
}

func (spec BlockKartTrackSpec) TrackAsset() *scene3d.TrackAsset {
	return &scene3d.TrackAsset{Version: 1, Name: spec.Name, ClosedLoop: true, Centerline: spec.Centerline, Surfaces: spec.Surfaces, Gates: spec.Gates, Spawns: spec.Spawns, Respawns: spec.Respawns}
}
