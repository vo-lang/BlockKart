package main

import (
	"math"
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

type BlockKartHUDCoreSnapshot struct {
	scene *scene3d.Scene
	vehicle *scene3d.Vehicle
	trackResult *scene3d.TrackSpawnResult
}

type BlockKartHUDInputSnapshot struct {
	settings BlockKartSettings
}

type BlockKartHUDRaceSnapshot struct {
	raceState string
	courseTime float64
	finishTime float64
	bestTime float64
	bestTimeSet bool
	collected int
	collectibles []*Collectible
	checkpointLabel string
	nextGateLabel string
	lap int
	totalLaps int
	finished bool
}

type BlockKartHUDKartSnapshot struct {
	kartSpeed float64
	drifting bool
	driftCharge float64
	boosting bool
}

type BlockKartHUDReadModel struct {
	core BlockKartHUDCoreSnapshot
	input BlockKartHUDInputSnapshot
	race BlockKartHUDRaceSnapshot
	kart BlockKartHUDKartSnapshot
	presentation RacePresentationState
}

func blockKartHUDReadModel(w *World) BlockKartHUDReadModel {
	speed := w.kart.kartSpeed
	if w.core.vehicle != nil {
		speed = w.core.vehicle.Telemetry().Speed
	}
	return BlockKartHUDReadModel{
		core: BlockKartHUDCoreSnapshot{scene: w.core.scene, vehicle: w.core.vehicle, trackResult: w.core.trackResult},
		input: BlockKartHUDInputSnapshot{settings: w.input.settings},
		race: BlockKartHUDRaceSnapshot{raceState: w.race.raceState, courseTime: w.race.courseTime, finishTime: w.race.finishTime, bestTime: w.race.bestTime, bestTimeSet: w.race.bestTimeSet, collected: w.race.collected, collectibles: w.race.collectibles, checkpointLabel: w.race.checkpointLabel, nextGateLabel: w.race.nextGateLabel, lap: w.race.lap, totalLaps: w.race.totalLaps, finished: w.race.finished},
		kart: BlockKartHUDKartSnapshot{kartSpeed: speed, drifting: w.kart.drifting, driftCharge: w.kart.driftCharge, boosting: blockKartIsBoosting(&w.core, &w.kart)},
		presentation: w.hud.presentation,
	}
}

func (w *World) Draw(g *voplay.GameCtx, debugOverlayVisible bool) {
	w.core.scene.Draw(g.Draw)
	perf := voplay.DebugOverlayStats{}
	if debugOverlayVisible {
		perf = g.DebugOverlayStats()
	}
	perfSnapshot := voplay.PerfSnapshot{}
	perfReportBlocked := blockKartRenderStressPerfReportBlocked(diagnosticsPortsFromStates(&w.core, &w.input, &w.race, &w.kart, &w.hud))
	if debugOverlayVisible || (!perfReportBlocked && w.hud.hudPresenter.shouldPollPerfSnapshotForConsoleReport(&w.hud)) {
		perfSnapshot = g.GetPerfSnapshot()
	}
	if !perfReportBlocked && w.hud.perfAnalyzer.ShouldReport(perfSnapshot) {
		w.hud.perfAnalyzer.Report(perfSnapshot, w.hud.fixedProfiler.Stats(), g.Screen)
	}
	if w.hud.presentation.terrainCameraView > 0 {
		return
	}
	hud := w.hud.hudPresenter.hudState(blockKartHUDReadModel(w), debugOverlayVisible, perf, perfSnapshot)
	if debugOverlayVisible {
		w.hud.hudPresenter.updateDebugHUDLines(&w.hud, &hud, perfSnapshot)
	}
	w.hud.hudPresenter.Capture(hud, w.hud.debugHudLines[:w.hud.debugHudLineCount])
	drawWorldHUD(&w.input.theme, g, &hud)
	w.input.touchControls.Draw(g.Draw)
}

func (h *HUDPresenter) shouldPollPerfSnapshotForConsoleReport(hud *BlockKartRuntimeHudState) bool {
	if !blockKartPerfReports {
		return false
	}
	hud.perfSnapshotPollFrame++
	firstReportFrame := blockKartPerfWarmupFrames + blockKartPerfWindowFrames
	if hud.perfSnapshotFastPolls > 0 {
		firstReportFrame = blockKartPerfWindowFrames
	}
	if hud.perfSnapshotPollFrame < firstReportFrame {
		return false
	}
	if hud.perfSnapshotFastPolls > 0 && (hud.perfSnapshotPollFrame - firstReportFrame) % blockKartPerfWindowFrames == 0 {
		hud.perfSnapshotFastPolls--
		return true
	}
	return (hud.perfSnapshotPollFrame - firstReportFrame) % blockKartPerfSnapshotPollFrames == 0
}

func (w *World) PrepareRender(g *voplay.GameCtx) {
	if w == nil || w.core.scene == nil || g == nil || g.Draw == nil {
		return
	}
	w.core.scene.Prepare(g.Draw)
}

func (h *HUDPresenter) updateTouchControls(input *BlockKartRuntimeInputState, g *voplay.GameCtx) {
	snapshot := input.touchControls.Read(g)
	input.touchInput = snapshot.Input
	input.touchInputActive = snapshot.Active
	input.touchResetPressed = snapshot.ResetPressed
}

func (h *HUDPresenter) resetPlayer(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, presentation *RacePresentationState) {
	race.raceSession.respawnAtCheckpoint(core, race, kart, presentation)
}

func (h *HUDPresenter) hudState(model BlockKartHUDReadModel, debugOverlayVisible bool, perf voplay.DebugOverlayStats, perfSnapshot voplay.PerfSnapshot) BlockKartHUDState {
	core := model.core
	input := model.input
	race := model.race
	kart := model.kart
	runtimeHud := model.presentation
	renderDebugMode := scene3d.RenderDebugLit
	stats := scene3d.SceneRenderStats{}
	primitiveInstances := 0
	primitiveVisibleInstances := 0
	primitiveChunks := 0
	primitiveVisibleChunks := 0
	primitiveGroups := 0
	if core.scene != nil {
		diagnostics := core.scene.Diagnostics()
		renderDebugMode = diagnostics.RenderDebugMode
	}
	if debugOverlayVisible && core.scene != nil {
		diagnostics := core.scene.Diagnostics()
		stats = diagnostics.Render
		primitiveStats := diagnostics.Primitive
		primitiveInstances = primitiveStats.TotalInstances
		primitiveVisibleInstances = primitiveStats.VisibleInstances
		primitiveChunks = primitiveStats.TotalChunks
		primitiveVisibleChunks = primitiveStats.VisibleChunks
		primitiveGroups = primitiveStats.ShapeMaterialGroups
	}
	trackEntities := 0
	if debugOverlayVisible && core.trackResult != nil {
		trackEntities = len(core.trackResult.Entities)
	}
	vehicleGrounded := false
	wheelContacts := 0
	wheelCount := 0
	wheelMaxSlip := 0.0
	wheelMaxCompression := 0.0
	if debugOverlayVisible && core.vehicle != nil {
		telemetry := core.vehicle.Telemetry()
		vehicleGrounded = telemetry.Grounded
		wheelContacts = telemetry.ContactCount
		wheelCount = telemetry.WheelCount
		wheelMaxSlip = math.Abs(telemetry.MaxLongitudinalSlip)
		if math.Abs(telemetry.MaxLateralSlip) > wheelMaxSlip {
			wheelMaxSlip = math.Abs(telemetry.MaxLateralSlip)
		}
		wheelMaxCompression = telemetry.MaxSuspensionCompression
	}
	camera := runtimeHud.cameraTelemetry.Snapshot()
	hud := BlockKartHUDState{RaceState: race.raceState, Time: race.courseTime, FinishTime: race.finishTime, BestTime: race.bestTime, BestTimeSet: race.bestTimeSet, Collected: race.collected, TotalCollectibles: len(race.collectibles), Checkpoint: race.checkpointLabel, NextGate: race.nextGateLabel, Lap: race.lap, TotalLaps: race.totalLaps, Speed: math.Abs(kart.kartSpeed), Boosting: kart.boosting, Drifting: kart.drifting, DriftCharge: kart.driftCharge, Message: runtimeHud.message, MessageTimer: runtimeHud.messageTimer, Finished: race.finished, DebugOverlayVisible: debugOverlayVisible, RenderDebugMode: renderDebugMode, HeroCameraVisible: runtimeHud.heroCameraVisible, SettingsStorageStatus: input.settings.StorageStatus, PerfFPS: perf.FPS, PerfFrameMs: perf.FrameMs, PerfLogicMs: perf.LogicMs, PerfInputMs: perf.InputMs, PerfAdvanceMs: perf.AdvanceMs, PerfDrawMs: perf.DrawMs, PerfOverlayMs: perf.OverlayMs, PerfBudgetMs: perf.FrameBudgetMs, PerfMaxFrameMs: perf.MaxFrameMs, PerfMaxLogicMs: perf.MaxLogicMs, PerfDrawBytes: perf.DrawBytes, PerfSubmitBytes: perf.SubmitBytes, PerfFixedSteps: perf.FixedSteps, PerfSlowFrames: perf.SlowFrames, PerfSlowLogs: perf.SlowLogs, PerfWorkSlowFrames: perf.WorkSlowFrames, PerfWorkSlowLogs: perf.WorkSlowLogs, PerfLastSlowReason: perf.LastSlowReason, PerfLastSlowFrameMs: perf.LastSlowFrameMs, PerfLastSlowLogicMs: perf.LastSlowLogicMs, PerfLastWorkSlowReason: perf.LastWorkSlowReason, PerfLastWorkSlowFrameMs: perf.LastWorkSlowFrameMs, PerfLastWorkSlowLogicMs: perf.LastWorkSlowLogicMs, PerfWindowFrames: perf.WindowFrames, PerfWindowSlowFrames: perf.WindowSlowFrames, PerfWindowLastSlowGapFrames: perf.WindowLastSlowGapFrames, PerfWindowLastSlowGapMs: perf.WindowLastSlowGapMs, PerfWindowWorkSlowFrames: perf.WindowWorkSlowFrames, PerfWindowLastWorkSlowGapFrames: perf.WindowLastWorkSlowGapFrames, PerfWindowLastWorkSlowGapMs: perf.WindowLastWorkSlowGapMs, PerfFrameP50Ms: perf.FrameP50Ms, PerfFrameP90Ms: perf.FrameP90Ms, PerfFrameP99Ms: perf.FrameP99Ms, PerfLogicP50Ms: perf.LogicP50Ms, PerfLogicP90Ms: perf.LogicP90Ms, PerfLogicP99Ms: perf.LogicP99Ms, PerfAdvanceP90Ms: perf.AdvanceP90Ms, PerfDrawP90Ms: perf.DrawP90Ms, PerfDrawP99Ms: perf.DrawP99Ms, PerfRenderFrame: perf.RenderFrame, PerfRenderLoopMs: perf.RenderLoopMs, PerfRenderPaceWaitMs: perf.RenderPaceWaitMs, PerfRenderReplyWaitMs: perf.RenderReplyWaitMs, PerfRenderSubmitMs: perf.RenderSubmitMs, PerfRenderDisplayPulseMs: perf.RenderDisplayPulseMs, PerfRenderDrawBytes: perf.RenderDrawBytes, PerfRenderFrameDivisor: perf.RenderFrameDivisor, PerfRenderAttribution: perf.RenderAttribution, PerfRenderWindowFrames: perf.RenderWindowFrames, PerfRenderWindowSlowFrames: perf.RenderWindowSlowFrames, PerfRenderWindowLastSlowGapFrames: perf.RenderWindowLastSlowGapFrames, PerfRenderWindowLastSlowGapMs: perf.RenderWindowLastSlowGapMs, PerfRenderCadenceSlowFrames: perf.RenderCadenceSlowFrames, PerfRenderReplySlowFrames: perf.RenderReplySlowFrames, PerfRenderSubmitSlowFrames: perf.RenderSubmitSlowFrames, PerfRenderUnattributedSlowFrames: perf.RenderUnattributedSlowFrames, PerfRenderLoopP50Ms: perf.RenderLoopP50Ms, PerfRenderLoopP90Ms: perf.RenderLoopP90Ms, PerfRenderLoopP99Ms: perf.RenderLoopP99Ms, PerfRenderPaceWaitP90Ms: perf.RenderPaceWaitP90Ms, PerfRenderReplyWaitP90Ms: perf.RenderReplyWaitP90Ms, PerfRenderSubmitP90Ms: perf.RenderSubmitP90Ms, SceneActive: stats.ActiveEntities, SceneVisible: stats.VisibleEntities, SceneCulled: stats.CulledEntities, SceneModels: stats.ModelEntities, SceneUpserts: stats.UpsertedObjects, SceneDestroyed: stats.DestroyedObjects, SceneBatchEligible: stats.BatchEligibleObjects, SceneBatchGroups: stats.BatchGroups, SceneFlushMs: stats.FlushCpuMs, SceneFrameMs: stats.FrameCpuMs, TrackEntities: trackEntities, PrimitiveInstances: primitiveInstances, PrimitiveVisibleInstances: primitiveVisibleInstances, PrimitiveChunks: primitiveChunks, PrimitiveChunksVisible: primitiveVisibleChunks, PrimitiveGroups: primitiveGroups, KartGrounded: vehicleGrounded, WheelContacts: wheelContacts, WheelCount: wheelCount, KartSlipPeak: wheelMaxSlip, WheelMaxCompression: wheelMaxCompression, CameraTargetStep: camera.Step, CameraTargetStepMax: camera.StepMax, CameraTargetResidual: camera.Residual, CameraTargetResidualMax: camera.ResidualMax, CameraTargetYStep: camera.YStep, CameraTargetYStepMax: camera.YStepMax, CameraSpeedStep: camera.SpeedStep, CameraSpeedStepMax: camera.SpeedStepMax}
	if debugOverlayVisible {
		blockKartApplyPerfSnapshotToHUD(&hud, perfSnapshot)
	}
	return hud
}

func (h *HUDPresenter) updateDebugHUDLines(runtimeHud *BlockKartRuntimeHudState, state *BlockKartHUDState, perfSnapshot voplay.PerfSnapshot) {
	runtimeHud.debugHudFrame++
	if runtimeHud.debugHudLineCount == 0 || runtimeHud.debugHudFrame >= 10 {
		fixed := runtimeHud.fixedProfiler.Stats()
		runtimeHud.debugHudFrame = 0
		runtimeHud.debugHudLineCount = 18
		runtimeHud.debugHudLines[0] = "F3 perf  fps " + formatHudFloat(state.PerfFPS, 1) + "  frame " + formatHudMs(state.PerfFrameMs) + " / budget " + formatHudMs(state.PerfBudgetMs) + "  logic " + formatHudMs(state.PerfLogicMs)
		runtimeHud.debugHudLines[1] = "slow " + itoa(state.PerfSlowFrames) + " logs " + itoa(state.PerfSlowLogs) + " work " + itoa(state.PerfWorkSlowFrames) + " logs " + itoa(state.PerfWorkSlowLogs)
		runtimeHud.debugHudLines[2] = "max frame " + formatHudMs(state.PerfMaxFrameMs) + "  max logic " + formatHudMs(state.PerfMaxLogicMs) + "  fixed steps " + itoa(state.PerfFixedSteps) + "  bytes " + formatHudBytes(state.PerfDrawBytes)
		runtimeHud.debugHudLines[3] = "BK fixed last/peak " + formatHudMs(fixed.TotalMs) + "/" + formatHudMs(fixed.PeakTotalMs) + "  slow " + itoa(fixed.WindowSlowFrames) + "/" + itoa(fixed.WindowFrames) + "  worst " + fixed.SlowestPhase + ":" + formatHudMs(fixed.SlowestPhaseMs)
		runtimeHud.debugHudLines[4] = "BK phase touch/game/drive/assist/phys/audio " + formatHudMs(fixed.TouchMs) + "/" + formatHudMs(fixed.GameplayMs) + "/" + formatHudMs(fixed.DriveMs) + "/" + formatHudMs(fixed.AssistMs) + "/" + formatHudMs(fixed.PhysicsMs) + "/" + formatHudMs(fixed.AudioMs) + " slept " + boolHud(fixed.Slept)
		runtimeHud.debugHudLines[5] = "engine phase input/advance/draw/overlay " + formatHudMs(state.PerfInputMs) + "/" + formatHudMs(state.PerfAdvanceMs) + "/" + formatHudMs(state.PerfDrawMs) + "/" + formatHudMs(state.PerfOverlayMs)
		if perfSnapshot.Enabled {
			window := blockKartPerfReportingWindow(perfSnapshot)
			current := perfSnapshot.Current
			workload := current.RendererWorkload
			gpu := current.GpuQueue
			runtimeHud.debugHudLines[6] = "perf frame p50/90/99/max " + formatHudMs(window.FrameP50Ms) + "/" + formatHudMs(window.FrameP90Ms) + "/" + formatHudMs(window.FrameP99Ms) + "/" + formatHudMs(window.FrameMaxMs) + "  slow " + itoa(window.SlowFrames) + "/" + itoa(window.Frames)
			runtimeHud.debugHudLines[7] = "perf p90 game/draw/render/gpu/hud " + formatHudMs(window.GameCpuP90Ms) + "/" + formatHudMs(window.DrawEncodeP90Ms) + "/" + formatHudMs(window.RenderSubmitP90Ms) + "/" + formatHudMs(window.GpuWorkDoneP90Ms) + "/" + formatHudMs(window.HudP90Ms)
			runtimeHud.debugHudLines[8] = "perf cause " + current.Classification.PrimaryCause + "  secondary " + current.Classification.SecondaryCause + "  queue " + gpu.QueueDepthClass
			runtimeHud.debugHudLines[9] = "gpu now work/inflight/probe " + formatHudMs(gpu.SubmittedWorkDoneMs) + "/" + itoa(gpu.InFlightSubmits) + "/" + formatHudMs(gpu.ProbeOverheadMs) + "  submit " + formatHudMs(current.RendererCpu.QueueSubmitCpuMs)
			runtimeHud.debugHudLines[10] = "work draws model/prim/sprite/text/batch " + itoa(workload.ModelDraws) + "/" + itoa(workload.PrimitiveDraws) + "/" + itoa(workload.SpriteDraws) + "/" + itoa(workload.TextDraws) + "/" + itoa(workload.InstancedBatches)
			runtimeHud.debugHudLines[11] = "work inst/tri/upload/chunks " + itoa(workload.Instances) + "/" + itoa(workload.Triangles) + "/" + formatHudBytes(workload.UploadBytes) + "/" + itoa(workload.PrimitiveChunks) + " churn " + itoa(workload.BufferCreates) + "/" + itoa(workload.BindGroupCreates) + "/" + itoa(workload.TextureUploads)
		} else {
			runtimeHud.debugHudLines[6] = "240f frame p50/90/99 " + formatHudMs(state.PerfFrameP50Ms) + "/" + formatHudMs(state.PerfFrameP90Ms) + "/" + formatHudMs(state.PerfFrameP99Ms) + "  slow " + itoa(state.PerfWindowSlowFrames) + "/" + itoa(state.PerfWindowFrames) + " gap " + itoa(state.PerfWindowLastSlowGapFrames) + "/" + formatHudMs(state.PerfWindowLastSlowGapMs)
			runtimeHud.debugHudLines[7] = "240f logic p50/90/99 " + formatHudMs(state.PerfLogicP50Ms) + "/" + formatHudMs(state.PerfLogicP90Ms) + "/" + formatHudMs(state.PerfLogicP99Ms) + "  work " + itoa(state.PerfWindowWorkSlowFrames) + " gap " + itoa(state.PerfWindowLastWorkSlowGapFrames) + "/" + formatHudMs(state.PerfWindowLastWorkSlowGapMs)
			runtimeHud.debugHudLines[8] = "240f advance/draw p90/99 " + formatHudMs(state.PerfAdvanceP90Ms) + "/" + formatHudMs(state.PerfDrawP90Ms) + "/" + formatHudMs(state.PerfDrawP99Ms)
			runtimeHud.debugHudLines[9] = "render now loop/pace/reply/submit " + formatHudMs(state.PerfRenderLoopMs) + "/" + formatHudMs(state.PerfRenderPaceWaitMs) + "/" + formatHudMs(state.PerfRenderReplyWaitMs) + "/" + formatHudMs(state.PerfRenderSubmitMs) + "  attr " + state.PerfRenderAttribution + "  bytes " + formatHudBytes(state.PerfRenderDrawBytes)
			runtimeHud.debugHudLines[10] = "render 240f loop p50/90/99 " + formatHudMs(state.PerfRenderLoopP50Ms) + "/" + formatHudMs(state.PerfRenderLoopP90Ms) + "/" + formatHudMs(state.PerfRenderLoopP99Ms) + "  pulse " + formatHudMs(state.PerfRenderDisplayPulseMs) + " x" + itoa(state.PerfRenderFrameDivisor)
			runtimeHud.debugHudLines[11] = "render p90 pace/reply/submit " + formatHudMs(state.PerfRenderPaceWaitP90Ms) + "/" + formatHudMs(state.PerfRenderReplyWaitP90Ms) + "/" + formatHudMs(state.PerfRenderSubmitP90Ms) + "  slow " + itoa(state.PerfRenderWindowSlowFrames) + "/" + itoa(state.PerfRenderWindowFrames) + " gap " + itoa(state.PerfRenderWindowLastSlowGapFrames) + "/" + formatHudMs(state.PerfRenderWindowLastSlowGapMs) + " c/r/s/u " + itoa(state.PerfRenderCadenceSlowFrames) + "/" + itoa(state.PerfRenderReplySlowFrames) + "/" + itoa(state.PerfRenderSubmitSlowFrames) + "/" + itoa(state.PerfRenderUnattributedSlowFrames)
		}
		runtimeHud.debugHudLines[12] = "scene active/visible/culled/model " + itoa(state.SceneActive) + "/" + itoa(state.SceneVisible) + "/" + itoa(state.SceneCulled) + "/" + itoa(state.SceneModels)
		runtimeHud.debugHudLines[13] = "scene upsert/destroy/batch/groups " + itoa(state.SceneUpserts) + "/" + itoa(state.SceneDestroyed) + "/" + itoa(state.SceneBatchEligible) + "/" + itoa(state.SceneBatchGroups)
		runtimeHud.debugHudLines[14] = "scene cpu flush " + formatHudMs(state.SceneFlushMs) + "  frame " + formatHudMs(state.SceneFrameMs) + "  track ents " + itoa(state.TrackEntities)
		runtimeHud.debugHudLines[15] = "primitive inst visible/total " + itoa(state.PrimitiveVisibleInstances) + "/" + itoa(state.PrimitiveInstances) + "  chunks " + itoa(state.PrimitiveChunksVisible) + "/" + itoa(state.PrimitiveChunks)
		runtimeHud.debugHudLines[16] = "primitive groups " + itoa(state.PrimitiveGroups)
		runtimeHud.debugHudLines[17] = "vehicle grounded " + boolHud(state.KartGrounded) + "  wheels " + itoa(state.WheelContacts) + "/" + itoa(state.WheelCount) + "  slip " + formatHudFloat(state.KartSlipPeak, 2) + "  comp " + formatHudFloat(state.WheelMaxCompression, 2)
	}
	state.DebugLines = runtimeHud.debugHudLines
	state.DebugLineCount = runtimeHud.debugHudLineCount
}

func (h *HUDPresenter) isBoosting(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState) bool {
	return blockKartIsBoosting(core, kart)
}

func blockKartIsBoosting(core *BlockKartRuntimeCore, kart *BlockKartRuntimeKartState) bool {
	if kart.boostTimer > 0 {
		return true
	}
	return core.kartController != nil && core.kartController.BoostTimer > 0
}
