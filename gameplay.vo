package main

import (
	"math"
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

const (
	collectibleRadius = 3.35
	collectibleRadiusSq = collectibleRadius * collectibleRadius
	checkpointRadius = 14.0
)

type Collectible struct {
	Core *scene3d.Entity
	Glow *scene3d.Entity
	CorePrimitive *PrimitivePart
	GlowPrimitive *PrimitivePart
	Position voplay.Vec3
	Collected bool
}

type Checkpoint struct {
	Position voplay.Vec3
	Respawn voplay.Vec3
	Yaw float64
	Label string
	Radius float64
	RadiusSq float64
	Reached bool
}

type BoostPad struct {
	Position voplay.Vec3
	Radius float64
	RadiusSq float64
}

type MovingObstacle struct {
	Entity *scene3d.Entity
	Visual *PrimitivePart
	Origin voplay.Vec3
	Axis voplay.Vec3
	Amplitude float64
	Speed float64
	Phase float64
}

func (r *RaceSession) addCollectible(w *BlockKartRuntimePorts, position voplay.Vec3, tag string) {
	primitive := w.core.trackRuntime.ensurePrimitiveScene(w)
	core := scene3d.ProductBlockKartDynamic(primitive, primitive.RoundedBox, primitive.OrbMat, position, voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, 0.78), voplay.Vec3{X: 1.15, Y: 1.15, Z: 1.15}, w.input.theme.OrbColor)
	glow := scene3d.ProductBlockKartDynamic(primitive, primitive.Sphere, primitive.GlowMat, position.Add(voplay.Vec3{Y: -0.12}), voplay.QuatIdentity(), voplay.Vec3{X: 1.55, Y: 0.3, Z: 1.55}, w.input.theme.GoalTrimColor)
	w.race.collectibles = append(w.race.collectibles, &Collectible{CorePrimitive: core, GlowPrimitive: glow, Position: position})
}

func (r *RaceSession) addCollectibleLine(w *BlockKartRuntimePorts, start, end voplay.Vec3, count int, tag string) {
	if count <= 1 {
		w.race.raceSession.addCollectible(w, start, tag + "_0")
		return
	}
	for i := 0; i < count; i++ {
		t := float64(i) / float64(count - 1)
		w.race.raceSession.addCollectible(w, start.Lerp(end, t), tag + "_" + itoa(i))
	}
}

func (r *RaceSession) addCheckpoint(w *BlockKartRuntimePorts, position, respawn voplay.Vec3, yaw float64, label string) {
	w.race.checkpoints = append(w.race.checkpoints, newCheckpoint(position, respawn, yaw, label, checkpointRadius))
}

func (r *RaceSession) addBoostPad(w *BlockKartRuntimePorts, position voplay.Vec3, radius float64) {
	w.race.boostPads = append(w.race.boostPads, newBoostPad(position, radius))
}

func newCheckpoint(position, respawn voplay.Vec3, yaw float64, label string, radius float64) *Checkpoint {
	return &Checkpoint{Position: position, Respawn: respawn, Yaw: yaw, Label: label, Radius: radius, RadiusSq: radius * radius}
}

func newBoostPad(position voplay.Vec3, radius float64) *BoostPad {
	return &BoostPad{Position: position, Radius: radius, RadiusSq: radius * radius}
}

func (r *RaceSession) addMovingObstacle(w *BlockKartRuntimePorts, position, scale, axis voplay.Vec3, amplitude, speed, phase float64, tag string) {
	entity := w.core.scene.Spawn(scene3d.EntityDesc{Position: position, Rotation: voplay.QuatIdentity(), Scale: voplay.Vec3{X: 1, Y: 1, Z: 1}, Tag: tag + "_physics", Physics: boxPhysics(scale), PickMode: scene3d.PickDisabled})
	entity.Visible = false
	primitive := w.core.trackRuntime.ensurePrimitiveScene(w)
	visual := scene3d.ProductBlockKartDynamic(primitive, primitive.RoundedBox, primitive.HazardMat, position, voplay.QuatIdentity(), scale, w.input.theme.HazardColor)
	w.race.obstacles = append(w.race.obstacles, &MovingObstacle{Entity: entity, Visual: visual, Origin: position, Axis: axis.Normalize(), Amplitude: amplitude, Speed: speed, Phase: phase})
}

func (r *RaceSession) updateGameplay(w *BlockKartRuntimePorts, g *voplay.GameCtx, dt float64) {
	w.hud.messageTimer = maxFloat(0, w.hud.messageTimer - dt)
	w.kart.boostTimer = maxFloat(0, w.kart.boostTimer - dt)
	if w.race.raceState != BlockKartRaceStateRunning {
		return
	}
	if w.race.finished {
		return
	}
	w.race.courseTime += dt
	w.race.raceSession.updateMovingObstacles(w)
	w.race.raceSession.updateCollectibles(w)
	w.race.raceSession.updateBoostPads(w)
	w.race.raceSession.updateRaceProgress(w, g)
}

func (r *RaceSession) updateMovingObstacles(w *BlockKartRuntimePorts) {
	for _, obstacle := range w.race.obstacles {
		if obstacle == nil || obstacle.Entity == nil {
			continue
		}
		offset := math.Sin(w.race.courseTime * obstacle.Speed + obstacle.Phase) * obstacle.Amplitude
		position := obstacle.Origin.Add(obstacle.Axis.Scale(offset))
		scene3d.MoveEntityPhysicsTarget(obstacle.Entity, position, "blockkart_moving_obstacle_position")
		if obstacle.Visual != nil {
			obstacle.Visual.SetPose(position, voplay.QuatIdentity())
		}
	}
}

func (r *RaceSession) updateCollectibles(w *BlockKartRuntimePorts) {
	if w.core.player == nil {
		return
	}
	playerPos := w.core.player.Position()
	for _, item := range w.race.collectibles {
		if item == nil || item.Collected {
			continue
		}
		if distanceSqVec3(playerPos, item.Position) > collectibleRadiusSq {
			continue
		}
		item.Collected = true
		w.race.collected++
		w.kart.kartRig.activateBoost(w, kartItemBoostDuration)
		w.hud.message = "Item boost!"
		w.hud.messageTimer = 1.1
		hideEntity(item.Core)
		hideEntity(item.Glow)
		hidePrimitivePart(item.CorePrimitive)
		hidePrimitivePart(item.GlowPrimitive)
	}
}

func (r *RaceSession) updateBoostPads(w *BlockKartRuntimePorts) {
	if w.core.player == nil {
		return
	}
	playerPos := w.core.player.Position()
	for _, pad := range w.race.boostPads {
		if pad == nil {
			continue
		}
		if distanceSqVec3(playerPos, pad.Position) > pad.RadiusSq {
			continue
		}
		if w.kart.boostTimer < 0.25 {
			w.hud.message = "Boost pad!"
			w.hud.messageTimer = 0.8
		}
		w.kart.kartRig.activateBoost(w, kartBoostPadDuration)
	}
}

func (r *RaceSession) updateRaceProgress(w *BlockKartRuntimePorts, g *voplay.GameCtx) {
	if w.race.finished || w.core.player == nil || len(w.race.checkpoints) == 0 {
		return
	}
	if w.race.nextCheckpoint < 0 || w.race.nextCheckpoint >= len(w.race.checkpoints) {
		w.race.nextCheckpoint = 0
	}
	checkpoint := w.race.checkpoints[w.race.nextCheckpoint]
	if checkpoint == nil {
		return
	}
	playerPos := w.core.player.Position()
	if distanceSqVec3(playerPos, checkpoint.Position) > checkpoint.RadiusSq {
		return
	}
	checkpoint.Reached = true
	w.race.checkpointPosition = checkpoint.Respawn
	w.race.checkpointYaw = checkpoint.Yaw
	w.race.checkpointLabel = checkpoint.Label
	if w.race.nextCheckpoint == len(w.race.checkpoints) - 1 {
		if w.race.lap >= w.race.totalLaps {
			w.race.raceSession.completeRace(w, g)
			return
		}
		w.race.lap++
		w.race.nextCheckpoint = 0
		w.race.raceSession.refreshNextGateLabel(w)
		for _, gate := range w.race.checkpoints {
			if gate != nil {
				gate.Reached = false
			}
		}
		w.hud.message = "Lap " + itoa(w.race.lap) + "/" + itoa(w.race.totalLaps)
		w.hud.messageTimer = 1.3
		return
	}
	w.race.nextCheckpoint++
	w.race.raceSession.refreshNextGateLabel(w)
}

func (r *RaceSession) completeRace(w *BlockKartRuntimePorts, g *voplay.GameCtx) {
	w.race.finished = true
	w.race.raceState = BlockKartRaceStateFinished
	w.race.finishTime = w.race.courseTime
	if w.race.finishTime > 0 && (!w.race.bestTimeSet || w.race.finishTime < w.race.bestTime) {
		w.race.bestTime = w.race.finishTime
		w.race.bestTimeSet = true
	}
	w.race.nextGateLabel = "Done"
	w.hud.message = "Race complete!"
	w.hud.messageTimer = 99
	w.kart.kartRig.stopKartForFinish(w)
	w.race.raceSession.reportRaceResultOnce(w, g)
}

func (r *RaceSession) refreshNextGateLabel(w *BlockKartRuntimePorts) {
	if len(w.race.checkpoints) == 0 {
		w.race.nextGateLabel = "Start"
		return
	}
	if w.race.nextCheckpoint < 0 || w.race.nextCheckpoint >= len(w.race.checkpoints) {
		w.race.nextCheckpoint = 0
	}
	checkpoint := w.race.checkpoints[w.race.nextCheckpoint]
	if checkpoint == nil {
		w.race.nextGateLabel = "Gate"
		return
	}
	w.race.nextGateLabel = checkpoint.Label
}

func (r *RaceSession) respawnAtCheckpoint(w *BlockKartRuntimePorts) {
	w.kart.kartRig.setKartPose(w, w.race.checkpointPosition, w.race.checkpointYaw)
	w.race.raceSession.updateRacingCamera(w, 0, false)
	w.hud.message = "Back to " + w.race.checkpointLabel
	w.hud.messageTimer = 1.2
}

func (r *RaceSession) restartRun(w *BlockKartRuntimePorts) {
	w.race.raceState = BlockKartRaceStateReady
	w.race.raceResultReported = false
	w.race.courseTime = 0
	w.race.finishTime = 0
	w.race.finished = false
	w.race.collected = 0
	w.race.lap = 1
	if w.race.totalLaps <= 0 {
		w.race.totalLaps = raceLapCount
	}
	w.race.nextCheckpoint = 0
	w.kart.kartSpeed = 0
	w.kart.kartYaw = w.race.startYaw
	if w.core.vehicle != nil {
		scene3d.ResetVehicleMotionState(w.core.vehicle)
	}
	w.kart.boostTimer = 0
	w.kart.driftCharge = 0
	w.kart.drifting = false
	w.race.checkpointPosition = w.race.startPosition
	w.race.checkpointYaw = w.race.startYaw
	w.race.checkpointLabel = "Start"
	w.race.raceSession.refreshNextGateLabel(w)
	for _, checkpoint := range w.race.checkpoints {
		if checkpoint != nil {
			checkpoint.Reached = false
		}
	}
	for _, item := range w.race.collectibles {
		if item == nil {
			continue
		}
		item.Collected = false
		showEntity(item.Core)
		showEntity(item.Glow)
		showPrimitivePart(item.CorePrimitive)
		showPrimitivePart(item.GlowPrimitive)
	}
	w.race.raceSession.respawnAtCheckpoint(w)
	w.hud.message = "Press W / Space / Enter"
	w.hud.messageTimer = 99
}

func hideEntity(e *scene3d.Entity) {
	if e != nil {
		e.Visible = false
	}
}

func showEntity(e *scene3d.Entity) {
	if e != nil {
		e.Visible = true
	}
}

func distanceSqVec3(a, b voplay.Vec3) float64 {
	dx := a.X - b.X
	dy := a.Y - b.Y
	dz := a.Z - b.Z
	return dx * dx + dy * dy + dz * dz
}

func maxFloat(a, b float64) float64 {
	if a > b {
		return a
	}
	return b
}

func itoa(value int) string {
	digits := "0123456789"
	if value == 0 {
		return "0"
	}
	out := ""
	n := value
	for n > 0 {
		d := n % 10
		out = digits[d:d + 1] + out
		n = n / 10
	}
	return out
}
