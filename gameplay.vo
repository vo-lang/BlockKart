package main

import (
	"math"
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

const (
	collectibleRadius = 3.35
	collectibleRadiusSq = collectibleRadius * collectibleRadius
	checkpointRadius = 14.0
)

type Collectible struct {
	Core *scene3d.Entity
	Glow *scene3d.Entity
	CorePrimitive *PrimitivePart
	GlowPrimitive *PrimitivePart
	Position voplay.Vec3
	Collected bool
}

type Checkpoint struct {
	Position voplay.Vec3
	Respawn voplay.Vec3
	Yaw float64
	Label string
	Radius float64
	RadiusSq float64
	Reached bool
}

type BoostPad struct {
	Position voplay.Vec3
	Radius float64
	RadiusSq float64
}

type MovingObstacle struct {
	Entity *scene3d.Entity
	Visual *PrimitivePart
	Origin voplay.Vec3
	Axis voplay.Vec3
	Amplitude float64
	Speed float64
	Phase float64
}

func (r *RaceSession) addCollectible(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, theme WorldTheme, position voplay.Vec3, tag string) {
	primitive := core.trackRuntime.ensurePrimitiveScene(core)
	collectibleCore := addPrimitiveDynamic(primitive, primitive.RoundedBox, primitive.OrbMat, position, voplay.QuatFromAxisAngle(voplay.Vec3{Y: 1}, 0.78), voplay.Vec3{X: 1.15, Y: 1.15, Z: 1.15}, theme.OrbColor)
	glow := addPrimitiveDynamic(primitive, primitive.Sphere, primitive.GlowMat, position.Add(voplay.Vec3{Y: -0.12}), voplay.QuatIdentity(), voplay.Vec3{X: 1.55, Y: 0.3, Z: 1.55}, theme.GoalTrimColor)
	race.collectibles = append(race.collectibles, &Collectible{CorePrimitive: collectibleCore, GlowPrimitive: glow, Position: position})
}

func (r *RaceSession) addCollectibleLine(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, theme WorldTheme, start, end voplay.Vec3, count int, tag string) {
	if count <= 1 {
		race.raceSession.addCollectible(core, race, theme, start, tag + "_0")
		return
	}
	for i := 0; i < count; i++ {
		t := float64(i) / float64(count - 1)
		race.raceSession.addCollectible(core, race, theme, start.Lerp(end, t), tag + "_" + itoa(i))
	}
}

func (r *RaceSession) addCheckpoint(race *BlockKartRuntimeRaceState, position, respawn voplay.Vec3, yaw float64, label string) {
	race.checkpoints = append(race.checkpoints, newCheckpoint(position, respawn, yaw, label, checkpointRadius))
}

func (r *RaceSession) addBoostPad(race *BlockKartRuntimeRaceState, position voplay.Vec3, radius float64) {
	race.boostPads = append(race.boostPads, newBoostPad(position, radius))
}

func newCheckpoint(position, respawn voplay.Vec3, yaw float64, label string, radius float64) *Checkpoint {
	return &Checkpoint{Position: position, Respawn: respawn, Yaw: yaw, Label: label, Radius: radius, RadiusSq: radius * radius}
}

func newBoostPad(position voplay.Vec3, radius float64) *BoostPad {
	return &BoostPad{Position: position, Radius: radius, RadiusSq: radius * radius}
}

func (r *RaceSession) addMovingObstacle(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, theme WorldTheme, position, scale, axis voplay.Vec3, amplitude, speed, phase float64, tag string) {
	entity := core.scene.Spawn(scene3d.EntityDesc{Position: position, Rotation: voplay.QuatIdentity(), Scale: voplay.Vec3{X: 1, Y: 1, Z: 1}, Tag: tag + "_physics", Physics: boxPhysics(scale), PickMode: scene3d.PickDisabled})
	entity.Visible = false
	primitive := core.trackRuntime.ensurePrimitiveScene(core)
	visual := addPrimitiveDynamic(primitive, primitive.RoundedBox, primitive.HazardMat, position, voplay.QuatIdentity(), scale, theme.HazardColor)
	race.obstacles = append(race.obstacles, &MovingObstacle{Entity: entity, Visual: visual, Origin: position, Axis: axis.Normalize(), Amplitude: amplitude, Speed: speed, Phase: phase})
}

func (r *RaceSession) updateGameplay(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, presentation *RacePresentationState, dt float64) {
	presentation.messageTimer = maxFloat(0, presentation.messageTimer - dt)
	kart.boostTimer = maxFloat(0, kart.boostTimer - dt)
	if race.raceState != BlockKartRaceStateRunning {
		return
	}
	if race.finished {
		return
	}
	race.courseTime += dt
	race.raceSession.updateMovingObstacles(race)
	race.raceSession.updateCollectibles(core, race, kart, presentation)
	race.raceSession.updateBoostPads(core, race, kart, presentation)
	race.raceSession.updateRaceProgress(core, race, kart, presentation)
}

func (r *RaceSession) updateMovingObstacles(race *BlockKartRuntimeRaceState) {
	for _, obstacle := range race.obstacles {
		if obstacle == nil || obstacle.Entity == nil {
			continue
		}
		offset := math.Sin(race.courseTime * obstacle.Speed + obstacle.Phase) * obstacle.Amplitude
		position := obstacle.Origin.Add(obstacle.Axis.Scale(offset))
		scene3d.MoveEntityPhysicsTarget(obstacle.Entity, position, "blockkart_moving_obstacle_position")
		if obstacle.Visual != nil {
			obstacle.Visual.SetPose(position, voplay.QuatIdentity())
		}
	}
}

func (r *RaceSession) updateCollectibles(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, presentation *RacePresentationState) {
	if core.player == nil {
		return
	}
	playerPos := core.player.Position()
	for _, item := range race.collectibles {
		if item == nil || item.Collected {
			continue
		}
		if distanceSqVec3(playerPos, item.Position) > collectibleRadiusSq {
			continue
		}
		item.Collected = true
		race.collected++
		kart.kartRig.activateBoost(core, kart, kartItemBoostDuration)
		presentation.message = "Item boost!"
		presentation.messageTimer = 1.1
		hideEntity(item.Core)
		hideEntity(item.Glow)
		hidePrimitivePart(item.CorePrimitive)
		hidePrimitivePart(item.GlowPrimitive)
	}
}

func (r *RaceSession) updateBoostPads(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, presentation *RacePresentationState) {
	if core.player == nil {
		return
	}
	playerPos := core.player.Position()
	for _, pad := range race.boostPads {
		if pad == nil {
			continue
		}
		if distanceSqVec3(playerPos, pad.Position) > pad.RadiusSq {
			continue
		}
		if kart.boostTimer < 0.25 {
			presentation.message = "Boost pad!"
			presentation.messageTimer = 0.8
		}
		kart.kartRig.activateBoost(core, kart, kartBoostPadDuration)
	}
}

func (r *RaceSession) updateRaceProgress(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, presentation *RacePresentationState) {
	if race.finished || core.player == nil || len(race.checkpoints) == 0 {
		return
	}
	if race.nextCheckpoint < 0 || race.nextCheckpoint >= len(race.checkpoints) {
		race.nextCheckpoint = 0
	}
	checkpoint := race.checkpoints[race.nextCheckpoint]
	if checkpoint == nil {
		return
	}
	playerPos := core.player.Position()
	if distanceSqVec3(playerPos, checkpoint.Position) > checkpoint.RadiusSq {
		return
	}
	checkpoint.Reached = true
	race.checkpointPosition = checkpoint.Respawn
	race.checkpointYaw = checkpoint.Yaw
	race.checkpointLabel = checkpoint.Label
	if race.nextCheckpoint == len(race.checkpoints) - 1 {
		if race.lap >= race.totalLaps {
			race.raceSession.completeRace(core, race, kart, presentation)
			return
		}
		race.lap++
		race.nextCheckpoint = 0
		race.raceSession.refreshNextGateLabel(race)
		for _, gate := range race.checkpoints {
			if gate != nil {
				gate.Reached = false
			}
		}
		presentation.message = "Lap " + itoa(race.lap) + "/" + itoa(race.totalLaps)
		presentation.messageTimer = 1.3
		return
	}
	race.nextCheckpoint++
	race.raceSession.refreshNextGateLabel(race)
}

func (r *RaceSession) completeRace(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, presentation *RacePresentationState) {
	race.finished = true
	race.raceState = BlockKartRaceStateFinished
	race.finishTime = race.courseTime
	if race.finishTime > 0 && (!race.bestTimeSet || race.finishTime < race.bestTime) {
		race.bestTime = race.finishTime
		race.bestTimeSet = true
	}
	race.nextGateLabel = "Done"
	presentation.message = "Race complete!"
	presentation.messageTimer = 99
	kart.kartRig.stopKartForFinish(core, race, kart)
}

func (r *RaceSession) refreshNextGateLabel(race *BlockKartRuntimeRaceState) {
	if len(race.checkpoints) == 0 {
		race.nextGateLabel = "Start"
		return
	}
	if race.nextCheckpoint < 0 || race.nextCheckpoint >= len(race.checkpoints) {
		race.nextCheckpoint = 0
	}
	checkpoint := race.checkpoints[race.nextCheckpoint]
	if checkpoint == nil {
		race.nextGateLabel = "Gate"
		return
	}
	race.nextGateLabel = checkpoint.Label
}

func (r *RaceSession) respawnAtCheckpoint(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, presentation *RacePresentationState) {
	kart.kartRig.setKartPose(core, race, kart, presentation, race.checkpointPosition, race.checkpointYaw)
	race.raceSession.updateRacingCamera(core, race, kart, presentation, 0, false)
	presentation.message = "Back to " + race.checkpointLabel
	presentation.messageTimer = 1.2
}

func (r *RaceSession) restartRun(core *BlockKartRuntimeCore, race *BlockKartRuntimeRaceState, kart *BlockKartRuntimeKartState, presentation *RacePresentationState) {
	race.raceState = BlockKartRaceStateReady
	race.raceResultReported = false
	race.courseTime = 0
	race.finishTime = 0
	race.finished = false
	race.collected = 0
	race.lap = 1
	if race.totalLaps <= 0 {
		race.totalLaps = raceLapCount
	}
	race.nextCheckpoint = 0
	kart.kartSpeed = 0
	kart.kartYaw = race.startYaw
	if core.vehicle != nil {
		scene3d.ResetVehicleMotionState(core.vehicle)
	}
	kart.boostTimer = 0
	kart.driftCharge = 0
	kart.drifting = false
	race.checkpointPosition = race.startPosition
	race.checkpointYaw = race.startYaw
	race.checkpointLabel = "Start"
	race.raceSession.refreshNextGateLabel(race)
	for _, checkpoint := range race.checkpoints {
		if checkpoint != nil {
			checkpoint.Reached = false
		}
	}
	for _, item := range race.collectibles {
		if item == nil {
			continue
		}
		item.Collected = false
		showEntity(item.Core)
		showEntity(item.Glow)
		showPrimitivePart(item.CorePrimitive)
		showPrimitivePart(item.GlowPrimitive)
	}
	race.raceSession.respawnAtCheckpoint(core, race, kart, presentation)
	presentation.message = "Press W / Space / Enter"
	presentation.messageTimer = 99
}

func hideEntity(e *scene3d.Entity) {
	if e != nil {
		e.Visible = false
	}
}

func showEntity(e *scene3d.Entity) {
	if e != nil {
		e.Visible = true
	}
}

func distanceSqVec3(a, b voplay.Vec3) float64 {
	dx := a.X - b.X
	dy := a.Y - b.Y
	dz := a.Z - b.Z
	return dx * dx + dy * dy + dz * dz
}

func maxFloat(a, b float64) float64 {
	if a > b {
		return a
	}
	return b
}

func itoa(value int) string {
	digits := "0123456789"
	if value == 0 {
		return "0"
	}
	out := ""
	n := value
	for n > 0 {
		d := n % 10
		out = digits[d:d + 1] + out
		n = n / 10
	}
	return out
}
