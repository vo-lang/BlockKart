package main

import (
	"math"
)

const (
	blockKartVehicleMassKg float64 = 285.0
	blockKartVehicleYawInertiaKgM2 float64 = 355.0
	blockKartVehicleFrontAxleMeters float64 = 1.08
	blockKartVehicleRearAxleMeters float64 = 1.22
	blockKartVehicleWheelbaseMeters float64 = 2.30
	blockKartVehicleCgHeightMeters float64 = 0.43
	blockKartVehicleFrontCorneringStiffness float64 = 39000.0
	blockKartVehicleRearCorneringStiffness float64 = 42500.0
	blockKartVehicleWheelRadiusMilli float64 = 480.0
	blockKartVehicleGravity float64 = 9.81
)

// BlockKartVehicleLateralState is one solved planar rigid-body state. Grip
// driving and drifting produce states through separate tyre regimes and the
// transition blends their physical outputs rather than stacking controllers.
type BlockKartVehicleLateralState struct {
	Lateral_speed_meters_per_second float64
	Yaw_rate_radians_per_second float64
	Front_slip_radians float64
	Rear_slip_radians float64
	Front_force_newtons float64
	Rear_force_newtons float64
}

func (vehicle *BlockKartVehicleController) stepDynamics(road BlockKartRoadSample, steerTarget float64, throttle float64, brake float64, boosting bool, miniTurbo bool, drifting bool, driftDirection int32, deltaSeconds float64) {
	vehicle.stepSteering(steerTarget, road.Surface, deltaSeconds)
	vehicle.stepDriftBlend(drifting, deltaSeconds)
	u := vehicle.Forward_speed / 1000.0
	v := vehicle.Lateral_speed / 1000.0
	r := vehicle.Yaw_rate
	longitudinalForce := vehicle.longitudinalForce(u, throttle, brake, boosting, miniTurbo, road)
	estimatedAcceleration := longitudinalForce / blockKartVehicleMassKg
	frontLoad, rearLoad := blockKartVehicleAxleLoads(estimatedAcceleration)
	frontDriveForce := 0.0
	rearDriveForce := longitudinalForce
	if brake > 0 && u > 0.5 {
		frontDriveForce = longitudinalForce * 0.58
		rearDriveForce = longitudinalForce * 0.42
	}
	// Integrate the longitudinal component of the single rigid body. The
	// lateral regimes below solve v and yaw together from this updated speed.
	du := (frontDriveForce + rearDriveForce) / blockKartVehicleMassKg + v * r
	u += du * deltaSeconds
	maximumSpeed := blockKartVehicleNormalMaximumSpeed / 1000.0
	if boosting {
		maximumSpeed = blockKartVehicleBoostMaximumSpeed / 1000.0
	}
	if road.Surface == blockKartRoadSurfaceGrass {
		maximumSpeed = blockKartVehicleOffRoadMaximumSpeed / 1000.0
	}
	u = blockKartVehicleClamp(u, -blockKartVehicleReverseMaximumSpeed / 1000.0, maximumSpeed)
	grip := blockKartVehicleGripLateralStep(
		u, v, r, vehicle.Wheel_angle_radians,
		frontDriveForce, rearDriveForce, frontLoad, rearLoad,
		road.Friction, deltaSeconds,
	)
	assist := vehicle.computeAssists(u, v, r, road, throttle, brake, drifting, driftDirection)
	drift := grip
	physicalDriftBlend := vehicle.Drift_blend * blockKartVehicleSmoothstep(4.0, 8.0, math.Abs(u))
	if physicalDriftBlend > 0 {
		delta := blockKartVehicleClamp(vehicle.Wheel_angle_radians+assist.Countersteer_radians, -0.52, 0.52)
		speedForSlip := math.Max(math.Abs(u), 4.0)
		frontSlip := math.Atan2(v+blockKartVehicleFrontAxleMeters*r, speedForSlip) - delta
		rearSlip := math.Atan2(v-blockKartVehicleRearAxleMeters*r, speedForSlip)
		frontMu := road.Friction
		rearMu := road.Friction * assist.Rear_friction_scale
		frontLateral := blockKartFialaLateralForce(
			frontSlip, blockKartVehicleFrontCorneringStiffness, frontMu, frontLoad,
		)
		rearLateral := blockKartFialaLateralForce(
			rearSlip, blockKartVehicleRearCorneringStiffness, rearMu, rearLoad,
		)
		frontLateral = blockKartCombinedSlipLateral(frontLateral, frontDriveForce, frontMu*frontLoad)
		rearLateral = blockKartCombinedSlipLateral(rearLateral, rearDriveForce, rearMu*rearLoad)
		totalLateral := frontLateral + rearLateral + assist.Lateral_force_newtons
		drift.Lateral_speed_meters_per_second = v +
			(totalLateral/blockKartVehicleMassKg-u*r)*deltaSeconds
		drift.Yaw_rate_radians_per_second = r +
			(blockKartVehicleFrontAxleMeters*frontLateral-
				blockKartVehicleRearAxleMeters*rearLateral+
				assist.Yaw_moment_newton_meters)/blockKartVehicleYawInertiaKgM2*deltaSeconds
		drift.Front_slip_radians = frontSlip
		drift.Rear_slip_radians = rearSlip
		drift.Front_force_newtons = frontLateral
		drift.Rear_force_newtons = rearLateral + assist.Lateral_force_newtons
	}
	v = blockKartVehicleLerp(
		grip.Lateral_speed_meters_per_second,
		drift.Lateral_speed_meters_per_second,
		physicalDriftBlend,
	)
	r = blockKartVehicleLerp(
		grip.Yaw_rate_radians_per_second,
		drift.Yaw_rate_radians_per_second,
		physicalDriftBlend,
	)
	frontSlip := blockKartVehicleLerp(grip.Front_slip_radians, drift.Front_slip_radians, physicalDriftBlend)
	rearSlip := blockKartVehicleLerp(grip.Rear_slip_radians, drift.Rear_slip_radians, physicalDriftBlend)
	frontLateral := blockKartVehicleLerp(grip.Front_force_newtons, drift.Front_force_newtons, physicalDriftBlend)
	rearLateral := blockKartVehicleLerp(grip.Rear_force_newtons, drift.Rear_force_newtons, physicalDriftBlend)
	// The grip envelope is deliberately tight for a locked-axle kart. Larger
	// body slip becomes available only as the explicit drift regime engages.
	gripSlipLimit := 0.060
	if road.Surface == blockKartRoadSurfaceCurb {
		gripSlipLimit = 0.075
	} else if road.Surface == blockKartRoadSurfaceGrass {
		gripSlipLimit = 0.105
	}
	bodySlipLimit := blockKartVehicleLerp(gripSlipLimit, 0.26, physicalDriftBlend)
	maximumLateralSpeed := math.Abs(u) * math.Tan(bodySlipLimit)
	v = blockKartVehicleClamp(v, -maximumLateralSpeed, maximumLateralSpeed)
	frictionYawLimit := road.Friction * blockKartVehicleGravity / math.Max(math.Abs(u), 3.0)
	maximumYawRate := blockKartVehicleClamp(frictionYawLimit, 0.72, 2.15)
	if physicalDriftBlend > 0 {
		maximumYawRate = math.Min(maximumYawRate, blockKartVehicleLerp(2.15, 1.35, physicalDriftBlend))
	}
	r = blockKartVehicleClamp(r, -maximumYawRate, maximumYawRate)
	if math.Abs(u) < 0.12 && throttle == 0 && brake == 0 {
		u = 0
		v = 0
		r = 0
	}
	vehicle.Forward_speed = u * 1000.0
	vehicle.Lateral_speed = v * 1000.0
	vehicle.Yaw_rate = r
	vehicle.Heading_radians = blockKartVehicleWrapRadians(vehicle.Heading_radians + r * deltaSeconds)
	vehicle.Lateral_acceleration = (frontLateral + rearLateral) / blockKartVehicleMassKg * 1000.0
	if math.Abs(u) < 0.12 {
		vehicle.Body_slip_radians = 0
	} else {
		vehicle.Body_slip_radians = math.Atan2(v, math.Abs(u))
	}
	vehicle.Front_slip_radians = frontSlip
	vehicle.Rear_slip_radians = rearSlip
	vehicle.Front_lateral_force_newtons = frontLateral
	vehicle.Rear_lateral_force_newtons = rearLateral
	vehicle.Drive_force_newtons = longitudinalForce
	vehicle.Front_normal_load_newtons = frontLoad
	vehicle.Rear_normal_load_newtons = rearLoad
	vehicle.Stability_yaw_moment_newton_meters = assist.Yaw_moment_newton_meters
	vehicle.Surface_friction = road.Friction
}

// blockKartVehicleGripLateralStep implements the established hybrid bicycle
// approach used by real-time vehicle solvers:
//   - a no-slip kinematic contact constraint at low speed;
//   - a backward-Euler dynamic bicycle solve once tyre slip is well-defined.
// Backward Euler solves lateral speed and yaw rate as one coupled state and is
// stable through the low-speed transition where an explicit 1/u model is not.
func blockKartVehicleGripLateralStep(
	longitudinalSpeed float64,
	lateralSpeed float64,
	yawRate float64,
	steerAngle float64,
	frontLongitudinalForce float64,
	rearLongitudinalForce float64,
	frontLoad float64,
	rearLoad float64,
	friction float64,
	deltaSeconds float64,
) BlockKartVehicleLateralState {
	u := longitudinalSpeed
	absoluteSpeed := math.Abs(u)
	tangentSteer := math.Tan(steerAngle)
	beta := math.Atan(blockKartVehicleRearAxleMeters / blockKartVehicleWheelbaseMeters * tangentSteer)
	kinematicV := u * math.Tan(beta)
	kinematicR := u * math.Cos(beta) / blockKartVehicleWheelbaseMeters * tangentSteer
	kinematicTotalForce := blockKartVehicleMassKg * u * kinematicR
	kinematicFrontForce := kinematicTotalForce * blockKartVehicleRearAxleMeters /
		blockKartVehicleWheelbaseMeters
	kinematicRearForce := kinematicTotalForce - kinematicFrontForce
	kinematicFrontForce = blockKartCombinedSlipLateral(
		kinematicFrontForce, frontLongitudinalForce, friction*frontLoad,
	)
	kinematicRearForce = blockKartCombinedSlipLateral(
		kinematicRearForce, rearLongitudinalForce, friction*rearLoad,
	)
	kinematic := BlockKartVehicleLateralState{
		Lateral_speed_meters_per_second: kinematicV,
		Yaw_rate_radians_per_second: kinematicR,
		Front_force_newtons: kinematicFrontForce,
		Rear_force_newtons: kinematicRearForce,
	}
	// Reverse manoeuvres remain in the kinematic contact regime. The dynamic
	// bicycle linearisation below assumes positive forward tyre velocity.
	if u <= 0 || absoluteSpeed <= 2.5 {
		return kinematic
	}
	nominalFrontLoad := blockKartVehicleMassKg * blockKartVehicleGravity *
		blockKartVehicleRearAxleMeters / blockKartVehicleWheelbaseMeters
	nominalRearLoad := blockKartVehicleMassKg * blockKartVehicleGravity - nominalFrontLoad
	frictionScale := blockKartVehicleClamp(friction/1.42, 0.28, 1.15)
	frontStiffness := blockKartVehicleFrontCorneringStiffness *
		blockKartVehicleClamp(frontLoad/nominalFrontLoad, 0.55, 1.45) * frictionScale
	rearStiffness := blockKartVehicleRearCorneringStiffness *
		blockKartVehicleClamp(rearLoad/nominalRearLoad, 0.55, 1.45) * frictionScale
	frontLimit := math.Max(friction*frontLoad, 1.0)
	rearLimit := math.Max(friction*rearLoad, 1.0)
	frontLongitudinalRatio := blockKartVehicleClamp(frontLongitudinalForce/frontLimit, -1, 1)
	rearLongitudinalRatio := blockKartVehicleClamp(rearLongitudinalForce/rearLimit, -1, 1)
	frontStiffness *= math.Sqrt(math.Max(0.08, 1.0-frontLongitudinalRatio*frontLongitudinalRatio))
	rearStiffness *= math.Sqrt(math.Max(0.08, 1.0-rearLongitudinalRatio*rearLongitudinalRatio))
	mass := blockKartVehicleMassKg
	inertia := blockKartVehicleYawInertiaKgM2
	a := blockKartVehicleFrontAxleMeters
	b := blockKartVehicleRearAxleMeters
	a11 := -(frontStiffness + rearStiffness) / (mass * u)
	a12 := (-frontStiffness*a + rearStiffness*b) / (mass*u) - u
	a21 := (-a*frontStiffness + b*rearStiffness) / (inertia*u)
	a22 := -(a*a*frontStiffness + b*b*rearStiffness) / (inertia * u)
	b1 := frontStiffness / mass
	b2 := a * frontStiffness / inertia
	m11 := 1.0 - deltaSeconds*a11
	m12 := -deltaSeconds * a12
	m21 := -deltaSeconds * a21
	m22 := 1.0 - deltaSeconds*a22
	rhs1 := lateralSpeed + deltaSeconds*b1*steerAngle
	rhs2 := yawRate + deltaSeconds*b2*steerAngle
	determinant := m11*m22 - m12*m21
	if math.Abs(determinant) < 0.000001 {
		return kinematic
	}
	dynamicV := (rhs1*m22 - m12*rhs2) / determinant
	dynamicR := (m11*rhs2 - rhs1*m21) / determinant
	frontSlip := math.Atan2(dynamicV+a*dynamicR, u) - steerAngle
	rearSlip := math.Atan2(dynamicV-b*dynamicR, u)
	frontForce := frontStiffness * (steerAngle - (dynamicV+a*dynamicR)/u)
	rearForce := rearStiffness * (b*dynamicR-dynamicV) / u
	frontForce = blockKartCombinedSlipLateral(frontForce, frontLongitudinalForce, frontLimit)
	rearForce = blockKartCombinedSlipLateral(rearForce, rearLongitudinalForce, rearLimit)
	dynamic := BlockKartVehicleLateralState{
		Lateral_speed_meters_per_second: dynamicV,
		Yaw_rate_radians_per_second: dynamicR,
		Front_slip_radians: frontSlip,
		Rear_slip_radians: rearSlip,
		Front_force_newtons: frontForce,
		Rear_force_newtons: rearForce,
	}
	dynamicBlend := blockKartVehicleSmoothstep(2.5, 6.0, absoluteSpeed)
	return BlockKartVehicleLateralState{
		Lateral_speed_meters_per_second: blockKartVehicleLerp(
			kinematic.Lateral_speed_meters_per_second,
			dynamic.Lateral_speed_meters_per_second,
			dynamicBlend,
		),
		Yaw_rate_radians_per_second: blockKartVehicleLerp(
			kinematic.Yaw_rate_radians_per_second,
			dynamic.Yaw_rate_radians_per_second,
			dynamicBlend,
		),
		Front_slip_radians: dynamic.Front_slip_radians * dynamicBlend,
		Rear_slip_radians: dynamic.Rear_slip_radians * dynamicBlend,
		Front_force_newtons: blockKartVehicleLerp(
			kinematic.Front_force_newtons,
			dynamic.Front_force_newtons,
			dynamicBlend,
		),
		Rear_force_newtons: blockKartVehicleLerp(
			kinematic.Rear_force_newtons,
			dynamic.Rear_force_newtons,
			dynamicBlend,
		),
	}
}

func (vehicle *BlockKartVehicleController) longitudinalForce(speedMps float64, throttle float64, brake float64, boosting bool, miniTurbo bool, road BlockKartRoadSample) float64 {
	absoluteSpeed := math.Abs(speedMps)
	speedRatio := blockKartVehicleClamp(absoluteSpeed / 30.0, 0, 1)
	engineForce := 5200.0 + (1650.0 - 5200.0) * speedRatio
	if road.Surface == blockKartRoadSurfaceCurb {
		engineForce *= 0.92
	} else if road.Surface == blockKartRoadSurfaceGrass {
		engineForce *= 0.62
	}
	force := throttle * engineForce
	if brake > 0 {
		if speedMps > 0.45 {
			force -= brake * 9200.0
		} else {
			force -= brake * 2800.0
		}
	}
	if boosting && speedMps >= 0 {
		boostForce := 2050.0
		if miniTurbo {
			boostForce = 2850.0
		}
		force += boostForce
	}
	rollingCoefficient := 0.016
	if road.Surface == blockKartRoadSurfaceCurb {
		rollingCoefficient = 0.035
	} else if road.Surface == blockKartRoadSurfaceGrass {
		rollingCoefficient = 0.105
	}
	if absoluteSpeed > 0.05 {
		direction := 1.0
		if speedMps < 0 {
			direction = -1.0
		}
		force -= direction * rollingCoefficient * blockKartVehicleMassKg * blockKartVehicleGravity
		force -= direction * 0.49 * absoluteSpeed * absoluteSpeed
	}
	force -= blockKartVehicleMassKg * blockKartVehicleGravity * road.Grade
	// Rear-drive launch traction and four-wheel braking have different usable
	// force envelopes. Keeping them separate prevents the old launch behavior
	// from reaching 60 km/h in roughly 1.7 seconds while retaining decisive,
	// stable braking.
	usableWeightFraction := 0.48
	if boosting {
		usableWeightFraction = 0.58
	}
	if brake > 0 {
		usableWeightFraction = 0.62
	}
	maximumTireForce := road.Friction * blockKartVehicleMassKg * blockKartVehicleGravity *
		usableWeightFraction
	return blockKartVehicleClamp(force, -maximumTireForce, maximumTireForce)
}

func blockKartVehicleAxleLoads(longitudinalAcceleration float64) (float64, float64) {
	weight := blockKartVehicleMassKg * blockKartVehicleGravity
	front := (weight * blockKartVehicleRearAxleMeters -
		blockKartVehicleMassKg * longitudinalAcceleration * blockKartVehicleCgHeightMeters) /
		blockKartVehicleWheelbaseMeters
	front = blockKartVehicleClamp(front, weight * 0.25, weight * 0.72)
	return front, weight - front
}

func blockKartFialaLateralForce(slipAngle float64, corneringStiffness float64, friction float64, normalLoad float64) float64 {
	if normalLoad <= 0 || friction <= 0 {
		return 0
	}
	slipAngle = blockKartVehicleClamp(slipAngle, -0.72, 0.72)
	tangent := math.Tan(slipAngle)
	absoluteTangent := math.Abs(tangent)
	frictionLoad := friction * normalLoad
	critical := math.Atan(3.0 * frictionLoad / corneringStiffness)
	if math.Abs(slipAngle) >= critical {
		if slipAngle > 0 {
			return -frictionLoad
		}
		return frictionLoad
	}
	stiffness2 := corneringStiffness * corneringStiffness
	stiffness3 := stiffness2 * corneringStiffness
	return -corneringStiffness * tangent +
		stiffness2 / (3.0 * frictionLoad) * absoluteTangent * tangent -
		stiffness3 / (27.0 * frictionLoad * frictionLoad) * tangent * tangent * tangent
}

func blockKartCombinedSlipLateral(lateralForce float64, longitudinalForce float64, frictionLimit float64) float64 {
	if frictionLimit <= 0 {
		return 0
	}
	longitudinalRatio := blockKartVehicleClamp(longitudinalForce / frictionLimit, -1, 1)
	lateralCapacity := frictionLimit *
		math.Sqrt(math.Max(0, 1.0 - longitudinalRatio * longitudinalRatio))
	return blockKartVehicleClamp(lateralForce, -lateralCapacity, lateralCapacity)
}

func blockKartVehicleSmoothstep(minimum float64, maximum float64, value float64) float64 {
	if maximum <= minimum {
		return 0
	}
	t := blockKartVehicleClamp((value - minimum) / (maximum - minimum), 0, 1)
	return t * t * (3.0 - 2.0 * t)
}

func blockKartVehicleLerp(from float64, to float64, amount float64) float64 {
	return from + (to - from) * amount
}

func (vehicle *BlockKartVehicleController) ApplyImpact(obstacleDirectionX float64, obstacleDirectionZ float64) float64 {
	if vehicle == nil {
		return 0
	}
	heading := vehicle.Heading_radians
	forwardX := math.Sin(heading)
	forwardZ := math.Cos(heading)
	rightX := math.Cos(heading)
	rightZ := -math.Sin(heading)
	forwardImpact := blockKartVehicleClamp(obstacleDirectionX * forwardX +
		obstacleDirectionZ * forwardZ, -1, 1)
	sideImpact := blockKartVehicleClamp(obstacleDirectionX * rightX + obstacleDirectionZ * rightZ, -1, 1)
	retainedSpeed := blockKartVehicleClamp(0.88 - math.Abs(forwardImpact) * 0.24, 0.56, 0.88)
	vehicle.Forward_speed *= retainedSpeed
	vehicle.Lateral_speed -= sideImpact * 2200.0
	vehicle.Yaw_rate -= sideImpact * 0.42
	vehicle.Yaw_rate = blockKartVehicleClamp(vehicle.Yaw_rate, -1.05, 1.05)
	vehicle.Steer_command *= 0.68
	vehicle.Wheel_angle_radians *= 0.72
	vehicle.Drift_blend *= 0.42
	return sideImpact
}
