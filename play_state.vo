package main

import (
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

const blockKartResetRepeatSeconds = 0.75

type PlayState struct {
	world *World
	runtimeCache *BlockKartRuntimeCache
	elapsed float64
	lifecycle string
	startupPhase string
	failure *BlockKartFailureReport
	debugOverlayVisible bool
	debugPerfStatsOwned bool
	renderDebugMode int
	heroCameraVisible bool
	renderPrepared bool
	resetActionConsumed bool
	bestTime float64
	bestTimeSet bool
	settings BlockKartSettings
}

func NewPlayState() *PlayState {
	return &PlayState{lifecycle: BlockKartLifecycleBoot, startupPhase: "new", settings: defaultBlockKartSettings()}
}

func (s *PlayState) Enter(g *voplay.GameCtx) {
	s.elapsed = 0
	s.renderPrepared = false
	s.debugPerfStatsOwned = false
	s.failure = nil
	if s.runtimeCache == nil {
		s.runtimeCache = &BlockKartRuntimeCache{}
	}
	bindGameActions(g)
	s.loadRacePersistence()
	s.setLifecycle(g, BlockKartLifecycleBoot, "enter")
	s.buildWorld(g, "startup")
}

func (s *PlayState) Exit(g *voplay.GameCtx) {
	if s.debugPerfStatsOwned {
		g.DisablePerfStats()
		s.debugPerfStatsOwned = false
	}
	if s.world != nil {
		s.captureRacePersistence()
		blockKartReportWorldDiagnostics(g, s.lifecycle, s.startupPhase, "close", s.world)
		s.world.Close()
		s.world = nil
	}
	if s.runtimeCache != nil {
		s.runtimeCache.Close()
		s.runtimeCache = nil
	}
	s.setLifecycle(g, BlockKartLifecycleClosed, "exit")
}

func (s *PlayState) Pause(g *voplay.GameCtx) {
	if s.failure != nil {
		return
	}
	s.setLifecycle(g, BlockKartLifecyclePaused, "pause")
}

func (s *PlayState) Resume(g *voplay.GameCtx) {
	if s.failure != nil {
		return
	}
	s.setLifecycle(g, BlockKartLifecycleRunning, "resume")
}

func (s *PlayState) FixedUpdate(g *voplay.GameCtx, dt float64) {
	s.elapsed += dt
	if s.failure != nil {
		return
	}
	if s.world == nil {
		return
	}
	if s.consumeResetAction(g) {
		s.restartRun(g)
		return
	}
	if !s.renderPrepared {
		return
	}
	s.world.FixedUpdate(g, dt, s.debugOverlayVisible)
	s.captureRacePersistence()
}

func (s *PlayState) Update(g *voplay.GameCtx, dt float64) {
	if s.failure != nil {
		if s.consumeResetAction(g) {
			s.restartWorld(g)
		}
		return
	}
	if s.consumeResetAction(g) {
		s.restartRun(g)
		return
	}
	if !s.renderPrepared {
		return
	}
	if g.Actions.IsPressed("toggle_debug_overlay") {
		s.debugOverlayVisible = !s.debugOverlayVisible
		s.applyDebugOverlay(g)
	}
	if g.Actions.IsPressed("cycle_render_debug") {
		s.renderDebugMode++
		if s.renderDebugMode > scene3d.RenderDebugAmbient {
			s.renderDebugMode = scene3d.RenderDebugLit
		}
		if s.world != nil {
			s.world.SetRenderDebugMode(s.renderDebugMode)
		}
	}
	if g.Actions.IsPressed("toggle_hero_camera") {
		s.heroCameraVisible = !s.heroCameraVisible
		if s.world != nil {
			s.world.SetHeroCameraVisible(s.heroCameraVisible)
		}
	}
	if g.Actions.IsPressed("cycle_terrain_camera") && s.world != nil {
		s.world.CycleTerrainCameraView()
	}
	if s.world == nil {
		return
	}
	if g.Actions.IsPressed("render_stress_primitive10k") {
		s.world.ActivateRenderStressProfile(g, blockKartRenderStressPrimitive10k)
	}
	if g.Actions.IsPressed("render_stress_water") {
		s.world.ActivateRenderStressProfile(g, blockKartRenderStressWater)
	}
	if g.Actions.IsPressed("render_stress_resource_churn") {
		s.world.ActivateRenderStressProfile(g, blockKartRenderStressResourceChurn)
	}
	if g.Actions.IsPressed("render_stress_chunked_world_drive") {
		s.world.ActivateRenderStressProfile(g, blockKartRenderStressChunkedWorldDrive)
	}
	if g.Actions.IsPressed("render_stress_shadow_post_matrix") {
		s.world.ActivateRenderStressProfile(g, blockKartRenderStressShadowPostMatrix)
	}
	s.world.Update(g, dt, s.debugOverlayVisible)
	s.captureRacePersistence()
}

func (s *PlayState) Draw(g *voplay.GameCtx) {
	clearColor := defaultWorldTheme().SkyColor
	if s.world != nil {
		clearColor = s.world.theme.SkyColor
	}
	g.Draw.ClearColor(clearColor)
	if s.failure != nil {
		s.drawFailure(g)
		return
	}
	if s.world != nil {
		if !s.renderPrepared {
			s.world.PrepareRender(g)
			s.renderPrepared = true
			s.applyDebugOverlay(g)
			return
		}
		s.world.Draw(g, s.debugOverlayVisible)
	}
}

func (s *PlayState) buildWorld(g *voplay.GameCtx, startupPhase string) bool {
	s.failure = nil
	s.setLifecycle(g, BlockKartLifecycleLoading, startupPhase)
	if s.runtimeCache == nil {
		s.runtimeCache = &BlockKartRuntimeCache{}
	}
	world, failure := NewWorld(g, s.runtimeCache)
	if failure != nil {
		s.enterFailure(g, failure)
		return false
	}
	s.world = world
	if s.world != nil {
		s.applyRacePersistenceToWorld(s.world)
		s.world.SetRenderDebugMode(s.renderDebugMode)
		s.world.SetHeroCameraVisible(s.heroCameraVisible)
	}
	s.setLifecycle(g, BlockKartLifecycleReady, "world")
	s.setLifecycle(g, BlockKartLifecycleRunning, "world")
	blockKartReportWorldDiagnostics(g, s.lifecycle, s.startupPhase, "worldReady", s.world)
	return true
}

func (s *PlayState) restartWorld(g *voplay.GameCtx) {
	s.setLifecycle(g, BlockKartLifecycleRestarting, "restart")
	if s.world != nil {
		s.captureRacePersistence()
		blockKartReportWorldDiagnostics(g, s.lifecycle, s.startupPhase, "preRestart", s.world)
		s.world.Close()
		s.world = nil
	}
	s.renderPrepared = false
	s.elapsed = 0
	s.buildWorld(g, "restart")
}

func (s *PlayState) restartRun(g *voplay.GameCtx) {
	if s.world == nil {
		s.restartWorld(g)
		return
	}
	s.setLifecycle(g, BlockKartLifecycleRestarting, "raceRestart")
	s.captureRacePersistence()
	s.world.restartRun()
	s.world.SetRenderDebugMode(s.renderDebugMode)
	s.world.SetHeroCameraVisible(s.heroCameraVisible)
	s.elapsed = 0
	s.setLifecycle(g, BlockKartLifecycleRunning, "raceRestart")
	blockKartReportWorldDiagnostics(g, s.lifecycle, s.startupPhase, "raceRestart", s.world)
}

func (s *PlayState) captureRacePersistence() {
	if s == nil || s.world == nil {
		return
	}
	s.settings = s.world.settings
	if s.world.bestTimeSet {
		improved := !s.bestTimeSet || s.world.bestTime < s.bestTime
		s.bestTime = s.world.bestTime
		s.bestTimeSet = true
		if improved {
			s.persistRacePersistence()
		}
	}
}

func (s *PlayState) applyRacePersistenceToWorld(w *World) {
	if s == nil || w == nil {
		return
	}
	w.settings = s.settings
	if s.bestTimeSet {
		w.bestTime = s.bestTime
		w.bestTimeSet = true
	}
}

func (s *PlayState) loadRacePersistence() {
	if s == nil {
		return
	}
	save := blockKartLoadProductSave(s.settings)
	s.settings = save.Settings
	if save.BestTimeSet {
		s.bestTime = save.BestTime
		s.bestTimeSet = true
	}
	if s.settings.StorageStatus == voplay.SettingsStatusEmpty {
		s.persistRacePersistence()
	}
}

func (s *PlayState) persistRacePersistence() {
	if s == nil {
		return
	}
	s.settings = blockKartSaveProductState(s.settings, s.bestTime, s.bestTimeSet)
	if s.world != nil {
		s.world.settings = s.settings
	}
}

func (s *PlayState) enterFailure(g *voplay.GameCtx, failure *BlockKartFailureReport) {
	if failure == nil {
		failure = blockKartNewFailureReport(BlockKartLifecycleFailed, "unknown", BlockKartOwnerBlockKart, BlockKartSubsystemRuntime, "BlockKart failed without an error report", "BlockKart could not start. Please try again.")
	}
	failure.LifecycleState = BlockKartLifecycleFailed
	s.failure = failure
	s.world = nil
	s.renderPrepared = true
	if s.runtimeCache != nil {
		s.runtimeCache.Close()
		s.runtimeCache = nil
	}
	s.lifecycle = failure.LifecycleState
	s.startupPhase = failure.StartupPhase
	blockKartReportLifecycle(g, failure.LifecycleState, failure.StartupPhase)
	blockKartReportFailure(g, failure)
}

func (s *PlayState) setLifecycle(g *voplay.GameCtx, state, startupPhase string) {
	s.lifecycle = state
	s.startupPhase = startupPhase
	blockKartReportLifecycle(g, state, startupPhase)
}

func (s *PlayState) consumeResetAction(g *voplay.GameCtx) bool {
	pressed := g.Actions.IsPressed("reset")
	down := g.Actions.IsDown("reset")
	if !pressed && !down {
		s.resetActionConsumed = false
		return false
	}
	if pressed && !s.resetActionConsumed {
		s.resetActionConsumed = true
		return true
	}
	if down && !pressed && s.elapsed >= blockKartResetRepeatSeconds {
		s.resetActionConsumed = true
		return true
	}
	return false
}

func (s *PlayState) drawFailure(g *voplay.GameCtx) {
	if g == nil || g.Draw == nil || s.failure == nil {
		return
	}
	message := s.failure.PlayerMessage
	if message == "" {
		message = "BlockKart could not start. Please try again."
	}
	g.Draw.ClearColor(voplay.Hex(0x10151d))
	g.Draw.DrawText("BlockKart", 64, 96, 36, voplay.White)
	g.Draw.DrawText(message, 64, 136, 20, voplay.Hex(0xffe3a8))
	g.Draw.DrawText("Press R to retry.", 64, 168, 16, voplay.Hex(0xb8d6ff))
}

func (s *PlayState) applyDebugOverlay(g *voplay.GameCtx) {
	if s.debugOverlayVisible || blockKartPerfStatsEnabled {
		snapshot := g.GetPerfSnapshot()
		if snapshot.Enabled {
			s.debugPerfStatsOwned = false
			return
		}
		s.debugPerfStatsOwned = true
		g.EnablePerfStats(voplay.PerfModeStats)
		return
	}
	if s.debugPerfStatsOwned {
		g.DisablePerfStats()
		s.debugPerfStatsOwned = false
	}
}

func bindGameActions(g *voplay.GameCtx) {
	g.Actions.Rebind("reset", voplay.KeyBinding("r"))
	g.Actions.Rebind("start", voplay.KeyBinding("w"), voplay.KeyBinding("ArrowUp"), voplay.KeyBinding(" "), voplay.KeyBinding("Space"), voplay.KeyBinding("Enter"))
	g.Actions.Rebind("toggle_debug_overlay", voplay.KeyBinding("F3"))
	g.Actions.Rebind("cycle_render_debug", voplay.KeyBinding("F4"))
	g.Actions.Rebind("toggle_hero_camera", voplay.KeyBinding("F5"))
	g.Actions.Rebind("cycle_terrain_camera", voplay.KeyBinding("F6"))
	g.Actions.Rebind("render_stress_primitive10k", voplay.KeyBinding("F7"))
	g.Actions.Rebind("render_stress_water", voplay.KeyBinding("F8"))
	g.Actions.Rebind("render_stress_resource_churn", voplay.KeyBinding("F9"))
	g.Actions.Rebind("render_stress_chunked_world_drive", voplay.KeyBinding("F10"))
	g.Actions.Rebind("render_stress_shadow_post_matrix", voplay.KeyBinding("F11"))
}
