package main

import (
	"math"
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/scene3d"
)

type CameraTargetTelemetry struct {
	initialized bool
	lastPosition voplay.Vec3
	lastSpeed float64
	step float64
	stepMax float64
	residual float64
	residualMax float64
	yStep float64
	yStepMax float64
	speedStep float64
	speedStepMax float64
}

type CameraTargetTelemetrySnapshot struct {
	Step float64
	StepMax float64
	Residual float64
	ResidualMax float64
	YStep float64
	YStepMax float64
	SpeedStep float64
	SpeedStepMax float64
}

func (t *CameraTargetTelemetry) ResetAnchor() {
	t.initialized = false
	t.step = 0
	t.residual = 0
	t.yStep = 0
	t.speedStep = 0
}

func (t *CameraTargetTelemetry) Record(target scene3d.RacingCameraTarget, dt float64) {
	if !t.initialized || dt <= 0 {
		t.initialized = true
		t.lastPosition = target.Position
		t.lastSpeed = target.Speed
		return
	}
	step := target.Position.Distance(t.lastPosition)
	yStep := math.Abs(target.Position.Y - t.lastPosition.Y)
	speedStep := math.Abs(target.Speed - t.lastSpeed)
	expectedSpeed := math.Abs(target.Speed)
	velocitySpeed := target.Velocity.Length()
	if velocitySpeed > expectedSpeed {
		expectedSpeed = velocitySpeed
	}
	residual := step - expectedSpeed * dt - 0.08
	if residual < 0 {
		residual = 0
	}
	t.step = step
	t.residual = residual
	t.yStep = yStep
	t.speedStep = speedStep
	if step > t.stepMax {
		t.stepMax = step
	}
	if residual > t.residualMax {
		t.residualMax = residual
	}
	if yStep > t.yStepMax {
		t.yStepMax = yStep
	}
	if speedStep > t.speedStepMax {
		t.speedStepMax = speedStep
	}
	t.lastPosition = target.Position
	t.lastSpeed = target.Speed
}

func (t *CameraTargetTelemetry) Snapshot() CameraTargetTelemetrySnapshot {
	return CameraTargetTelemetrySnapshot{Step: t.step, StepMax: t.stepMax, Residual: t.residual, ResidualMax: t.residualMax, YStep: t.yStep, YStepMax: t.yStepMax, SpeedStep: t.speedStep, SpeedStepMax: t.speedStepMax}
}
