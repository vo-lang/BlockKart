package main

import (
	"errors"
	"math"
	"github.com/vo-lang/voplay"
	"github.com/vo-lang/voplay/vo/assets"
	"github.com/vo-lang/voplay/vo/audio"
	"github.com/vo-lang/voplay/vo/input"
	"github.com/vo-lang/voplay/vo/physics3d"
	"github.com/vo-lang/voplay/vo/render"
	"github.com/vo-lang/voplay/vo/render2d"
)

const (
	blockKartSystemInput uint64 = 100
	blockKartSystemDrive uint64 = 200
	blockKartSystemPhysics uint64 = 300
	blockKartSystemFrame uint64 = 500
)

const (
	blockKartTicksPerSecond uint32 = 20
	blockKartCountdownTicks uint32 = 3 * blockKartTicksPerSecond
	blockKartBoostTicks uint32 = 9 * blockKartTicksPerSecond
	blockKartBoostCooldownTicks uint32 = 18 * blockKartTicksPerSecond
)

const (
	blockKartComponentTransform uint64 = 1001
	blockKartComponentVelocity uint64 = 1002
	blockKartComponentControl uint64 = 1003
	blockKartComponentKartState uint64 = 1004
	blockKartComponentTrackMarker uint64 = 1005
	blockKartComponentRenderPose uint64 = 1006
	blockKartComponentCollectible uint64 = 1007
	blockKartComponentBoostPad uint64 = 1008
	blockKartComponentMovingObstacle uint64 = 1009
)

const (
	blockKartLayerWorld uint32 = 1
	blockKartLayerKart uint32 = 2
	blockKartLayerTrigger uint32 = 4
)

type BlockKart struct {
	Engine voplay.EngineRef
	Transforms *TransformStore
	Velocities *VelocityStore
	Controls *KartControlStore
	KartStates *KartStateStore
	TrackMarkers *TrackMarkerStore
	RenderPoses *RenderPoseStore
	Collectibles *CollectibleStore
	BoostPads *BoostPadStore
	MovingObstacles *MovingObstacleStore
	Physics *physics3d.Runtime
	KartEntity uint64
	KartBody physics3d.BodyRef
	KartCollider physics3d.ColliderRef
	TrackBody physics3d.BodyRef
	TrackCollider physics3d.ColliderRef
	TrackGates []BlockKartGate
	Pickups []BlockKartPhysicsEntity
	PadEntities []BlockKartPhysicsEntity
	ObstacleEntities []BlockKartPhysicsEntity
	Contacts []physics3d.ContactEvent
	TrackCenterline []BlockKartRoadPoint
	LastSafeTransform Transform
	RenderControls *render.RenderControlStore
	RenderTarget render.StableControlRef
	RenderView render.StableControlRef
	RenderWidth uint32
	RenderHeight uint32
	RenderControlPublished bool
	RenderWorldPublished bool
	RenderLiveDynamicEntities map[uint32]bool
	RenderLastDynamicPackets map[uint32][]byte
	StaticRenderPackets [][]byte
	MeshInstancePackets map[uint64][]byte
	HudStaticPackets map[uint64][]byte
	GameplayStaticPackets map[uint64][]byte
	RenderAssetPackets [][]byte
	RenderAssetCursor uint32
	RenderAssetsPublished bool
	RenderAssetAcks map[uint64]uint64
	RenderRevision uint64
	KartMeshAsset uint64
	BoostAudioAsset uint64
	EngineAudioAsset uint64
	HitAudioAsset uint64
	SkidAudioAsset uint64
	GrassAudioAsset uint64
	Audio *audio.ControlState
	AudioAssetPackets [][]byte
	AudioAssetsPublished bool
	AudioAssetAcks map[uint64]uint64
	EngineAudioSource audio.PersistentSourceRef
	AudioSequence uint64
	AssetSequence uint64
	AssetRegistrationSent bool
	RequestedAssetCount uint32
	AssetScopeRequested bool
	AssetRequestsSent bool
	AssetScope assets.AssetScope
	RegisteredAssets []assets.AssetRef
	AssetTickets map[uint64]assets.AssetTicket
	ReadyAssets map[uint64]bool
	InputSequence uint64
	LeftPressed bool
	RightPressed bool
	ThrottlePressed bool
	BrakePressed bool
	DriftPressed bool
	BoostKeyPressed bool
	GamepadSteer int32
	GamepadThrottle int32
	GamepadBrake int32
	GamepadDrift bool
	GamepadBoost bool
	Steering_milli int32
	WheelSpin_milliradians int32
	ChassisLean_milliradians int32
	ChassisPitch_milliradians int32
	DriftCharge_milli uint32
	DriftStage uint32
	DriftDirection int32
	WasDrifting bool
	MiniTurbo_ticks uint32
	StartFlash_ticks uint32
	TouchPoints map[uint32]BlockKartTouchPoint
	Paused bool
	CameraMode uint32
	DebugOverlayVisible bool
	RenderDebugMode uint32
	StressMode bool
	BoostPressed bool
	OffRoad bool
	Drifting bool
	HitAudioPending bool
	LastBoostAudioTick uint64
	LastSkidAudioTick uint64
	LastGrassAudioTick uint64
	LastAudioControlTick uint64
	LastAudioSnapshotRevision uint64
	LastRenderDeadlineNanos uint64
	RenderPulseCounter uint64
	ConfigurationError error
}

type BlockKartTouchPoint struct {
	Role uint32
	X int32
	Y int32
}

type BlockKartGate struct {
	Entity uint64
	Order uint32
	Body physics3d.BodyRef
	Collider physics3d.ColliderRef
	Position [3]int64
}

func ConfigureBlockKart(game *BlockKart, builder voplay.Builder) {
	if game == nil {
		return
	}
	if err := builder.SetFixedTick(50000000, 4); err != nil {
		game.ConfigurationError = err
		return
	}
	systems := []voplay.SystemSpec{
		{
			Id: blockKartSystemInput, Stage: voplay.StageInput, Descriptor: []byte("blockkart.input.v1"),
			Deterministic: true, SimulationWrites: []uint64{blockKartComponentControl},
		},
		{
			Id: blockKartSystemDrive, Stage: voplay.StageGameplay, Descriptor: []byte("blockkart.gameplay.v2"),
			Deterministic: true,
			SimulationReads: []uint64{
				blockKartComponentControl, blockKartComponentMovingObstacle,
			},
			SimulationWrites: []uint64{
				blockKartComponentVelocity, blockKartComponentKartState,
				blockKartComponentTransform, blockKartComponentBoostPad,
			},
		},
		{
			Id: blockKartSystemFrame, Stage: voplay.StageFrame, Descriptor: []byte("blockkart.frame.v1"),
			Deterministic: false, SimulationReads: []uint64{blockKartComponentTransform},
			PresentationWrites: []uint64{blockKartComponentRenderPose},
		},
	}
	for _, system := range systems {
		if err := builder.RegisterScheduledSystem(system); err != nil {
			game.ConfigurationError = err
			return
		}
	}
}

func StartBlockKart(game *BlockKart, init BlockKartInit, context voplay.StartContext) error {
	if game == nil || context == nil {
		return errors.New("blockkart: missing game or start context")
	}
	if game.ConfigurationError != nil {
		return game.ConfigurationError
	}
	if init.Seed == 0 || init.Difficulty == 0 || init.Difficulty > 5 {
		return errors.New("blockkart: invalid governed init")
	}
	game.Engine = context.Engine()
	game.RenderLiveDynamicEntities = map[uint32]bool{}
	game.RenderLastDynamicPackets = map[uint32][]byte{}
	game.MeshInstancePackets = map[uint64][]byte{}
	game.HudStaticPackets = map[uint64][]byte{}
	game.GameplayStaticPackets = map[uint64][]byte{}
	var ok bool
	game.Transforms, ok = NewTransformStore(512, 4096)
	if !ok {
		return errors.New("blockkart: transform store")
	}
	game.Velocities, ok = NewVelocityStore(512, 4096)
	if !ok {
		return errors.New("blockkart: velocity store")
	}
	game.Controls, ok = NewKartControlStore(16, 256)
	if !ok {
		return errors.New("blockkart: control store")
	}
	game.KartStates, ok = NewKartStateStore(16, 256)
	if !ok {
		return errors.New("blockkart: kart state store")
	}
	game.TrackMarkers, ok = NewTrackMarkerStore(128, 1024)
	if !ok {
		return errors.New("blockkart: track marker store")
	}
	game.RenderPoses, ok = NewRenderPoseStore(512, 4096)
	if !ok {
		return errors.New("blockkart: render pose store")
	}
	game.Collectibles, ok = NewCollectibleStore(128, 1024)
	if !ok {
		return errors.New("blockkart: collectible store")
	}
	game.BoostPads, ok = NewBoostPadStore(64, 512)
	if !ok {
		return errors.New("blockkart: boost pad store")
	}
	game.MovingObstacles, ok = NewMovingObstacleStore(64, 512)
	if !ok {
		return errors.New("blockkart: moving obstacle store")
	}
	game.Physics, ok = physics3d.NewRuntime(512, 1024, 4096, 4096)
	if !ok {
		return errors.New("blockkart: physics owner")
	}
	if err := game.startWorld(context); err != nil {
		return err
	}
	return nil
}

func ExecuteBlockKart(game *BlockKart, invocation voplay.SystemInvocation) (voplay.TickOutput, error) {
	if game == nil || invocation.Tick.Count == 0 || invocation.Tick.FirstTick == 0 ||
		invocation.System.Id != blockKartSystemFrame && invocation.Tick.Count != 1 {
		return voplay.TickOutput{}, errors.New("blockkart: invalid system invocation")
	}
	switch invocation.System.Id {
		case blockKartSystemInput:
			return voplay.TickOutput{}, game.readInput(invocation.Tick)
		case blockKartSystemDrive:
			return voplay.TickOutput{}, game.updateGameplay(invocation.Tick)
		case blockKartSystemPhysics:
			return voplay.TickOutput{}, game.stepPhysics(invocation.Tick)
		case blockKartSystemFrame:
			return game.frame(invocation.Tick, invocation.PresentationPulse)
		default:
			return voplay.TickOutput{}, errors.New("blockkart: unknown scheduled system")
	}
}

func (game *BlockKart) updateGameplay(tick voplay.TickBatch) error {
	if err := game.drive(tick); err != nil {
		return err
	}
	if err := game.updateDynamics(tick); err != nil {
		return err
	}
	if err := game.stepPhysics(tick); err != nil {
		return err
	}
	if err := game.syncRace(tick); err != nil {
		return err
	}
	return game.drainJournals()
}

func (game *BlockKart) drainJournals() error {
	game.Transforms.TakeChanges()
	game.Velocities.TakeChanges()
	game.Controls.TakeChanges()
	game.KartStates.TakeChanges()
	game.TrackMarkers.TakeChanges()
	game.Collectibles.TakeChanges()
	game.BoostPads.TakeChanges()
	game.MovingObstacles.TakeChanges()
	game.RenderPoses.TakeChanges()
	return nil
}

func (game *BlockKart) startWorld(context voplay.StartContext) error {
	kart, err := context.Spawn([]byte("blockkart.entity.kart.v1"))
	if err != nil || !kart.Valid() {
		return errors.New("blockkart: spawn kart")
	}
	var ok bool
	game.KartEntity = uint64(kart.Index)
	startTransform := blockKartStartTransform()
	game.TrackCenterline = blockKartTrackCenterline()
	if len(game.TrackCenterline) == 0 {
		return errors.New("blockkart: build track centerline")
	}
	game.LastSafeTransform = startTransform
	if !game.Transforms.Upsert(game.KartEntity, startTransform) ||
		!game.Velocities.Upsert(game.KartEntity, Velocity{}) ||
		!game.Controls.Upsert(game.KartEntity, KartControl{}) ||
		!game.KartStates.Upsert(game.KartEntity, KartState{
			Checkpoint: 1, Countdown_ticks: blockKartCountdownTicks,
		}) {
		return errors.New("blockkart: initialize kart components")
	}
	game.KartBody, ok = game.Physics.CreateBody(physics3d.BodyDesc{
		Kind: physics3d.BodyDynamic,
		Position: [3]int64{startTransform.X, startTransform.Y, startTransform.Z},
	})
	if !ok || !game.KartBody.Valid() {
		return errors.New("blockkart: create kart body")
	}
	game.KartCollider, ok = game.Physics.CreateCollider(physics3d.ColliderDesc{
		Body: game.KartBody, HalfExtent: [3]uint32{850, 500, 1250},
		Layer: blockKartLayerKart, Mask: blockKartLayerWorld | blockKartLayerTrigger,
	})
	if !ok || game.KartCollider.Index == 0 {
		return errors.New("blockkart: create kart collider")
	}
	if err = game.startTrack(context); err != nil {
		return err
	}
	if err = game.startGameplay(context); err != nil {
		return err
	}
	if _, err = context.CreateRenderView([]byte("blockkart.main-view.v1")); err != nil {
		return errors.New("blockkart: create render view")
	}
	if err = game.startRenderControl(); err != nil {
		return err
	}
	if err = game.startAssets(context); err != nil {
		return err
	}
	return nil
}

func (game *BlockKart) startRenderControl() error {
	var ok bool
	game.RenderControls, ok = render.NewRenderControlStore(1, 16, 16, 1048576)
	if !ok {
		return errors.New("blockkart: create render control owner")
	}
	graph, ok := render.EncodeGraphProgram([]render.GraphResourceDescriptor{
		{ID: 1, Format: 2, SampleCount: 4, Usage: 8 | 32, Lifetime: 2},
	}, []render.GraphNodeDescriptor{
		{
			ID: 1, StableType: 100, Label: []byte("blockkart.scene"), Queue: 1,
			Writes: []render.GraphResourceWrite{{Resource: 1, BaseVersion: 0, Usage: 8}},
		},
		{
			ID: 2, StableType: 101, Label: []byte("blockkart.present"), Queue: 3, Dependencies: []uint32{1},
			Reads: []render.GraphResourceRead{{Resource: 1, Version: 1, Usage: 32}},
		},
	})
	if !ok {
		return errors.New("blockkart: encode render graph")
	}
	first, ok := game.RenderControls.Commit(render.RenderControlTransaction{
		ExpectedRevision: 0,
		Operations: []render.RenderControlOperation{
			{
				Kind: render.RenderCreateTarget,
				Target: render.TargetDescriptor{
					Width: 1280, Height: 720, Format: 2, DepthFormat: 4, SampleCount: 4, Usage: 1 | 8 | 16 | 32,
					Lifetime: 2, Clear: 2, SurfaceIndex: 1, SurfaceGeneration: 1,
				},
			},
			{Kind: render.RenderCreateGraph, Graph: render.GraphDescriptor{Signature: 7001, Nodes: graph}},
		},
	})
	if !ok || len(first.Created) != 2 {
		return errors.New("blockkart: create render target and graph")
	}
	game.RenderTarget = first.Created[0]
	second, ok := game.RenderControls.Commit(render.RenderControlTransaction{
		ExpectedRevision: first.Revision,
		Operations: []render.RenderControlOperation{
			{
				Kind: render.RenderCreateView,
				View: render.ViewDescriptor{
					Target: first.Created[0], CameraWorldIndex: 1, CameraWorldGeneration: 1,
					CameraEntityIndex: 900001, CameraEntityGeneration: 1, PresentationDomainIndex: 1,
					PresentationDomainGeneration: 1, ViewportWidth: 1280, ViewportHeight: 720, LayerMask: 3,
					GraphTemplate: 7001, QualityProfile: 1, Clear: 1,
					ClearColor: [4]uint16{5000, 9000, 16000, 65535}, ClearDepth: 65535, Enabled: true,
				},
			},
		},
	})
	if !ok {
		return errors.New("blockkart: create render view")
	}
	if len(second.Created) != 1 {
		return errors.New("blockkart: retain render view")
	}
	game.RenderView = second.Created[0]
	game.RenderWidth = 1280
	game.RenderHeight = 720
	return nil
}

func (game *BlockKart) updateRenderMetrics(metrics render.SurfaceMetrics) error {
	if metrics.Width == game.RenderWidth && metrics.Height == game.RenderHeight {
		return nil
	}
	if metrics.Width == 0 || metrics.Height == 0 {
		return errors.New("blockkart: invalid render metrics")
	}
	_, ok := game.RenderControls.Commit(render.RenderControlTransaction{
		ExpectedRevision: game.RenderControls.Revision,
		Operations: []render.RenderControlOperation{
			{
				Kind: render.RenderUpdateTarget, Ref: game.RenderTarget,
				Target: render.TargetDescriptor{
					Width: metrics.Width, Height: metrics.Height, Format: 2, DepthFormat: 4, SampleCount: 4,
					Usage: 1 | 8 | 16 | 32, Lifetime: 2, Clear: 2, SurfaceIndex: 1, SurfaceGeneration: 1,
				},
			},
			{
				Kind: render.RenderUpdateView, Ref: game.RenderView,
				View: render.ViewDescriptor{
					Target: game.RenderTarget, CameraWorldIndex: 1, CameraWorldGeneration: 1,
					CameraEntityIndex: 900001, CameraEntityGeneration: 1, PresentationDomainIndex: 1,
					PresentationDomainGeneration: 1, ViewportWidth: metrics.Width, ViewportHeight: metrics.Height,
					LayerMask: 3, GraphTemplate: 7001, QualityProfile: 1, Clear: 1,
					ClearColor: [4]uint16{5000, 9000, 16000, 65535}, ClearDepth: 65535, Enabled: true,
				},
			},
		},
	})
	if !ok {
		return errors.New("blockkart: resize render target")
	}
	game.RenderWidth = metrics.Width
	game.RenderHeight = metrics.Height
	game.RenderControlPublished = false
	return nil
}

func (game *BlockKart) readInput(tick voplay.TickBatch) error {
	control, ok := game.Controls.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: missing control component")
	}
	leftTapped := false
	rightTapped := false
	throttleTapped := false
	brakeTapped := false
	for _, packet := range tick.InputFrames {
		event, decoded := input.DecodePlatformEvent(packet)
		if !decoded || event.ConsumedByUi || event.Sequence <= game.InputSequence {
			continue
		}
		game.InputSequence = event.Sequence
		if event.Kind >= input.PlatformPointerDown && event.Kind <= input.PlatformPointerCancel {
			if err := game.readTouchInput(&control, event); err != nil {
				return err
			}
			continue
		}
		if event.Kind == 16 {
			switch event.Code {
				case 0:
					game.GamepadSteer = blockKartInputMagnitude(event.Value)
				case 4:
					game.GamepadBrake = blockKartInputMagnitude(event.Value)
				case 5:
					game.GamepadThrottle = blockKartInputMagnitude(event.Value)
			}
			continue
		}
		if event.Kind == 15 {
			switch event.Code {
				case 0:
					game.GamepadThrottle = blockKartInputMagnitude(event.Value)
				case 1:
					game.GamepadBrake = blockKartInputMagnitude(event.Value)
				case 4:
					game.GamepadDrift = event.Value != 0
				case 5:
					game.GamepadBoost = event.Value != 0
			}
			continue
		}
		if event.Kind != input.PlatformKeyDown && event.Kind != input.PlatformKeyUp {
			continue
		}
		pressed := event.Value != 0
		if pressed {
			switch event.Code {
				case 19, 1026227156:
					game.Paused = !game.Paused
				case 21, 1059782394:
					if err := game.restartRace(); err != nil {
						return err
					}
				case 60, 114, 332577688:
					game.DebugOverlayVisible = !game.DebugOverlayVisible
				case 61, 115, 382910545:
					game.RenderDebugMode = (game.RenderDebugMode + 1) % 8
				case 62, 116, 366132926:
					if game.CameraMode == 1 {
						game.CameraMode = 0
					} else {
						game.CameraMode = 1
					}
				case 63, 117, 416465783:
					game.CameraMode = (game.CameraMode + 1) % 3
				case 64, 118, 399688164:
					game.StressMode = !game.StressMode
			}
		}
		switch event.Code {
			case 4, 37, 65, 80, 774562871, 3199684067:
				game.LeftPressed = pressed
				if pressed {
					leftTapped = true
				}
			case 7, 39, 68, 79, 690674776, 1371226220:
				game.RightPressed = pressed
				if pressed {
					rightTapped = true
				}
			case 26, 38, 82, 87, 154847355, 1009449537:
				game.ThrottlePressed = pressed
				if pressed {
					throttleTapped = true
				}
			case 22, 40, 81, 83, 1076560013, 2494835758:
				game.BrakePressed = pressed
				if pressed {
					brakeTapped = true
				}
			case 32, 44, 3250860581:
				game.DriftPressed = pressed
			case 16, 225, 2431419694:
				game.BoostKeyPressed = pressed
		}
	}
	control = KartControl{}
	leftActive := game.LeftPressed || leftTapped
	rightActive := game.RightPressed || rightTapped
	if leftActive == rightActive {
		control.Steer_milli = -game.GamepadSteer
	} else if leftActive {
		control.Steer_milli = 1000
	} else {
		control.Steer_milli = -1000
	}
	if game.ThrottlePressed || throttleTapped {
		control.Throttle_milli = 1000
	} else {
		control.Throttle_milli = game.GamepadThrottle
	}
	if game.BrakePressed || brakeTapped {
		control.Brake_milli = 1000
	} else {
		control.Brake_milli = game.GamepadBrake
	}
	control.Drift = game.DriftPressed || game.GamepadDrift
	control.Boost = game.BoostKeyPressed || game.GamepadBoost
	game.applyTouchControls(&control)
	if !game.Controls.Upsert(game.KartEntity, control) {
		return errors.New("blockkart: update control component")
	}
	return nil
}

func (game *BlockKart) readTouchInput(control *KartControl, event input.PlatformEvent) error {
	position, decoded := input.DecodePointerPosition(event)
	if !decoded {
		return nil
	}
	if game.TouchPoints == nil {
		game.TouchPoints = map[uint32]BlockKartTouchPoint{}
	}
	if event.Kind == input.PlatformPointerUp || event.Kind == input.PlatformPointerCancel {
		delete(game.TouchPoints, position.Contact)
		game.applyTouchControls(control)
		return nil
	}
	point, exists := game.TouchPoints[position.Contact]
	if !exists {
		point.Role = game.touchRole(position.XMilli, position.YMilli)
	}
	if point.Role == 0 {
		return nil
	}
	point.X = position.XMilli
	point.Y = position.YMilli
	game.TouchPoints[position.Contact] = point
	if point.Role == 6 && event.Kind == input.PlatformPointerDown {
		return game.restartRace()
	}
	game.applyTouchControls(control)
	return nil
}

func (game *BlockKart) touchRole(x int32, y int32) uint32 {
	width := int64(game.RenderWidth) * 1000
	height := int64(game.RenderHeight) * 1000
	px := int64(x)
	py := int64(y)
	if width == 0 || height == 0 || px < 0 || py < 0 || px > width || py > height {
		return 0
	}
	if px < width * 52 / 100 && py > height * 48 / 100 {
		return 1
	}
	if px > width * 88 / 100 && py < height * 30 / 100 {
		return 6
	}
	if px > width * 82 / 100 && py > height * 72 / 100 {
		return 2
	}
	if px > width * 66 / 100 && px <= width * 82 / 100 && py > height * 72 / 100 {
		return 3
	}
	if px > width * 66 / 100 && px <= width * 82 / 100 && py > height * 52 / 100 &&
		py <= height * 72 / 100 {
		return 4
	}
	if px > width * 82 / 100 && py > height * 52 / 100 && py <= height * 72 / 100 {
		return 5
	}
	return 0
}

func (game *BlockKart) applyTouchControls(control *KartControl) {
	if control == nil || len(game.TouchPoints) == 0 {
		return
	}
	width := int64(game.RenderWidth) * 1000
	height := int64(game.RenderHeight) * 1000
	centerX := width * 18 / 100
	centerY := height * 78 / 100
	radius := height * 16 / 100
	if radius < 1 {
		radius = 1
	}
	for _, point := range game.TouchPoints {
		switch point.Role {
			case 1:
				steer := (centerX - int64(point.X)) * 1000 / radius
				vertical := (centerY - int64(point.Y)) * 1000 / radius
				if steer < -1000 {
					steer = -1000
				}
				if steer > 1000 {
					steer = 1000
				}
				control.Steer_milli = int32(steer)
				if vertical > 0 {
					if vertical > 1000 {
						vertical = 1000
					}
					control.Throttle_milli = int32(vertical)
				} else {
					vertical = -vertical
					if vertical > 1000 {
						vertical = 1000
					}
					control.Brake_milli = int32(vertical)
				}
			case 2:
				control.Throttle_milli = 1000
			case 3:
				control.Brake_milli = 1000
			case 4:
				control.Drift = true
			case 5:
				control.Boost = true
		}
	}
}

func (game *BlockKart) drive(tick voplay.TickBatch) error {
	control, ok := game.Controls.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: read control component")
	}
	velocity, ok := game.Velocities.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: read velocity component")
	}
	transform, ok := game.Transforms.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: read drive transform")
	}
	state, ok := game.KartStates.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: read kart state")
	}
	if game.Paused || state.Countdown_ticks != 0 || state.Finished {
		if state.Countdown_ticks != 0 && !game.Paused {
			state.Countdown_ticks--
			if state.Countdown_ticks == 0 {
				game.StartFlash_ticks = blockKartTicksPerSecond * 4 / 5
			}
		}
		state.Speed_per_second = 0
		velocity.X_per_second = 0
		velocity.Z_per_second = 0
		velocity.Yaw_per_second = 0
		if !game.Velocities.Upsert(game.KartEntity, velocity) ||
			!game.KartStates.Upsert(game.KartEntity, state) {
			return errors.New("blockkart: hold race state")
		}
		game.BoostPressed = false
		game.Steering_milli = 0
		game.ChassisLean_milliradians = blockKartApproachInt32(
			game.ChassisLean_milliradians, 0, 12,
		)
		game.ChassisPitch_milliradians = blockKartApproachInt32(
			game.ChassisPitch_milliradians, 0, 10,
		)
		game.Drifting = false
		game.WasDrifting = false
		game.DriftCharge_milli = 0
		game.DriftStage = 0
		game.DriftDirection = 0
		return nil
	}
	if game.StartFlash_ticks != 0 {
		game.StartFlash_ticks--
	}
	roadBeforeDrive := game.nearestRoadSample(transform)
	game.OffRoad = roadBeforeDrive.Distance_milli >
		roadBeforeDrive.Half_width_milli + 5500
	deltaSeconds := float64(tick.FixedTickNanos) / 1000000000.0
	if deltaSeconds <= 0 || deltaSeconds > 0.1 {
		return errors.New("blockkart: invalid drive delta")
	}
	speed := float64(state.Speed_per_second)
	absoluteSpeed := math.Abs(speed)
	driftInput := control.Steer_milli
	driftEligible := control.Drift && absoluteSpeed > 9000 &&
		(game.WasDrifting || math.Abs(float64(driftInput)) > 220)
	if driftEligible {
		if !game.WasDrifting {
			if driftInput < 0 {
				game.DriftDirection = -1
			} else {
				game.DriftDirection = 1
			}
			game.DriftCharge_milli = 0
		}
		game.Drifting = true
		chargeGain := uint32(7 + absoluteSpeed / 3000.0 +
			math.Abs(float64(driftInput)) / 190.0)
		if driftInput != 0 &&
			(driftInput < 0) != (game.DriftDirection < 0) {
			chargeGain += 4
		}
		game.DriftCharge_milli += chargeGain
		if game.DriftCharge_milli > 2100 {
			game.DriftCharge_milli = 2100
		}
		game.DriftStage = 0
		if game.DriftCharge_milli >= 520 {
			game.DriftStage = 1
		}
		if game.DriftCharge_milli >= 1120 {
			game.DriftStage = 2
		}
		if game.DriftCharge_milli >= 1780 {
			game.DriftStage = 3
		}
	} else {
		game.Drifting = false
		if game.WasDrifting {
			if game.DriftCharge_milli >= 1780 {
				game.MiniTurbo_ticks = blockKartTicksPerSecond * 19 / 10
			} else if game.DriftCharge_milli >= 1120 {
				game.MiniTurbo_ticks = blockKartTicksPerSecond * 5 / 4
			} else if game.DriftCharge_milli >= 520 {
				game.MiniTurbo_ticks = blockKartTicksPerSecond * 2 / 3
			}
		}
		game.DriftCharge_milli = 0
		game.DriftStage = 0
		game.DriftDirection = 0
	}
	game.WasDrifting = game.Drifting
	miniTurbo := game.MiniTurbo_ticks != 0
	if game.MiniTurbo_ticks != 0 {
		game.MiniTurbo_ticks--
	}
	throttle := float64(control.Throttle_milli) / 1000.0
	brake := float64(control.Brake_milli) / 1000.0
	normalMaximumSpeed := 39000.0
	boostMaximumSpeed := 47000.0
	speedRatioBefore := blockKartClampFloat64(absoluteSpeed / normalMaximumSpeed, 0, 1)
	engineAcceleration := 15500.0 * (1.0 - speedRatioBefore * 0.86)
	if engineAcceleration < 2100 {
		engineAcceleration = 2100
	}
	acceleration := 0.0
	if throttle > 0 {
		if speed < -500 {
			acceleration += 27500.0 * throttle
		} else {
			acceleration += engineAcceleration * throttle
		}
	}
	if brake > 0 {
		if speed > 500 {
			acceleration -= 28500.0 * brake
		} else {
			acceleration -= 9800.0 * brake
		}
	}
	boosting := control.Boost || state.Boost_ticks != 0 || miniTurbo
	if boosting && speed >= 0 {
		if miniTurbo {
			acceleration += 9200.0
		} else {
			acceleration += 7300.0
		}
	}
	if throttle == 0 && brake == 0 {
		resistance := 650.0 + absoluteSpeed * 0.075
		if speed > 0 {
			acceleration -= resistance
		} else if speed < 0 {
			acceleration += resistance
		}
	} else {
		acceleration -= speed * 0.052
	}
	if game.OffRoad {
		if throttle > 0 && speed >= 0 {
			acceleration -= engineAcceleration * throttle * 0.58
		}
		acceleration -= speed * 0.62
	}
	nextSpeed := speed + acceleration * deltaSeconds
	if throttle == 0 && brake == 0 &&
		(speed > 0 && nextSpeed < 0 || speed < 0 && nextSpeed > 0) {
		nextSpeed = 0
	}
	maximumSpeed := normalMaximumSpeed
	if boosting {
		maximumSpeed = boostMaximumSpeed
	}
	if nextSpeed > maximumSpeed {
		nextSpeed = maximumSpeed
	}
	if nextSpeed < -10500 {
		nextSpeed = -10500
	}
	state.Speed_per_second = int64(nextSpeed)
	absoluteSpeed = math.Abs(nextSpeed)
	speedRatio := blockKartClampFloat64(absoluteSpeed / normalMaximumSpeed, 0, 1)
	steeringRate := 3400.0 - speedRatio * 900.0
	steeringStep := int32(steeringRate * deltaSeconds)
	if control.Steer_milli == 0 {
		steeringStep = int32(5800.0 * deltaSeconds)
	} else if game.Steering_milli != 0 &&
		(game.Steering_milli < 0) != (control.Steer_milli < 0) {
		steeringStep = int32(6800.0 * deltaSeconds)
	}
	if steeringStep < 1 {
		steeringStep = 1
	}
	game.Steering_milli = blockKartApproachInt32(
		game.Steering_milli, control.Steer_milli, steeringStep,
	)
	steeringValue := float64(game.Steering_milli) / 1000.0
	steeringCurve := math.Pow(math.Abs(steeringValue), 1.25)
	if steeringValue < 0 {
		steeringCurve = -steeringCurve
	}
	maximumWheelAngle := 0.41 - speedRatio * 0.17
	lowSpeedAuthority := blockKartClampFloat64(absoluteSpeed / 5200.0, 0, 1)
	direction := 1.0
	if nextSpeed < -250 {
		direction = -1.0
	}
	desiredYawRate := direction * nextSpeed / 11200.0 *
		math.Tan(steeringCurve * maximumWheelAngle) * lowSpeedAuthority
	maximumYawRate := 1.02 - speedRatio * 0.22
	steeringResponse := 5.6
	if game.Drifting {
		driftArc := float64(game.DriftDirection) * (0.40 + speedRatio * 0.62)
		counterSteer := steeringCurve * (0.28 + speedRatio * 0.15)
		desiredYawRate = (driftArc + counterSteer) * direction
		maximumYawRate = 1.42
		steeringResponse = 4.8
	} else if control.Steer_milli == 0 {
		steeringResponse = 9.0
	}
	desiredYawRate = blockKartClampFloat64(
		desiredYawRate, -maximumYawRate, maximumYawRate,
	)
	steeringBlend := steeringResponse * deltaSeconds
	if steeringBlend > 1 {
		steeringBlend = 1
	}
	yawRate := float64(velocity.Yaw_per_second)
	yawRate += (desiredYawRate - yawRate) * steeringBlend
	if game.Steering_milli == 0 && absoluteSpeed < 500 {
		yawRate = 0
	}
	velocity.Yaw_per_second = int32(yawRate * 1000.0)
	leanTarget := int32(-yawRate * speedRatio * 118.0)
	if leanTarget > 120 {
		leanTarget = 120
	}
	if leanTarget < -120 {
		leanTarget = -120
	}
	game.ChassisLean_milliradians = blockKartApproachInt32(
		game.ChassisLean_milliradians, leanTarget, int32(280.0 * deltaSeconds),
	)
	longitudinalAcceleration := (nextSpeed - speed) / deltaSeconds
	pitchTarget := int32(longitudinalAcceleration / 16000.0 * 52.0)
	if pitchTarget > 62 {
		pitchTarget = 62
	}
	if pitchTarget < -62 {
		pitchTarget = -62
	}
	game.ChassisPitch_milliradians = blockKartApproachInt32(
		game.ChassisPitch_milliradians, pitchTarget, int32(230.0 * deltaSeconds),
	)
	spinStep := int32(nextSpeed * deltaSeconds / 440.0 * 1000.0)
	game.WheelSpin_milliradians = blockKartWrapMilliRadians(
		game.WheelSpin_milliradians + spinStep,
	)
	transform.Yaw_milliradians += int32(yawRate * deltaSeconds * 1000.0)
	transform.Yaw_milliradians = blockKartWrapMilliRadians(transform.Yaw_milliradians)
	heading := float64(transform.Yaw_milliradians) / 1000.0
	forwardX := math.Sin(heading)
	forwardZ := math.Cos(heading)
	rightX := math.Cos(heading)
	rightZ := -math.Sin(heading)
	lateralSpeed := float64(velocity.X_per_second) * rightX +
		float64(velocity.Z_per_second) * rightZ
	grip := 16.0 - speedRatio * 2.0
	if game.Drifting {
		grip = 3.2
	}
	if game.OffRoad {
		grip = 4.2
	}
	if game.Drifting {
		driftCommit := float64(game.Steering_milli * game.DriftDirection) / 1000000.0
		slipRatio := 0.235 + speedRatio * 0.055 + driftCommit * 0.025
		driftLateralTarget := -float64(game.DriftDirection) * absoluteSpeed * slipRatio
		slipBlend := blockKartClampFloat64(3.8 * deltaSeconds, 0, 1)
		lateralSpeed += (driftLateralTarget - lateralSpeed) * slipBlend
	} else {
		gripRetention := 1.0 - grip * deltaSeconds
		if gripRetention < 0 {
			gripRetention = 0
		}
		lateralSpeed *= gripRetention
	}
	maximumLateralSpeed := absoluteSpeed * 0.30
	if game.Drifting {
		maximumLateralSpeed = absoluteSpeed * 0.40
	}
	if lateralSpeed > maximumLateralSpeed {
		lateralSpeed = maximumLateralSpeed
	}
	if lateralSpeed < -maximumLateralSpeed {
		lateralSpeed = -maximumLateralSpeed
	}
	velocity.X_per_second = int64(forwardX * nextSpeed + rightX * lateralSpeed)
	velocity.Z_per_second = int64(forwardZ * nextSpeed + rightZ * lateralSpeed)
	if !game.Transforms.Upsert(game.KartEntity, transform) {
		return errors.New("blockkart: update drive transform")
	}
	if !game.Velocities.Upsert(game.KartEntity, velocity) {
		return errors.New("blockkart: update velocity component")
	}
	state.Elapsed_millis += tick.FixedTickNanos / 1000000
	if state.Boost_ticks != 0 {
		state.Boost_ticks--
	}
	if !game.KartStates.Upsert(game.KartEntity, state) {
		return errors.New("blockkart: update kart state")
	}
	game.BoostPressed = control.Boost || state.Boost_ticks != 0 || miniTurbo
	return nil
}

func blockKartClampFloat64(value float64, minimum float64, maximum float64) float64 {
	if value < minimum {
		return minimum
	}
	if value > maximum {
		return maximum
	}
	return value
}

func blockKartApproachInt32(current int32, target int32, step int32) int32 {
	if current < target {
		current += step
		if current > target {
			return target
		}
		return current
	}
	if current > target {
		current -= step
		if current < target {
			return target
		}
	}
	return current
}

func blockKartWrapMilliRadians(value int32) int32 {
	for value > 3142 {
		value -= 6283
	}
	for value < -3142 {
		value += 6283
	}
	return value
}

func (game *BlockKart) stepPhysics(tick voplay.TickBatch) error {
	velocity, ok := game.Velocities.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: physics velocity")
	}
	if !game.Physics.Submit(physics3d.Command{
		Kind: physics3d.CommandVelocity, Body: game.KartBody,
		Value: [3]int64{velocity.X_per_second, velocity.Y_per_second, velocity.Z_per_second},
	}) {
		return errors.New("blockkart: submit physics velocity")
	}
	game.Contacts, ok = game.Physics.Step(tick.FirstTick, tick.FixedTickNanos)
	if !ok {
		return errors.New("blockkart: step physics")
	}
	snapshot, ok := game.Physics.Snapshot()
	if !ok {
		return errors.New("blockkart: snapshot physics")
	}
	for _, body := range snapshot.Bodies {
		if body.Ref != game.KartBody {
			continue
		}
		transform, found := game.Transforms.Get(game.KartEntity)
		if !found {
			return errors.New("blockkart: physics transform")
		}
		transform.X = body.Position[0]
		transform.Z = body.Position[2]
		road := game.nearestRoadSample(transform)
		transform.Y = road.Y
		if road.Distance_milli <= road.Half_width_milli + 2500 {
			game.LastSafeTransform = transform
		}
		if road.Distance_milli > road.Half_width_milli + 8000 ||
			transform.X < -650000 || transform.X > 650000 ||
			transform.Z < -650000 || transform.Z > 650000 {
			return game.recoverToTrack()
		}
		if !game.Physics.Submit(physics3d.Command{
			Kind: physics3d.CommandTeleport, Body: game.KartBody,
			Value: [3]int64{transform.X, transform.Y, transform.Z},
		}) {
			return errors.New("blockkart: align kart body to road")
		}
		if !game.Transforms.Upsert(game.KartEntity, transform) {
			return errors.New("blockkart: publish physics transform")
		}
		return nil
	}
	return errors.New("blockkart: kart body missing from physics snapshot")
}

func (game *BlockKart) syncRace(tick voplay.TickBatch) error {
	transform, ok := game.Transforms.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: race transform")
	}
	state, ok := game.KartStates.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: race state")
	}
	for _, contact := range game.Contacts {
		var other physics3d.BodyRef
		if contact.A == game.KartBody {
			other = contact.B
		} else if contact.B == game.KartBody {
			other = contact.A
		} else {
			continue
		}
		for _, gate := range game.TrackGates {
			if gate.Body == other && gate.Order == state.Checkpoint + 1 {
				state.Checkpoint++
				break
			}
		}
	}
	if err := game.applyGameplayContacts(&state); err != nil {
		return err
	}
	if state.Checkpoint >= uint32(len(game.TrackGates)) {
		state.Lap++
		state.Checkpoint = 0
		if state.Lap >= 3 {
			state.Finished = true
			if state.Best_millis == 0 || state.Elapsed_millis < state.Best_millis {
				state.Best_millis = state.Elapsed_millis
			}
		}
	}
	if !game.KartStates.Upsert(game.KartEntity, state) {
		return errors.New("blockkart: publish race state")
	}
	if transform.Y < -10000 || transform.X < -650000 || transform.X > 650000 || transform.Z < -650000 ||
		transform.Z > 650000 {
		return game.respawn()
	}
	return nil
}

func (game *BlockKart) frame(tick voplay.TickBatch, pulse []byte) (voplay.TickOutput, error) {
	if err := game.processEndpointReturns(tick); err != nil {
		return voplay.TickOutput{}, err
	}
	assetPackets, err := game.processAssetLifecycle(tick)
	if err != nil {
		return voplay.TickOutput{}, err
	}
	framePulse, decodedPulse := render.DecodeFramePulse(pulse)
	if !decodedPulse {
		return voplay.TickOutput{}, errors.New("blockkart: decode presentation pulse")
	}
	if err := game.updateRenderMetrics(framePulse.Metrics); err != nil {
		return voplay.TickOutput{}, err
	}
	if game.RenderWorldPublished && game.RenderAssetsPublished {
		game.RenderPulseCounter++
	}
	if game.RenderWorldPublished && game.RenderAssetsPublished &&
		(game.RenderPulseCounter % 2 == 0 ||
			game.LastRenderDeadlineNanos != 0 &&
				framePulse.DeadlineNanos > game.LastRenderDeadlineNanos &&
				framePulse.DeadlineNanos - game.LastRenderDeadlineNanos < 50000000) {
		game.RenderRevision++
		noOpPacket, encoded := render.EncodeTransactionPacket(
			game.Engine, 1, framePulse.PulseId, game.RenderRevision - 1, game.RenderRevision,
			game.RenderControls.Revision, tick.FirstTick, []render.TransactionOp{},
		)
		if !encoded {
			return voplay.TickOutput{}, errors.New("blockkart: encode retained no-op frame")
		}
		return voplay.TickOutput{
			RenderPackets: [][]byte{noOpPacket},
			AssetPackets: assetPackets,
		}, nil
	}
	game.LastRenderDeadlineNanos = framePulse.DeadlineNanos
	transform, ok := game.Transforms.Get(game.KartEntity)
	if !ok {
		return voplay.TickOutput{}, errors.New("blockkart: extract transform")
	}
	state, ok := game.KartStates.Get(game.KartEntity)
	if !ok {
		return voplay.TickOutput{}, errors.New("blockkart: extract race state")
	}
	kartPackets, kartEncoded := game.kartRenderPackets(transform, tick.FirstTick)
	if !kartEncoded {
		return voplay.TickOutput{}, errors.New("blockkart: encode retained kart")
	}
	rivalObjects, rivalsEncoded := game.rivalRenderObjects(tick.FirstTick)
	if !rivalsEncoded {
		return voplay.TickOutput{}, errors.New("blockkart: encode rival karts")
	}
	poseBytes := blockKartTransformBytes(transform)
	previous, _ := game.RenderPoses.Get(game.KartEntity)
	if !game.RenderPoses.Upsert(game.KartEntity, RenderPose{
		Previous_tick: previous.Current_tick, Current_tick: tick.FirstTick,
		Previous_transform: previous.Current_transform, Current_transform: poseBytes,
	}) {
		return voplay.TickOutput{}, errors.New("blockkart: publish render pose")
	}
	gameplayObjects, ok := game.gameplayRenderPackets(tick.FirstTick)
	if !ok {
		return voplay.TickOutput{}, errors.New("blockkart: encode gameplay entities")
	}
	checkpointObjects := []render.SnapshotObject{}
	effectObjects, ok := game.effectRenderObjects(transform, tick.FirstTick)
	if !ok {
		return voplay.TickOutput{}, errors.New("blockkart: encode driving effects")
	}
	camera := game.cameraPacket(transform, tick.FirstTick)
	if len(camera) == 0 {
		return voplay.TickOutput{}, errors.New("blockkart: encode camera")
	}
	hud := game.hudPackets(false)
	if len(hud) == 0 {
		return voplay.TickOutput{}, errors.New("blockkart: encode HUD")
	}
	dynamicObjects := make([]render.SnapshotObject, 0, len(kartPackets) + len(rivalObjects) + len(gameplayObjects) +
		len(checkpointObjects) + len(effectObjects) + len(hud) + 1)
	for index, bytes := range kartPackets {
		dynamicObjects = append(dynamicObjects, render.SnapshotObject{
			Entity: voplay.Handle{Index: uint32(100 + index), Generation: 1}, Bytes: bytes,
		})
	}
	dynamicObjects = append(dynamicObjects, rivalObjects...)
	dynamicObjects = append(dynamicObjects, gameplayObjects...)
	dynamicObjects = append(dynamicObjects, checkpointObjects...)
	dynamicObjects = append(dynamicObjects, effectObjects...)
	dynamicObjects = append(dynamicObjects, render.SnapshotObject{
		Entity: voplay.Handle{Index: 900001, Generation: 1}, Bytes: camera,
	})
	dynamicObjects = append(dynamicObjects, hud...)
	blockKartSortSnapshotObjects(dynamicObjects)
	game.RenderRevision++
	renderPacket := []byte{}
	renderEncoded := false
	if !game.RenderWorldPublished {
		objects := make([]render.SnapshotObject, 0, len(game.StaticRenderPackets) + len(dynamicObjects))
		for index, bytes := range game.StaticRenderPackets {
			objects = append(objects, render.SnapshotObject{
				Entity: voplay.Handle{Index: uint32(1000 + index), Generation: 1}, Bytes: bytes,
			})
		}
		objects = append(objects, dynamicObjects...)
		blockKartSortSnapshotObjects(objects)
		renderPacket, renderEncoded = render.EncodeSnapshotPacket(
			game.Engine, 1, framePulse.PulseId, game.RenderRevision,
			game.RenderControls.Revision, tick.FirstTick, objects,
		)
		if renderEncoded {
			game.RenderLiveDynamicEntities = blockKartDynamicEntitySet(dynamicObjects)
			for _, object := range dynamicObjects {
				game.RenderLastDynamicPackets[object.Entity.Index] = object.Bytes
			}
			game.RenderWorldPublished = true
		}
	} else {
		ops := game.renderTransactionOps(dynamicObjects)
		renderPacket, renderEncoded = render.EncodeTransactionPacket(
			game.Engine, 1, framePulse.PulseId, game.RenderRevision - 1, game.RenderRevision,
			game.RenderControls.Revision, tick.FirstTick, ops,
		)
	}
	if !renderEncoded {
		return voplay.TickOutput{}, errors.New("blockkart: encode retained render update")
	}
	output := voplay.TickOutput{AssetPackets: assetPackets}
	if !game.RenderControlPublished {
		controlPacket, controlEncoded := game.RenderControls.EncodeSnapshotPacket(game.Engine, 1)
		if !controlEncoded {
			return voplay.TickOutput{}, errors.New("blockkart: encode render control")
		}
		output.RenderPackets = append(output.RenderPackets, controlPacket)
		game.RenderControlPublished = true
	}
	if !game.RenderAssetsPublished {
		if int(game.RenderAssetCursor) < len(game.RenderAssetPackets) {
			output.RenderPackets = append(
				output.RenderPackets,
				game.RenderAssetPackets[game.RenderAssetCursor],
			)
			game.RenderAssetCursor++
		}
		if int(game.RenderAssetCursor) == len(game.RenderAssetPackets) {
			game.RenderAssetsPublished = true
		}
	}
	output.RenderPackets = append(output.RenderPackets, renderPacket)
	if game.LastAudioControlTick == 0 || tick.FirstTick >= game.LastAudioControlTick + 5 {
		if err := game.updateAudio(transform, tick.FirstTick); err != nil {
			return voplay.TickOutput{}, err
		}
		game.LastAudioControlTick = tick.FirstTick
	}
	if game.LastAudioSnapshotRevision != game.Audio.Revision {
		audioSnapshot, encoded := game.Audio.EncodeSnapshotPacket(game.Engine, 1)
		if !encoded {
			return voplay.TickOutput{}, errors.New("blockkart: encode audio state")
		}
		output.AudioPackets = append(output.AudioPackets, audioSnapshot)
		game.LastAudioSnapshotRevision = game.Audio.Revision
	}
	if !game.AudioAssetsPublished {
		output.AudioPackets = append(output.AudioPackets, game.AudioAssetPackets...)
		game.AudioAssetsPublished = true
	}
	if game.BoostPressed && tick.FirstTick >= game.LastBoostAudioTick + uint64(blockKartTicksPerSecond) {
		packet, eventEncoded := game.audioOneShot(game.BoostAudioAsset, 700, tick.FirstTick, framePulse.DeadlineNanos /
			1000000)
		if !eventEncoded {
			return voplay.TickOutput{}, errors.New("blockkart: encode boost audio event")
		}
		if len(packet) != 0 {
			output.AudioPackets = append(output.AudioPackets, packet)
			game.LastBoostAudioTick = tick.FirstTick
		}
	}
	if game.HitAudioPending {
		packet, eventEncoded := game.audioOneShot(game.HitAudioAsset, 820, tick.FirstTick, framePulse.DeadlineNanos /
			1000000)
		if !eventEncoded {
			return voplay.TickOutput{}, errors.New("blockkart: encode collision audio event")
		}
		if len(packet) != 0 {
			output.AudioPackets = append(output.AudioPackets, packet)
			game.HitAudioPending = false
		}
	}
	if game.Drifting && tick.FirstTick >= game.LastSkidAudioTick + uint64(blockKartTicksPerSecond * 3 / 5) {
		packet, eventEncoded := game.audioOneShot(game.SkidAudioAsset, 520, tick.FirstTick, framePulse.DeadlineNanos /
			1000000)
		if !eventEncoded {
			return voplay.TickOutput{}, errors.New("blockkart: encode skid audio event")
		}
		if len(packet) != 0 {
			output.AudioPackets = append(output.AudioPackets, packet)
			game.LastSkidAudioTick = tick.FirstTick
		}
	}
	if game.OffRoad && tick.FirstTick >= game.LastGrassAudioTick + uint64(blockKartTicksPerSecond * 4 / 5) {
		packet, eventEncoded := game.audioOneShot(game.GrassAudioAsset, 430, tick.FirstTick, framePulse.DeadlineNanos /
			1000000)
		if !eventEncoded {
			return voplay.TickOutput{}, errors.New("blockkart: encode grass audio event")
		}
		if len(packet) != 0 {
			output.AudioPackets = append(output.AudioPackets, packet)
			game.LastGrassAudioTick = tick.FirstTick
		}
	}
	return output, nil
}

func (game *BlockKart) audioOneShot(asset uint64, gain int32, tick uint64, deadlineMillis uint64) ([]byte, bool) {
	if game.AudioAssetAcks[uint64(uint32(asset)) | uint64(1) << 32] == 0 {
		return nil, true
	}
	oneShot := audio.EncodeOneShot(audio.OneShot{
		AssetIndex: uint32(asset), AssetGeneration: 1, Bus: audio.AudioBusRef{Index: 1, Generation: 1},
		GainMilli: gain, Tick: tick,
	})
	if len(oneShot) == 0 {
		return nil, false
	}
	game.AudioSequence++
	return audio.EncodeEventPacket(game.Engine, 1, game.AudioSequence, game.AudioSequence, tick, game.Audio.Revision, deadlineMillis, oneShot)
}

func (game *BlockKart) processEndpointReturns(tick voplay.TickBatch) error {
	if game.RenderAssetAcks == nil {
		game.RenderAssetAcks = map[uint64]uint64{}
	}
	if game.AudioAssetAcks == nil {
		game.AudioAssetAcks = map[uint64]uint64{}
	}
	for _, packet := range tick.RenderReturns {
		ack, ok := render.DecodeAssetAck(game.Engine, packet)
		if !ok {
			continue
		}
		key := ack.Asset | uint64(ack.Kind) << 56
		if current, found := game.RenderAssetAcks[key]; !found || current < ack.Revision {
			game.RenderAssetAcks[key] = ack.Revision
		}
	}
	for _, packet := range tick.AudioReturns {
		ack, ok := audio.DecodeAssetAck(game.Engine, packet)
		if !ok {
			continue
		}
		key := uint64(ack.Asset.Index) | uint64(ack.Asset.Generation) << 32
		if current, found := game.AudioAssetAcks[key]; !found || current < ack.Revision {
			game.AudioAssetAcks[key] = ack.Revision
		}
		if ack.Asset.Index == uint32(game.EngineAudioAsset) {
			source, found := game.Audio.Source(game.EngineAudioSource)
			if !found {
				return errors.New("blockkart: activate resident engine audio")
			}
			if !source.Playing {
				source.Playing = true
				if _, committed := game.Audio.Commit(audio.ControlTransaction{
					ExpectedRevision: game.Audio.Revision,
					Operations: []audio.ControlOperation{
						{Kind: audio.ControlUpdateSource, Source: game.EngineAudioSource, SourceValue: source},
					},
				}); !committed {
					return errors.New("blockkart: start resident engine audio")
				}
			}
		}
	}
	return nil
}

func blockKartSortSnapshotObjects(objects []render.SnapshotObject) {
	for index := 1; index < len(objects); index++ {
		value := objects[index]
		position := index
		for position > 0 &&
			(objects[position - 1].Entity.Index > value.Entity.Index ||
				objects[position - 1].Entity.Index == value.Entity.Index &&
					objects[position - 1].Entity.Generation > value.Entity.Generation) {
			objects[position] = objects[position - 1]
			position--
		}
		objects[position] = value
	}
}

func blockKartDynamicEntitySet(objects []render.SnapshotObject) map[uint32]bool {
	entities := map[uint32]bool{}
	for _, object := range objects {
		entities[object.Entity.Index] = true
	}
	return entities
}

func (game *BlockKart) renderTransactionOps(objects []render.SnapshotObject) []render.TransactionOp {
	current := blockKartDynamicEntitySet(objects)
	ops := make([]render.TransactionOp, 0, len(objects) + len(game.RenderLiveDynamicEntities))
	for _, object := range objects {
		previous := game.RenderLastDynamicPackets[object.Entity.Index]
		if game.RenderLiveDynamicEntities[object.Entity.Index] &&
			blockKartBytesEqual(previous, object.Bytes) {
			continue
		}
		kind := render.TransactionUpsert
		if !game.RenderLiveDynamicEntities[object.Entity.Index] {
			kind = render.TransactionSpawn
		}
		ops = append(ops, render.TransactionOp{
			Kind: kind, Entity: object.Entity, Bytes: object.Bytes,
		})
		game.RenderLastDynamicPackets[object.Entity.Index] = object.Bytes
	}
	for entity := range game.RenderLiveDynamicEntities {
		if !current[entity] {
			ops = append(ops, render.TransactionOp{
				Kind: render.TransactionDespawn,
				Entity: voplay.Handle{Index: entity, Generation: 1},
			})
			delete(game.RenderLastDynamicPackets, entity)
		}
	}
	game.RenderLiveDynamicEntities = current
	return ops
}

func blockKartBytesEqual(left []byte, right []byte) bool {
	if len(left) != len(right) {
		return false
	}
	for index, value := range left {
		if right[index] != value {
			return false
		}
	}
	return true
}

func (game *BlockKart) updateAudio(transform Transform, tick uint64) error {
	source, ok := game.Audio.Source(game.EngineAudioSource)
	if !ok {
		return errors.New("blockkart: engine audio source")
	}
	velocity, ok := game.Velocities.Get(game.KartEntity)
	if !ok {
		return errors.New("blockkart: engine audio velocity")
	}
	speed := velocity.Z_per_second
	if speed < 0 {
		speed = -speed
	}
	gain := int32(280 + speed / 80)
	if gain > 900 {
		gain = 900
	}
	source.GainMilli = gain
	source.TransportTick = tick
	source.Spatial = &audio.SpatialSource{
		PositionMilli: [3]int32{int32(transform.X), int32(transform.Y), int32(transform.Z)},
		MinDistanceMilli: 1000, MaxDistanceMilli: 80000,
	}
	heading := float64(transform.Yaw_milliradians) / 1000.0
	_, ok = game.Audio.Commit(audio.ControlTransaction{
		ExpectedRevision: game.Audio.Revision,
		Operations: []audio.ControlOperation{
			{Kind: audio.ControlUpdateSource, Source: game.EngineAudioSource, SourceValue: source},
			{
				Kind: audio.ControlSetListener,
				ListenerValue: audio.Listener{
					PositionMilli: [3]int32{int32(transform.X), int32(transform.Y + 8500), int32(transform.Z)},
					ForwardMilli: [3]int32{int32(math.Sin(heading) * 1000), 0, int32(math.Cos(heading) * 1000)},
					UpMilli: [3]int32{0, 1000, 0},
				},
			},
		},
	})
	if !ok {
		return errors.New("blockkart: update audio control")
	}
	return nil
}

func (game *BlockKart) hudPackets(includeStatic bool) []render.SnapshotObject {
	state, ok := game.KartStates.Get(game.KartEntity)
	if !ok {
		return nil
	}
	speed := state.Speed_per_second
	if speed < 0 {
		speed = -speed
	}
	speedKph := uint64(speed * 36 / 10000)
	if speedKph > 199 {
		speedKph = 199
	}
	staticShapes := []render2d.Shape{
		{
			Id: 1, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{22000, 18000, 226000, 70000},
			RadiusMilli: 12000, Fill: [4]byte{5, 13, 24, 168}, StrokeMilli: 1400,
			Stroke: [4]byte{80, 133, 162, 118}, Z: 100, Layers: 2,
		},
		{
			Id: 2, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{520000, 18000, 240000, 66000},
			RadiusMilli: 12000, Fill: [4]byte{5, 13, 24, 154}, StrokeMilli: 1400,
			Stroke: [4]byte{255, 199, 63, 145}, Z: 100, Layers: 2,
		},
		{
			Id: 3, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{1042000, 18000, 214000, 154000},
			RadiusMilli: 15000, Fill: [4]byte{5, 13, 24, 152}, StrokeMilli: 1400,
			Stroke: [4]byte{125, 169, 194, 105}, Z: 100, Layers: 2,
		},
		{
			Id: 4, Kind: render2d.ShapeCircle, Bounds: [4]int64{1066000, 510000, 180000, 180000},
			Fill: [4]byte{4, 11, 20, 174}, StrokeMilli: 4200,
			Stroke: [4]byte{25, 49, 68, 190}, Z: 100, Layers: 2,
		},
		{
			Id: 5, Kind: render2d.ShapeCircle, Bounds: [4]int64{1080000, 524000, 152000, 152000},
			Fill: [4]byte{7, 19, 33, 188}, StrokeMilli: 1600,
			Stroke: [4]byte{70, 102, 124, 128}, Z: 101, Layers: 2,
		},
		{
			Id: 6, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{22000, 624000, 318000, 66000},
			RadiusMilli: 13000, Fill: [4]byte{5, 13, 24, 166}, StrokeMilli: 1400,
			Stroke: [4]byte{117, 155, 181, 112}, Z: 100, Layers: 2,
		},
		{
			Id: 7, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{42000, 669000, 278000, 9000},
			RadiusMilli: 4500, Fill: [4]byte{20, 41, 56, 225}, Z: 102, Layers: 2,
		},
		{
			Id: 8, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{482000, 701000, 316000, 7000},
			RadiusMilli: 3500, Fill: [4]byte{17, 34, 50, 158}, Z: 100, Layers: 2,
		},
		{
			Id: 9, Kind: render2d.ShapePath, Bounds: [4]int64{1030000, 34000, 210000, 136000},
				Path: blockKartMinimapPath(), Fill: [4]byte{0, 0, 0, 0}, StrokeMilli: 6500,
				Stroke: [4]byte{42, 74, 93, 205}, Z: 104, Layers: 2,
		},
		{
			Id: 10, Kind: render2d.ShapePath, Bounds: [4]int64{1030000, 34000, 210000, 136000},
				Path: blockKartMinimapPath(), Fill: [4]byte{0, 0, 0, 0}, StrokeMilli: 2200,
				Stroke: [4]byte{224, 239, 244, 235}, Z: 105, Layers: 2,
		},
		{
			Id: 11, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{22000, 18000, 6000, 70000},
			RadiusMilli: 3000, Fill: [4]byte{35, 211, 250, 240}, Z: 103, Layers: 2,
		},
	}
	for index, point := range blockKartTrackPoints() {
		mapX, mapY := blockKartMinimapPoint(point[0], point[2])
		color := [4]byte{218, 236, 245, 238}
		radius := int64(3100)
		if index % 4 == 0 {
			color = [4]byte{39, 209, 246, 255}
			radius = 4300
		}
		staticShapes = append(staticShapes, render2d.Shape{
			Id: uint64(20 + index), Kind: render2d.ShapeCircle,
			Bounds: [4]int64{mapX - radius, mapY - radius, radius * 2, radius * 2},
			Fill: color, StrokeMilli: 900, Stroke: [4]byte{5, 13, 24, 230},
			Z: 108, Layers: 2,
		})
	}
	shapes := []render2d.Shape{}
	if includeStatic {
		shapes = append(shapes, staticShapes...)
	}
	driftWidth := int64(game.DriftCharge_milli) * 278000 / 1800
	driftColor := [4]byte{255, 192, 55, 255}
	if game.DriftStage == 2 {
		driftColor = [4]byte{38, 211, 255, 255}
	}
	if game.DriftStage >= 3 {
		driftColor = [4]byte{255, 82, 65, 255}
	}
	shapes = append(shapes, render2d.Shape{
		Id: 100, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{42000, 669000, driftWidth + 1, 9000},
		RadiusMilli: 4500, Fill: driftColor, Z: 112, Layers: 2,
	})
	boostWidth := int64(0)
	if game.BoostPressed {
		boostWidth = 316000
	}
	shapes = append(shapes, render2d.Shape{
		Id: 101, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{482000, 701000, boostWidth + 1, 7000},
		RadiusMilli: 3500, Fill: [4]byte{33, 218, 255, 222}, Z: 112, Layers: 2,
	})
	activeSpeedDots := int(speedKph * 14 / 150)
	if activeSpeedDots > 14 {
		activeSpeedDots = 14
	}
	for index := 0; index < 14; index++ {
		angle := -2.35 + float64(index) / 13.0 * 4.70
		x := int64(1156000.0 + math.Cos(angle) * 73000.0)
		y := int64(600000.0 + math.Sin(angle) * 73000.0)
		color := [4]byte{34, 57, 73, 240}
		if index < activeSpeedDots {
			color = [4]byte{39, 209, 246, 255}
			if index >= 10 {
				color = [4]byte{255, 190, 55, 255}
			}
		}
		shapes = append(shapes, render2d.Shape{
			Id: uint64(120 + index), Kind: render2d.ShapeCircle,
			Bounds: [4]int64{x - 5200, y - 5200, 10400, 10400},
			Fill: color, Z: 113, Layers: 2,
		})
	}
	if transform, transformOk := game.Transforms.Get(game.KartEntity); transformOk {
		mapX, mapY := blockKartMinimapPoint(transform.X, transform.Z)
		shapes = append(shapes, render2d.Shape{
			Id: 140, Kind: render2d.ShapeCircle, Bounds: [4]int64{mapX - 7500, mapY - 7500, 15000, 15000},
			Fill: [4]byte{255, 198, 58, 255}, StrokeMilli: 2200,
			Stroke: [4]byte{255, 255, 255, 255}, Z: 116, Layers: 2,
		})
	}
	if state.Countdown_ticks != 0 || game.StartFlash_ticks != 0 {
		shapes = append(shapes, render2d.Shape{
			Id: 150, Kind: render2d.ShapeCircle, Bounds: [4]int64{560000, 250000, 160000, 160000},
			Fill: [4]byte{6, 17, 30, 210}, StrokeMilli: 9000,
			Stroke: [4]byte{255, 198, 58, 245}, Z: 130, Layers: 2,
		})
	}
	if game.Paused || state.Finished {
		shapes = append(shapes, render2d.Shape{
			Id: 151, Kind: render2d.ShapeRect, Bounds: [4]int64{0, 0, 1280000, 720000},
			Fill: [4]byte{2, 7, 14, 175}, Z: 130, Layers: 2,
		}, render2d.Shape{
			Id: 152, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{360000, 220000, 560000, 270000},
			RadiusMilli: 26000, Fill: [4]byte{8, 20, 35, 242}, StrokeMilli: 4000,
			Stroke: [4]byte{255, 198, 58, 230}, Z: 132, Layers: 2,
		})
	}
	if game.RenderWidth <= 1000 || game.RenderHeight > game.RenderWidth {
		shapes = game.appendTouchHud(shapes)
	}

	lapText := []byte{byte(49 + state.Lap), ' ', '/', ' ', '3'}
	if state.Lap >= 3 {
		lapText[0] = '3'
	}
	staticTexts := []render2d.TextRun{
		{Id: 1, Font: 1, Text: []byte("ALPINE ASCENT"), Position: [2]int64{41000, 44000}, SizeMilli: 17000, Color: [4]byte{255, 255, 255, 250}, Z: 180, Layers: 2},
		{Id: 2, Font: 1, Text: []byte("TIME ATTACK"), Position: [2]int64{42000, 72000}, SizeMilli: 9000, Color: [4]byte{39, 209, 246, 240}, Z: 180, Layers: 2},
		{Id: 3, Font: 1, Text: []byte("LAP"), Position: [2]int64{188000, 41000}, SizeMilli: 9000, Color: [4]byte{174, 203, 220, 230}, Z: 180, Layers: 2},
		{Id: 4, Font: 1, Text: []byte("RACE TIME"), Position: [2]int64{602000, 35000}, SizeMilli: 9000, Color: [4]byte{174, 203, 220, 220}, Z: 180, Layers: 2},
		{Id: 5, Font: 1, Text: []byte("COURSE"), Position: [2]int64{1060000, 38000}, SizeMilli: 8500, Color: [4]byte{174, 203, 220, 220}, Z: 180, Layers: 2},
		{Id: 6, Font: 1, Text: []byte("DRIFT"), Position: [2]int64{42000, 649000}, SizeMilli: 10000, Color: [4]byte{222, 235, 243, 235}, Z: 180, Layers: 2},
		{Id: 7, Font: 1, Text: []byte("KM/H"), Position: [2]int64{1136000, 650000}, SizeMilli: 9000, Color: [4]byte{166, 194, 211, 220}, Z: 180, Layers: 2},
		{Id: 8, Font: 1, Text: []byte("W  DRIVE    A/D  STEER    SPACE  DRIFT    SHIFT  BOOST"), Position: [2]int64{430000, 716000}, SizeMilli: 8500, Color: [4]byte{209, 227, 237, 142}, Z: 180, Layers: 2},
	}
	texts := []render2d.TextRun{}
	if includeStatic {
		texts = append(texts, staticTexts...)
	}
	texts = append(texts,
		render2d.TextRun{Id: 10, Font: 1, Text: lapText, Position: [2]int64{185000, 72000}, SizeMilli: 18000, Color: [4]byte{255, 198, 58, 255}, Z: 182, Layers: 2},
		render2d.TextRun{Id: 11, Font: 1, Text: blockKartRaceTimeText(state.Elapsed_millis), Position: [2]int64{565000, 70000}, SizeMilli: 27000, Color: [4]byte{255, 255, 255, 250}, Z: 182, Layers: 2},
		render2d.TextRun{Id: 12, Font: 1, Text: blockKartDecimalText(speedKph, 3), Position: [2]int64{1107000, 625000}, SizeMilli: 42000, Color: [4]byte{255, 255, 255, 250}, Z: 182, Layers: 2},
	)
	if game.DriftStage != 0 {
		stageText := []byte("CHARGED")
		if game.DriftStage == 2 {
			stageText = []byte("SUPER")
		}
		if game.DriftStage >= 3 {
			stageText = []byte("ULTRA")
		}
		texts = append(texts, render2d.TextRun{
			Id: 13, Font: 1, Text: stageText, Position: [2]int64{245000, 649000}, SizeMilli: 10000,
			Color: driftColor, Z: 182, Layers: 2,
		})
	}
	if state.Countdown_ticks != 0 || game.StartFlash_ticks != 0 {
		countdownText := []byte("GO!")
		if state.Countdown_ticks != 0 {
			countdown := uint64(
				(state.Countdown_ticks + blockKartTicksPerSecond - 1) / blockKartTicksPerSecond,
			)
			countdownText = blockKartDecimalText(countdown, 1)
		}
		texts = append(texts, render2d.TextRun{
			Id: 14, Font: 1, Text: countdownText, Position: [2]int64{598000, 355000},
			SizeMilli: 69000, Color: [4]byte{255, 255, 255, 255}, Z: 184, Layers: 2,
		})
	}
	if game.Paused {
		texts = append(texts,
			render2d.TextRun{Id: 15, Font: 1, Text: []byte("RACE PAUSED"), Position: [2]int64{492000, 305000}, SizeMilli: 44000, Color: [4]byte{255, 255, 255, 255}, Z: 184, Layers: 2},
			render2d.TextRun{Id: 16, Font: 1, Text: []byte("PRESS P TO RESUME"), Position: [2]int64{515000, 392000}, SizeMilli: 18000, Color: [4]byte{39, 209, 246, 255}, Z: 184, Layers: 2},
		)
	}
	if state.Finished {
		texts = append(texts,
			render2d.TextRun{Id: 17, Font: 1, Text: []byte("FINISH!"), Position: [2]int64{535000, 290000}, SizeMilli: 52000, Color: [4]byte{255, 198, 58, 255}, Z: 184, Layers: 2},
			render2d.TextRun{Id: 18, Font: 1, Text: blockKartRaceTimeText(state.Elapsed_millis), Position: [2]int64{525000, 370000}, SizeMilli: 36000, Color: [4]byte{255, 255, 255, 255}, Z: 184, Layers: 2},
			render2d.TextRun{Id: 19, Font: 1, Text: []byte("R  RUN AGAIN"), Position: [2]int64{550000, 438000}, SizeMilli: 17000, Color: [4]byte{39, 209, 246, 255}, Z: 184, Layers: 2},
		)
	}

	objects := make([]render.SnapshotObject, 0, len(shapes) + len(texts))
	for _, shape := range shapes {
		packet := []byte{}
		if shape.Id < 100 {
			packet = game.HudStaticPackets[shape.Id]
		}
		if len(packet) == 0 {
			packet = render2d.EncodeShape(shape)
			if shape.Id < 100 {
				game.HudStaticPackets[shape.Id] = packet
			}
		}
		if len(packet) == 0 {
			return nil
		}
		objects = append(objects, render.SnapshotObject{
			Entity: voplay.Handle{Index: uint32(910000 + shape.Id), Generation: 1}, Bytes: packet,
		})
	}
	for _, text := range texts {
		packet := []byte{}
		if text.Id < 10 {
			cacheKey := uint64(1000 + text.Id)
			packet = game.HudStaticPackets[cacheKey]
			if len(packet) == 0 {
				packet = render2d.EncodeText(text)
				game.HudStaticPackets[cacheKey] = packet
			}
		} else {
			packet = render2d.EncodeText(text)
		}
		if len(packet) == 0 {
			return nil
		}
		objects = append(objects, render.SnapshotObject{
			Entity: voplay.Handle{Index: uint32(920000 + text.Id), Generation: 1}, Bytes: packet,
		})
	}
	return objects
}

func blockKartMinimapPath() []int64 {
	points := blockKartTrackPoints()
	path := make([]int64, 0, (len(points) + 1) * 2)
	for _, point := range points {
		x, y := blockKartMinimapPoint(point[0], point[2])
		path = append(path, x, y)
	}
	if len(path) >= 2 {
		path = append(path, path[0], path[1])
	}
	return path
}

func blockKartMinimapPoint(x int64, z int64) (int64, int64) {
	return int64(1048000) + (x + 55000) * 190000 / 345000,
		int64(43000) + (85000 - z) * 116000 / 408000
}

func blockKartRaceTimeText(milliseconds uint64) []byte {
	minutes := milliseconds / 60000
	if minutes > 99 {
		minutes = 99
	}
	seconds := milliseconds / 1000 % 60
	tenths := milliseconds / 100 % 10
	return []byte{
		byte(48 + minutes / 10), byte(48 + minutes % 10), ':',
		byte(48 + seconds / 10), byte(48 + seconds % 10), '.',
		byte(48 + tenths),
	}
}

func (game *BlockKart) hudPacketsLegacy(includeStatic bool) []render.SnapshotObject {
	state, ok := game.KartStates.Get(game.KartEntity)
	if !ok || len(game.TrackGates) == 0 {
		return nil
	}
	progress := state.Checkpoint * 360 / uint32(len(game.TrackGates))
	shapes := []render2d.Shape{
		{
			Id: 1, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{24000, 22000, 420000, 112000},
			RadiusMilli: 10000, Fill: [4]byte{8, 18, 30, 225}, StrokeMilli: 2000,
			Stroke: [4]byte{45, 166, 218, 190}, Z: 100, Layers: 2,
		},
		{
			Id: 2, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{42000, 110000, 360000, 10000},
			RadiusMilli: 5000, Fill: [4]byte{32, 48, 62, 255}, Z: 101, Layers: 2,
		},
		{
			Id: 3, Kind: render2d.ShapeRoundedRect,
			Bounds: [4]int64{42000, 110000, int64(progress + 1) * 1000, 10000}, RadiusMilli: 5000,
			Fill: [4]byte{246, 184, 48, 255}, Z: 102, Layers: 2,
		},
		{
			Id: 18, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{540000, 20000, 200000, 90000},
			RadiusMilli: 10000, Fill: [4]byte{8, 18, 30, 215}, StrokeMilli: 2000,
			Stroke: [4]byte{246, 184, 48, 170}, Z: 100, Layers: 2,
		},
	}
	speed := state.Speed_per_second
	if speed < 0 {
		speed = -speed
	}
	speedWidth := speed * 180 / 34000
	if speedWidth > 180 {
		speedWidth = 180
	}
	shapes = append(shapes, render2d.Shape{
		Id: 6, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{1020000, 590000, 230000, 100000},
		RadiusMilli: 12000, Fill: [4]byte{8, 18, 30, 225}, StrokeMilli: 2000,
		Stroke: [4]byte{238, 78, 48, 180}, Z: 100, Layers: 2,
	}, render2d.Shape{
		Id: 7, Kind: render2d.ShapeRoundedRect,
		Bounds: [4]int64{1035000, 670000, (speedWidth + 1) * 1000, 9000}, RadiusMilli: 4500,
		Fill: [4]byte{238, 78, 48, 255}, Z: 102, Layers: 2,
	})
	if state.Boost_ticks != 0 || game.BoostPressed {
		shapes = append(shapes, render2d.Shape{
			Id: 8, Kind: render2d.ShapeCircle, Bounds: [4]int64{1210000, 600000, 36000, 36000},
			Fill: [4]byte{32, 206, 255, 240}, Z: 103, Layers: 2,
		})
	}
	if state.Countdown_ticks != 0 {
		color := [4]byte{246, 84, 54, 240}
		if state.Countdown_ticks <= 2 * blockKartTicksPerSecond {
			color = [4]byte{246, 184, 48, 240}
		}
		if state.Countdown_ticks <= blockKartTicksPerSecond {
			color = [4]byte{84, 220, 116, 240}
		}
		shapes = append(shapes, render2d.Shape{
			Id: 9, Kind: render2d.ShapeCircle, Bounds: [4]int64{600000, 260000, 80000, 80000}, Fill: color,
			StrokeMilli: 5000, Stroke: [4]byte{255, 255, 255, 230}, Z: 120, Layers: 2,
		})
	}
	if game.Paused {
		shapes = append(shapes, render2d.Shape{
			Id: 10, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{390000, 300000, 500000, 120000},
			RadiusMilli: 18000, Fill: [4]byte{8, 12, 20, 220}, StrokeMilli: 3000,
			Stroke: [4]byte{255, 255, 255, 180}, Z: 130, Layers: 2,
		}, render2d.Shape{
			Id: 12, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{590000, 330000, 22000, 62000},
			RadiusMilli: 7000, Fill: [4]byte{255, 255, 255, 230}, Z: 132, Layers: 2,
		}, render2d.Shape{
			Id: 13, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{630000, 330000, 22000, 62000},
			RadiusMilli: 7000, Fill: [4]byte{255, 255, 255, 230}, Z: 132, Layers: 2,
		})
	}
	if state.Finished {
		shapes = append(shapes, render2d.Shape{
			Id: 11, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{340000, 245000, 600000, 230000},
			RadiusMilli: 26000, Fill: [4]byte{14, 22, 34, 235}, StrokeMilli: 6000,
			Stroke: [4]byte{246, 184, 48, 255}, Z: 140, Layers: 2,
		}, render2d.Shape{
			Id: 14, Kind: render2d.ShapeRect, Bounds: [4]int64{565000, 300000, 36000, 36000},
			Fill: [4]byte{255, 255, 255, 255}, Z: 142, Layers: 2,
		}, render2d.Shape{
			Id: 15, Kind: render2d.ShapeRect, Bounds: [4]int64{601000, 336000, 36000, 36000},
			Fill: [4]byte{255, 255, 255, 255}, Z: 142, Layers: 2,
		}, render2d.Shape{
			Id: 16, Kind: render2d.ShapeRect, Bounds: [4]int64{601000, 300000, 36000, 36000},
			Fill: [4]byte{20, 24, 32, 255}, Z: 142, Layers: 2,
		}, render2d.Shape{
			Id: 17, Kind: render2d.ShapeRect, Bounds: [4]int64{565000, 336000, 36000, 36000},
			Fill: [4]byte{20, 24, 32, 255}, Z: 142, Layers: 2,
		})
	}
	countdown := uint64(0)
	if state.Countdown_ticks != 0 {
		countdown = uint64(
			(state.Countdown_ticks + blockKartTicksPerSecond - 1) /
				blockKartTicksPerSecond,
		)
	}
	lapValue := uint64(state.Lap + 1)
	if lapValue > 3 {
		lapValue = 3
	}
	speedValue := uint64(speed / 1000)
	if speedValue > 99 {
		speedValue = 99
	}
	elapsedSeconds := state.Elapsed_millis / 1000
	if elapsedSeconds > 999 {
		elapsedSeconds = 999
	}
	if game.RenderWidth <= 1000 || game.RenderHeight > game.RenderWidth {
		shapes = game.appendTouchHud(shapes)
	}
	if game.DebugOverlayVisible {
		shapes = append(shapes, render2d.Shape{
			Id: 700, Kind: render2d.ShapeRoundedRect, Bounds: [4]int64{880000, 26000, 360000, 150000},
			RadiusMilli: 12000, Fill: [4]byte{4, 10, 18, 225}, StrokeMilli: 2000,
			Stroke: [4]byte{32, 206, 255, 180}, Z: 170, Layers: 2,
		})
	}
	objects := make([]render.SnapshotObject, 0, len(shapes))
	for _, shape := range shapes {
		if blockKartStaticHudShape(shape.Id) && !includeStatic {
			continue
		}
		packet := []byte{}
		if blockKartStaticHudShape(shape.Id) {
			packet = game.HudStaticPackets[shape.Id]
		}
		if len(packet) == 0 {
			packet = render2d.EncodeShape(shape)
			if blockKartStaticHudShape(shape.Id) {
				game.HudStaticPackets[shape.Id] = packet
			}
		}
		if len(packet) == 0 {
			return nil
		}
		objects = append(objects, render.SnapshotObject{
			Entity: voplay.Handle{Index: uint32(910000 + shape.Id), Generation: 1}, Bytes: packet,
		})
	}
	texts := []render2d.TextRun{
		{Id: 1, Font: 1, Text: []byte("BLOCKKART"), Position: [2]int64{42000, 52000}, SizeMilli: 30000, Color: [4]byte{255, 255, 255, 255}, Z: 180, Layers: 2},
		{Id: 2, Font: 1, Text: []byte("PRIMITIVE CIRCUIT"), Position: [2]int64{42000, 88000}, SizeMilli: 14000, Color: [4]byte{246, 184, 48, 255}, Z: 180, Layers: 2},
		{Id: 3, Font: 1, Text: []byte("LAP"), Position: [2]int64{338000, 50000}, SizeMilli: 12000, Color: [4]byte{180, 210, 228, 255}, Z: 180, Layers: 2},
		{Id: 4, Font: 1, Text: []byte("TIME"), Position: [2]int64{604000, 36000}, SizeMilli: 12000, Color: [4]byte{210, 225, 238, 255}, Z: 180, Layers: 2},
		{Id: 5, Font: 1, Text: []byte("SPEED"), Position: [2]int64{1040000, 615000}, SizeMilli: 12000, Color: [4]byte{210, 225, 238, 255}, Z: 180, Layers: 2},
		{Id: 6, Font: 1, Text: []byte("W/UP GAS   S/DOWN BRAKE   A/D STEER   SPACE DRIFT   R RESTART"), Position: [2]int64{30000, 700000}, SizeMilli: 12000, Color: [4]byte{235, 244, 250, 235}, Z: 180, Layers: 2},
		{Id: 7, Font: 1, Text: blockKartDecimalText(lapValue, 1), Position: [2]int64{365000, 81000}, SizeMilli: 36000, Color: [4]byte{246, 184, 48, 255}, Z: 180, Layers: 2},
		{Id: 8, Font: 1, Text: blockKartDecimalText(elapsedSeconds, 3), Position: [2]int64{578000, 88000}, SizeMilli: 42000, Color: [4]byte{255, 255, 255, 235}, Z: 180, Layers: 2},
		{Id: 9, Font: 1, Text: blockKartDecimalText(speedValue, 2), Position: [2]int64{1090000, 655000}, SizeMilli: 46000, Color: [4]byte{255, 255, 255, 255}, Z: 180, Layers: 2},
	}
	if countdown != 0 {
		texts = append(texts, render2d.TextRun{
			Id: 10, Font: 1, Text: blockKartDecimalText(countdown, 1), Position: [2]int64{622000, 340000},
			SizeMilli: 70000, Color: [4]byte{255, 255, 255, 255}, Z: 180, Layers: 2,
		})
	}
	for _, text := range texts {
		if text.Id <= 6 && !includeStatic {
			continue
		}
		packet := []byte{}
		if text.Id <= 6 {
			cacheKey := uint64(1000 + text.Id)
			packet = game.HudStaticPackets[cacheKey]
			if len(packet) == 0 {
				packet = render2d.EncodeText(text)
				game.HudStaticPackets[cacheKey] = packet
			}
		} else {
			packet = render2d.EncodeText(text)
		}
		if len(packet) == 0 {
			return nil
		}
		objects = append(objects, render.SnapshotObject{
			Entity: voplay.Handle{Index: uint32(920000 + text.Id), Generation: 1}, Bytes: packet,
		})
	}
	return objects
}

func blockKartStaticHudShape(id uint64) bool {
	return id == 1 || id == 2 || id == 6 || id == 18
}

func (game *BlockKart) appendTouchHud(shapes []render2d.Shape) []render2d.Shape {
	width := int64(game.RenderWidth) * 1000
	height := int64(game.RenderHeight) * 1000
	radius := height * 13 / 100
	if radius > width * 13 / 100 {
		radius = width * 13 / 100
	}
	centerX := width * 18 / 100
	centerY := height * 78 / 100
	knobX := centerX
	knobY := centerY
	for _, point := range game.TouchPoints {
		if point.Role == 1 {
			knobX = int64(point.X)
			knobY = int64(point.Y)
			break
		}
	}
	button := height * 15 / 100
	if button > width * 14 / 100 {
		button = width * 14 / 100
	}
	shapes = append(shapes, render2d.Shape{
		Id: 600, Kind: render2d.ShapeCircle,
		Bounds: [4]int64{centerX - radius, centerY - radius, radius * 2, radius * 2},
		Fill: [4]byte{16, 35, 61, 150}, StrokeMilli: 3000, Stroke: [4]byte{255, 255, 255, 180}, Z: 160,
		Layers: 2,
	}, render2d.Shape{
		Id: 601, Kind: render2d.ShapeCircle,
		Bounds: [4]int64{knobX - radius / 3, knobY - radius / 3, radius * 2 / 3, radius * 2 / 3},
		Fill: [4]byte{33, 223, 255, 220}, Z: 161, Layers: 2,
	}, render2d.Shape{
		Id: 602, Kind: render2d.ShapeCircle,
		Bounds: [4]int64{width - button * 6 / 5, height - button * 6 / 5, button, button},
		Fill: [4]byte{84, 206, 122, 190}, Z: 160, Layers: 2,
	}, render2d.Shape{
		Id: 603, Kind: render2d.ShapeCircle,
		Bounds: [4]int64{
			width - button * 12 / 5, height - button * 11 / 10, button * 4 / 5, button * 4 / 5,
		},
		Fill: [4]byte{238, 78, 48, 190}, Z: 160, Layers: 2,
	}, render2d.Shape{
		Id: 604, Kind: render2d.ShapeCircle,
		Bounds: [4]int64{
			width - button * 12 / 5, height - button * 23 / 10, button * 4 / 5, button * 4 / 5,
		},
		Fill: [4]byte{246, 184, 48, 190}, Z: 160, Layers: 2,
	}, render2d.Shape{
		Id: 605, Kind: render2d.ShapeCircle,
		Bounds: [4]int64{width - button * 6 / 5, height - button * 5 / 2, button * 4 / 5, button * 4 / 5},
		Fill: [4]byte{32, 206, 255, 210}, Z: 160, Layers: 2,
	}, render2d.Shape{
		Id: 606, Kind: render2d.ShapeRoundedRect,
		Bounds: [4]int64{width - button, height / 12, button * 3 / 5, button * 3 / 5},
		RadiusMilli: uint32(button / 8), Fill: [4]byte{255, 255, 255, 150}, Z: 160, Layers: 2,
	})
	return shapes
}

func blockKartDecimalText(value uint64, digits uint32) []byte {
	text := make([]byte, 0, int(digits))
	divisor := uint64(1)
	for index := uint32(1); index < digits; index++ {
		divisor *= 10
	}
	for digitIndex := uint32(0); digitIndex < digits; digitIndex++ {
		digit := byte(value / divisor % 10)
		text = append(text, byte(48) + digit)
		if divisor > 1 {
			divisor /= 10
		}
	}
	return text
}

func blockKartInputMagnitude(value int32) int32 {
	if value == 0 {
		return 0
	}
	if value >= -1 && value <= 1 {
		return value * 1000
	}
	if value < -1000 {
		return -1000
	}
	if value > 1000 {
		return 1000
	}
	return value
}
