package runtimepack

import (
	"errors"
	"github.com/vo-lang/vopack"
	"github.com/vo-lang/vopack/scene3dmap"
	"os"
	"path/filepath"
)

type File struct {
	Path string
	Kind string
	Dependencies []string
}

// Write packages one strictly decoded Scene3D map and its complete resource
// closure. The wire contract lives in vopack/scene3dmap, so this producer stays
// independent of Voplay and its native extension.
func Write(packPath, mapPath, mapBaseDir string, extras []File) error {
	if err := os.MkdirAll("assets", 0755); err != nil {
		return err
	}
	asset, err := loadMapAsset(mapPath)
	if err != nil {
		return err
	}
	mapDeps := scene3dmap.Dependencies(asset, mapBaseDir)
	writer, createErr := vopack.Create(packPath)
	if createErr != nil {
		return createErr
	}
	writer.SetManifestInfo("BlockKart", "primitive-track")
	seen := map[string]bool{}
	if err := addRuntimePackFile(writer, seen, mapPath, "map", dependencyPaths(mapDeps)); err != nil {
		return err
	}
	for _, dep := range mapDeps {
		if err := addRuntimePackFile(writer, seen, dep.Path, dep.Kind, nil); err != nil {
			return err
		}
	}
	for _, extra := range extras {
		if err := addRuntimePackFile(writer, seen, extra.Path, extra.Kind, extra.Dependencies); err != nil {
			return err
		}
	}
	return writer.Close()
}

func addRuntimePackFile(writer *vopack.PackWriter, seen map[string]bool, path, kind string, deps []string) error {
	archivePath := filepath.ToSlash(path)
	if archivePath == "" || seen[archivePath] {
		return nil
	}
	portableDeps := []string{}
	for _, dep := range deps {
		portable := filepath.ToSlash(dep)
		if portable != "" {
			portableDeps = append(portableDeps, portable)
		}
	}
	seen[archivePath] = true
	return writer.AddFile(archivePath, archivePath, vopack.EntryOpts{
		Type: kind, Dependencies: portableDeps,
	})
}

func loadMapAsset(path string) (*scene3dmap.Asset, error) {
	if path == "" {
		return nil, errors.New("runtimepack: map path must not be empty")
	}
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, errors.New("runtimepack: read map " + path + ": " + err.Error())
	}
	asset, decodeErr := scene3dmap.Decode(data)
	if decodeErr != nil {
		return nil, errors.New("runtimepack: decode map " + path + ": " + decodeErr.Error())
	}
	return asset, nil
}

func dependencyPaths(deps []scene3dmap.Dependency) []string {
	paths := []string{}
	for _, dep := range deps {
		if dep.Path != "" {
			paths = append(paths, dep.Path)
		}
	}
	return paths
}
