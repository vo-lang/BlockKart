package main

import (
	"math"
)

const (
	blockKartHandlingScenarioIdle uint32 = 0
	blockKartHandlingScenarioStraightBrake uint32 = 1
	blockKartHandlingScenarioCircleLeft uint32 = 2
	blockKartHandlingScenarioCircleRight uint32 = 3
	blockKartHandlingScenarioSlalom uint32 = 4
	blockKartHandlingScenarioRecovery uint32 = 5
	blockKartHandlingScenarioImpact uint32 = 6
	blockKartHandlingScenarioDrift uint32 = 7
	blockKartHandlingScenarioSteerRelease uint32 = 8
	blockKartHandlingScenarioFlatCorrection uint32 = 9
	blockKartHandlingScenarioStaticSteer uint32 = 10
	blockKartHandlingFailureAcceleration uint32 = 1
	blockKartHandlingFailureStraightLine uint32 = 2
	blockKartHandlingFailureBraking uint32 = 4
	blockKartHandlingFailureHeadingStep uint32 = 8
	blockKartHandlingFailureDirection uint32 = 16
	blockKartHandlingFailureResponse uint32 = 32
	blockKartHandlingFailureSlip uint32 = 64
	blockKartHandlingFailureOvershoot uint32 = 128
	blockKartHandlingFailureSlalom uint32 = 256
	blockKartHandlingFailureRecovery uint32 = 512
	blockKartHandlingFailureImpact uint32 = 1024
	blockKartHandlingFailureDrift uint32 = 2048
	blockKartHandlingFailureSteerRelease uint32 = 4096
	blockKartHandlingFailureFlatCorrection uint32 = 8192
	blockKartHandlingFailureStaticSteer uint32 = 16384
)

// BlockKartHandlingBenchmark runs the vehicle model against an isolated flat
// asphalt reference. It shares the shipping dynamics implementation while
// removing track geometry, collision and player variability from the
// measurement. The shipping chase-camera model remains in the loop so yaw
// settlement and visual settlement are evaluated together.
type BlockKartHandlingBenchmark struct {
	Active bool
	Completed bool
	Passed bool
	Scenario uint32
	Tick uint32
	Failure_mask uint32
	Vehicle BlockKartKartPhysics
	Position_x_meters float64
	Position_z_meters float64
	Last_heading_radians float64
	Last_camera_heading_radians float64
	Peak_speed_meters_per_second float64
	Peak_yaw_rate_radians_per_second float64
	Peak_slip_radians float64
	Peak_lateral_acceleration_meters_per_second_squared float64
	Maximum_heading_step_radians float64
	Maximum_lateral_drift_meters float64
	Reached_sixty_tick uint32
	Brake_started bool
	Brake_start_x_meters float64
	Brake_start_z_meters float64
	Stop_distance_meters float64
	Stop_tick uint32
	Steer_response_ticks uint32
	Steer_start_speed_meters_per_second float64
	Peak_yaw_tick uint32
	Peak_yaw_speed_meters_per_second float64
	Steady_yaw_sum float64
	Steady_speed_sum float64
	Steady_yaw_samples uint32
	Yaw_sign_changes uint32
	Last_yaw_sign int32
	Grass_entry_tick uint32
	Road_return_tick uint32
	Recovery_ticks uint32
	Impact_tick uint32
	Impact_recovery_tick uint32
	Peak_impact_heading_step_radians float64
	Drift_countersteer_slip_sum float64
	Drift_countersteer_samples uint32
	Drift_release_tick uint32
	Drift_recovery_tick uint32
	Steer_release_tick uint32
	Steer_release_recovery_tick uint32
	Steer_release_yaw_sign_changes uint32
	Steer_release_camera_sign_changes uint32
	Last_release_yaw_sign int32
	Last_release_camera_sign int32
	Peak_camera_heading_error_radians float64
	Maximum_camera_heading_step_radians float64
	Correction_reverse_tick uint32
	Correction_yaw_cross_tick uint32
	Correction_release_tick uint32
	Correction_settle_tick uint32
	Correction_release_yaw_rate float64
	Correction_post_release_peak_yaw_rate float64
}

func (benchmark *BlockKartHandlingBenchmark) StartNext() {
	if benchmark == nil {
		return
	}
	scenario := benchmark.Scenario + 1
	if scenario < blockKartHandlingScenarioStraightBrake || scenario > blockKartHandlingScenarioStaticSteer {
		scenario = blockKartHandlingScenarioStraightBrake
	}
	benchmark.Start(scenario)
}

func (benchmark *BlockKartHandlingBenchmark) Start(scenario uint32) {
	if benchmark == nil {
		return
	}
	if scenario < blockKartHandlingScenarioStraightBrake || scenario > blockKartHandlingScenarioStaticSteer {
		scenario = blockKartHandlingScenarioStraightBrake
	}
	*benchmark = BlockKartHandlingBenchmark{Active: true, Scenario: scenario}
	benchmark.Vehicle.Reset(Transform{})
	benchmark.Last_heading_radians = benchmark.Vehicle.Heading_radians
	benchmark.Last_camera_heading_radians = benchmark.Vehicle.Camera_heading_radians
}

func (benchmark *BlockKartHandlingBenchmark) ScenarioName() []byte {
	if benchmark == nil {
		return []byte("IDLE")
	}
	switch benchmark.Scenario {
		case blockKartHandlingScenarioStraightBrake:
			return []byte("STRAIGHT + BRAKE")
		case blockKartHandlingScenarioCircleLeft:
			return []byte("CONSTANT LEFT")
		case blockKartHandlingScenarioCircleRight:
			return []byte("CONSTANT RIGHT")
		case blockKartHandlingScenarioSlalom:
			return []byte("SLALOM")
		case blockKartHandlingScenarioRecovery:
			return []byte("GRASS RECOVERY")
		case blockKartHandlingScenarioImpact:
			return []byte("BARRIER IMPACT")
		case blockKartHandlingScenarioDrift:
			return []byte("DRIFT CONTROL")
		case blockKartHandlingScenarioSteerRelease:
			return []byte("STEER RELEASE")
		case blockKartHandlingScenarioFlatCorrection:
			return []byte("FLAT CORRECTION")
		case blockKartHandlingScenarioStaticSteer:
			return []byte("STATIC STEER")
		default:
			return []byte("IDLE")
	}
}

func (benchmark *BlockKartHandlingBenchmark) DurationTicks() uint32 {
	if benchmark == nil {
		return 0
	}
	switch benchmark.Scenario {
		case blockKartHandlingScenarioStraightBrake:
			return 600
		case blockKartHandlingScenarioCircleLeft, blockKartHandlingScenarioCircleRight:
			return 660
		case blockKartHandlingScenarioSlalom:
			return 720
		case blockKartHandlingScenarioRecovery:
			return 720
		case blockKartHandlingScenarioImpact:
			return 540
		case blockKartHandlingScenarioDrift:
			return 540
		case blockKartHandlingScenarioSteerRelease:
			return 480
		case blockKartHandlingScenarioFlatCorrection:
			return 360
		case blockKartHandlingScenarioStaticSteer:
			return 240
		default:
			return 0
	}
}

func (benchmark *BlockKartHandlingBenchmark) Control() KartControl {
	if benchmark == nil {
		return KartControl{}
	}
	switch benchmark.Scenario {
		case blockKartHandlingScenarioStraightBrake:
			if !benchmark.Brake_started {
				return KartControl{Throttle_milli: 1000}
			}
			return KartControl{Brake_milli: 1000}
		case blockKartHandlingScenarioCircleLeft:
			steer := int32(0)
			if benchmark.Tick >= 180 {
				steer = 700
			}
			return benchmark.cruiseControl(13.8889, steer)
		case blockKartHandlingScenarioCircleRight:
			steer := int32(0)
			if benchmark.Tick >= 180 {
				steer = -700
			}
			return benchmark.cruiseControl(13.8889, steer)
		case blockKartHandlingScenarioSlalom:
			steer := int32(0)
			if benchmark.Tick >= 180 {
				phase := (benchmark.Tick - 180) / 45
				steer = 650
				if phase % 2 != 0 {
					steer = -650
				}
			}
			return benchmark.cruiseControl(16.6667, steer)
		case blockKartHandlingScenarioRecovery:
			steer := int32(0)
			if benchmark.Grass_entry_tick == 0 && benchmark.Tick >= 180 {
				steer = 650
			} else if benchmark.Grass_entry_tick != 0 && benchmark.Road_return_tick == 0 {
				steer = -650
			}
			return benchmark.cruiseControl(13.8889, steer)
		case blockKartHandlingScenarioImpact:
			return benchmark.cruiseControl(15.2778, 0)
		case blockKartHandlingScenarioDrift:
			steer := int32(0)
			drift := false
			if benchmark.Tick >= 180 && benchmark.Tick < 330 {
				steer = 650
				drift = true
			} else if benchmark.Tick >= 330 && benchmark.Tick < 420 {
				steer = -500
				drift = true
			}
			control := benchmark.cruiseControl(16.6667, steer)
			control.Drift = drift
			return control
		case blockKartHandlingScenarioSteerRelease:
			steer := int32(0)
			if benchmark.Tick >= 180 && benchmark.Tick < 300 {
				steer = 700
			}
			return benchmark.cruiseControl(13.8889, steer)
		case blockKartHandlingScenarioFlatCorrection:
			steer := int32(0)
			if benchmark.Tick >= 180 && benchmark.Tick < 210 {
				steer = 1000
			} else if benchmark.Tick >= 210 && benchmark.Tick < 240 {
				steer = -1000
			}
			return benchmark.cruiseControl(16.6667, steer)
		case blockKartHandlingScenarioStaticSteer:
			steer := int32(0)
			if benchmark.Tick >= 30 && benchmark.Tick < 100 {
				steer = 1000
			} else if benchmark.Tick >= 100 && benchmark.Tick < 170 {
				steer = -1000
			}
			return KartControl{Steer_milli: steer}
		default:
			return KartControl{}
	}
}

func (benchmark *BlockKartHandlingBenchmark) cruiseControl(targetSpeedMetersPerSecond float64, steerMilli int32) KartControl {
	speed := benchmark.Vehicle.Forward_speed / 1000.0
	error := targetSpeedMetersPerSecond - speed
	control := KartControl{Steer_milli: steerMilli}
	if error >= 0 {
		control.Throttle_milli = int32(blockKartVehicleClamp(error * 220.0, 0, 1000))
	} else {
		control.Brake_milli = int32(blockKartVehicleClamp(-error * 260.0, 0, 1000))
	}
	return control
}

func (benchmark *BlockKartHandlingBenchmark) Step(fixedTickNanos uint64) {
	if benchmark == nil || !benchmark.Active {
		return
	}
	deltaSeconds := float64(fixedTickNanos) / 1000000000.0
	if deltaSeconds <= 0 || deltaSeconds > 0.1 {
		benchmark.Failure_mask |= blockKartHandlingFailureHeadingStep
		benchmark.finish()
		return
	}
	control := benchmark.Control()
	road := benchmark.syntheticRoad()
	if (benchmark.Scenario == blockKartHandlingScenarioCircleLeft ||
		benchmark.Scenario == blockKartHandlingScenarioCircleRight) &&
		benchmark.Tick == 180 {
		benchmark.Steer_start_speed_meters_per_second = math.Abs(benchmark.Vehicle.Forward_speed) / 1000.0
	}
	if benchmark.Scenario == blockKartHandlingScenarioImpact && benchmark.Tick == 180 {
		benchmark.Vehicle.ApplyImpact(0.78, 0.62)
		benchmark.Impact_tick = benchmark.Tick + 1
	}
	steerTarget := blockKartVehicleSteeringInput(float64(control.Steer_milli) / 1000.0, -1, 1)
	throttle := blockKartVehicleClamp(float64(control.Throttle_milli) / 1000.0, 0, 1)
	brake := blockKartVehicleClamp(float64(control.Brake_milli) / 1000.0, 0, 1)
	drifting := benchmark.Scenario == blockKartHandlingScenarioDrift && control.Drift
	substepSeconds := deltaSeconds / float64(blockKartVehicleSubsteps)
	for substep := uint32(0); substep < blockKartVehicleSubsteps; substep++ {
		benchmark.Vehicle.Step(
			road,
			steerTarget,
			throttle,
			brake,
			false,
			false,
			drifting,
			substepSeconds,
		)
		benchmark.integratePosition(substepSeconds)
	}
	benchmark.Vehicle.stepCamera(drifting, road, deltaSeconds)
	benchmark.sample()
	benchmark.Tick++
	if benchmark.Scenario == blockKartHandlingScenarioStraightBrake && benchmark.Stop_tick != 0 &&
		benchmark.Tick >= benchmark.Stop_tick + 30 {
		benchmark.finish()
		return
	}
	if benchmark.Scenario == blockKartHandlingScenarioRecovery && benchmark.Road_return_tick != 0 &&
		benchmark.Tick >= benchmark.Road_return_tick + 30 {
		benchmark.finish()
		return
	}
	if benchmark.Scenario == blockKartHandlingScenarioDrift && benchmark.Drift_recovery_tick != 0 &&
		benchmark.Tick >= benchmark.Drift_recovery_tick + 30 {
		benchmark.finish()
		return
	}
	if benchmark.Tick >= benchmark.DurationTicks() {
		benchmark.finish()
	}
}

func (benchmark *BlockKartHandlingBenchmark) syntheticRoad() BlockKartRoadSample {
	if benchmark.Scenario == blockKartHandlingScenarioRecovery ||
		benchmark.Scenario == blockKartHandlingScenarioImpact {
		offsetMilli := int64(benchmark.Position_x_meters * 1000.0)
		absoluteOffsetMilli := blockKartAbsInt64(offsetMilli)
		surface := blockKartRoadSurfaceAsphalt
		friction := 1.42
		if absoluteOffsetMilli > 3550 {
			surface = blockKartRoadSurfaceCurb
			friction = 1.10
		}
		if absoluteOffsetMilli > 4950 {
			surface = blockKartRoadSurfaceGrass
			friction = 0.62
		}
		return BlockKartRoadSample{
			Half_width_milli: 4000, Signed_offset_milli: offsetMilli, Surface: surface, Friction: friction,
			Tangent_z: 1, Right_x: 1, Normal_y: 1, Tangent_z_milli: 1000,
		}
	}
	heading := benchmark.Vehicle.Heading_radians
	tangentX := math.Sin(heading)
	tangentZ := math.Cos(heading)
	return BlockKartRoadSample{
		Half_width_milli: 100000, Surface: blockKartRoadSurfaceAsphalt, Friction: 1.42,
		Tangent_x: tangentX, Tangent_z: tangentZ, Right_x: math.Cos(heading), Right_z: -math.Sin(heading),
		Normal_y: 1, Tangent_x_milli: int32(tangentX * 1000.0), Tangent_z_milli: int32(tangentZ * 1000.0),
	}
}

func (benchmark *BlockKartHandlingBenchmark) integratePosition(deltaSeconds float64) {
	heading := benchmark.Vehicle.Heading_radians
	forwardX := math.Sin(heading)
	forwardZ := math.Cos(heading)
	rightX := math.Cos(heading)
	rightZ := -math.Sin(heading)
	forwardSpeed := benchmark.Vehicle.Forward_speed / 1000.0
	lateralSpeed := benchmark.Vehicle.Lateral_speed / 1000.0
	benchmark.Position_x_meters += (forwardX * forwardSpeed + rightX * lateralSpeed) * deltaSeconds
	benchmark.Position_z_meters += (forwardZ * forwardSpeed + rightZ * lateralSpeed) * deltaSeconds
}

func (benchmark *BlockKartHandlingBenchmark) sample() {
	speed := math.Abs(benchmark.Vehicle.Forward_speed) / 1000.0
	yaw := math.Abs(benchmark.Vehicle.Yaw_rate)
	slip := math.Abs(benchmark.Vehicle.Body_slip_radians)
	lateralAcceleration := math.Abs(benchmark.Vehicle.Lateral_acceleration) / 1000.0
	headingStep := math.Abs(blockKartVehicleWrapRadians(benchmark.Vehicle.Heading_radians -
		benchmark.Last_heading_radians))
	cameraHeadingStep := math.Abs(blockKartVehicleWrapRadians(benchmark.Vehicle.Camera_heading_radians -
		benchmark.Last_camera_heading_radians))
	cameraHeadingError := math.Abs(blockKartVehicleWrapRadians(benchmark.Vehicle.Heading_radians -
		benchmark.Vehicle.Camera_heading_radians))
	benchmark.Last_heading_radians = benchmark.Vehicle.Heading_radians
	benchmark.Last_camera_heading_radians = benchmark.Vehicle.Camera_heading_radians
	benchmark.Peak_speed_meters_per_second = math.Max(benchmark.Peak_speed_meters_per_second, speed)
	if yaw > benchmark.Peak_yaw_rate_radians_per_second {
		benchmark.Peak_yaw_rate_radians_per_second = yaw
		benchmark.Peak_yaw_tick = benchmark.Tick + 1
		benchmark.Peak_yaw_speed_meters_per_second = speed
	}
	benchmark.Peak_slip_radians = math.Max(benchmark.Peak_slip_radians, slip)
	benchmark.Peak_lateral_acceleration_meters_per_second_squared = math.Max(benchmark.Peak_lateral_acceleration_meters_per_second_squared, lateralAcceleration)
	benchmark.Maximum_heading_step_radians = math.Max(benchmark.Maximum_heading_step_radians, headingStep)
	benchmark.Maximum_camera_heading_step_radians = math.Max(benchmark.Maximum_camera_heading_step_radians,
		cameraHeadingStep)
	benchmark.Peak_camera_heading_error_radians = math.Max(benchmark.Peak_camera_heading_error_radians,
		cameraHeadingError)
	benchmark.Maximum_lateral_drift_meters = math.Max(benchmark.Maximum_lateral_drift_meters, math.Abs(benchmark.Position_x_meters))
	if benchmark.Reached_sixty_tick == 0 && speed >= 16.6667 {
		benchmark.Reached_sixty_tick = benchmark.Tick + 1
	}
	if benchmark.Scenario == blockKartHandlingScenarioStraightBrake {
		if !benchmark.Brake_started && speed >= 22.2222 {
			benchmark.Brake_started = true
			benchmark.Brake_start_x_meters = benchmark.Position_x_meters
			benchmark.Brake_start_z_meters = benchmark.Position_z_meters
		}
		if benchmark.Brake_started && benchmark.Stop_tick == 0 && speed <= 0.5 {
			deltaX := benchmark.Position_x_meters - benchmark.Brake_start_x_meters
			deltaZ := benchmark.Position_z_meters - benchmark.Brake_start_z_meters
			benchmark.Stop_distance_meters = math.Sqrt(deltaX * deltaX + deltaZ * deltaZ)
			benchmark.Stop_tick = benchmark.Tick + 1
		}
	}
	if benchmark.Scenario == blockKartHandlingScenarioCircleLeft ||
		benchmark.Scenario == blockKartHandlingScenarioCircleRight {
		if benchmark.Tick >= 180 && benchmark.Steer_response_ticks == 0 && yaw >= 0.35 {
			benchmark.Steer_response_ticks = benchmark.Tick - 180 + 1
		}
		if benchmark.Tick + 60 >= benchmark.DurationTicks() {
			benchmark.Steady_yaw_sum += yaw
			benchmark.Steady_speed_sum += speed
			benchmark.Steady_yaw_samples++
		}
	}
	if benchmark.Scenario == blockKartHandlingScenarioSlalom && benchmark.Tick >= 180 && yaw >= 0.12 {
		sign := int32(1)
		if benchmark.Vehicle.Yaw_rate < 0 {
			sign = -1
		}
		if benchmark.Last_yaw_sign != 0 && benchmark.Last_yaw_sign != sign {
			benchmark.Yaw_sign_changes++
		}
		benchmark.Last_yaw_sign = sign
	}
	if benchmark.Scenario == blockKartHandlingScenarioRecovery {
		road := benchmark.syntheticRoad()
		if benchmark.Grass_entry_tick == 0 && road.Surface == blockKartRoadSurfaceGrass {
			benchmark.Grass_entry_tick = benchmark.Tick + 1
		}
		if benchmark.Grass_entry_tick != 0 && benchmark.Road_return_tick == 0 &&
			road.Surface == blockKartRoadSurfaceAsphalt {
			benchmark.Road_return_tick = benchmark.Tick + 1
			benchmark.Recovery_ticks = benchmark.Road_return_tick - benchmark.Grass_entry_tick
		}
	}
	if benchmark.Scenario == blockKartHandlingScenarioImpact && benchmark.Impact_tick != 0 {
		benchmark.Peak_impact_heading_step_radians = math.Max(benchmark.Peak_impact_heading_step_radians, headingStep)
		if benchmark.Impact_recovery_tick == 0 && benchmark.Tick >= benchmark.Impact_tick &&
			math.Abs(benchmark.Vehicle.Yaw_rate) <= 0.10 &&
			math.Abs(benchmark.Vehicle.Lateral_speed) <= 400 &&
			speed >= 12.0 {
			benchmark.Impact_recovery_tick = benchmark.Tick + 1
		}
	}
	if benchmark.Scenario == blockKartHandlingScenarioDrift {
		if benchmark.Tick >= 330 && benchmark.Tick < 420 {
			benchmark.Drift_countersteer_slip_sum += slip
			benchmark.Drift_countersteer_samples++
		}
		if benchmark.Tick == 420 {
			benchmark.Drift_release_tick = benchmark.Tick + 1
		}
		if benchmark.Tick >= 420 && benchmark.Drift_recovery_tick == 0 && slip <= 0.052 && yaw <= 0.15 {
			benchmark.Drift_recovery_tick = benchmark.Tick + 1
		}
	}
	if benchmark.Scenario == blockKartHandlingScenarioSteerRelease && benchmark.Tick >= 300 {
		if benchmark.Steer_release_tick == 0 {
			benchmark.Steer_release_tick = benchmark.Tick + 1
		}
		yawSign := int32(0)
		if benchmark.Vehicle.Yaw_rate > 0.03 {
			yawSign = 1
		} else if benchmark.Vehicle.Yaw_rate < -0.03 {
			yawSign = -1
		}
		if yawSign != 0 {
			if benchmark.Last_release_yaw_sign != 0 && benchmark.Last_release_yaw_sign != yawSign {
				benchmark.Steer_release_yaw_sign_changes++
			}
			benchmark.Last_release_yaw_sign = yawSign
		}
		signedCameraError := blockKartVehicleWrapRadians(benchmark.Vehicle.Heading_radians -
			benchmark.Vehicle.Camera_heading_radians)
		cameraSign := int32(0)
		if signedCameraError > 0.003 {
			cameraSign = 1
		} else if signedCameraError < -0.003 {
			cameraSign = -1
		}
		if cameraSign != 0 {
			if benchmark.Last_release_camera_sign != 0 &&
				benchmark.Last_release_camera_sign != cameraSign {
				benchmark.Steer_release_camera_sign_changes++
			}
			benchmark.Last_release_camera_sign = cameraSign
		}
		if benchmark.Steer_release_recovery_tick == 0 &&
			math.Abs(benchmark.Vehicle.Wheel_angle_radians) <= 0.012 &&
			math.Abs(benchmark.Vehicle.Yaw_rate) <= 0.05 &&
			math.Abs(benchmark.Vehicle.Lateral_speed) <= 250 &&
			cameraHeadingError <= 0.012 {
			benchmark.Steer_release_recovery_tick = benchmark.Tick + 1
		}
	}
	if benchmark.Scenario == blockKartHandlingScenarioFlatCorrection {
		if benchmark.Tick == 210 {
			benchmark.Correction_reverse_tick = benchmark.Tick + 1
		}
		if benchmark.Tick >= 210 && benchmark.Correction_yaw_cross_tick == 0 &&
			benchmark.Vehicle.Yaw_rate <= 0 {
			benchmark.Correction_yaw_cross_tick = benchmark.Tick + 1
		}
		if benchmark.Tick == 239 {
			benchmark.Correction_release_yaw_rate = yaw
		}
		if benchmark.Tick == 240 {
			benchmark.Correction_release_tick = benchmark.Tick + 1
		}
		if benchmark.Tick >= 240 {
			benchmark.Correction_post_release_peak_yaw_rate = math.Max(
				benchmark.Correction_post_release_peak_yaw_rate,
				yaw,
			)
			if benchmark.Correction_settle_tick == 0 &&
				math.Abs(benchmark.Vehicle.Wheel_angle_radians) <= 0.012 &&
				yaw <= 0.05 &&
				math.Abs(benchmark.Vehicle.Lateral_speed) <= 250 {
				benchmark.Correction_settle_tick = benchmark.Tick + 1
			}
		}
	}
}

func (benchmark *BlockKartHandlingBenchmark) finish() {
	if benchmark == nil {
		return
	}
	benchmark.Active = false
	benchmark.Completed = true
	switch benchmark.Scenario {
		case blockKartHandlingScenarioStraightBrake:
			if benchmark.Reached_sixty_tick < 144 || benchmark.Reached_sixty_tick > 192 {
				benchmark.Failure_mask |= blockKartHandlingFailureAcceleration
			}
			if benchmark.Maximum_lateral_drift_meters > 0.35 {
				benchmark.Failure_mask |= blockKartHandlingFailureStraightLine
			}
			if benchmark.Stop_tick == 0 || benchmark.Stop_distance_meters < 24 ||
				benchmark.Stop_distance_meters > 36 {
				benchmark.Failure_mask |= blockKartHandlingFailureBraking
			}
		case blockKartHandlingScenarioCircleLeft:
			if benchmark.Vehicle.Yaw_rate <= 0 {
				benchmark.Failure_mask |= blockKartHandlingFailureDirection
			}
			benchmark.evaluateCircle()
		case blockKartHandlingScenarioCircleRight:
			if benchmark.Vehicle.Yaw_rate >= 0 {
				benchmark.Failure_mask |= blockKartHandlingFailureDirection
			}
			benchmark.evaluateCircle()
		case blockKartHandlingScenarioSlalom:
			if benchmark.Yaw_sign_changes < 8 {
				benchmark.Failure_mask |= blockKartHandlingFailureSlalom
			}
			if benchmark.Peak_slip_radians > 0.244 {
				benchmark.Failure_mask |= blockKartHandlingFailureSlip
			}
		case blockKartHandlingScenarioRecovery:
			recoveredWithinWindow := benchmark.Grass_entry_tick != 0 && benchmark.Road_return_tick != 0 &&
				benchmark.Recovery_ticks <= 180
			if !recoveredWithinWindow {
				benchmark.Failure_mask |= blockKartHandlingFailureRecovery
			}
		case blockKartHandlingScenarioImpact:
			recoveredWithinWindow := benchmark.Impact_tick != 0 &&
				benchmark.Impact_recovery_tick >= benchmark.Impact_tick &&
				benchmark.Impact_recovery_tick <= benchmark.Impact_tick + 180
			if !recoveredWithinWindow || benchmark.Peak_impact_heading_step_radians > 0.06 {
				benchmark.Failure_mask |= blockKartHandlingFailureImpact
			}
		case blockKartHandlingScenarioDrift:
			countersteerSlip := 1.0
			if benchmark.Drift_countersteer_samples != 0 {
				countersteerSlip = benchmark.Drift_countersteer_slip_sum /
					float64(benchmark.Drift_countersteer_samples)
			}
			recoveredWithinWindow := benchmark.Drift_release_tick != 0 &&
				benchmark.Drift_recovery_tick >= benchmark.Drift_release_tick &&
				benchmark.Drift_recovery_tick <= benchmark.Drift_release_tick + 120
			if benchmark.Peak_slip_radians < 0.087 || benchmark.Peak_slip_radians > 0.244 ||
				countersteerSlip > benchmark.Peak_slip_radians * 0.80 ||
				!recoveredWithinWindow {
				benchmark.Failure_mask |= blockKartHandlingFailureDrift
			}
		case blockKartHandlingScenarioSteerRelease:
			recoveredWithinWindow := benchmark.Steer_release_tick != 0 &&
				benchmark.Steer_release_recovery_tick >= benchmark.Steer_release_tick &&
				benchmark.Steer_release_recovery_tick <= benchmark.Steer_release_tick + 90
			if !recoveredWithinWindow ||
				benchmark.Steer_release_yaw_sign_changes != 0 ||
				benchmark.Steer_release_camera_sign_changes != 0 ||
				benchmark.Peak_camera_heading_error_radians > 0.11 ||
				benchmark.Maximum_camera_heading_step_radians > 0.06 {
				benchmark.Failure_mask |= blockKartHandlingFailureSteerRelease
			}
		case blockKartHandlingScenarioFlatCorrection:
			reversedWithinWindow := benchmark.Correction_reverse_tick != 0 &&
				benchmark.Correction_yaw_cross_tick >= benchmark.Correction_reverse_tick &&
				benchmark.Correction_yaw_cross_tick <= benchmark.Correction_reverse_tick + 6
			settledWithinWindow := benchmark.Correction_release_tick != 0 &&
				benchmark.Correction_settle_tick >= benchmark.Correction_release_tick &&
				benchmark.Correction_settle_tick <= benchmark.Correction_release_tick + 30
			releasePeakBound := benchmark.Correction_release_yaw_rate*1.05 + 0.01
			if !reversedWithinWindow || !settledWithinWindow ||
				benchmark.Correction_post_release_peak_yaw_rate > releasePeakBound ||
				benchmark.Peak_slip_radians > 0.087 {
				benchmark.Failure_mask |= blockKartHandlingFailureFlatCorrection
			}
		case blockKartHandlingScenarioStaticSteer:
			// Steering changes wheel geometry only. With zero contact-patch
			// velocity, the chassis must not gain yaw, lateral velocity, slip,
			// or displacement from a fabricated tyre force.
			if benchmark.Peak_yaw_rate_radians_per_second > 0.000001 ||
				benchmark.Peak_slip_radians > 0.000001 ||
				math.Abs(benchmark.Vehicle.Lateral_speed) > 0.001 ||
				benchmark.Maximum_lateral_drift_meters > 0.000001 {
				benchmark.Failure_mask |= blockKartHandlingFailureStaticSteer
			}
	}
	if benchmark.Maximum_heading_step_radians > 0.06 {
		benchmark.Failure_mask |= blockKartHandlingFailureHeadingStep
	}
	benchmark.Passed = benchmark.Failure_mask == 0
}

func (benchmark *BlockKartHandlingBenchmark) evaluateCircle() {
	if benchmark.Steer_response_ticks < 3 || benchmark.Steer_response_ticks > 10 {
		benchmark.Failure_mask |= blockKartHandlingFailureResponse
	}
	if benchmark.Peak_slip_radians > 0.244 {
		benchmark.Failure_mask |= blockKartHandlingFailureSlip
	}
	if benchmark.Steady_yaw_samples == 0 {
		benchmark.Failure_mask |= blockKartHandlingFailureOvershoot
		return
	}
	steadyYaw := benchmark.Steady_yaw_sum / float64(benchmark.Steady_yaw_samples)
	if steadyYaw < 0.01 || (benchmark.Peak_yaw_rate_radians_per_second - steadyYaw) / steadyYaw > 0.08 {
		benchmark.Failure_mask |= blockKartHandlingFailureOvershoot
	}
}
