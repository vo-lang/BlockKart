package main

import "math"

const (
	blockKartRoadSurfaceAsphalt uint32 = 1
	blockKartRoadSurfaceCurb uint32 = 2
	blockKartRoadSurfaceGrass uint32 = 3
	blockKartTrackSamplesPerAnchor int = 24
	blockKartTrackGridCellMilli int64 = 32000
	blockKartTrackRideHeightMilli int64 = 720
)

// BlockKartTrackModel is the one authoritative road representation used by
// vehicle contact, rivals, recovery, race progress, and presentation helpers.
// Its coordinates follow the OpenDRIVE reference-line convention: S advances
// along the road, T is positive toward the local right vector, and H follows
// the road normal.
type BlockKartTrackModel struct {
	Samples []BlockKartTrackSample
	Grid map[int64][]int
	Total_length_milli int64
}

type BlockKartTrackSample struct {
	S_milli int64
	X int64
	Y int64
	Z int64
	Half_width_milli int64
	Tangent_x float64
	Tangent_y float64
	Tangent_z float64
	Right_x float64
	Right_y float64
	Right_z float64
	Normal_x float64
	Normal_y float64
	Normal_z float64
	Curvature_per_meter float64
	Grade float64
	Bank_radians float64
}

type BlockKartRoadPoint struct {
	X int64
	Y int64
	Z int64
	Half_width_milli int64
}

type BlockKartRoadSample struct {
	X int64
	Y int64
	Z int64
	Half_width_milli int64
	Distance_milli int64
	Signed_offset_milli int64
	S_milli int64
	Segment_index int
	Surface uint32
	Friction float64
	Curvature_per_meter float64
	Preview_curvature_per_meter float64
	Corner_speed_limit_meters_per_second float64
	Grade float64
	Bank_radians float64
	Tangent_x float64
	Tangent_y float64
	Tangent_z float64
	Right_x float64
	Right_y float64
	Right_z float64
	Normal_x float64
	Normal_y float64
	Normal_z float64
	Tangent_x_milli int32
	Tangent_z_milli int32
}

func blockKartStartTransform() Transform {
	return Transform{
		X: 0, Y: 100 + blockKartTrackRideHeightMilli, Z: 0,
		Yaw_milliradians: 3079,
	}
}

func blockKartTrackPoints() [][3]int64 {
	return [][3]int64{
		{0, 0, 30000}, {0, 100, 0}, {2000, 1000, -32000}, {-6000, 2800, -64000},
		{-31000, 5800, -94000}, {-50000, 9500, -126000}, {-45000, 14500, -160000},
		{-22000, 19000, -194000}, {11000, 23000, -226000}, {42000, 27000, -258000},
		{62000, 30000, -292000}, {150000, 32000, -318000}, {250000, 26000, -275000},
		{285000, 18000, -180000}, {260000, 9000, -70000}, {190000, 3000, 35000},
		{90000, 800, 80000},
	}
}

func blockKartTrackHalfWidths() []int64 {
	return []int64{
		8200, 8200, 8200, 8200, 8200, 8200, 8200, 8200, 8200,
		8200, 8200, 8200, 8200, 8200, 8200, 8200, 8200,
	}
}

func blockKartCatmullRom(a int64, b int64, c int64, d int64, t float64) int64 {
	t2 := t * t
	t3 := t2 * t
	return int64(0.5 *
		(2.0 * float64(b) + float64(-a + c) * t +
			float64(2*a-5*b+4*c-d)*t2 +
			float64(-a+3*b-3*c+d)*t3))
}

func blockKartBuildTrackModel() BlockKartTrackModel {
	anchors := blockKartTrackPoints()
	widths := blockKartTrackHalfWidths()
	model := BlockKartTrackModel{Grid: map[int64][]int{}}
	if len(anchors) < 4 || len(widths) != len(anchors) {
		return model
	}
	model.Samples = make([]BlockKartTrackSample, 0,
		len(anchors)*blockKartTrackSamplesPerAnchor)
	for index, b := range anchors {
		a := anchors[(index-1+len(anchors))%len(anchors)]
		c := anchors[(index+1)%len(anchors)]
		d := anchors[(index+2)%len(anchors)]
		wa := widths[(index-1+len(widths))%len(widths)]
		wb := widths[index]
		wc := widths[(index+1)%len(widths)]
		wd := widths[(index+2)%len(widths)]
		for step := 0; step < blockKartTrackSamplesPerAnchor; step++ {
			t := float64(step) / float64(blockKartTrackSamplesPerAnchor)
			model.Samples = append(model.Samples, BlockKartTrackSample{
				X: blockKartCatmullRom(a[0], b[0], c[0], d[0], t),
				Y: blockKartCatmullRom(a[1], b[1], c[1], d[1], t),
				Z: blockKartCatmullRom(a[2], b[2], c[2], d[2], t),
				Half_width_milli: blockKartCatmullRom(wa, wb, wc, wd, t),
			})
		}
	}
	model.buildArcLengthAndFrames()
	model.buildSpatialGrid()
	return model
}

func (model *BlockKartTrackModel) buildArcLengthAndFrames() {
	if model == nil || len(model.Samples) < 4 {
		return
	}
	total := int64(0)
	for index := 0; index < len(model.Samples); index++ {
		if index > 0 {
			previous := model.Samples[index-1]
			current := model.Samples[index]
			total += blockKartTrackDistance3(previous, current)
		}
		model.Samples[index].S_milli = total
	}
	last := model.Samples[len(model.Samples)-1]
	first := model.Samples[0]
	model.Total_length_milli = total + blockKartTrackDistance3(last, first)
	for index := 0; index < len(model.Samples); index++ {
		previous := model.Samples[(index-1+len(model.Samples))%len(model.Samples)]
		next := model.Samples[(index+1)%len(model.Samples)]
		dx := float64(next.X - previous.X)
		dy := float64(next.Y - previous.Y)
		dz := float64(next.Z - previous.Z)
		length := math.Sqrt(dx*dx + dy*dy + dz*dz)
		if length < 1 {
			length = 1
		}
		tangentX := dx / length
		tangentY := dy / length
		tangentZ := dz / length
		model.Samples[index].Tangent_x = tangentX
		model.Samples[index].Tangent_y = tangentY
		model.Samples[index].Tangent_z = tangentZ
		horizontal := math.Sqrt(tangentX*tangentX + tangentZ*tangentZ)
		if horizontal < 0.0001 {
			horizontal = 0.0001
		}
		model.Samples[index].Grade = tangentY / horizontal
	}
	for index := 0; index < len(model.Samples); index++ {
		previous := model.Samples[(index-1+len(model.Samples))%len(model.Samples)]
		next := model.Samples[(index+1)%len(model.Samples)]
		previousHeading := math.Atan2(previous.Tangent_x, previous.Tangent_z)
		nextHeading := math.Atan2(next.Tangent_x, next.Tangent_z)
		headingChange := blockKartTrackWrapRadians(nextHeading - previousHeading)
		spanMeters := float64(blockKartTrackDistance3(previous, next)) / 1000.0
		if spanMeters < 0.01 {
			spanMeters = 0.01
		}
		curvature := headingChange / spanMeters
		model.Samples[index].Curvature_per_meter = curvature
		designLateralAcceleration := 20.0 * 20.0 * curvature
		bank := -math.Atan(designLateralAcceleration / 9.81) * 0.32
		model.Samples[index].Bank_radians = blockKartTrackClamp(bank, -0.13, 0.13)
	}
	for pass := 0; pass < 3; pass++ {
		smoothed := make([]float64, len(model.Samples))
		for index := 0; index < len(model.Samples); index++ {
			previous := model.Samples[(index-1+len(model.Samples))%len(model.Samples)]
			current := model.Samples[index]
			next := model.Samples[(index+1)%len(model.Samples)]
			smoothed[index] = previous.Bank_radians*0.25 +
				current.Bank_radians*0.5 + next.Bank_radians*0.25
		}
		for index, value := range smoothed {
			model.Samples[index].Bank_radians = value
		}
	}
	for index := 0; index < len(model.Samples); index++ {
		sample := &model.Samples[index]
		cosBank := math.Cos(sample.Bank_radians)
		sinBank := math.Sin(sample.Bank_radians)
		horizontal := math.Sqrt(sample.Tangent_x*sample.Tangent_x +
			sample.Tangent_z*sample.Tangent_z)
		if horizontal < 0.0001 {
			horizontal = 0.0001
		}
		rightX := sample.Tangent_z / horizontal * cosBank
		rightY := sinBank
		rightZ := -sample.Tangent_x / horizontal * cosBank
		normalX := sample.Tangent_y*rightZ - sample.Tangent_z*rightY
		normalY := sample.Tangent_z*rightX - sample.Tangent_x*rightZ
		normalZ := sample.Tangent_x*rightY - sample.Tangent_y*rightX
		normalLength := math.Sqrt(normalX*normalX + normalY*normalY + normalZ*normalZ)
		if normalLength < 0.0001 {
			normalLength = 1
		}
		sample.Right_x = rightX
		sample.Right_y = rightY
		sample.Right_z = rightZ
		sample.Normal_x = normalX / normalLength
		sample.Normal_y = normalY / normalLength
		sample.Normal_z = normalZ / normalLength
	}
}

func (model *BlockKartTrackModel) buildSpatialGrid() {
	if model == nil {
		return
	}
	if model.Grid == nil {
		model.Grid = map[int64][]int{}
	}
	for index, sample := range model.Samples {
		cellX := blockKartTrackFloorDiv(sample.X, blockKartTrackGridCellMilli)
		cellZ := blockKartTrackFloorDiv(sample.Z, blockKartTrackGridCellMilli)
		key := blockKartTrackGridKey(cellX, cellZ)
		model.Grid[key] = append(model.Grid[key], index)
	}
}

func blockKartTrackDistance3(a BlockKartTrackSample, b BlockKartTrackSample) int64 {
	dx := float64(b.X - a.X)
	dy := float64(b.Y - a.Y)
	dz := float64(b.Z - a.Z)
	return int64(math.Sqrt(dx*dx + dy*dy + dz*dz))
}

func blockKartTrackFloorDiv(value int64, divisor int64) int64 {
	result := value / divisor
	if value < 0 && value%divisor != 0 {
		result--
	}
	return result
}

func blockKartTrackGridKey(x int64, z int64) int64 {
	return (x+32768)*65536 + (z + 32768)
}

func blockKartTrackWrapRadians(value float64) float64 {
	for value > math.Pi {
		value -= math.Pi * 2.0
	}
	for value < -math.Pi {
		value += math.Pi * 2.0
	}
	return value
}

func blockKartTrackClamp(value float64, minimum float64, maximum float64) float64 {
	if value < minimum {
		return minimum
	}
	if value > maximum {
		return maximum
	}
	return value
}

func (model *BlockKartTrackModel) Query(x int64, z int64) BlockKartRoadSample {
	if model == nil || len(model.Samples) < 2 {
		return BlockKartRoadSample{
			X: x, Z: z, Half_width_milli: 9000, Distance_milli: 1000000,
			Friction: 0.6, Surface: blockKartRoadSurfaceGrass,
			Tangent_z: 1, Tangent_z_milli: 1000, Right_x: 1, Normal_y: 1,
		}
	}
	cellX := blockKartTrackFloorDiv(x, blockKartTrackGridCellMilli)
	cellZ := blockKartTrackFloorDiv(z, blockKartTrackGridCellMilli)
	bestSquared := math.MaxFloat64
	bestIndex := 0
	bestAlong := 0.0
	queryX := float64(x)
	queryZ := float64(z)
	foundCandidate := false
	for offsetX := int64(-1); offsetX <= 1; offsetX++ {
		for offsetZ := int64(-1); offsetZ <= 1; offsetZ++ {
			key := blockKartTrackGridKey(cellX+offsetX, cellZ+offsetZ)
			for _, index := range model.Grid[key] {
				distanceSquared, along, valid :=
					model.segmentProjection(index, queryX, queryZ)
				if valid && distanceSquared < bestSquared {
					bestSquared = distanceSquared
					bestIndex = index
					bestAlong = along
					foundCandidate = true
				}
			}
		}
	}
	if !foundCandidate {
		for index := range model.Samples {
			distanceSquared, along, valid :=
				model.segmentProjection(index, queryX, queryZ)
			if valid && distanceSquared < bestSquared {
				bestSquared = distanceSquared
				bestIndex = index
				bestAlong = along
			}
		}
	}
	from := model.Samples[bestIndex]
	to := model.Samples[(bestIndex+1)%len(model.Samples)]
	dx := float64(to.X - from.X)
	dz := float64(to.Z - from.Z)
	horizontalLength := math.Sqrt(dx*dx + dz*dz)
	if horizontalLength < 1 {
		horizontalLength = 1
	}
	centerX := float64(from.X) + dx*bestAlong
	centerY := float64(from.Y) + float64(to.Y-from.Y)*bestAlong
	centerZ := float64(from.Z) + dz*bestAlong
	tangentX := blockKartTrackLerp(from.Tangent_x, to.Tangent_x, bestAlong)
	tangentY := blockKartTrackLerp(from.Tangent_y, to.Tangent_y, bestAlong)
	tangentZ := blockKartTrackLerp(from.Tangent_z, to.Tangent_z, bestAlong)
	rightX := blockKartTrackLerp(from.Right_x, to.Right_x, bestAlong)
	rightY := blockKartTrackLerp(from.Right_y, to.Right_y, bestAlong)
	rightZ := blockKartTrackLerp(from.Right_z, to.Right_z, bestAlong)
	normalX := blockKartTrackLerp(from.Normal_x, to.Normal_x, bestAlong)
	normalY := blockKartTrackLerp(from.Normal_y, to.Normal_y, bestAlong)
	normalZ := blockKartTrackLerp(from.Normal_z, to.Normal_z, bestAlong)
	offsetX := queryX - centerX
	offsetZ := queryZ - centerZ
	signedOffset := offsetX*rightX + offsetZ*rightZ
	halfWidth := int64(float64(from.Half_width_milli) +
		float64(to.Half_width_milli-from.Half_width_milli)*bestAlong)
	surface := blockKartRoadSurfaceAsphalt
	friction := 1.42
	absoluteOffset := math.Abs(signedOffset)
	if absoluteOffset > float64(halfWidth-450) {
		surface = blockKartRoadSurfaceCurb
		friction = 1.10
	}
	if absoluteOffset > float64(halfWidth+950) {
		surface = blockKartRoadSurfaceGrass
		friction = 0.62
	}
	segmentLength := blockKartTrackDistance3(from, to)
	s := from.S_milli + int64(float64(segmentLength)*bestAlong)
	if s >= model.Total_length_milli {
		s -= model.Total_length_milli
	}
	roadHeight := centerY + rightY*signedOffset
	return BlockKartRoadSample{
		X: int64(centerX), Y: int64(roadHeight), Z: int64(centerZ),
		Half_width_milli: halfWidth,
		Distance_milli: int64(math.Sqrt(bestSquared)),
		Signed_offset_milli: int64(signedOffset),
		S_milli: s,
		Segment_index: bestIndex,
		Surface: surface,
		Friction: friction,
		Curvature_per_meter: blockKartTrackLerp(from.Curvature_per_meter,
			to.Curvature_per_meter, bestAlong),
		Grade: blockKartTrackLerp(from.Grade, to.Grade, bestAlong),
		Bank_radians: blockKartTrackLerp(from.Bank_radians, to.Bank_radians, bestAlong),
		Tangent_x: tangentX, Tangent_y: tangentY, Tangent_z: tangentZ,
		Right_x: rightX, Right_y: rightY, Right_z: rightZ,
		Normal_x: normalX, Normal_y: normalY, Normal_z: normalZ,
		Tangent_x_milli: int32(tangentX * 1000.0),
		Tangent_z_milli: int32(tangentZ * 1000.0),
	}
}

func (model *BlockKartTrackModel) segmentProjection(
	index int,
	queryX float64,
	queryZ float64,
) (float64, float64, bool) {
	if model == nil || index < 0 || index >= len(model.Samples) {
		return 0, 0, false
	}
	from := model.Samples[index]
	to := model.Samples[(index+1)%len(model.Samples)]
	dx := float64(to.X - from.X)
	dz := float64(to.Z - from.Z)
	lengthSquared := dx*dx + dz*dz
	if lengthSquared < 1 {
		return 0, 0, false
	}
	along := ((queryX-float64(from.X))*dx +
		(queryZ-float64(from.Z))*dz) / lengthSquared
	along = blockKartTrackClamp(along, 0, 1)
	nearestX := float64(from.X) + dx*along
	nearestZ := float64(from.Z) + dz*along
	offsetX := queryX - nearestX
	offsetZ := queryZ - nearestZ
	return offsetX*offsetX + offsetZ*offsetZ, along, true
}

func blockKartTrackLerp(from float64, to float64, amount float64) float64 {
	return from + (to-from)*amount
}

func blockKartTrackCenterline(model BlockKartTrackModel) []BlockKartRoadPoint {
	if len(model.Samples) == 0 {
		return nil
	}
	result := make([]BlockKartRoadPoint, 0, len(model.Samples))
	for _, sample := range model.Samples {
		result = append(result, BlockKartRoadPoint{
			X: sample.X, Y: sample.Y, Z: sample.Z,
			Half_width_milli: sample.Half_width_milli,
		})
	}
	return result
}

func (model *BlockKartTrackModel) SampleAtS(s int64) BlockKartTrackSample {
	if model == nil || len(model.Samples) == 0 || model.Total_length_milli <= 0 {
		return BlockKartTrackSample{}
	}
	for s < 0 {
		s += model.Total_length_milli
	}
	s %= model.Total_length_milli
	low := 0
	high := len(model.Samples)
	for low < high {
		middle := low + (high-low)/2
		if model.Samples[middle].S_milli <= s {
			low = middle + 1
		} else {
			high = middle
		}
	}
	fromIndex := low - 1
	if fromIndex < 0 {
		fromIndex = len(model.Samples) - 1
	}
	toIndex := (fromIndex + 1) % len(model.Samples)
	from := model.Samples[fromIndex]
	to := model.Samples[toIndex]
	segmentLength := blockKartTrackDistance3(from, to)
	if segmentLength < 1 {
		return from
	}
	distanceIntoSegment := s - from.S_milli
	if toIndex == 0 && distanceIntoSegment < 0 {
		distanceIntoSegment += model.Total_length_milli
	}
	amount := blockKartTrackClamp(
		float64(distanceIntoSegment)/float64(segmentLength), 0, 1,
	)
	return BlockKartTrackSample{
		S_milli: s,
		X: int64(float64(from.X)+float64(to.X-from.X)*amount),
		Y: int64(float64(from.Y)+float64(to.Y-from.Y)*amount),
		Z: int64(float64(from.Z)+float64(to.Z-from.Z)*amount),
		Half_width_milli: int64(float64(from.Half_width_milli)+
			float64(to.Half_width_milli-from.Half_width_milli)*amount),
		Tangent_x: blockKartTrackLerp(from.Tangent_x, to.Tangent_x, amount),
		Tangent_y: blockKartTrackLerp(from.Tangent_y, to.Tangent_y, amount),
		Tangent_z: blockKartTrackLerp(from.Tangent_z, to.Tangent_z, amount),
		Right_x: blockKartTrackLerp(from.Right_x, to.Right_x, amount),
		Right_y: blockKartTrackLerp(from.Right_y, to.Right_y, amount),
		Right_z: blockKartTrackLerp(from.Right_z, to.Right_z, amount),
		Normal_x: blockKartTrackLerp(from.Normal_x, to.Normal_x, amount),
		Normal_y: blockKartTrackLerp(from.Normal_y, to.Normal_y, amount),
		Normal_z: blockKartTrackLerp(from.Normal_z, to.Normal_z, amount),
		Curvature_per_meter: blockKartTrackLerp(
			from.Curvature_per_meter, to.Curvature_per_meter, amount,
		),
		Grade: blockKartTrackLerp(from.Grade, to.Grade, amount),
		Bank_radians: blockKartTrackLerp(from.Bank_radians, to.Bank_radians, amount),
	}
}

// PrepareDrivingReference samples the road far enough ahead to cover a
// one-second steering decision plus the braking distance of a fast kart. The
// resulting corner speed is derived from a 1.35 g grip budget and is consumed
// as a soft throttle/brake envelope by the vehicle model.
func (model *BlockKartTrackModel) PrepareDrivingReference(
	road *BlockKartRoadSample,
	speedMetersPerSecond float64,
) {
	if model == nil || road == nil || len(model.Samples) == 0 ||
		model.Total_length_milli <= 0 {
		return
	}
	speedMetersPerSecond = math.Abs(speedMetersPerSecond)
	lookAheadMeters := blockKartTrackClamp(
		16.0+speedMetersPerSecond*1.55,
		24.0,
		64.0,
	)
	previewCurvature := road.Curvature_per_meter
	maximumAbsoluteCurvature := math.Abs(previewCurvature)
	for step := 1; step <= 5; step++ {
		amount := float64(step) / 5.0
		sample := model.SampleAtS(
			road.S_milli + int64(lookAheadMeters*amount*1000.0),
		)
		absoluteCurvature := math.Abs(sample.Curvature_per_meter)
		if absoluteCurvature > maximumAbsoluteCurvature {
			maximumAbsoluteCurvature = absoluteCurvature
			previewCurvature = sample.Curvature_per_meter
		}
	}
	road.Preview_curvature_per_meter = previewCurvature
	const cornerLateralAcceleration = 13.25
	cornerSpeed := 30.0
	if maximumAbsoluteCurvature > 0.001 {
		cornerSpeed = math.Sqrt(
			cornerLateralAcceleration / maximumAbsoluteCurvature,
		)
	}
	road.Corner_speed_limit_meters_per_second = blockKartTrackClamp(
		cornerSpeed,
		11.25,
		30.0,
	)
}

func (game *BlockKart) nearestRoadSample(transform Transform) BlockKartRoadSample {
	if game == nil {
		return BlockKartRoadSample{}
	}
	return game.Track.Query(transform.X, transform.Z)
}
