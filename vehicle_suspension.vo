package main

import "math"

const (
	blockKartVehicleHalfTrackMeters float64 = 0.79
	blockKartVehicleSuspensionRestMilli float64 = 720.0
	blockKartVehicleSuspensionTravelMilli float64 = 170.0
)

func (vehicle *BlockKartVehicleController) stepSuspension(
	track *BlockKartTrackModel,
	transform Transform,
	deltaSeconds float64,
) {
	if vehicle == nil || track == nil {
		return
	}
	heading := vehicle.Heading_radians
	forwardX := math.Sin(heading)
	forwardZ := math.Cos(heading)
	rightX := math.Cos(heading)
	rightZ := -math.Sin(heading)
	frontMilli := blockKartVehicleFrontAxleMeters * 1000.0
	rearMilli := blockKartVehicleRearAxleMeters * 1000.0
	halfTrackMilli := blockKartVehicleHalfTrackMeters * 1000.0
	wheelX := [4]float64{
		float64(transform.X)+forwardX*frontMilli-rightX*halfTrackMilli,
		float64(transform.X)+forwardX*frontMilli+rightX*halfTrackMilli,
		float64(transform.X)-forwardX*rearMilli-rightX*halfTrackMilli,
		float64(transform.X)-forwardX*rearMilli+rightX*halfTrackMilli,
	}
	wheelZ := [4]float64{
		float64(transform.Z)+forwardZ*frontMilli-rightZ*halfTrackMilli,
		float64(transform.Z)+forwardZ*frontMilli+rightZ*halfTrackMilli,
		float64(transform.Z)-forwardZ*rearMilli-rightZ*halfTrackMilli,
		float64(transform.Z)-forwardZ*rearMilli+rightZ*halfTrackMilli,
	}
	roadHeight := [4]float64{}
	for index := 0; index < 4; index++ {
		contact := track.Query(int64(wheelX[index]), int64(wheelZ[index]))
		roadHeight[index] = float64(contact.Y)
	}
	frontHeight := (roadHeight[0] + roadHeight[1]) * 0.5
	rearHeight := (roadHeight[2] + roadHeight[3]) * 0.5
	leftHeight := (roadHeight[0] + roadHeight[2]) * 0.5
	rightHeight := (roadHeight[1] + roadHeight[3]) * 0.5
	averageHeight := (frontHeight + rearHeight) * 0.5
	targetHeight := averageHeight + blockKartVehicleSuspensionRestMilli
	if !vehicle.Initialized || vehicle.Suspended_height_milli == 0 {
		vehicle.Suspended_height_milli = targetHeight
	}
	displacement := targetHeight - vehicle.Suspended_height_milli
	springAcceleration := displacement*92.0 -
		vehicle.Suspension_velocity_milli_per_second*18.0
	springAcceleration =
		blockKartVehicleClamp(springAcceleration, -52000, 52000)
	vehicle.Suspension_velocity_milli_per_second +=
		springAcceleration * deltaSeconds
	vehicle.Suspended_height_milli +=
		vehicle.Suspension_velocity_milli_per_second * deltaSeconds
	minimumHeight := targetHeight - blockKartVehicleSuspensionTravelMilli
	maximumHeight := targetHeight + blockKartVehicleSuspensionTravelMilli
	if vehicle.Suspended_height_milli < minimumHeight {
		vehicle.Suspended_height_milli = minimumHeight
		if vehicle.Suspension_velocity_milli_per_second < 0 {
			vehicle.Suspension_velocity_milli_per_second *= -0.12
		}
	} else if vehicle.Suspended_height_milli > maximumHeight {
		vehicle.Suspended_height_milli = maximumHeight
		if vehicle.Suspension_velocity_milli_per_second > 0 {
			vehicle.Suspension_velocity_milli_per_second *= -0.12
		}
	}
	vehicle.Suspension_offset_milli =
		vehicle.Suspended_height_milli - targetHeight
	vehicle.Road_pitch_radians = math.Atan2(
		frontHeight-rearHeight,
		blockKartVehicleWheelbaseMeters*1000.0,
	)
	vehicle.Road_roll_radians = math.Atan2(
		rightHeight-leftHeight,
		blockKartVehicleHalfTrackMeters*2000.0,
	)
	for index := 0; index < 4; index++ {
		nominalWheelCenter := vehicle.Suspended_height_milli - 220.0
		desiredWheelCenter := roadHeight[index] + blockKartVehicleWheelRadiusMilli
		visualOffset := desiredWheelCenter - nominalWheelCenter
		visualOffset = blockKartVehicleClamp(
			visualOffset,
			-blockKartVehicleSuspensionTravelMilli,
			blockKartVehicleSuspensionTravelMilli,
		)
		vehicle.Wheel_compression_milli[index] =
			blockKartVehicleClamp(-visualOffset, -95, 145)
		vehicle.Wheel_visual_offset_milli[index] = visualOffset
	}
}

func (vehicle *BlockKartVehicleController) visualWheelOffset(index int) int64 {
	if vehicle == nil || index < 0 || index >= 4 {
		return 0
	}
	// Authored wheel order is rear-left, rear-right, front-left, front-right.
	physicsIndex := index
	if index == 0 {
		physicsIndex = 2
	} else if index == 1 {
		physicsIndex = 3
	} else if index == 2 {
		physicsIndex = 0
	} else if index == 3 {
		physicsIndex = 1
	}
	return int64(vehicle.Wheel_visual_offset_milli[physicsIndex])
}
